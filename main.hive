// The Hive Tour — an HTTP server that walks through the language one
// feature at a time, in the spirit of an interactive language tour. Every
// slide is one `Slide` value: a title, an explanation, and one or more
// code examples — each a complete, runnable program in its own right, kept
// small enough that one example makes one point. Every piece of prose
// carries an English and a Portuguese version side by side; the code never
// does, because code is not prose. `handle` reads the slide number and the
// chosen language out of the URL, `hive.net.httpServe` does the rest.
//
// The interface is built with `hive.ui`: the sidebar, the heading, the
// explanation and the prev/next links are all `View`s, rendered by
// `ui.page`. Two things the widget set has no answer for are spliced into
// the finished document as literal HTML: a monospaced, boxed code sample,
// which goes in place of a marker view, and the `<link>` that names the tab
// icon, which goes in the head, where nothing is on show and so nothing is
// a view. Everything else stays a view all the way down.
//
// The mark the home screen shows, and the one the tab gets, both live in
// ./logo, which holds the drawing and nothing else — the tour is prose, and
// a page of path coordinates in the middle of it would read as neither.
import hive.ui
import ./logo

type Example {
	caption:   Str
	captionPt: Str
	code:      Str
	codePt:    Str
}

type Slide {
	title:         Str
	titlePt:       Str
	explanation:   Str
	explanationPt: Str
	examples:      Example[dyn]
	download:      Bool
}

proc main(): void {
	echo "The Hive Tour: http://localhost:8080"
	hive.net.httpServe(8080, handle)
}

proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	path := requestPath(request.url)
	lang := requestLang(request.url)

	if path == "/" {
		return homeResponse(lang)
	}

	// The two framings of the mark, at the two paths that ask for them: the
	// home screen's `<img>`, and whatever a browser makes of the `<link>` in
	// the head. Neither depends on the language, so neither reads `lang`.
	if path == "/hive-logo.svg" {
		return svgResponse(logo.svg())
	}
	if path == "/favicon.svg" {
		return svgResponse(logo.icon())
	}

	all := slides()
	if path is "/{n}" {
		parsed := hive.conv.sti(n)
		if parsed is Result.Ok(num) {
			idx := num - 1
			if all bounds idx {
				slide := all[idx]
				return renderSlide(slide, idx, all, lang)
			}
		}
	}
	return notFoundResponse(lang, path)
}

// The path and the query string travel together in `request.url` — a GET
// to "/3?lang=pt" arrives as exactly that one Str. Splitting on "?" is the
// whole of parsing either back out: `split` never yields zero pieces, so
// the path half is always there, and the query half is only there to ask
// about when a "?" showed up at all.
func requestPath(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 0 {
		return parts[0]
	}
	return url
}

// The only query parameter this server reads. Not a real query-string
// parser — it doesn't need to be one, since this program is the only thing
// that ever writes a `?lang=` into one of its own links.
func requestLang(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 1 {
		if indexOf(parts[1], "lang=pt") is Result.Ok(_) {
			return "pt"
		}
	}
	return "en"
}

// ---------------------------------------------------------------------------
// Rendering

// The one View a page never keeps: a stand-in for the code examples, so
// they can be rendered once inside `ui.page` and then found again in the
// HTML that comes back. Its rendering has no attributes at all, so it
// always comes back exactly as `codeMarkerTag` says, whatever the renderer
// does.
func codeMarker(): Str {
	return "HIVE_TOUR_CODE_SAMPLE"
}

func codeMarkerView(): ui.View {
	return ui.text([], codeMarker())
}

func codeMarkerTag(): Str {
	return "<span class=\"h-text\">" + codeMarker() + "</span>"
}

// Every page this server sends, and the one line of it no view can carry.
// `ui.page` writes a whole document — charset, viewport, title, stylesheet
// — and the tab icon belongs in its head, which is the half of a page
// nobody looks at. So it is spliced the way a code sample is: split the
// document on a tag that is certainly in it, and join it back with ours in
// front of that tag.
func document(title: Str, view: ui.View): Str {
	page := ui.page(title, view)
	return join(split(page, "</head>"), iconLinkTag() + "</head>")
}

// An SVG icon rather than the .ico a browser guesses at: one drawing, drawn
// at whatever size the tab it lands in happens to be.
func iconLinkTag(): Str {
	return "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">"
}

// The mark, either framing of it. A day of caching, because the drawing is
// part of the executable: it cannot change without a new binary, and until
// one ships there is nothing here worth asking for twice.
func svgResponse(svg: Str): hive.net.HttpResponse {
	headers := [
		["Content-Type", "image/svg+xml; charset=utf-8"],
		["Cache-Control", "public, max-age=86400"],
	]
	return hive.net.HttpResponse(200, headers, svg)
}

func renderSlide(slide: Slide, idx: Int, all: Slide[], lang: Str): hive.net.HttpResponse {
	total := len(all)
	path := "/{idx + 1}"
	top := ui.row([], [sidebarView(all, idx, lang, path), headerColumn(slide, idx, total, lang)])
	page := document(slideTitle(slide, lang) + pageTitleSuffix(lang), top)
	spliced := examplesHtml(slide.examples, lang) + ui.html(bottomView(slide, idx, total, lang, path))
	body := join(split(page, codeMarkerTag()), spliced)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"]], body)
}

func slideTitle(slide: Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.titlePt
	}
	return slide.title
}

func slideExplanation(slide: Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.explanationPt
	}
	return slide.explanation
}

// The landing page: what Hive is, in the same layout every slide uses, so
// the sidebar is already there to jump into wherever looks interesting —
// or `/1` picks it up from the beginning.
func homeResponse(lang: Str): hive.net.HttpResponse {
	all := slides()
	content := ui.column([ui.gap(20), ui.pad(40), ui.grow(1), ui.width(680)], [
		// The gap is small because the drawing brings its own: the artwork is
		// a square with the bee inside it, so a fifth of the width beside the
		// name is margin the mark already paid for.
		ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
			ui.image([ui.width(128)], "/hive-logo.svg", logoAlt(lang)),
			ui.column([ui.gap(4)], [
				ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], homeKicker(lang)),
				ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Hive"),
			]),
		]),
		ui.text([], homeParagraphOne(lang)),
		ui.text([], homeParagraphTwo(lang)),
		highlightsView(lang),
		ui.row([ui.gap(16), ui.align(ui.Align.Center())], [
			ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourArrow(lang)),
			ui.link([], releaseUrl(), downloadLabel(lang)),
			ui.link([], repoUrl(), repoLinkLabel(lang)),
			ui.text([ui.tone(ui.Tone.Muted())], featuresCount(lang, len(all))),
		]),
	])
	top := ui.row([], [sidebarView(all, -1, lang, "/"), content])
	body := document(homePageTitle(lang), top)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// The two URLs this program ever links outside itself: GitHub's own
// `/releases/latest` redirect, so the download link never has to know a
// version number and never goes stale as new releases ship, and the
// repository itself, for whoever wants the source rather than a binary.
func releaseUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang/releases/latest"
}

func repoUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang"
}

func downloadLinkView(lang: Str): ui.View {
	return ui.link([ui.background(ui.Tone.Good())], releaseUrl(), downloadLabelArrow(lang))
}

func repoLinkView(lang: Str): ui.View {
	return ui.link([], repoUrl(), repoLinkLabel(lang))
}

func repoLinkLabel(lang: Str): Str {
	if lang == "pt" { return "Ver o repositório" }
	return "View the repository"
}

func highlightRow(text: Str): ui.View {
	return ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
		ui.icon([ui.tone(ui.Tone.Good())], ui.Icon.Check()),
		ui.text([], text),
	])
}

func highlightsView(lang: Str): ui.View {
	if lang == "pt" {
		return ui.column([ui.gap(8)], [
			highlightRow("Um único executável — nada mais para instalar, nenhum runtime para configurar"),
			highlightRow("Sem erros em tempo de execução e sem surpresas — um programa que compila é um programa que roda"),
			highlightRow("Tabelas são um tipo nativo da linguagem, não um import de biblioteca"),
			highlightRow("HTTP, WebSockets, SQL, criptografia, uma UI e atores distribuídos — tudo na biblioteca padrão"),
		])
	}
	return ui.column([ui.gap(8)], [
		highlightRow("One executable — nothing else to install, no runtime to configure"),
		highlightRow("No runtime errors and no surprises — a program that compiles is a program that runs"),
		highlightRow("Tables are a built-in type, not a library import"),
		highlightRow("HTTP, WebSockets, SQL, crypto, a UI and distributed actors — all in the standard library"),
	])
}

func notFoundResponse(lang: Str, path: Str): hive.net.HttpResponse {
	all := slides()
	content := ui.column([ui.pad(60), ui.align(ui.Align.Center()), ui.gap(12), ui.grow(1)], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "404"),
		ui.text([ui.tone(ui.Tone.Muted())], notFoundText(lang)),
		ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourPlain(lang)),
	])
	top := ui.row([], [sidebarView(all, -1, lang, path), content])
	body := document(notFoundPageTitle(lang), top)
	return hive.net.HttpResponse(404, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// Every internal link goes through here: unchanged in English, and
// carrying `?lang=pt` in Portuguese, so the language a visitor picked
// survives every click rather than resetting on the next page.
func href(path: Str, lang: Str): Str {
	if lang == "pt" {
		return path + "?lang=pt"
	}
	return path
}

// The list of every slide, down the left, under a link back to the home
// screen and the EN/PT switch. The current slide is picked out with a
// muted background — `ui.background`, not a class of our own, since the
// tone it takes is one `hive.ui`'s own stylesheet already knows — and the
// switch picks out the current language the same way. `idx` of `-1` — the
// home page and the 404 page both pass it — highlights no slide at all.
func sidebarView(all: Slide[], idx: Int, lang: Str, path: Str): ui.View {
	mut ui.View[dyn] items = []
	for i := 0; i < len(all); i++ {
		item := all[i]
		mut highlight := ui.Tone.Normal()
		if i == idx {
			highlight = ui.Tone.Muted()
		}
		link := ui.link(
			[ui.background(highlight)],
			href("/{i + 1}", lang),
			"{i + 1}. {slideTitle(item, lang)}",
		)
		append(items, link)
	}
	home := ui.link([ui.size(ui.TextSize.Subtitle())], href("/", lang), tourTitle(lang))
	return ui.column(
		[ui.width(260), ui.pad(24), ui.gap(2), ui.scroll(ui.Axis.Vertical())],
		[home, languageSwitcherView(lang, path)] + items,
	)
}

func languageSwitcherView(lang: Str, path: Str): ui.View {
	mut enTone := ui.Tone.Normal()
	mut ptTone := ui.Tone.Normal()
	if lang == "pt" {
		ptTone = ui.Tone.Muted()
	} else {
		enTone = ui.Tone.Muted()
	}
	return ui.row([ui.gap(6)], [
		ui.link([ui.background(enTone)], href(path, "en"), "EN"),
		ui.link([ui.background(ptTone)], href(path, "pt"), "PT"),
	])
}

// The slide's own column: where it sits in the tour, its title, and then
// the marker the code examples land on once the page has been rendered.
func headerColumn(slide: Slide, idx: Int, total: Int, lang: Str): ui.View {
	titleGroup := ui.column([ui.gap(6)], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], slideProgress(idx, total, lang)),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], slideTitle(slide, lang)),
	])
	return ui.column([ui.gap(24), ui.pad(40), ui.grow(1)], [titleGroup, codeMarkerView()])
}

// What follows the code examples: the explanation, one paragraph per view
// so each wraps on its own, a download link on the two slides that ask for
// one, and the prev/next pager. Rendered separately with `ui.html` and spliced in
// right after the examples, so it still ends up inside the same column the
// header opened.
func bottomView(slide: Slide, idx: Int, total: Int, lang: Str, path: Str): ui.View {
	mut ui.View[dyn] blocks = []
	for each para in split(slideExplanation(slide, lang), "\n\n") {
		append(blocks, ui.text([], para))
	}
	if slide.download {
		append(blocks, ui.row([ui.gap(12)], [downloadLinkView(lang), repoLinkView(lang)]))
	}

	mut prevNode := ui.text([ui.tone(ui.Tone.Muted())], prevLabel(lang))
	if idx > 0 {
		prevNode = ui.link([], href("/{idx}", lang), prevLabel(lang))
	}
	mut nextNode := ui.text([ui.tone(ui.Tone.Muted())], nextLabel(lang))
	if idx + 1 < total {
		nextNode = ui.link([], href("/{idx + 2}", lang), nextLabel(lang))
	}
	pager := ui.row([ui.justify(ui.Justify.Between())], [prevNode, nextNode])
	append(blocks, pager)
	return ui.column([ui.gap(16)], blocks)
}

// Every example a slide carries, one small labelled block per example. A
// slide with one example — most of them — shows no caption at all; a
// slide split into several shows what each one is about, so a big feature
// still arrives as several small, focused programs rather than one long
// one.
func examplesHtml(examples: Example[], lang: Str): Str {
	mut Str[dyn] blocks = []
	for each ex in examples {
		append(blocks, exampleHtml(ex, lang))
	}
	return join(blocks, "")
}

func exampleHtml(ex: Example, lang: Str): Str {
	mut caption := ex.caption
	if lang == "pt" {
		caption = ex.captionPt
	}
	mut captionHtml := ""
	if caption != "" {
		captionHtml = "<div style=\"font-size:12px;color:var(--muted);margin:0 0 6px;"
			+ "text-transform:uppercase;letter-spacing:.04em\">" + escapeHtml(caption) + "</div>"
	}
	mut code := ex.code
	if lang == "pt" {
		code = ex.codePt
	}
	return "<div style=\"margin-bottom:20px\">" + captionHtml + codeBlockHtml(code) + "</div>"
}

// The one piece of literal HTML on the page: `hive.ui` has no monospaced,
// boxed text of its own, so a code example is written out by hand. It
// still leans on the theme `ui.page` already put in the document —
// `var(--surface)` and `var(--line)` — so it stays in step with light and
// dark mode without a stylesheet of its own. The code itself never
// changes between languages — only its `//` comments do, in `codePt`.
func codeBlockHtml(code: Str): Str {
	return "<pre style=\"background:var(--surface);border:1px solid var(--line);"
		+ "border-radius:8px;padding:16px 18px;overflow-x:auto;font-size:13.5px;"
		+ "line-height:1.5;margin:0\"><code style=\"font-family:'SFMono-Regular',"
		+ "Consolas,Menlo,monospace\">" + escapeHtml(code) + "</code></pre>"
}

func escapeChar(c: Str): Str {
	if c == "&" { return "&amp;" }
	else if c == "<" { return "&lt;" }
	else if c == ">" { return "&gt;" }
	return c
}

func escapeHtml(s: Str): Str {
	return join(map(split(s, ""), escapeChar), "")
}

// ---------------------------------------------------------------------------
// The small, reusable pieces of interface text — everything that is not
// part of one particular slide.

func tourTitle(lang: Str): Str {
	if lang == "pt" { return "O Tour do Hive" }
	return "The Hive Tour"
}

func pageTitleSuffix(lang: Str): Str {
	if lang == "pt" { return " — O Tour do Hive" }
	return " — The Hive Tour"
}

// What the mark is, for whoever is not being shown it. The name is right
// beside it in either language, so what is left to say is the picture.
func logoAlt(lang: Str): Str {
	if lang == "pt" { return "O logo do Hive: uma abelha sobre um favo de mel" }
	return "The Hive logo: a bee on a honeycomb"
}

func homePageTitle(lang: Str): Str {
	if lang == "pt" { return "Hive — um tour pela linguagem" }
	return "Hive — a tour of the language"
}

func notFoundPageTitle(lang: Str): Str {
	if lang == "pt" { return "Página não encontrada — O Tour do Hive" }
	return "Not found — The Hive Tour"
}

func slideProgress(idx: Int, total: Int, lang: Str): Str {
	if lang == "pt" { return "Slide {idx + 1} de {total}" }
	return "Slide {idx + 1} of {total}"
}

func prevLabel(lang: Str): Str {
	if lang == "pt" { return "← Anterior" }
	return "← Prev"
}

func nextLabel(lang: Str): Str {
	if lang == "pt" { return "Próximo →" }
	return "Next →"
}

func startTourArrow(lang: Str): Str {
	if lang == "pt" { return "Começar o tour →" }
	return "Start the tour →"
}

func startTourPlain(lang: Str): Str {
	if lang == "pt" { return "Começar o tour" }
	return "Start the tour"
}

func downloadLabel(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador" }
	return "Download the compiler"
}

func downloadLabelArrow(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador →" }
	return "Download the compiler →"
}

func featuresCount(lang: Str, n: Int): Str {
	if lang == "pt" { return "{n} recursos, um por vez" }
	return "{n} features, one at a time"
}

func homeKicker(lang: Str): Str {
	if lang == "pt" { return "Um tour pela linguagem" }
	return "A tour of the language"
}

func homeParagraphOne(lang: Str): Str {
	if lang == "pt" {
		return "Hive é uma linguagem baseada em tabelas com memória gerenciada. Tabelas são uma ideia nativa da linguagem em vez de uma biblioteca, valores se comportam como valores, e boa parte do que outras linguagens deixam para o tempo de execução — todo índice de vetor, todo ramo de um match, as colunas que uma consulta SQL devolve — é resolvido em tempo de compilação."
	}
	return "Hive is a memory-managed, table-based language. Tables are a built-in idea rather than a library, values behave like values, and a good deal of what other languages leave to runtime — every vector index, every branch of a match, the columns a SQL query comes back with — is settled at compile time instead."
}

func homeParagraphTwo(lang: Str): Str {
	if lang == "pt" {
		return "Esta própria página é a prova: ela é servida por um servidor HTTP escrito em Hive, e sua interface abaixo dos exemplos de código é construída inteiramente com views do hive.ui. Não há framework por trás de nenhum dos dois — ambos são a biblioteca padrão, e nenhum é uma dependência que este programa precisou pedir."
	}
	return "This very page is the proof: it is served by an HTTP server written in Hive, and its interface below the code samples is built entirely out of hive.ui views. There is no framework underneath either of them — both are the standard library, and neither is a dependency this program had to ask for."
}

func notFoundText(lang: Str): Str {
	if lang == "pt" { return "Esse slide não existe." }
	return "That slide does not exist."
}

// ---------------------------------------------------------------------------
// The content of the tour, one feature at a time. Every code example below
// is a complete program: copy it into a `.hive` file and `hive run` it.

func slides(): Slide[49] {
	return [
		Slide(
			title: "Hello, World",
			titlePt: "Olá, Mundo",
			download: false,
			explanation: "Every Hive program starts at proc main(): void, in the file handed to `hive run` or `hive build`. echo prints a value and appends a newline, converting whatever it is given to text the way it would be shown.",
			explanationPt: "Todo programa Hive começa em proc main(): void, no arquivo passado para `hive run` ou `hive build`. echo imprime um valor e adiciona uma nova linha, convertendo o que quer que receba em texto da mesma forma que seria exibido.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	echo "it works"
}`, codePt: `proc main(): void {
	echo "funciona"
}`)],
		),
		Slide(
			title: "Running these examples",
			titlePt: "Rodando estes exemplos",
			download: true,
			explanation: "Every example from here on is a complete program: put it in a file ending in .hive, and one command runs it. The compiler is a single executable with nothing to install beside it — no runtime, no package manager, no project file — so the download link below is the whole of the setup.\n\nhive check reads a program and reports what is wrong with it without building anything, which is why it is the one worth reaching for first. hive run compiles and runs in a single step, hive build leaves a native executable behind, hive test runs a file's tests and reports coverage, and hive container writes a Dockerfile that builds and runs the program. Every pass reports as much as it can find rather than stopping at the first thing, so a program with six mistakes is a program whose author gets told about six.",
			explanationPt: "Todo exemplo daqui em diante é um programa completo: coloque-o em um arquivo terminado em .hive, e um comando o roda. O compilador é um único executável sem nada para instalar ao lado dele — sem runtime, sem gerenciador de pacotes, sem arquivo de projeto — então o link de download abaixo é toda a configuração que existe.\n\nhive check lê um programa e reporta o que há de errado nele sem construir nada, e é por isso que vale a pena recorrer a ele primeiro. hive run compila e roda em um único passo, hive build deixa um executável nativo pronto, hive test roda os testes de um arquivo e reporta a cobertura, e hive container escreve um Dockerfile que constrói e roda o programa. Toda passagem reporta tudo que consegue encontrar em vez de parar na primeira coisa, então um programa com seis erros é um programa cujo autor é avisado sobre os seis.",
			examples: [Example(caption: "", captionPt: "", code: `$ printf 'proc main(): void {\n\techo "it works"\n}\n' > hello.hive

$ hive check hello.hive
No problems found in hello.hive (0s)

$ hive run hello.hive
it works

$ hive build hello.hive
Compiled hello.hive -> hello (0s)`, codePt: `$ printf 'proc main(): void {\n\techo "funciona"\n}\n' > hello.hive

$ hive check hello.hive
No problems found in hello.hive (0s)

$ hive run hello.hive
funciona

$ hive build hello.hive
Compiled hello.hive -> hello (0s)`)],
		),
		Slide(
			title: "Comments",
			titlePt: "Comentários",
			download: false,
			explanation: "A comment runs from // to the end of the line, and nothing more. There is no block comment form in Hive itself — inside a query body, which is SQL rather than Hive, SQL's own -- and /* */ are recognised instead.",
			explanationPt: "Um comentário vai de // até o fim da linha, e nada mais. Não existe forma de comentário em bloco no próprio Hive — dentro do corpo de uma query, que é SQL e não Hive, os -- e /* */ do próprio SQL são reconhecidos em seu lugar.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	// A comment. The whole line, and nothing of the next.
	x := 1 // ...or the tail of one.
	echo x
}`, codePt: `proc main(): void {
	// Um comentário. A linha toda, e nada da próxima.
	x := 1 // ...ou o resto de uma.
	echo x
}`)],
		),
		Slide(
			title: "Names have shapes",
			titlePt: "Nomes têm formas",
			download: false,
			explanation: "A name's spelling says what it is, and each shape is enforced where the name is declared. camelCase names variables, parameters, fields and every proc/func/query. PascalCase names types, their variants, and atoms. UPPER_CASE is how a constant is written: a variable nothing reassigns. Keywords are lower case, and only lower case — a keyword spelled in another casing, like Proc or IF, is a compile error naming both readings rather than a usable identifier.",
			explanationPt: "A grafia de um nome diz o que ele é, e cada forma é obrigatória no lugar onde o nome é declarado. camelCase nomeia variáveis, parâmetros, campos e todo proc/func/query. PascalCase nomeia tipos, suas variantes e átomos. UPPER_CASE é como se escreve uma constante: uma variável que nada reatribui. Palavras-chave são em minúsculas, e somente em minúsculas — uma palavra-chave grafada de outra forma, como Proc ou IF, é um erro de compilação que aponta as duas leituras em vez de um identificador utilizável.",
			examples: [Example(caption: "", captionPt: "", code: `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: a variable
	MAX_RETRIES := 5          // UPPER_CASE: a constant
	shape := Shape.Circle(4)  // PascalCase: a type and its variant

	echo "{name}, retry up to {MAX_RETRIES} times, shape={shape}"
}`, codePt: `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: uma variável
	MAX_RETRIES := 5          // UPPER_CASE: uma constante
	shape := Shape.Circle(4)  // PascalCase: um tipo e sua variante

	echo "{name}, tente até {MAX_RETRIES} vezes, forma={shape}"
}`)],
		),
		Slide(
			title: "Variables and constants",
			titlePt: "Variáveis e constantes",
			download: false,
			explanation: ":= infers a type from the value, including a static vector length. A type written out front with = states it instead, which is the only way to say [dyn], or to give a value nothing else says the shape of somewhere to land. A binding is immutable unless it says mut, and a mut variable may never be spelled UPPER_CASE — that shape is reserved for something nothing reassigns.",
			explanationPt: ":= infere um tipo a partir do valor, incluindo um tamanho estático de vetor. Um tipo escrito explicitamente na frente com = o declara em vez disso, que é a única forma de dizer [dyn], ou de dar a um valor que nada mais define a forma de um lugar para chegar. Uma ligação é imutável a menos que diga mut, e uma variável mut nunca pode ser grafada em UPPER_CASE — essa forma é reservada para algo que nada reatribui.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	x := 1                     // inferred, immutable
	mut count := 0              // inferred, reassignable
	mut Str[dyn] rows = []       // annotated: says "dynamic"
	MAX := 100                  // a constant, by its shape alone

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`, codePt: `proc main(): void {
	x := 1                     // inferido, imutável
	mut count := 0              // inferido, reatribuível
	mut Str[dyn] rows = []       // anotado: diz "dinâmico"
	MAX := 100                  // uma constante, só pela forma

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`)],
		),
		Slide(
			title: "Scalar types",
			titlePt: "Tipos escalares",
			download: false,
			explanation: "Str holds UTF-8 text. Int is a 64-bit signed integer whose overflow wraps silently. Float is a 64-bit float. Bool is true or false. Atom is an interned symbol, written #Name — a label, not a condition, so `if flag` is a compile error when flag is an Atom. void is a return type only; there is no void value, field or element. There is no implicit numeric widening anywhere: an Int never becomes a Float on its own.",
			explanationPt: "Str guarda texto UTF-8. Int é um inteiro de 64 bits com sinal cujo overflow dá a volta silenciosamente. Float é um float de 64 bits. Bool é true ou false. Atom é um símbolo internado, escrito #Nome — um rótulo, não uma condição, então `if flag` é um erro de compilação quando flag é um Atom. void é apenas um tipo de retorno; não existe valor, campo ou elemento void. Não há ampliação numérica implícita em lugar nenhum: um Int nunca se torna um Float por conta própria.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	Str   name   = "bee"
