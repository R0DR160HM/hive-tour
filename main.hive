// The Hive Tour — an HTTP server that walks through the language one
// feature at a time, in the spirit of an interactive language tour. Every
// slide is one `slides.Slide` value: a title, an explanation, and one or
// more code examples — each a complete, runnable program in its own right,
// kept small enough that one example makes one point. Every piece of prose
// carries an English and a Portuguese version side by side; the code never
// does, because code is not prose. `handle` reads the slide number and the
// chosen language out of the URL, `hive.net.httpServe` does the rest.
//
// This file is the server, and only the server. Five others hold the things
// that are not it, each because a program is easier to read when the thing it
// does and the material it does it to are not interleaved:
//
//   ./slides     the tour itself, fifty-five slides of it in two languages,
//                and the two types that hold one. Four fifths of the whole
//                program by weight, and none of it about HTTP.
//   ./logo       the mark, as the paths of an SVG. A drawing is not prose,
//                and a page of path coordinates in the middle of some would
//                read as neither.
//   ./icon       the same mark as pixels, in the three raster shapes a
//                search engine, a browser, and an iOS home screen or a
//                pasted link respectively want. It exists because neither
//                Google Search nor any link unfurler will read the SVG the
//                other two files are perfectly happy with.
//   ./theme      how it all looks: the one stylesheet this program writes,
//                layered over the one `ui.page` writes for itself.
//   ./highlight  a Hive lexer, for painting the samples in ./slides. It is
//                here rather than in a script tag because the home page
//                claims there is no framework underneath this site, and that
//                claim is worth more than the eight lines it saves.
//
// The interface is built with `hive.ui`: the sidebar, the heading, the
// explanation and the prev/next links are all `View`s, rendered by
// `ui.page`. Three kinds of thing the widget set has no answer for are
// spliced into the finished document as literal HTML: a monospaced, boxed
// code sample, which goes in place of a marker view; a wrapper around the
// prose under it, so the pager at its foot is something a stylesheet can
// name; and everything that belongs in the head — the stylesheet, the tab
// icons, and the whole of what a page says about itself to a search engine
// or a link unfurler. The head is the half of a page nobody looks at, so
// nothing in it is on show, and a thing that is not on show is not a view.
// Everything else stays a view all the way down.
//
// Two more paths answer to nobody who is reading: /robots.txt and
// /sitemap.xml, which between them say what there is here and in which
// languages. The sitemap is built from the same `slides.all()` the pages
// are, so a slide added there is a slide a crawler is told about, and there
// is no second list anywhere to forget to update.
import hive.ui
import ./logo
import ./highlight
import ./icon
import ./shots
import ./slides
import ./theme

// What a page says about itself before anybody has read a word of it: the
// title in the tab, the sentence a search result prints under it, the URL
// that is the real one when several point at the same page, and where the
// other language's version of it lives. Every page this server sends fills
// one of these in, and `document` turns it into the tags that carry it.
type PageHead {
	title:       Str
	description: Str
	path:        Str
	lang:        Str
	indexable:   Bool
	prev:        Str
	next:        Str
}

// `httpServe` binds `:8080` — every interface, not just the loopback — which
// is what makes this the same program in a container as on a laptop.
//
// The line it prints says the port it bound and *then* the URL, in that order,
// and the order is the whole point of it. It used to print the URL alone, and
// inside a container that is a sentence which is true for the program and
// false for the person reading it: the server really is answering on
// localhost:8080, on the container's localhost, which is not the one the
// browser is pointed at. A container started without `-p 8080:8080` then looks
// exactly like a working one — it builds, it runs, it says it is serving, and
// nothing loads — and the log is the reason the search starts in the wrong
// place. Naming the bound port first says what was actually done; the URL
// after it is the convenience it always was, for the case where the machine
// running this is the machine holding the browser.
proc main(): void {
	echo "The Hive Tour — listening on :8080 (locally, http://localhost:8080)"
	hive.net.httpServe(8080, handle)
}

proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	path := requestPath(request.url)
	lang := requestLang(request.url)

	if path == "/" {
		return homeResponse(lang)
	}

	// Every framing of the mark, at the paths that ask for one: the home
	// screen's `<img>`, whatever a browser makes of the `<link>`s in the head,
	// and the three rasters from ./icon that are there because a search engine
	// and a link unfurler cannot read either of the first two. None of them
	// depends on the language, so none of them reads `lang`.
	if path == "/hive-logo.svg" {
		return svgResponse(logo.svg())
	}
	if path == "/favicon.svg" {
		return svgResponse(logo.icon())
	}
	if path == "/favicon.png" {
		return rasterResponse(icon.png(), icon.pngType())
	}
	if path == "/favicon.ico" {
		return rasterResponse(icon.ico(), icon.icoType())
	}
	if path == markPath() {
		return rasterResponse(icon.mark(), icon.pngType())
	}

	// A picture of what a slide's code draws, for the one kind of code on this
	// tour whose output a page cannot carry. ./shots says why there is one.
	if path == shots.scenePath() {
		return rasterResponse(shots.scene(), icon.pngType())
	}

	// The two files a crawler asks for that no visitor ever does. Neither
	// depends on the language either: the sitemap names both of them for
	// every page, which is the point of it.
	if path == "/contents" {
		return contentsResponse(lang)
	}

	if path == "/robots.txt" {
		return robotsResponse()
	}
	if path == "/sitemap.xml" {
		return sitemapResponse()
	}

	all := slides.all()
	if path is "/{n}" {
		parsed := hive.conv.sti(n)
		if parsed is Result.Ok(num) {
			idx := num - 1
			if all bounds idx {
				slide := all[idx]
				return renderSlide(slide, idx, all, lang)
			}
		}
	}
	return notFoundResponse(lang, path)
}

// The path and the query string travel together in `request.url` — a GET
// to "/3?lang=pt" arrives as exactly that one Str. Splitting on "?" is the
// whole of parsing either back out: `split` never yields zero pieces, so
// the path half is always there, and the query half is only there to ask
// about when a "?" showed up at all.
func requestPath(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 0 {
		return parts[0]
	}
	return url
}

// The only query parameter this server reads. Not a real query-string
// parser — it doesn't need to be one, since this program is the only thing
// that ever writes a `?lang=` into one of its own links.
func requestLang(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 1 {
		if indexOf(parts[1], "lang=pt") is Result.Ok(_) {
			return "pt"
		}
	}
	return "en"
}

// ---------------------------------------------------------------------------
// Rendering

// The one View a page never keeps: a stand-in for the code examples, so
// they can be rendered once inside `ui.page` and then found again in the
// HTML that comes back. Its rendering has no attributes at all, so it
// always comes back exactly as `codeMarkerTag` says, whatever the renderer
// does.
func codeMarker(): Str {
	return "HIVE_TOUR_CODE_SAMPLE"
}

func codeMarkerView(): ui.View {
	return ui.text([], codeMarker())
}

func codeMarkerTag(): Str {
	return "<span class=\"h-text\">" + codeMarker() + "</span>"
}

// Every page this server sends, and the lines of it no view can carry.
// `ui.page` writes a whole document — charset, viewport, title, stylesheet
// — and everything a page says *about* itself belongs in its head, which is
// the half of a page nobody looks at. So it is spliced the way a code
// sample is: split the document on a tag that is certainly in it, and join
// it back with ours in front of that tag. Twice, because the language a
// document is written in is an attribute of `<html>` rather than a tag
// inside it, and a screen reader picking a voice reads it there.
func document(head: PageHead, view: ui.View): Str {
	page := ui.page(head.title, view)
	tagged := join(split(page, "<html>"), "<html lang=\"" + htmlLang(head.lang) + "\">")
	return join(split(tagged, "</head>"), headTags(head) + "</head>")
}

// BCP 47, which is what an `hreflang` and an `<html lang>` are both read as.
// The Portuguese here is Brazilian, and saying so is the difference between
// a search engine offering this page to somebody in São Paulo and offering
// it to everybody who reads any Portuguese at all.
func htmlLang(lang: Str): Str {
	if lang == "pt" { return "pt-BR" }
	return "en"
}

// The whole of the head this program writes for itself. Order is nobody's
// business but a reader of the source's, so it goes: how the page looks, what
// the mark is, what the page is, who may index it, which URL is the real one,
// where the other language is, and then the two vocabularies — Open Graph and
// Twitter's — that decide what a pasted link unfurls into. The structured
// data closes it, because it is the one part that repeats what the tags above
// already said, and it repeats it for a reader that wants it as data rather
// than as tags.
//
// The stylesheet goes first of all, and it has to: `ui.page` has already
// written its own into this same head, and ./theme is layered over the top of
// that rather than replacing it, which only works while it comes second in
// the document. Everything spliced here lands immediately before `</head>`,
// so it does.
func headTags(head: PageHead): Str {
	canonical := absoluteUrl(head.path, head.lang)
	english := absoluteUrl(head.path, "en")
	portuguese := absoluteUrl(head.path, "pt")
	mut Str[dyn] tags = [
		theme.styleTag(),
		iconLinkTag(),
		metaTag("description", head.description),
		metaTag("robots", robotsValue(head.indexable)),
		metaTag("theme-color", brandColour()),
		metaTag("color-scheme", "light dark"),
		linkTag("canonical", canonical),
		alternateTag("en", english),
		alternateTag("pt-BR", portuguese),
		alternateTag("x-default", english),
		propertyTag("og:type", openGraphType(head)),
		propertyTag("og:site_name", tourTitle(head.lang)),
		propertyTag("og:title", head.title),
		propertyTag("og:description", head.description),
		propertyTag("og:url", canonical),
		propertyTag("og:image", siteUrl() + markPath()),
		propertyTag("og:image:width", "256"),
		propertyTag("og:image:height", "256"),
		propertyTag("og:image:alt", logoAlt(head.lang)),
		propertyTag("og:locale", openGraphLocale(head.lang)),
		propertyTag("og:locale:alternate", openGraphLocale(otherLang(head.lang))),
		metaTag("twitter:card", "summary"),
		metaTag("twitter:title", head.title),
		metaTag("twitter:description", head.description),
		metaTag("twitter:image", siteUrl() + markPath()),
	]

	// Only where there is one to point at. A `rel="prev"` on the first slide
	// would be a link to nowhere, which is worse than no link at all.
	if head.prev != "" {
		append(tags, linkTag("prev", absoluteUrl(head.prev, head.lang)))
	}
	if head.next != "" {
		append(tags, linkTag("next", absoluteUrl(head.next, head.lang)))
	}

	append(tags, structuredDataTag(head))
	return join(tags, "")
}

// Where the mark is, in every form something might want it, best first.
//
// This used to be the one SVG link and nothing else, on the reasoning that
// one drawing drawn at whatever size the tab happens to be beats any number
// of fixed rasters. All of that is still true, and it is still the first line
// here, because a browser reads the list and takes the best thing on it.
//
// What it missed is that the most important reader of this list is not a
// browser. Google Search does not accept an SVG favicon at all — its formats
// are BMP, GIF, ICO, PNG, JPEG, PPM and TIFF — so for as long as this was the
// only line, every result for the tour came out wearing the generic globe
// that means "this site has no icon". The PNG below it is the fix, and the
// rest of the list is the same courtesy extended to everything else that
// asks: the ICO for a browser that goes looking for /favicon.ico on its own,
// and the apple-touch-icon for an iOS home screen, which Google reads as a
// fallback too. ./icon is where all three come from and why.
func iconLinkTag(): Str {
	return "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">"
		+ "<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/favicon.png\">"
		+ "<link rel=\"icon\" type=\"image/x-icon\" sizes=\"32x32 16x16\" href=\"/favicon.ico\">"
		+ "<link rel=\"apple-touch-icon\" sizes=\"256x256\" href=\"" + markPath() + "\">"
}

// The one raster that is not a favicon, and the one path named in more than
// one place: an iOS home screen and a pasted link both want a square of the
// mark on paper of its own, at very much the same size, so they get the same
// square rather than two of it. ./icon explains why it is 256 and why it is
// opaque; this is only where it lives.
func markPath(): Str {
	return "/hive-mark.png"
}

// The amber the bee is painted in, which is what a browser tints its own
// chrome with on a phone.
func brandColour(): Str {
	return "#e29b19"
}

// The one absolute URL this program knows about itself. Every canonical
// link, every alternate, every entry of the sitemap and the picture a
// pasted link unfurls into is built out of it, so moving the tour to
// another domain is this one line and nothing else.
func siteUrl(): Str {
	return "https://hive-lang.run"
}

// A page's real address, which is the site, the path, and — in Portuguese —
// the query that chose the language. Two languages of one slide are two
// URLs and each is canonical for itself: telling a search engine they are
// the same page would be telling it to throw one of them away.
func absoluteUrl(path: Str, lang: Str): Str {
	return siteUrl() + href(path, lang)
}

func otherLang(lang: Str): Str {
	if lang == "pt" { return "en" }
	return "pt"
}

func openGraphLocale(lang: Str): Str {
	if lang == "pt" { return "pt_BR" }
	return "en_US"
}

// Open Graph's own word for what a page is. The home screen is the site;
// every slide is a piece of writing on it.
func openGraphType(head: PageHead): Str {
	if head.path == "/" { return "website" }
	return "article"
}

// The 404 is the one page here worth keeping out of an index — it is not a
// page about anything — and `follow` still lets a crawler that landed on
// one take the links back out of it.
func robotsValue(indexable: Bool): Str {
	if indexable {
		return "index,follow,max-image-preview:large"
	}
	return "noindex,follow"
}

func metaTag(name: Str, content: Str): Str {
	return "<meta name=\"" + name + "\" content=\"" + escapeAttr(content) + "\">"
}

func propertyTag(property: Str, content: Str): Str {
	return "<meta property=\"" + property + "\" content=\"" + escapeAttr(content) + "\">"
}

func linkTag(rel: Str, target: Str): Str {
	return "<link rel=\"" + rel + "\" href=\"" + escapeAttr(target) + "\">"
}

func alternateTag(hreflang: Str, target: Str): Str {
	return "<link rel=\"alternate\" hreflang=\"" + hreflang
		+ "\" href=\"" + escapeAttr(target) + "\">"
}

// The same facts again, as JSON-LD, which is the shape a search engine
// reads rather than infers. It is written out by hand rather than through
// `hive.json.encode` for one reason: every key that matters here opens with
// an `@`, and a Hive field name cannot.
func structuredDataTag(head: PageHead): Str {
	return "<script type=\"application/ld+json\">" + structuredData(head) + "</script>"
}

// A `\{` is a literal brace rather than the start of an interpolation, which
// is a rule this one function leans on harder than the whole of the rest of
// the program: every object here opens with one.
func structuredData(head: PageHead): Str {
	site := "\{\"@type\":\"WebSite\",\"name\":" + jsonText(tourTitle(head.lang))
		+ ",\"url\":" + jsonText(absoluteUrl("/", head.lang)) + "}"
	language := "\{\"@type\":\"ComputerLanguage\",\"name\":\"Hive\",\"url\":"
		+ jsonText(repoUrl()) + "}"

	if head.path == "/" {
		return "\{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":"
			+ jsonText(tourTitle(head.lang)) + ",\"url\":"
			+ jsonText(absoluteUrl("/", head.lang)) + ",\"description\":"
			+ jsonText(head.description) + ",\"inLanguage\":"
			+ jsonText(htmlLang(head.lang)) + ",\"about\":" + language + "}"
	}
	return "\{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":"
		+ jsonText(head.title) + ",\"description\":" + jsonText(head.description)
		+ ",\"url\":" + jsonText(absoluteUrl(head.path, head.lang)) + ",\"inLanguage\":"
		+ jsonText(htmlLang(head.lang)) + ",\"isPartOf\":" + site
		+ ",\"about\":" + language + ",\"isAccessibleForFree\":true}"
}

// A JSON string, quotes and all. The two angle brackets are escaped as well
// as the two JSON demands, because this text lands inside a `<script>` and
// a `</` anywhere in there would close it early — and a page about a
// language whose one built-in union is spelled `Result<T, E>` is a page
// where that text really does turn up.
func jsonText(s: Str): Str {
	mut out := join(split(s, "\\"), "\\\\")
	out = join(split(out, "\""), "\\\"")
	out = join(split(out, "\n"), " ")
	out = join(split(out, "<"), "\\u003c")
	out = join(split(out, ">"), "\\u003e")
	return "\"" + out + "\""
}

// Where a search engine is told what there is to read: every page, in both
// languages, each one carrying the full set of alternates so a crawler that
// arrives at either finds the other. `robots.txt` names it, which is the
// one line in that file worth having.
func robotsResponse(): hive.net.HttpResponse {
	body := "User-agent: *\nAllow: /\n\nSitemap: " + siteUrl() + "/sitemap.xml\n"
	headers := [
		["Content-Type", "text/plain; charset=utf-8"],
		["Cache-Control", "public, max-age=86400"],
	]
	return hive.net.HttpResponse(200, headers, body)
}

func sitemapResponse(): hive.net.HttpResponse {
	all := slides.all()
	mut Str[dyn] entries = [
		sitemapEntry("/", "en"), sitemapEntry("/", "pt"),
		sitemapEntry("/contents", "en"), sitemapEntry("/contents", "pt"),
	]
	for i := 0; i < len(all); i++ {
		append(entries, sitemapEntry("/{i + 1}", "en"))
		append(entries, sitemapEntry("/{i + 1}", "pt"))
	}
	body := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
		+ "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\""
		+ " xmlns:xhtml=\"http://www.w3.org/1999/xhtml\">\n"
		+ join(entries, "") + "</urlset>\n"
	headers := [
		["Content-Type", "application/xml; charset=utf-8"],
		["Cache-Control", "public, max-age=3600"],
	]
	return hive.net.HttpResponse(200, headers, body)
}

func sitemapEntry(path: Str, lang: Str): Str {
	english := absoluteUrl(path, "en")
	portuguese := absoluteUrl(path, "pt")
	return "  <url><loc>" + escapeAttr(absoluteUrl(path, lang)) + "</loc>"
		+ sitemapAlternate("en", english)
		+ sitemapAlternate("pt-BR", portuguese)
		+ sitemapAlternate("x-default", english)
		+ "</url>\n"
}

func sitemapAlternate(hreflang: Str, target: Str): Str {
	return "<xhtml:link rel=\"alternate\" hreflang=\"" + hreflang
		+ "\" href=\"" + escapeAttr(target) + "\"/>"
}

// The sentence a search result prints under the title, and what a link to
// this page unfurls into wherever it is pasted. It is taken from the
// slide's own opening paragraph rather than written a second time: what a
// page opens by saying is already the best short answer to what it is
// about, and a description kept somewhere else is a description that goes
// stale the first time the page is edited. The cut lands on a word
// boundary, because half a word helps nobody.
func summarise(text: Str, limit: Int): Str {
	paragraphs := split(text, "\n\n")
	mut opening := text
	if paragraphs bounds 0 {
		opening = paragraphs[0]
	}
	if len(opening) <= limit {
		return opening
	}

	chars := split(opening, "")
	mut cut := opening
	high := limit - 1
	if chars bounds 0 && chars bounds high {
		cut = join(chars[0:high], "")
	}

	// The last word is the one the cut landed in the middle of, so it goes.
	words := split(cut, " ")
	stop := len(words) - 2
	if words bounds 0 && words bounds stop {
		return join(words[0:stop], " ") + "…"
	}
	return cut + "…"
}

// The mark, either framing of it. A day of caching, because the drawing is
// part of the executable: it cannot change without a new binary, and until
// one ships there is nothing here worth asking for twice.
func svgResponse(svg: Str): hive.net.HttpResponse {
	headers := [
		["Content-Type", "image/svg+xml; charset=utf-8"],
		["Cache-Control", "public, max-age=86400"],
	]
	return hive.net.HttpResponse(200, headers, svg)
}

// The rasterised mark, in whichever of its three forms was asked for. Cached
// the same day the drawing is, for the same reason: it is part of the
// executable, and until a new binary ships there is nothing here worth asking
// for twice.
//
// It takes a Result rather than bytes because that is what ./icon answers
// with, and the two ways it can fail are worth telling apart. Bytes that
// decoded are the picture. Bytes that did not are not a bad request — the
// base64 they came from is a constant in the source, so a failure here means
// the program was built broken and every visitor is about to see the same
// thing. There is nothing useful to say to this particular visitor about
// that, and the vector framing of the same mark is sitting right there, so
// the tab still gets a bee and the tour carries on.
//
// No charset, unlike the SVG above: these are bytes rather than text, and a
// charset on a PNG is a claim about an encoding it does not have.
func rasterResponse(decoded: Result<Str, hive.crypto.CryptoError>, contentType: Str): hive.net.HttpResponse {
	if decoded is Result.Ok(bytes) {
		headers := [
			["Content-Type", contentType],
			["Cache-Control", "public, max-age=86400"],
		]
		return hive.net.HttpResponse(200, headers, bytes)
	}
	return svgResponse(logo.icon())
}

func renderSlide(slide: slides.Slide, idx: Int, all: slides.Slide[], lang: Str): hive.net.HttpResponse {
	total := len(all)
	path := "/{idx + 1}"

	// Where a reader — and a crawler — goes from here. Empty at either end
	// of the tour, which is what says there is no such page rather than
	// pointing at one that isn't there.
	mut previous := ""
	if idx > 0 { previous = "/{idx}" }
	mut following := ""
	if idx + 1 < total { following = "/{idx + 2}" }

	head := PageHead(
		title: slideTitle(slide, lang) + pageTitleSuffix(lang),
		description: summarise(slideExplanation(slide, lang), 155),
		path: path,
		lang: lang,
		indexable: true,
		prev: previous,
		next: following,
	)
	top := pageView(lang, path, [progressView(idx, total), headerColumn(slide, idx, total, lang)])
	page := document(head, top)

	// The examples, and then everything that follows them, in the one place
	// the marker view left for both. The second half is wrapped in a div of
	// its own for the same reason the code block carries a class: the pager at
	// the foot of it wants a rule above it, and a `ui.row` deep inside a
	// column of prose is not a thing a stylesheet can name. One marked
	// wrapper, and it is `.tour-prose > .h-column > .h-row:last-child`.
	spliced := examplesHtml(slide.examples, lang)
		+ "<div class=\"tour-prose\">"
		+ ui.html(bottomView(slide, idx, total, lang, path))
		+ "</div>"
	body := join(split(page, codeMarkerTag()), spliced)
	return hive.net.HttpResponse(200, htmlHeaders(), body)
}

// What every HTML page here answers with. Five minutes of caching, because
// a slide changes when a new binary ships and not before — long enough to
// spare the machine a second render of a page somebody is reading through,
// short enough that a deploy is live by the time anybody notices it.
func htmlHeaders(): Str[dyn][dyn] {
	return [
		["Content-Type", "text/html; charset=utf-8"],
		["Cache-Control", "public, max-age=300"],
	]
}

func slideTitle(slide: slides.Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.titlePt
	}
	return slide.title
}

func slideExplanation(slide: slides.Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.explanationPt
	}
	return slide.explanation
}

// The landing page, and the one page with **no rail down the left**. A
// sidebar is for somebody who is already inside the tour and wants a
// different part of it; on the way in it is fifty-five links in front of
// two paragraphs, which is a table of contents standing where the cover
// should be. So the home page is one centred column, and the only way on
// from it is the same way anybody would have gone anyway: start at the
// beginning, or take the download.
//
// It is a `ui.column` at the root rather than a `ui.row` with one child
// because the stylesheet tells the rail from the page by position — first
// child and last child of the row — and a lone column would answer to both.
func homeResponse(lang: Str): hive.net.HttpResponse {
	all := slides.all()
	content := ui.column([ui.gap(30), ui.pad(40), ui.grow(1)], [
		// Two columns, and the reason is a screen rather than a taste. Stacked
		// in one 680px column, the mark, two paragraphs, six claims and four
		// links came to something over a thousand pixels, which is a front
		// page that does not fit on the screen it is being read on — so the
		// first thing it says about a language small enough to learn in a day
		// is "scroll". Side by side the same material is under seven hundred,
		// and everything the page has to say arrives at once.
		//
		// They split the room evenly. The left is prose and wants a measure;
		// the right is six claims and wants each of them to stay short. Half
		// and half is what gives both, and `grow` is how a view says it: the
		// numbers are a ratio rather than a width, so the two keep their
		// proportion at whatever width the window turns out to be.
		ui.row([ui.gap(52), ui.align(ui.Align.Start())], [
			ui.column([ui.gap(22), ui.grow(1)], [
				// The gap is small because the drawing brings its own: the
				// artwork is a square with the bee inside it, so a fifth of
				// the width beside the name is margin the mark already paid
				// for.
				ui.row([ui.gap(10), ui.align(ui.Align.Center())], [
					ui.image([ui.width(104)], "/hive-logo.svg", logoAlt(lang)),
					ui.column([ui.gap(4)], [
						ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], homeKicker(lang)),
						ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Hive"),
					]),
				]),
				ui.text([], homeParagraphOne(lang)),
				ui.text([], homeParagraphTwo(lang)),
				// Two rows rather than one. Four things abreast wrapped every
				// label onto two lines, which made the one that matters look
				// like the three that do not: the way on is a button of its
				// own, and the rest are what somebody reads after deciding not
				// to take it.
				ui.column([ui.gap(14)], [
					ui.row([ui.gap(18), ui.align(ui.Align.Center())], [
						ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourArrow(lang)),
						ui.link([], href("/contents", lang), contentsLabel(lang)),
					]),
					ui.row([ui.gap(18), ui.align(ui.Align.Center())], [
						ui.link([], releaseUrl(), downloadLabel(lang)),
						ui.link([], repoUrl(), repoLinkLabel(lang)),
					]),
				]),
			]),
			ui.column([ui.gap(14), ui.grow(1)], [
				ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], featuresCount(lang, len(all))),
				highlightsView(lang),
			]),
		]),
	])
	head := PageHead(
		title: homePageTitle(lang),
		description: homeDescription(lang),
		path: "/",
		lang: lang,
		indexable: true,
		prev: "",
		next: "/1",
	)
	body := document(head, pageView(lang, "/", [content]))
	return hive.net.HttpResponse(200, htmlHeaders(), body)
}

// The two URLs this program ever links outside itself: GitHub's own
// `/releases/latest` redirect, so the download link never has to know a
// version number and never goes stale as new releases ship, and the
// repository itself, for whoever wants the source rather than a binary.
func releaseUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang/releases/latest"
}

func repoUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang"
}

func downloadLinkView(lang: Str): ui.View {
	return ui.link([ui.background(ui.Tone.Good())], releaseUrl(), downloadLabelArrow(lang))
}

func repoLinkView(lang: Str): ui.View {
	return ui.link([], repoUrl(), repoLinkLabel(lang))
}

func repoLinkLabel(lang: Str): Str {
	if lang == "pt" { return "Ver o repositório" }
	return "View the repository"
}

// The bullet sits against the first line of the claim rather than in the
// middle of the block of it. A claim that runs to three lines with its mark
// floating halfway down them reads as a mark belonging to the second line,
// which is a line it has nothing to do with.
func highlightRow(text: Str): ui.View {
	return ui.row([ui.gap(10), ui.align(ui.Align.Start())], [
		ui.icon([ui.tone(ui.Tone.Good())], ui.Icon.Check()),
		ui.text([], text),
	])
}

func highlightsView(lang: Str): ui.View {
	if lang == "pt" {
		return ui.column([ui.gap(11)], [
			highlightRow("Sem exceções em tempo de execução — não existe null, nada é lançado, e todo índice é provado antes de o programa rodar"),
			highlightRow("Pequena o bastante para se aprender em um dia — este tour é a linguagem inteira, um recurso por vez"),
			highlightRow("Feita para sistemas distribuídos desde o começo — um serviço é endereçado do mesmo jeito nesta máquina ou em outra"),
			highlightRow("Segura por padrão — TLS entre nós, criptografia e JWT nativos, valores de SQL sempre vinculados como parâmetros, e nada que chegue a um shell"),
			highlightRow("Testes e análise de custo são do compilador — cobertura sem framework, e um relatório do que um programa vai custar antes de rodar"),
			highlightRow("Um único executável, e uma biblioteca padrão com HTTP, WebSockets, SQL, criptografia, uma UI e atores distribuídos"),
		])
	}
	return ui.column([ui.gap(11)], [
		highlightRow("No runtime exceptions — no null, nothing thrown, and every index proved before the program runs"),
		highlightRow("Small enough to learn in a day — this tour is the whole language, one feature at a time"),
		highlightRow("Built for distributed systems from the start — a service is addressed the same way on this machine or another"),
		highlightRow("Secure by default — TLS between nodes, native encryption and JWTs, SQL values always bound as parameters, and nothing that reaches a shell"),
		highlightRow("Testing and cost analysis are the compiler's — coverage with no framework, and a report on what a program will cost before it runs"),
		highlightRow("One executable, and a standard library with HTTP, WebSockets, SQL, crypto, a UI and distributed actors in it"),
	])
}

func notFoundResponse(lang: Str, path: Str): hive.net.HttpResponse {
	content := ui.column([ui.pad(60), ui.align(ui.Align.Center()), ui.gap(14), ui.grow(1)], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "404"),
		ui.text([ui.tone(ui.Tone.Muted())], notFoundText(lang)),
		ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourPlain(lang)),
	])
	head := PageHead(
		title: notFoundPageTitle(lang),
		description: notFoundText(lang),
		path: path,
		lang: lang,
		indexable: false,
		prev: "",
		next: "",
	)
	body := document(head, pageView(lang, path, [content]))
	return hive.net.HttpResponse(404, htmlHeaders(), body)
}

// Every internal link goes through here: unchanged in English, and
// carrying `?lang=pt` in Portuguese, so the language a visitor picked
// survives every click rather than resetting on the next page.
func href(path: Str, lang: Str): Str {
	if lang == "pt" {
		return path + "?lang=pt"
	}
	return path
}

// The line of small type across the top of every page, and the bar of
// progress under it. Between them they are the whole of this tour's
// navigation, and what they replace is a rail down the left carrying all
// fifty-five slides at once.
//
// The rail went because of what it was, not because of how it looked. A list
// of every page, pinned open beside every page, collapsing into a lid on a
// narrow one, is the shape of a documentation site — and a tour is not one.
// Documentation is arrived at sideways, from a search, in the middle, and it
// owes a reader a map because no reader of it started at the start. A tour is
// the opposite: it has a first slide, a last one, and an order that is the
// argument. Pinning the map open beside it spends a fifth of the window, and
// every pixel of that fifth, on a question the reader of a tour is not
// asking. Worse, it answers it badly — fifty-five entries is well past the
// length anybody reads as a list, so the rail was mostly a texture with one
// line picked out of it.
//
// What a book does instead is what this does now. A running head says what
// you are reading. A contents page — one click, its own address, and set out
// properly when you get there — is where the map lives. Prev and next at the
// foot of the slide are how you actually move, because moving one slide at a
// time is what a tour is for. Nothing is pinned open, nothing collapses into
// a lid, and the reading gets the whole window.
//
// It is `ui.spacer` that splits the head in two, which is the widget for
// exactly this and the reason no attribute here pushes anything to an edge:
// what is before it sits left, what is after it sits right, and the row needs
// to know nothing else.
func runningHeadView(lang: Str, path: Str): ui.View {
	return ui.row([ui.gap(22), ui.align(ui.Align.Center())], [
		ui.link([ui.size(ui.TextSize.Caption())], href("/", lang), tourTitle(lang)),
		ui.link([ui.size(ui.TextSize.Caption())], href("/contents", lang), contentsLabel(lang)),
		ui.spacer(),
		languageSwitcherView(lang, path),
	])
}

// How far through the tour this slide is, as a bar two pixels tall under the
// running head.
//
// It is the one thing the rail was genuinely good at — a glance that says
// there is a lot of this left, or nearly none — kept, and given two pixels
// instead of two hundred and sixty. And it is a view like everything else:
// two boxes in a row, one carrying `grow(read)` and one `grow(left)`, which
// is how `hive.ui` says "these two split the room in that ratio". No width is
// computed here and no percentage is written down. The ratio is the slide
// number, and the layout is what turns a ratio into a length.
//
// `grow(0)` is what the last slide leaves the second box, and a share of
// nought of the leftover room is no room at all — so the bar arrives full on
// slide fifty-five without that being a case anybody had to write.
func progressView(idx: Int, total: Int): ui.View {
	return ui.row([ui.height(3)], [
		ui.column([ui.grow(idx + 1), ui.background(ui.Tone.Good())], []),
		ui.column([ui.grow(total - idx - 1)], []),
	])
}

// Every page in this program is the same two things stacked: the running head,
// and then whatever that page is. It is one function because it is one shape,
// and because a head is the kind of thing that is wrong the moment one page
// has a slightly different one.
func pageView(lang: Str, path: Str, body: ui.View[dyn]): ui.View {
	return ui.column([], [runningHeadView(lang, path)] + body)
}

// The contents, which is the rail again with both things wrong with it put
// right: it is somewhere you go rather than something you carry, and when you
// get there it has the whole window to be a list in.
//
// Three columns rather than one, because fifty-five entries down a single
// column is a list you have to scroll to read, and a list you scroll is a
// list you cannot see. Three columns of eighteen is one screen. They are real
// `ui.column`s inside a `ui.row` rather than a CSS column count, so the
// reading order is the order of the markup: one to eighteen, then nineteen to
// thirty-six, then the rest. A stylesheet that flows one list into three
// columns draws the same picture and hands a screen reader one long list,
// which is fine; this hands it three, each a run of consecutive slides, which
// is better.
func contentsResponse(lang: Str): hive.net.HttpResponse {
	all := slides.all()
	total := len(all)
	perColumn := (total + 2) / 3

	mut ui.View[dyn] columns = []
	mut ui.View[dyn] current = []
	for i := 0; i < len(all); i++ {
		append(current, contentsEntryView(all[i], i, lang))
		if len(current) == perColumn {
			append(columns, ui.column([ui.gap(2), ui.grow(1)], current))
			current = []
		}
	}
	if len(current) > 0 {
		append(columns, ui.column([ui.gap(2), ui.grow(1)], current))
	}

	body := ui.column([ui.gap(30), ui.pad(40), ui.grow(1)], [
		ui.column([ui.gap(6)], [
			ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], featuresCount(lang, total)),
			ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], contentsLabel(lang)),
		]),
		ui.row([ui.gap(36), ui.align(ui.Align.Start())], columns),
	])
	head := PageHead(
		title: contentsLabel(lang) + pageTitleSuffix(lang),
		description: contentsDescription(lang),
		path: "/contents",
		lang: lang,
		indexable: true,
		prev: "",
		next: "/1",
	)
	return hive.net.HttpResponse(200, htmlHeaders(), document(head, pageView(lang, "/contents", [body])))
}

// One line of the contents. The number is padded to two digits, and the
// padding is not cosmetic: ./theme sets this list in a monospace and hangs
// every entry off a four-character indent, so a title long enough to wrap
// comes back underneath the title rather than underneath the number. That
// only holds while every label really is four characters before the text
// starts, which "9. " is not and "09. " is. The two files have to agree about
// the four, and this is the half of the agreement that produces it.
func contentsEntryView(slide: slides.Slide, i: Int, lang: Str): ui.View {
	mut number := "{i + 1}"
	if i + 1 < 10 {
		number = "0{i + 1}"
	}
	return ui.link([], href("/{i + 1}", lang), "{number}. {slideTitle(slide, lang)}")
}

func languageSwitcherView(lang: Str, path: Str): ui.View {
	mut enTone := ui.Tone.Normal()
	mut ptTone := ui.Tone.Normal()
	if lang == "pt" {
		ptTone = ui.Tone.Muted()
	} else {
		enTone = ui.Tone.Muted()
	}
	return ui.row([ui.gap(6)], [
		ui.link([ui.background(enTone)], href(path, "en"), "EN"),
		ui.link([ui.background(ptTone)], href(path, "pt"), "PT"),
	])
}

// The slide's own column: where it sits in the tour, its title, the picture
// if it has one, and then the marker the code examples land on once the page
// has been rendered.
func headerColumn(slide: slides.Slide, idx: Int, total: Int, lang: Str): ui.View {
	titleGroup := ui.column([ui.gap(6)], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], slideProgress(idx, total, lang)),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], slideTitle(slide, lang)),
	])
	mut ui.View[dyn] blocks = [titleGroup]
	for each block in shotView(slide, lang) {
		append(blocks, block)
	}
	append(blocks, codeMarkerView())
	return ui.column([ui.gap(24), ui.pad(40), ui.grow(1)], blocks)
}

// The picture, above the code that draws it, on the slides that have one —
// and nothing at all on the fifty-two that do not.
//
// It answers with a vector rather than a View because there is no view that
// means "no view here": `ui.none` would still be a child, and a column with
// an empty child in it still spends a gap on it. An empty vector spends
// nothing, and the caller appends whatever came back.
//
// This is a view like everything else on the page, which is the point. The
// picture is of a scene, and a scene is the one thing hive.ui cannot put in a
// document — but a *photograph* of one is an image, and an image is a widget
// the set has always had. So nothing here is spliced HTML: it is `ui.image`
// and a caption, and the reason it is a picture rather than the thing itself
// is written down in ./shots rather than acted out here.
func shotView(slide: slides.Slide, lang: Str): ui.View[dyn] {
	if slide.shot == "" {
		return []
	}
	return [ui.column([ui.gap(6)], [
		ui.image([], slide.shot, shotAlt(lang)),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], shotCaption(lang)),
	])]
}

// What follows the code examples: the explanation, one paragraph per view
// so each wraps on its own, a download link on the two slides that ask for
// one, and the prev/next pager. Rendered separately with `ui.html` and spliced in
// right after the examples, so it still ends up inside the same column the
// header opened.
func bottomView(slide: slides.Slide, idx: Int, total: Int, lang: Str, path: Str): ui.View {
	mut ui.View[dyn] blocks = []
	for each para in split(slideExplanation(slide, lang), "\n\n") {
		append(blocks, ui.text([], para))
	}
	if slide.download {
		append(blocks, ui.row([ui.gap(12)], [downloadLinkView(lang), repoLinkView(lang)]))
	}

	mut prevNode := ui.text([ui.tone(ui.Tone.Muted())], prevLabel(lang))
	if idx > 0 {
		prevNode = ui.link([], href("/{idx}", lang), prevLabel(lang))
	}
	mut nextNode := ui.text([ui.tone(ui.Tone.Muted())], nextLabel(lang))
	if idx + 1 < total {
		nextNode = ui.link([], href("/{idx + 2}", lang), nextLabel(lang))
	}
	pager := ui.row([ui.justify(ui.Justify.Between())], [prevNode, nextNode])
	append(blocks, pager)
	return ui.column([ui.gap(16)], blocks)
}

// Every example a slide carries, one small labelled block per example. A
// slide with one example — most of them — shows no caption at all; a
// slide split into several shows what each one is about, so a big feature
// still arrives as several small, focused programs rather than one long
// one.
func examplesHtml(examples: slides.Example[], lang: Str): Str {
	mut Str[dyn] blocks = []
	for each ex in examples {
		append(blocks, exampleHtml(ex, lang))
	}
	return join(blocks, "")
}

func exampleHtml(ex: slides.Example, lang: Str): Str {
	mut caption := ex.caption
	if lang == "pt" {
		caption = ex.captionPt
	}
	mut captionHtml := ""
	if caption != "" {
		captionHtml = "<div class=\"tour-caption\">" + escapeHtml(caption) + "</div>"
	}
	mut code := ex.code
	if lang == "pt" {
		code = ex.codePt
	}
	return "<div class=\"tour-example\">" + captionHtml + codeBlockHtml(code) + "</div>"
}

// The one piece of literal HTML on the page: `hive.ui` has no monospaced,
// boxed text of its own, so a code example is written out by hand. The code
// itself never changes between languages — only its `//` comments do, in
// `codePt`.
//
// What it carries is two class names and no `style`. It used to be the other
// way round, with the whole appearance of a code block written inline right
// here, and that was the wrong place for it twice over: a stylesheet spelled
// out inside a Str is a stylesheet nobody can find when they come looking for
// why the samples look like that, and it is one no rule can override without
// `!important`. Both classes are answered for in ./theme.
//
// The sample goes through ./highlight rather than through `escapeHtml`, and
// the escaping goes with it: a painter that wrapped text in spans and left
// somebody else to escape it would have to be trusted to hand back the two
// jobs in the right order, and there is no order that works — escape first
// and the spans are escaped too, escape after and the markup is. So the one
// pass that decides where a span goes is the one that escapes what is inside
// it, and this line has nothing left to do but name the element.
func codeBlockHtml(code: Str): Str {
	return "<pre class=\"tour-code\"><code>" + highlight.html(code) + "</code></pre>"
}

func escapeChar(c: Str): Str {
	if c == "&" { return "&amp;" }
	else if c == "<" { return "&lt;" }
	else if c == ">" { return "&gt;" }
	return c
}

func escapeHtml(s: Str): Str {
	return join(map(split(s, ""), escapeChar), "")
}

// The same three, plus the quote that would otherwise end the attribute
// this text is sitting inside. Every `content=` and every `href=` this
// program writes by hand goes through here.
func escapeAttrChar(c: Str): Str {
	if c == "\"" { return "&quot;" }
	return escapeChar(c)
}

func escapeAttr(s: Str): Str {
	return join(map(split(s, ""), escapeAttrChar), "")
}

// ---------------------------------------------------------------------------
// The small, reusable pieces of interface text — everything that is not
// part of one particular slide.

func tourTitle(lang: Str): Str {
	if lang == "pt" { return "O Tour do Hive" }
	return "The Hive Tour"
}

func pageTitleSuffix(lang: Str): Str {
	if lang == "pt" { return " — O Tour do Hive" }
	return " — The Hive Tour"
}

// What the mark is, for whoever is not being shown it. The name is right
// beside it in either language, so what is left to say is the picture.
func logoAlt(lang: Str): Str {
	if lang == "pt" { return "O logo do Hive: uma abelha sobre um favo de mel" }
	return "The Hive logo: a bee on a honeycomb"
}

func homePageTitle(lang: Str): Str {
	if lang == "pt" { return "Hive — um tour pela linguagem" }
	return "Hive — a tour of the language"
}

// The landing page's own sentence, written rather than taken from the
// prose above it. It is the one description here worth a second pass: it is
// what a search result for the language itself shows, and what a link to
// the tour unfurls into everywhere it is pasted.
func homeDescription(lang: Str): Str {
	if lang == "pt" {
		return "Um tour interativo pelo Hive: uma linguagem compilada sem exceções em tempo de execução, feita para sistemas distribuídos e pequena o bastante para se aprender em um dia. Um único executável."
	}
	return "An interactive tour of Hive: a compiled language with no runtime exceptions, built for distributed systems and small enough to learn in a day. One executable."
}

func notFoundPageTitle(lang: Str): Str {
	if lang == "pt" { return "Página não encontrada — O Tour do Hive" }
	return "Not found — The Hive Tour"
}

func slideProgress(idx: Int, total: Int, lang: Str): Str {
	if lang == "pt" { return "Slide {idx + 1} de {total}" }
	return "Slide {idx + 1} of {total}"
}

// What the contents page is called, in the running head, on the page itself,
// and in the tab. One word doing three jobs, so it is the same word in all
// three places rather than a heading, a link label and a title that drift.
func contentsLabel(lang: Str): Str {
	if lang == "pt" { return "Sumário" }
	return "Contents"
}

func contentsDescription(lang: Str): Str {
	if lang == "pt" {
		return "Todos os recursos do tour da linguagem Hive, em ordem, cada um em uma página."
	}
	return "Every feature in the Hive language tour, in order, one to a page."
}

func prevLabel(lang: Str): Str {
	if lang == "pt" { return "← Anterior" }
	return "← Prev"
}

func nextLabel(lang: Str): Str {
	if lang == "pt" { return "Próximo →" }
	return "Next →"
}

func startTourArrow(lang: Str): Str {
	if lang == "pt" { return "Começar o tour →" }
	return "Start the tour →"
}

func startTourPlain(lang: Str): Str {
	if lang == "pt" { return "Começar o tour" }
	return "Start the tour"
}

func downloadLabel(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador" }
	return "Download the compiler"
}

func downloadLabelArrow(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador →" }
	return "Download the compiler →"
}

func featuresCount(lang: Str, n: Int): Str {
	if lang == "pt" { return "{n} recursos, um por vez" }
	return "{n} features, one at a time"
}

func homeKicker(lang: Str): Str {
	if lang == "pt" { return "Um tour pela linguagem" }
	return "A tour of the language"
}

func homeParagraphOne(lang: Str): Str {
	if lang == "pt" {
		return "Hive é uma linguagem compilada, de memória gerenciada, e sem exceções em tempo de execução. Não existe null, nada é lançado, e todo índice de vetor é provado dentro dos limites antes de o programa rodar — o que outras linguagens deixam para o tempo de execução, aqui se resolve na compilação. Uma falha é um valor que você abre, não algo que passa voando por você."
	}
	return "Hive is a compiled, memory-managed language with no runtime exceptions. There is no null, nothing is thrown, and every vector index is proved in bounds before the program runs — what other languages leave to run time is settled at compile time instead. A failure is a value you open, not something that sails past you."
}

func homeParagraphTwo(lang: Str): Str {
	if lang == "pt" {
		return "Esta própria página é a prova: ela é servida por um servidor HTTP escrito em Hive, e sua interface abaixo dos exemplos de código é construída inteiramente com views do hive.ui. Não há framework por trás de nenhum dos dois — ambos são a biblioteca padrão, e nenhum é uma dependência que este programa precisou pedir."
	}
	return "This very page is the proof: it is served by an HTTP server written in Hive, and its interface below the code samples is built entirely out of hive.ui views. There is no framework underneath either of them — both are the standard library, and neither is a dependency this program had to ask for."
}

// What the picture is, for whoever is not being shown it, and what it says
// under itself to everybody else. Both are deliberately about *where* the
// picture came from rather than what is in it: a reader who cannot see it is
// better served by knowing this is a photograph of a real window running the
// code above than by a list of the coloured shapes in it, which the code
// beside it already spells out in full.
func shotAlt(lang: Str): Str {
	if lang == "pt" {
		return "Uma janela do hive.ui rodando o exemplo acima, fotografada"
	}
	return "A hive.ui window running the example above, photographed"
}

func shotCaption(lang: Str): Str {
	if lang == "pt" {
		return "Desenhado pelo hive.ui, em uma janela"
	}
	return "Drawn by hive.ui, in a window"
}

func notFoundText(lang: Str): Str {
	if lang == "pt" { return "Esse slide não existe." }
	return "That slide does not exist."
}