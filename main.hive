// The Hive Tour — an HTTP server that walks through the language one
// feature at a time, in the spirit of an interactive language tour. Every
// slide is one `slides.Slide` value: a title, an explanation, and one or
// more code examples — each a complete, runnable program in its own right,
// kept small enough that one example makes one point. Every piece of prose
// carries an English and a Portuguese version side by side; the code never
// does, because code is not prose. `handle` reads the slide number and the
// chosen language out of the URL, `hive.net.httpServe` does the rest.
//
// This file is the server, and only the server. Twelve others hold the things
// that are not it, each because a program is easier to read when the thing it
// does and the material it does it to are not interleaved:
//
//   ./slides     the tour itself, seventy-five slides of it in two languages,
//                and the two types that hold one. Four fifths of the whole
//                program by weight, and none of it about HTTP.
//   ./home       what the front page says: the case for the language, made to
//                somebody deciding whether to use it, in the same two
//                languages and with samples held to the same rule.
//   ./logo       the mark, as the paths of an SVG. A drawing is not prose,
//                and a page of path coordinates in the middle of some would
//                read as neither.
//   ./icon       the same mark as pixels, in the three raster shapes a
//                search engine, a browser, and an iOS home screen or a
//                pasted link respectively want. It exists because neither
//                Google Search nor any link unfurler will read the SVG the
//                other two files are perfectly happy with.
//   ./theme      how it all looks: the one stylesheet this program writes,
//                layered over the one `ui.page` writes for itself.
//   ./fonts      the three typefaces it is set in, carried in the binary so
//                nothing on a page is fetched from anywhere but here.
//   ./rail       railroad diagrams — a grammar rule drawn as track — drawn
//                with `hive.ui`'s own canvas, and the line of the tour
//                drawn in the same notation across the top of a slide.
//   ./chart      the symbol on each slide's tile, for the chart the contents
//                page is and the front page ends on.
//   ./grammar    the rules of Hive's grammar it draws, copied from the spec,
//                and which slide teaches which.
//   ./highlight  a Hive lexer, for painting the samples in ./slides. It is
//                here rather than in a script tag because the home page
//                claims there is no framework underneath this site, and that
//                claim is worth more than the eight lines it saves.
//   ./play       the playground: which samples can run in a reader's
//                browser, what to say about one that cannot, and the one
//                script this site ships, which runs them there. It says
//                why there is a script at all.
//   ./compile.go the build behind the playground's Run button — the one
//                file not written in Hive, because it has to be able to give
//                up on a build, and Hive cannot stop a program it started.
//
// The interface is built with `hive.ui`: the running head, the track, the
// headings, the columns, the links and the diagrams are all `View`s, rendered
// by `ui.page`. The kinds of thing the widget set has no answer for are
// spliced into the finished document as literal HTML: a monospaced, boxed
// code sample and the prose around it, which go in place of marker views; a
// figure round a drawn rule; the `<main>` and `<nav>` landmarks a page is
// framed in, whose class names are what the stylesheet hangs from; and
// everything that belongs in the head — the stylesheet, the type, the tab
// icons, and the whole of what a page says about itself to a search engine
// or a link unfurler. The head is the half of a page nobody looks at, so
// nothing in it is on show, and a thing that is not on show is not a view.
// Everything else stays a view all the way down.
//
// Two more paths answer to nobody who is reading: /robots.txt and
// /sitemap.xml, which between them say what there is here and in which
// languages. The sitemap is built from the same `slides.all()` the pages
// are, so a slide added there is a slide a crawler is told about, and there
// is no second list anywhere to forget to update.
import hive.ui
import ./logo
import ./chart
import ./compile.go
import ./fonts
import ./grammar
import ./highlight
import ./home
import ./icon
import ./play
import ./rail
import ./shots
import ./slides
import ./theme

// What a page says about itself before anybody has read a word of it: the
// title in the tab, the sentence a search result prints under it, the URL
// that is the real one when several point at the same page, and where the
// other language's version of it lives. Every page this server sends fills
// one of these in, and `document` turns it into the tags that carry it.
type PageHead {
	title:       Str
	description: Str
	path:        Str
	lang:        Str
	indexable:   Bool
	prev:        Str
	next:        Str
}

// `httpServe` binds `:8080` — every interface, not just the loopback — which
// is what makes this the same program in a container as on a laptop.
//
// The line it prints says the port it bound and *then* the URL, in that order,
// and the order is the whole point of it. It used to print the URL alone, and
// inside a container that is a sentence which is true for the program and
// false for the person reading it: the server really is answering on
// localhost:8080, on the container's localhost, which is not the one the
// browser is pointed at. A container started without `-p 8080:8080` then looks
// exactly like a working one — it builds, it runs, it says it is serving, and
// nothing loads — and the log is the reason the search starts in the wrong
// place. Naming the bound port first says what was actually done; the URL
// after it is the convenience it always was, for the case where the machine
// running this is the machine holding the browser.
proc main(): void {
	echo "The Hive Tour — listening on :8080 (locally, http://localhost:8080)"
	hive.net.httpServe(8080, handle)
}

// Every request, answered: routed to the page or file it asks for, and then,
// if the reader has picked a colour scheme of their own, marked with it.
//
// A build is answered before any of that. It is the one request that is not
// a GET and the one answer that is not a page, and it must never be marked: a
// compiled program is bytes, and a program holding the text `<html lang=` in
// one of its strings would have the scheme written into the middle of it.
proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	if requestPath(request.url) == play.compilePath() {
		return compileResponse(request)
	}
	response := route(request.url)
	theme := requestTheme(request.headers)
	if theme == "" {
		return response
	}
	return withTheme(response, theme)
}

proc route(url: Str): hive.net.HttpResponse {
	path := requestPath(url)
	lang := requestLang(url)

	if path == "/" {
		return homeResponse(lang)
	}

	// The switch between the light scheme and the dark one, which is a link
	// rather than a script: it lands here, says which scheme in a cookie, and
	// sends the reader straight back to the page they were on.
	if indexOf(path, "/theme/dark") is Result.Ok(0) {
		return themeResponse("dark", replaceFirst(path, "/theme/dark", ""), lang)
	}
	if indexOf(path, "/theme/light") is Result.Ok(0) {
		return themeResponse("light", replaceFirst(path, "/theme/light", ""), lang)
	}

	// Every framing of the mark, at the paths that ask for one: the home
	// screen's `<img>`, whatever a browser makes of the `<link>`s in the head,
	// and the three rasters from ./icon that are there because a search engine
	// and a link unfurler cannot read either of the first two. None of them
	// depends on the language, so none of them reads `lang`.
	if path == "/hive-logo.svg" {
		return svgResponse(logo.svg())
	}
	if path == "/favicon.svg" {
		return svgResponse(logo.icon())
	}
	if path == "/favicon.png" {
		return rasterResponse(icon.png(), icon.pngType())
	}
	if path == "/favicon.ico" {
		return rasterResponse(icon.ico(), icon.icoType())
	}
	if path == markPath() {
		return rasterResponse(icon.mark(), icon.pngType())
	}

	// The three typefaces, out of the executable like everything else.
	if path == fonts.serifPath() {
		return fontResponse(fonts.serif())
	}
	if path == fonts.italicPath() {
		return fontResponse(fonts.italic())
	}
	if path == fonts.monoPath() {
		return fontResponse(fonts.mono())
	}

	// A picture of what a slide's code draws, for the one kind of code on this
	// tour whose output a page cannot carry. ./shots says why there is one.
	if path == shots.scenePath() {
		return rasterResponse(shots.scene(), icon.pngType())
	}

	// The playground's script, and the loader it runs a compiled program
	// with. ./play says why there is a script on this site at all.
	if path == play.scriptPath() {
		return scriptResponse(play.script())
	}
	if path == play.loaderPath() {
		return loaderResponse()
	}

	// The two files a crawler asks for that no visitor ever does. Neither
	// depends on the language either: the sitemap names both of them for
	// every page, which is the point of it.
	if path == "/contents" {
		return contentsResponse(lang)
	}

	if path == "/robots.txt" {
		return robotsResponse()
	}
	if path == "/sitemap.xml" {
		return sitemapResponse()
	}

	all := slides.all()
	if path is "/{n}" {
		parsed := hive.conv.sti(n)
		if parsed is Result.Ok(num) {
			idx := num - 1
			if all bounds idx {
				slide := all[idx]
				return renderSlide(slide, idx, all, lang)
			}
		}
	}
	return notFoundResponse(lang, path)
}

// ---------------------------------------------------------------------------
// The colour scheme
//
// A page follows the reader's system — light or dark, whichever their machine
// is set to — until they say otherwise, and saying otherwise is a link in the
// running head. The one script on this site runs programs and nothing else —
// ./play says why there is even that one — so the choice is remembered the
// way the web did it before scripts: in a cookie, set by the server, sent back
// with every request after. It holds one word, `dark` or `light`, and nothing
// about who is asking.
//
// The link goes to `/theme/dark` or `/theme/light` followed by the page it was
// on. This answers it with the cookie and a redirect back there; every page
// after that comes out of `handle` with the scheme written on its `<html>`,
// which is all ./theme needs to tell the system's choice from the reader's.

// The scheme a request asked for, or nothing when it has never asked.
func requestTheme(headers: Str[dyn][dyn]): Str {
	for each row in headers {
		if row bounds 0 && row bounds 1 {
			if row[0] == "Cookie" || row[0] == "cookie" {
				for each part in split(row[1], ";") {
					cookie := replaceAll(part, " ", "")
					if cookie == "theme=dark" { return "dark" }
					if cookie == "theme=light" { return "light" }
				}
			}
		}
	}
	return ""
}

// A page, marked with the scheme its reader picked. Only a document has an
// `<html>` to mark; every other answer comes back untouched.
func withTheme(response: hive.net.HttpResponse, theme: Str): hive.net.HttpResponse {
	if indexOf(response.body, "<html lang=") is Result.Ok(_) {
		marked := replaceFirst(response.body, "<html lang=", "<html data-theme=\"" + theme + "\" lang=")
		return hive.net.HttpResponse(response.status, response.headers, marked)
	}
	return response
}

// The answer to the switch: the cookie, for a year, and a 303 back to the page
// the link was on. That page is only ever a path on this site — anything that
// does not start with a single slash sends the reader to the front page — so
// the switch can never be made into a way of sending somebody somewhere else.
func themeResponse(theme: Str, back: Str, lang: Str): hive.net.HttpResponse {
	mut target := "/"
	if indexOf(back, "/") is Result.Ok(0) && indexOf(back, "//") is Result.Error(_) {
		target = back
	}
	headers := [
		["Location", href(target, lang)],
		["Set-Cookie", "theme=" + theme + "; Path=/; Max-Age=31536000; SameSite=Lax; HttpOnly"],
		["Cache-Control", "no-store"],
	]
	return hive.net.HttpResponse(303, headers, "")
}

// The path and the query string travel together in `request.url` — a GET
// to "/3?lang=pt" arrives as exactly that one Str. Splitting on "?" is the
// whole of parsing either back out: `split` never yields zero pieces, so
// the path half is always there, and the query half is only there to ask
// about when a "?" showed up at all.
func requestPath(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 0 {
		return parts[0]
	}
	return url
}

// The only query parameter this server reads. Not a real query-string
// parser — it doesn't need to be one, since this program is the only thing
// that ever writes a `?lang=` into one of its own links.
func requestLang(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 1 {
		if indexOf(parts[1], "lang=pt") is Result.Ok(_) {
			return "pt"
		}
	}
	return "en"
}

// ---------------------------------------------------------------------------
// Rendering

// The one View a page never keeps: a stand-in for the code examples, so
// they can be rendered once inside `ui.page` and then found again in the
// HTML that comes back. Its rendering has no attributes at all, so it
// always comes back exactly as `codeMarkerTag` says, whatever the renderer
// does.
func codeMarker(): Str {
	return "HIVE_TOUR_CODE_SAMPLE"
}

func codeMarkerView(): ui.View {
	return ui.text([], codeMarker())
}

func codeMarkerTag(): Str {
	return "<span class=\"h-text\">" + codeMarker() + "</span>"
}

// The same trick for a page with more than one hole in it, which is the front
// page: a sample beside the masthead, and prose and samples down the length of
// it. Each hole is named by what goes in it and a number, so the view that
// leaves one and the line that fills it agree by construction rather than by
// counting. The full tag is what is matched, closing `</span>` and all, so
// hole 1 is never mistaken for the start of hole 10.
func holeView(kind: Str, n: Int): ui.View {
	return ui.text([], "HIVE_TOUR_{kind}_{n}")
}

func fill(page: Str, kind: Str, n: Int, html: Str): Str {
	tag := "<span class=\"h-text\">HIVE_TOUR_{kind}_{n}</span>"
	return join(split(page, tag), html)
}

// Every page this server sends, and the lines of it no view can carry.
// `ui.page` writes a whole document — charset, viewport, title, stylesheet
// — and everything a page says *about* itself belongs in its head, which is
// the half of a page nobody looks at. So it is spliced the way a code
// sample is: split the document on a tag that is certainly in it, and join
// it back with ours in front of that tag. Twice, because the language a
// document is written in is an attribute of `<html>` rather than a tag
// inside it, and a screen reader picking a voice reads it there.
func document(head: PageHead, view: ui.View): Str {
	page := ui.page(head.title, view)
	tagged := join(split(page, "<html>"), "<html lang=\"" + htmlLang(head.lang) + "\">")
	return join(split(tagged, "</head>"), headTags(head) + "</head>")
}

// BCP 47, which is what an `hreflang` and an `<html lang>` are both read as.
// The Portuguese here is Brazilian, and saying so is the difference between
// a search engine offering this page to somebody in São Paulo and offering
// it to everybody who reads any Portuguese at all.
func htmlLang(lang: Str): Str {
	if lang == "pt" { return "pt-BR" }
	return "en"
}

// The whole of the head this program writes for itself. Order is nobody's
// business but a reader of the source's, so it goes: how the page looks, what
// the mark is, what the page is, who may index it, which URL is the real one,
// where the other language is, and then the two vocabularies — Open Graph and
// Twitter's — that decide what a pasted link unfurls into. The structured
// data closes it, because it is the one part that repeats what the tags above
// already said, and it repeats it for a reader that wants it as data rather
// than as tags.
//
// The stylesheet goes first of all, and it has to: `ui.page` has already
// written its own into this same head, and ./theme is layered over the top of
// that rather than replacing it, which only works while it comes second in
// the document. Everything spliced here lands immediately before `</head>`,
// so it does.
func headTags(head: PageHead): Str {
	canonical := absoluteUrl(head.path, head.lang)
	english := absoluteUrl(head.path, "en")
	portuguese := absoluteUrl(head.path, "pt")
	mut Str[dyn] tags = [
		theme.styleTag(),
		fontPreloadTag(fonts.serifPath()),
		fontPreloadTag(fonts.monoPath()),
		iconLinkTag(),
		metaTag("description", head.description),
		metaTag("robots", robotsValue(head.indexable)),
		metaTag("theme-color", brandColour()),
		metaTag("color-scheme", "light dark"),
		linkTag("canonical", canonical),
		alternateTag("en", english),
		alternateTag("pt-BR", portuguese),
		alternateTag("x-default", english),
		propertyTag("og:type", openGraphType(head)),
		propertyTag("og:site_name", tourTitle(head.lang)),
		propertyTag("og:title", head.title),
		propertyTag("og:description", head.description),
		propertyTag("og:url", canonical),
		propertyTag("og:image", siteUrl() + markPath()),
		propertyTag("og:image:width", "256"),
		propertyTag("og:image:height", "256"),
		propertyTag("og:image:alt", logoAlt(head.lang)),
		propertyTag("og:locale", openGraphLocale(head.lang)),
		propertyTag("og:locale:alternate", openGraphLocale(otherLang(head.lang))),
		metaTag("twitter:card", "summary"),
		metaTag("twitter:title", head.title),
		metaTag("twitter:description", head.description),
		metaTag("twitter:image", siteUrl() + markPath()),
	]

	// Only where there is one to point at. A `rel="prev"` on the first slide
	// would be a link to nowhere, which is worse than no link at all.
	if head.prev != "" {
		append(tags, linkTag("prev", absoluteUrl(head.prev, head.lang)))
	}
	if head.next != "" {
		append(tags, linkTag("next", absoluteUrl(head.next, head.lang)))
	}

	append(tags, structuredDataTag(head))
	return join(tags, "")
}

// Where the mark is, in every form something might want it, best first.
//
// This used to be the one SVG link and nothing else, on the reasoning that
// one drawing drawn at whatever size the tab happens to be beats any number
// of fixed rasters. All of that is still true, and it is still the first line
// here, because a browser reads the list and takes the best thing on it.
//
// What it missed is that the most important reader of this list is not a
// browser. Google Search does not accept an SVG favicon at all — its formats
// are BMP, GIF, ICO, PNG, JPEG, PPM and TIFF — so for as long as this was the
// only line, every result for the tour came out wearing the generic globe
// that means "this site has no icon". The PNG below it is the fix, and the
// rest of the list is the same courtesy extended to everything else that
// asks: the ICO for a browser that goes looking for /favicon.ico on its own,
// and the apple-touch-icon for an iOS home screen, which Google reads as a
// fallback too. ./icon is where all three come from and why.
func iconLinkTag(): Str {
	return "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">"
		+ "<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/favicon.png\">"
		+ "<link rel=\"icon\" type=\"image/x-icon\" sizes=\"32x32 16x16\" href=\"/favicon.ico\">"
		+ "<link rel=\"apple-touch-icon\" sizes=\"256x256\" href=\"" + markPath() + "\">"
}

// The two faces nearly every page sets text in, asked for before the
// stylesheet has been read rather than after, so the first paint is in the
// right type rather than a fallback that jumps when the font arrives. The
// italic is left to be found the ordinary way: it is only ever in a diagram.
// `crossorigin` is not optional, even for a font from the page's own origin —
// fonts are always fetched in that mode, and a preload made without it is a
// second download rather than a head start.
func fontPreloadTag(path: Str): Str {
	return "<link rel=\"preload\" href=\"" + path + "\" as=\"font\" type=\""
		+ fonts.woff2Type() + "\" crossorigin>"
}

// The one raster that is not a favicon, and the one path named in more than
// one place: an iOS home screen and a pasted link both want a square of the
// mark on paper of its own, at very much the same size, so they get the same
// square rather than two of it. ./icon explains why it is 256 and why it is
// opaque; this is only where it lives.
func markPath(): Str {
	return "/hive-mark.png"
}

// The amber the bee is painted in, which is what a browser tints its own
// chrome with on a phone.
func brandColour(): Str {
	return "#e29b19"
}

// The one absolute URL this program knows about itself. Every canonical
// link, every alternate, every entry of the sitemap and the picture a
// pasted link unfurls into is built out of it, so moving the tour to
// another domain is this one line and nothing else.
func siteUrl(): Str {
	return "https://hive-lang.run"
}

// A page's real address, which is the site, the path, and — in Portuguese —
// the query that chose the language. Two languages of one slide are two
// URLs and each is canonical for itself: telling a search engine they are
// the same page would be telling it to throw one of them away.
func absoluteUrl(path: Str, lang: Str): Str {
	return siteUrl() + href(path, lang)
}

func otherLang(lang: Str): Str {
	if lang == "pt" { return "en" }
	return "pt"
}

func openGraphLocale(lang: Str): Str {
	if lang == "pt" { return "pt_BR" }
	return "en_US"
}

// Open Graph's own word for what a page is. The home screen is the site;
// every slide is a piece of writing on it.
func openGraphType(head: PageHead): Str {
	if head.path == "/" { return "website" }
	return "article"
}

// The 404 is the one page here worth keeping out of an index — it is not a
// page about anything — and `follow` still lets a crawler that landed on
// one take the links back out of it.
func robotsValue(indexable: Bool): Str {
	if indexable {
		return "index,follow,max-image-preview:large"
	}
	return "noindex,follow"
}

func metaTag(name: Str, content: Str): Str {
	return "<meta name=\"" + name + "\" content=\"" + escapeAttr(content) + "\">"
}

func propertyTag(property: Str, content: Str): Str {
	return "<meta property=\"" + property + "\" content=\"" + escapeAttr(content) + "\">"
}

func linkTag(rel: Str, target: Str): Str {
	return "<link rel=\"" + rel + "\" href=\"" + escapeAttr(target) + "\">"
}

func alternateTag(hreflang: Str, target: Str): Str {
	return "<link rel=\"alternate\" hreflang=\"" + hreflang
		+ "\" href=\"" + escapeAttr(target) + "\">"
}

// The same facts again, as JSON-LD, which is the shape a search engine
// reads rather than infers. It is written out by hand rather than through
// `hive.json.encode` for one reason: every key that matters here opens with
// an `@`, and a Hive field name cannot.
func structuredDataTag(head: PageHead): Str {
	return "<script type=\"application/ld+json\">" + structuredData(head) + "</script>"
}

// A `\{` is a literal brace rather than the start of an interpolation, which
// is a rule this one function leans on harder than the whole of the rest of
// the program: every object here opens with one.
func structuredData(head: PageHead): Str {
	site := "\{\"@type\":\"WebSite\",\"name\":" + jsonText(tourTitle(head.lang))
		+ ",\"url\":" + jsonText(absoluteUrl("/", head.lang)) + "}"
	language := "\{\"@type\":\"ComputerLanguage\",\"name\":\"Hive\",\"url\":"
		+ jsonText(repoUrl()) + "}"

	if head.path == "/" {
		return "\{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":"
			+ jsonText(tourTitle(head.lang)) + ",\"url\":"
			+ jsonText(absoluteUrl("/", head.lang)) + ",\"description\":"
			+ jsonText(head.description) + ",\"inLanguage\":"
			+ jsonText(htmlLang(head.lang)) + ",\"about\":" + language + "}"
	}
	return "\{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":"
		+ jsonText(head.title) + ",\"description\":" + jsonText(head.description)
		+ ",\"url\":" + jsonText(absoluteUrl(head.path, head.lang)) + ",\"inLanguage\":"
		+ jsonText(htmlLang(head.lang)) + ",\"isPartOf\":" + site
		+ ",\"about\":" + language + ",\"isAccessibleForFree\":true}"
}

// A JSON string, quotes and all. The two angle brackets are escaped as well
// as the two JSON demands, because this text lands inside a `<script>` and
// a `</` anywhere in there would close it early — and a page about a
// language whose one built-in union is spelled `Result<T, E>` is a page
// where that text really does turn up.
func jsonText(s: Str): Str {
	mut out := join(split(s, "\\"), "\\\\")
	out = join(split(out, "\""), "\\\"")
	out = join(split(out, "\n"), " ")
	out = join(split(out, "<"), "\\u003c")
	out = join(split(out, ">"), "\\u003e")
	return "\"" + out + "\""
}

// Where a search engine is told what there is to read: every page, in both
// languages, each one carrying the full set of alternates so a crawler that
// arrives at either finds the other. `robots.txt` names it, which is the
// one line in that file worth having.
func robotsResponse(): hive.net.HttpResponse {
	body := "User-agent: *\nAllow: /\nDisallow: /theme/\nDisallow: /play/\n\nSitemap: " + siteUrl() + "/sitemap.xml\n"
	headers := [
		["Content-Type", "text/plain; charset=utf-8"],
		["Cache-Control", "public, max-age=86400"],
	]
	return hive.net.HttpResponse(200, headers, body)
}

func sitemapResponse(): hive.net.HttpResponse {
	all := slides.all()
	mut Str[dyn] entries = [
		sitemapEntry("/", "en"), sitemapEntry("/", "pt"),
		sitemapEntry("/contents", "en"), sitemapEntry("/contents", "pt"),
	]
	for i := 0; i < len(all); i++ {
		append(entries, sitemapEntry("/{i + 1}", "en"))
		append(entries, sitemapEntry("/{i + 1}", "pt"))
	}
	body := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
		+ "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\""
		+ " xmlns:xhtml=\"http://www.w3.org/1999/xhtml\">\n"
		+ join(entries, "") + "</urlset>\n"
	headers := [
		["Content-Type", "application/xml; charset=utf-8"],
		["Cache-Control", "public, max-age=3600"],
	]
	return hive.net.HttpResponse(200, headers, body)
}

func sitemapEntry(path: Str, lang: Str): Str {
	english := absoluteUrl(path, "en")
	portuguese := absoluteUrl(path, "pt")
	return "  <url><loc>" + escapeAttr(absoluteUrl(path, lang)) + "</loc>"
		+ sitemapAlternate("en", english)
		+ sitemapAlternate("pt-BR", portuguese)
		+ sitemapAlternate("x-default", english)
		+ "</url>\n"
}

func sitemapAlternate(hreflang: Str, target: Str): Str {
	return "<xhtml:link rel=\"alternate\" hreflang=\"" + hreflang
		+ "\" href=\"" + escapeAttr(target) + "\"/>"
}

// The sentence a search result prints under the title, and what a link to
// this page unfurls into wherever it is pasted. It is taken from the
// slide's own opening paragraph rather than written a second time: what a
// page opens by saying is already the best short answer to what it is
// about, and a description kept somewhere else is a description that goes
// stale the first time the page is edited. The cut lands on a word
// boundary, because half a word helps nobody.
func summarise(text: Str, limit: Int): Str {
	paragraphs := split(text, "\n\n")
	mut opening := text
	if paragraphs bounds 0 {
		opening = paragraphs[0]
	}
	if len(opening) <= limit {
		return opening
	}

	chars := split(opening, "")
	mut cut := opening
	high := limit - 1
	if chars bounds 0 && chars bounds high {
		cut = join(chars[0:high], "")
	}

	// The last word is the one the cut landed in the middle of, so it goes.
	words := split(cut, " ")
	stop := len(words) - 2
	if words bounds 0 && words bounds stop {
		return join(words[0:stop], " ") + "…"
	}
	return cut + "…"
}

// The mark, either framing of it. A day of caching, because the drawing is
// part of the executable: it cannot change without a new binary, and until
// one ships there is nothing here worth asking for twice.
func svgResponse(svg: Str): hive.net.HttpResponse {
	headers := [
		["Content-Type", "image/svg+xml; charset=utf-8"],
		["Cache-Control", "public, max-age=86400"],
	]
	return hive.net.HttpResponse(200, headers, svg)
}

// The rasterised mark, in whichever of its three forms was asked for. Cached
// the same day the drawing is, for the same reason: it is part of the
// executable, and until a new binary ships there is nothing here worth asking
// for twice.
//
// It takes a Result rather than bytes because that is what ./icon answers
// with, and the two ways it can fail are worth telling apart. Bytes that
// decoded are the picture. Bytes that did not are not a bad request — the
// base64 they came from is a constant in the source, so a failure here means
// the program was built broken and every visitor is about to see the same
// thing. There is nothing useful to say to this particular visitor about
// that, and the vector framing of the same mark is sitting right there, so
// the tab still gets a bee and the tour carries on.
//
// No charset, unlike the SVG above: these are bytes rather than text, and a
// charset on a PNG is a claim about an encoding it does not have.
func rasterResponse(decoded: Result<Str, hive.crypto.CryptoError>, contentType: Str): hive.net.HttpResponse {
	if decoded is Result.Ok(bytes) {
		headers := [
			["Content-Type", contentType],
			["Cache-Control", "public, max-age=86400"],
		]
		return hive.net.HttpResponse(200, headers, bytes)
	}
	return svgResponse(logo.icon())
}

// A typeface, decoded. A day of caching for the reason the mark has one: it
// is part of the executable, and cannot change before a new binary ships. A
// font that fails to decode was built broken, and there is nothing to send
// for it but a 404, which the stylesheet's own fallbacks are there for.
func fontResponse(decoded: Result<Str, hive.crypto.CryptoError>): hive.net.HttpResponse {
	if decoded is Result.Ok(bytes) {
		headers := [
			["Content-Type", fonts.woff2Type()],
			["Cache-Control", "public, max-age=86400"],
		]
		return hive.net.HttpResponse(200, headers, bytes)
	}
	return hive.net.HttpResponse(404, [["Content-Type", "text/plain; charset=utf-8"]], "")
}

// The other end of a Run button: one program's source in, and that program
// built for a browser out — or what the compiler said about it, or why it was
// never handed to the compiler at all. ./play says why the server compiles
// and never runs, and ./compile.go is the build.
//
// Each refusal comes before the one after it costs anything. Only a POST from
// the tour's own script, which says so in a header — one that another site's
// page cannot send here without asking first, and is never told yes — then nothing
// longer than any program on the tour by some way, then nothing a browser
// could not run anyway. What is left waits up to fifteen seconds for the one
// build slot and gets thirty to build in.
//
// The status says which of the three answers this is, and the script reads
// it that way: 200 is a program, 422 is the compiler's own words about one,
// and anything else is a sentence of ours. Nothing is cached anywhere: a
// build is one reader's program, asked for once.
proc compileResponse(request: hive.net.HttpRequest): hive.net.HttpResponse {
	lang := requestLang(request.url)
	if request.method != "POST" {
		return hive.net.HttpResponse(405, [["Allow", "POST"], ["Cache-Control", "no-store"]], "")
	}
	if requestHeader(request.headers, "X-Hive-Tour") != "play" {
		return playText(403, notFromPageNote(lang))
	}
	if bytes(request.body) > 65536 {
		return playText(413, tooLongNote(lang))
	}
	if play.refusal(request.body, lang) is Result.Ok(why) {
		return playText(403, why)
	}

	built := compile.wasm(request.body, 15000, 30000)
	if built is Result.Ok(outcome) {
		if outcome.problems != "" {
			return playText(422, outcome.problems)
		}
		headers := [
			["Content-Type", "application/wasm"],
			["Cache-Control", "no-store"],
		]
		return hive.net.HttpResponse(200, headers, outcome.wasm)
	}
	if built is Result.Error(why) {
		if why == "busy" {
			return playText(503, busyNote(lang))
		}
		if why == "timeout" {
			return playText(503, timedOutNote(lang))
		}
		hive.term.status("the playground could not run the compiler: {why}")
	}
	return playText(503, brokenNote(lang))
}

// A sentence for the playground to show, as the whole of an answer.
func playText(status: Int, text: Str): hive.net.HttpResponse {
	headers := [
		["Content-Type", "text/plain; charset=utf-8"],
		["Cache-Control", "no-store"],
	]
	return hive.net.HttpResponse(status, headers, text)
}

// The value of one header, or nothing. The server underneath writes every
// name in its canonical case, so one spelling of it is enough to ask for.
func requestHeader(headers: Str[dyn][dyn], name: Str): Str {
	for each row in headers {
		if row bounds 0 && row bounds 1 {
			if row[0] == name {
				return row[1]
			}
		}
	}
	return ""
}

// The playground's script, cached for as long as a page is, because a page
// and the script that reads its controls have to change together.
func scriptResponse(source: Str): hive.net.HttpResponse {
	headers := [
		["Content-Type", "text/javascript; charset=utf-8"],
		["Cache-Control", "public, max-age=300"],
	]
	return hive.net.HttpResponse(200, headers, source)
}

// Go's loader for a `js/wasm` program: what instantiates one in a browser
// and stands in for the operating system it was compiled to talk to. It is
// the one file this server sends that is not in the binary, on purpose. A
// loader has to match the Go that compiled the program it loads, and the copy
// beside that Go's own toolchain is the only copy that is sure to.
proc loaderResponse(): hive.net.HttpResponse {
	if hive.term.exec("go", ["env", "GOROOT"], "") is Result.Ok(found) {
		root := replaceAll(replaceAll(found, "\n", ""), "\r", "")
		if hive.file.read(root + "/lib/wasm/wasm_exec.js") is Result.Ok(loader) {
			return scriptResponse(loader)
		}
	}
	return hive.net.HttpResponse(404, [["Content-Type", "text/plain; charset=utf-8"]], "")
}

// One slide: the line of the tour with this slide's station on it, the
// slide's own tile in its chapter's colour beside its title, the grammar
// rules it teaches drawn as railroad diagrams and folded away under a line
// that names them, and then the explanation and the programs side by side — the text in one column and its
// figures in the other, the way a report sets a figure beside the paragraph
// about it.
//
// It used to be one column, code first and the explanation under it, which
// asked a reader to scroll past a program to find out what it was for. Two
// columns let both be read at once. A slide whose programs are wider than
// their column is set the old way round instead — the text, then the programs
// at the full width of the page — because a program scrolled sideways next to
// a column of text with room to spare is the wrong way round. Which slides
// those are is measured here, from the programs themselves.
//
// The explanation, the programs and the rules are holes in the view, filled
// once it has been rendered, because each is markup no widget writes. The
// tile is wrapped once, in its chapter's class, for the reason the chart's
// tiles are: a colour that changes with the scheme cannot be an inline one.
func renderSlide(slide: slides.Slide, idx: Int, all: slides.Slide[], lang: Str): hive.net.HttpResponse {
	total := len(all)
	path := "/{idx + 1}"

	// Where a reader — and a crawler — goes from here. Empty at either end
	// of the tour, which is what says there is no such page rather than
	// pointing at one that isn't there.
	mut previous := ""
	if idx > 0 { previous = "/{idx}" }
	mut following := ""
	if idx + 1 < total { following = "/{idx + 2}" }

	head := PageHead(
		title: slideTitle(slide, lang) + pageTitleSuffix(lang),
		description: summarise(plainText(slideExplanation(slide, lang)), 155),
		path: path,
		lang: lang,
		indexable: true,
		prev: previous,
		next: following,
	)
	part := chapterOf(idx)
	title := ui.row([], [
		tileView(idx, slide.title, chapterTitle(part, lang)),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], slideTitle(slide, lang)),
	])
	body := ui.row([], [
		ui.column([], [holeView("TEXT", 1)] + downloadViews(slide, lang)),
		ui.column([], shotView(slide, lang) + [holeView("CODE", 1)]),
	])
	mut text := fill(ui.html(body), "TEXT", 1, proseHtml(slideExplanation(slide, lang)))
	text = fill(text, "CODE", 1, examplesHtml(slide.examples, lang, true))

	inner := ui.html(trackView(idx, total, lang))
		+ "<div class=\"tour-head f{part}\">" + ui.html(title) + "</div>"
		+ rulesHtml(grammar.forSlide(slide.title), lang)
		+ text
		+ ui.html(pagerView(idx, all, lang))
		+ playScriptTag(slide.examples, lang)
	mut name := "tour-slide"
	if widest(slide.examples, lang) > 84 {
		name = "tour-slide tour-wide"
	}
	return framed(head, lang, path, name, inner, 200)
}

// The widest line among a slide's programs, in columns, with a tab counted as
// the four ./theme sets it at.
func widest(examples: slides.Example[], lang: Str): Int {
	mut most := 0
	for each ex in examples {
		mut code := ex.code
		if lang == "pt" {
			code = ex.codePt
		}
		for each line in split(code, "\n") {
			wide := len(line) + 3 * (len(split(line, "\t")) - 1)
			if wide > most {
				most = wide
			}
		}
	}
	return most
}

// Which chapter a slide is in, counted from one, which is the number its
// colour class carries.
func chapterOf(idx: Int): Int {
	mut start := 0
	mut part := 0
	for each chapter in slides.chapters() {
		part += 1
		if idx >= start && idx < start + chapter.length {
			return part
		}
		start += chapter.length
	}
	return part
}

func chapterTitle(part: Int, lang: Str): Str {
	mut n := 0
	for each chapter in slides.chapters() {
		n += 1
		if n == part {
			return inLang(lang, chapter.title, chapter.titlePt)
		}
	}
	return ""
}

// A slide's tile, the way the chart draws it: its number, the piece of the
// language it is about, and the chapter it belongs to. On a slide it stands
// beside the title, large; on the chart it is one of seventy-five.
func tileView(idx: Int, title: Str, chapter: Str): ui.View {
	return ui.column([], [
		ui.text([], "{idx + 1}"),
		symbolView(chart.symbol(title)),
		ui.text([], chapter),
	])
}

// A tile's symbol, set a size smaller when it is long enough not to fit the
// tile at the size the short ones are.
func symbolView(symbol: Str): ui.View {
	if len(symbol) > 6 {
		return ui.text([ui.size(ui.TextSize.Caption())], symbol)
	}
	return ui.text([], symbol)
}

// Every page, finished: the running head as a view, and the page's own
// content spliced in after it inside one `<main>`, named for the kind of page
// it is. The landmark is the one piece of the frame `hive.ui` has no widget
// for — a screen reader jumps straight to it — and its class is the one name
// ./theme hangs each page's rules from, so no rule for a slide can reach the
// front page or the other way round.
func framed(head: PageHead, lang: Str, path: Str, name: Str, inner: Str, status: Int): hive.net.HttpResponse {
	page := document(head, pageView(lang, path, [codeMarkerView()]))
	body := join(split(page, codeMarkerTag()), "<main class=\"" + name + "\">" + inner + "</main>")
	return hive.net.HttpResponse(status, htmlHeaders(), body)
}

// What every HTML page here answers with. Five minutes of caching, because
// a slide changes when a new binary ships and not before — long enough to
// spare the machine a second render of a page somebody is reading through,
// short enough that a deploy is live by the time anybody notices it. The
// page varies with the cookie because the colour scheme a reader picked is
// written into it, and a page cached in one scheme must not be handed back in
// the other.
func htmlHeaders(): Str[dyn][dyn] {
	return [
		["Content-Type", "text/html; charset=utf-8"],
		["Cache-Control", "public, max-age=300"],
		["Vary", "Cookie"],
	]
}

func slideTitle(slide: slides.Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.titlePt
	}
	return slide.title
}

func slideExplanation(slide: slides.Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.explanationPt
	}
	return slide.explanation
}

// The landing page, and the one page with no track across the top. A track
// says where in the tour a reader is, and somebody on the front page is not in
// it yet: they are deciding whether to get on.
//
// It runs in the order that decision is made, which ./home sets out: what
// Hive is and the ways in, why somebody would pick it, whether it suits this
// project, each reason at length with the program that shows it, and at the
// foot the whole tour on one chart, with the ways in again under it.
//
// Everything is a view except what never could be — the samples, the prose
// with names set in monospace, and the chart — which are holes in the view,
// filled once it has been rendered.
func homeResponse(lang: Str): hive.net.HttpResponse {
	all := slides.all()
	points := home.points()
	proofNumber := len(points) + 1
	view := ui.column([], [
		heroView(lang),
		reasonsView(lang),
		fitView(lang),
		pointView(points[0], 1, [holeView("CODE", 1)], all, lang),
		pointView(points[1], 2, [targetsView(lang)], all, lang),
		pointView(points[2], 3, [holeView("CODE", 3)], all, lang),
		pointView(points[3], 4, [entriesView(home.modulesLabel(lang), home.modules(), lang)], all, lang),
		pointView(points[4], 5, [entriesView(home.commandsLabel(lang), home.commands(), lang)], all, lang),
		proofView(home.proof(), proofNumber, all, lang),
		closingView(lang, len(all), proofNumber + 1),
	])

	mut inner := fill(ui.html(view), "CODE", 0, examplesHtml(home.hero(), lang, false))
	inner = fill(inner, "CHART", 1, chartHtml(all, lang, 3))
	for i := 0; i < len(points); i++ {
		inner = fill(inner, "TEXT", i + 1, proseHtml(inLang(lang, points[i].text, points[i].textPt)))
		inner = fill(inner, "CODE", i + 1, examplesHtml(points[i].examples, lang, false))
		inner = fill(inner, "READS", i + 1, readsHtml(points[i].reads, all, lang))
		inner = fill(inner, "ANCHOR", i + 1, anchorHtml(pointAnchor(i + 1)))
	}
	proof := home.proof()
	inner = fill(inner, "TEXT", proofNumber, proseHtml(inLang(lang, proof.text, proof.textPt)))
	inner = fill(inner, "READS", proofNumber, readsHtml(proof.reads, all, lang))
	inner = fill(inner, "ANCHOR", proofNumber + 1, anchorHtml(pointAnchor(proofNumber + 1)))

	head := PageHead(
		title: homePageTitle(lang),
		description: homeDescription(lang),
		path: "/",
		lang: lang,
		indexable: true,
		prev: "",
		next: "/1",
	)
	return framed(head, lang, "/", "tour-home", inner, 200)
}

// The top of the front page: the mark and the name, what the language is in
// one sentence and then in a paragraph, the ways in, and a whole program
// beside all of it — so a reader who never scrolls has still seen the
// language do something real.
//
// The prose gets five parts of the width and the program seven, because the
// program is the one that cannot wrap.
func heroView(lang: Str): ui.View {
	return ui.row([], [
		ui.column([], [
			ui.row([], [
				ui.image([], "/hive-logo.svg", logoAlt(lang)),
				ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Hive"),
			]),
			ui.text([ui.size(ui.TextSize.Subtitle())], home.lede(lang)),
			ui.text([], home.intro(lang)),
			actionsView(lang),
		]),
		ui.column([], [holeView("CODE", 0)]),
	])
}

// The ways in, in two lines. The first is the way on — one button, in the
// brand's amber — and the map beside it; the second, quieter, is where the
// language itself lives: its repository and its compiler. A reader should
// never have to work out which of four equal buttons is the one that matters,
// and four things abreast never fitted the column without one of them falling
// onto a line of its own anyway. Used at the head of the page, at its foot,
// and on a page that is not there.
func actionsView(lang: Str): ui.View {
	return ui.column([], [
		ui.row([], [
			ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourLabel(lang)),
			ui.link([], href("/contents", lang), contentsLabel(lang)),
		]),
		ui.row([], [
			ui.link([], repoUrl(), repoLinkLabel(lang)),
			ui.link([], releaseUrl(), downloadLabel(lang)),
		]),
	])
}

// The two URLs this program ever links outside itself: GitHub's own
// `/releases/latest` redirect, so the download link never has to know a
// version number and never goes stale as new releases ship, and the
// repository itself, for whoever wants the source rather than a binary.
func releaseUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang/releases/latest"
}

func repoUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang"
}

// On a slide the way to the compiler is a plain link like the one beside it:
// amber on a slide means the station the reader is at, and nothing else.
func downloadLinkView(lang: Str): ui.View {
	return ui.link([], releaseUrl(), downloadLabel(lang))
}

func repoLinkView(lang: Str): ui.View {
	return ui.link([], repoUrl(), repoLinkLabel(lang))
}

func repoLinkLabel(lang: Str): Str {
	if lang == "pt" { return "Ver o repositório" }
	return "View the repository"
}

// One claim: a mark, a few words, and the sentence that backs them up. The
// mark sits against the first line rather than in the middle of the block, so
// a claim that runs to three lines is not read as belonging to its second.
//
// The words are an `h3` because each one is a heading over its sentence, and
// a screen reader listing the page's headings should be able to read the
// reasons off that list without the sentences in between.
func claimView(claim: home.Claim, icon: ui.Icon, tone: ui.Tone, lang: Str): ui.View {
	return ui.row([], [
		ui.icon([ui.tone(tone)], icon),
		ui.column([], [
			ui.text([ui.heading(3)], inLang(lang, claim.title, claim.titlePt)),
			ui.text([ui.tone(ui.Tone.Muted())], inLang(lang, claim.text, claim.textPt)),
		]),
	])
}

// The six reasons, as a list of them rather than a grid of six equal cells:
// each one's few words, and the sentence that backs them up, on one line of
// the list. The words link down the page to the section that argues the
// reason at length, so the list is the page's own table of contents as well
// as its summary.
func reasonsView(lang: Str): ui.View {
	reasons := home.reasons()
	mut ui.View[dyn] rows = []
	for i := 0; i < len(reasons); i++ {
		claim := reasons[i]
		append(rows, ui.row([], [
			ui.link([], "#" + reasonAnchor(i), inLang(lang, claim.title, claim.titlePt)),
			ui.text([ui.tone(ui.Tone.Muted())], inLang(lang, claim.text, claim.textPt)),
		]))
	}
	return ui.column([], [
		ui.text([ui.size(ui.TextSize.Subtitle()), ui.heading(2)], home.whyTitle(lang)),
		ui.column([], rows),
	])
}

// Where each reason is argued: the section of the page it links to, by the
// order ./home gives the reasons in. Secure defaults and batteries included
// are one section, because the standard library is where the defaults are.
func reasonAnchor(i: Int): Str {
	if i == 0 { return "reliability" }
	if i == 1 { return "everywhere" }
	if i == 2 { return "scale" }
	if i == 3 || i == 4 { return "batteries" }
	return "learn"
}

// The name each section of the page answers to, by its place among them.
func pointAnchor(n: Int): Str {
	if n == 1 { return "reliability" }
	if n == 2 { return "everywhere" }
	if n == 3 { return "scale" }
	if n == 4 { return "batteries" }
	if n == 5 { return "tooling" }
	return "learn"
}

// A place a link can land: written by hand because no widget carries an `id`,
// and absolutely positioned so it takes no room in the column it marks.
func anchorHtml(name: Str): Str {
	return "<span class=\"anchor\" id=\"" + name + "\"></span>"
}

// What Hive suits and what it does not, side by side, so the two read as one
// answer to one question. The caveats are marked in the page's quietest tone
// rather than in a warning colour: they are not alarms, they are the half of
// the answer a reader needs in order to trust the other half.
func fitView(lang: Str): ui.View {
	return ui.column([], [
		ui.text([ui.size(ui.TextSize.Subtitle()), ui.heading(2)], home.fitTitle(lang)),
		ui.row([], [
			claimsColumn(home.fitLabel(lang), home.fits(), ui.Icon.Check(), ui.Tone.Good(), lang),
			claimsColumn(home.caveatLabel(lang), home.caveats(), ui.Icon.Minus(), ui.Tone.Muted(), lang),
		]),
	])
}

func claimsColumn(label: Str, claims: home.Claim[], icon: ui.Icon, tone: ui.Tone, lang: Str): ui.View {
	mut ui.View[dyn] rows = [ui.text([ui.heading(3), ui.tone(ui.Tone.Muted())], label)]
	for each claim in claims {
		append(rows, claimView(claim, icon, tone, lang))
	}
	return ui.column([], rows)
}

// One reason at length: a heading, the prose, the slides that say the rest,
// and a figure beside all of it. The figure is whatever the caller hands in —
// a hole a sample goes in, or a list — so a point that is about a program and
// a point that is about everything around one are laid out as the same thing.
func pointView(point: home.Point, n: Int, figure: ui.View[dyn], all: slides.Slide[], lang: Str): ui.View {
	return ui.row([], [
		ui.column([], [
			holeView("ANCHOR", n),
			ui.text([ui.size(ui.TextSize.Subtitle()), ui.heading(2)], inLang(lang, point.title, point.titlePt)),
			holeView("TEXT", n),
			readsView(n, lang),
		]),
		ui.column([], figure),
	])
}

// The last point has no figure, so it is set the other way: the heading
// where the prose would be, and the prose where the figure would be. The
// columns line up with every point above it, and nothing is an empty half.
func proofView(point: home.Point, n: Int, all: slides.Slide[], lang: Str): ui.View {
	return ui.row([], [
		ui.column([], [
			ui.text([ui.size(ui.TextSize.Subtitle()), ui.heading(2)], inLang(lang, point.title, point.titlePt)),
		]),
		ui.column([], [
			holeView("TEXT", n),
			readsView(n, lang),
		]),
	])
}

// Where in the tour a point is said in full: its label, and a hole the slides
// it names go in.
func readsView(n: Int, lang: Str): ui.View {
	return ui.column([], [
		ui.text([ui.tone(ui.Tone.Muted())], home.readsLabel(lang)),
		holeView("READS", n),
	])
}

// The slides themselves, each a small tile in its chapter's colour with its
// number and title — the chart at the foot of the page, a few tiles at a time,
// so every argument above it is already tied to the part of the language it
// is about. The colour is the chapter's class, written by hand because a
// colour that changes with the scheme cannot be an inline one. A title the
// tour does not have is left out rather than linked to a 404, and
// home.test.hive is what keeps that from ever happening quietly.
func readsHtml(titles: Str[], all: slides.Slide[], lang: Str): Str {
	mut Str[dyn] items = []
	for each title in titles {
		if slideIndex(all, title) is Result.Ok(idx) {
			if all bounds idx {
				slide := all[idx]
				link := ui.link([], href("/{idx + 1}", lang), "{idx + 1}. {slideTitle(slide, lang)}")
				append(items, "<li class=\"f{chapterOf(idx)}\">" + ui.html(link) + "</li>")
			}
		}
	}
	return "<ul class=\"reads\">" + join(items, "") + "</ul>"
}

// Where a slide is in the tour, found by its English title.
func slideIndex(all: slides.Slide[], title: Str): Result<Int, Str> {
	for i := 0; i < len(all); i++ {
		if all[i].title == title {
			return Result.Ok(i)
		}
	}
	return Result.Error("the tour has no slide called \"{title}\"")
}

// A figure that is a list rather than a program: a caption, then one line per
// entry, the name in the monospace and what it is for beside it. The name is
// marked with `Tone.Good`, which is how ./theme finds the lines of a table.
func entriesView(label: Str, entries: home.Entry[], lang: Str): ui.View {
	mut ui.View[dyn] rows = [ui.text([ui.tone(ui.Tone.Muted())], label)]
	for each entry in entries {
		append(rows, ui.row([], [
			ui.text([ui.tone(ui.Tone.Good())], entry.name),
			ui.text([], inLang(lang, entry.about, entry.aboutPt)),
		]))
	}
	return ui.column([], rows)
}

// The same kind of table the other way round: the platform first, in the
// text face, and the command that reaches it after, in the monospace. The
// left column is one width, so the six commands line up into the column that
// makes the point: one file, six places, and only the flag changes.
func targetsView(lang: Str): ui.View {
	mut ui.View[dyn] rows = [ui.text([ui.tone(ui.Tone.Muted())], home.platformsLabel(lang))]
	for each target in home.platforms() {
		append(rows, ui.row([], [
			ui.text([], inLang(lang, target.name, target.namePt)),
			ui.text([ui.tone(ui.Tone.Good())], target.command),
		]))
	}
	return ui.column([], rows)
}

// The foot of the page, which says the one thing the points above leave to
// it — that the whole language fits in an afternoon — and then shows it: the
// whole tour on one chart, every tile a slide. The ways in follow, so a
// reader who has scrolled to the bottom does not have to scroll back up.
func closingView(lang: Str, total: Int, n: Int): ui.View {
	return ui.column([], [
		holeView("ANCHOR", n),
		ui.text([ui.size(ui.TextSize.Subtitle()), ui.heading(2)], home.closingTitle(lang, total)),
		ui.text([ui.tone(ui.Tone.Muted())], home.closingText(lang)),
		holeView("CHART", 1),
		actionsView(lang),
	])
}

// A page that is not there: the number, what happened, and the same ways in
// the front page offers.
func notFoundResponse(lang: Str, path: Str): hive.net.HttpResponse {
	content := ui.column([], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "404"),
		ui.text([ui.tone(ui.Tone.Muted())], notFoundText(lang)),
		actionsView(lang),
	])
	head := PageHead(
		title: notFoundPageTitle(lang),
		description: notFoundText(lang),
		path: path,
		lang: lang,
		indexable: false,
		prev: "",
		next: "",
	)
	return framed(head, lang, path, "tour-lost", ui.html(content), 404)
}

// Every internal link goes through here: unchanged in English, and
// carrying `?lang=pt` in Portuguese, so the language a visitor picked
// survives every click rather than resetting on the next page.
func href(path: Str, lang: Str): Str {
	if lang == "pt" {
		return path + "?lang=pt"
	}
	return path
}

// The line across the top of every page: the mark and the tour's name, the
// contents, and the language. It is the whole of the site's navigation that
// is always there, and what it replaced was a rail down the left carrying
// every slide at once — the shape of a documentation site, which a tour is
// not. Documentation is arrived at sideways, from a search, in the middle; a
// tour has a first slide, a last one, and an order that is the argument. So
// the map is a page of its own, the contents, one click away, and the way
// through is the next slide.
//
// It is `ui.spacer` that splits the head in two, which is the widget for
// exactly this: what is before it sits left, what is after it sits right.
func runningHeadView(lang: Str, path: Str): ui.View {
	return ui.row([], [
		ui.image([], "/favicon.svg", logoAlt(lang)),
		ui.link([], href("/", lang), tourTitle(lang)),
		ui.link([], href("/contents", lang), contentsLabel(lang)),
		ui.spacer(),
		ui.link([ui.hint(themeHint(lang, "dark"))], "/theme/dark" + href(path, lang), themeLabel(lang, "dark")),
		ui.link([ui.hint(themeHint(lang, "light"))], "/theme/light" + href(path, lang), themeLabel(lang, "light")),
		languageSwitcherView(lang, path),
	])
}

// Where this slide is: the whole tour drawn as one line of track by ./rail,
// with this slide's station in amber, and under it the chapter it belongs to
// and its number. It is what the rail down the left was genuinely good at — a
// glance that says there is a lot of this left, or nearly none — kept, and
// given one line instead of a column.
func trackView(idx: Int, total: Int, lang: Str): ui.View {
	mut Int[dyn] lengths = []
	for each part in slides.chapters() {
		append(lengths, part.length)
	}
	return ui.column([], [
		rail.journey(lengths, idx),
		ui.row([], [
			ui.text([ui.size(ui.TextSize.Caption())], chapterTitle(chapterOf(idx), lang)),
			ui.spacer(),
			ui.text([ui.size(ui.TextSize.Caption())], slideProgress(idx, total, lang)),
		]),
	])
}

// Every page in this program is the same two things stacked: the running head,
// and then whatever that page is. It is one function because it is one shape,
// and because a head is the kind of thing that is wrong the moment one page
// has a slightly different one.
func pageView(lang: Str, path: Str, body: ui.View[dyn]): ui.View {
	return ui.column([], [runningHeadView(lang, path)] + body)
}

// The contents: the whole tour on one chart.
//
// A slide you have already read comes up in the deeper shade of its chapter's
// colour. That is the browser's own `:visited`, which knows what this page
// has never been told: nothing is stored anywhere and no script runs, and a
// reader who clears their history gets the tour back new.
func contentsResponse(lang: Str): hive.net.HttpResponse {
	all := slides.all()
	total := len(all)
	intro := ui.column([], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], contentsLabel(lang)),
		ui.text([ui.tone(ui.Tone.Muted())], featuresCount(lang, total) + ". " + visitedHint(lang)),
	])
	inner := ui.html(intro) + chartHtml(all, lang, 2)
	head := PageHead(
		title: contentsLabel(lang) + pageTitleSuffix(lang),
		description: contentsDescription(lang),
		path: "/contents",
		lang: lang,
		indexable: true,
		prev: "",
		next: "/1",
	)
	return framed(head, lang, "/contents", "tour-contents", inner, 200)
}

// The chart itself, as it stands on the contents page and at the foot of the
// front page.
//
// It is laid out the way a periodic table is. Each chapter is a family, a
// block of tiles one or two wide, in reading order down the block; the blocks
// stand side by side in tour order, on one baseline, so their heights make a
// skyline of the language. A chapter too long for the skyline is set apart
// below it as rows of its own — the standard library, which is what the
// lanthanides are to the elements — and a tile in the skyline marks where it
// belongs. On a phone the blocks simply follow one another, each under its
// name.
//
// Every tile is a link to its slide whose label is the slide's title, so a
// screen reader reads the chart as seventy-five named links in order. The
// number and the symbol are laid over the link by ./theme, and the colour is
// the family's class, written here, because a colour that has to change with
// the scheme cannot be an inline one. How many rows a family takes is worked
// out from its length and written beside it, so a slide added to a chapter
// changes the shape of the chart and nothing else has to.
func chartHtml(all: slides.Slide[], lang: Str, level: Int): Str {
	mut Str[dyn] families = []
	mut Str[dyn] key = []
	mut index := 0
	mut part := 0
	apart := apartChapter()
	for each chapter in slides.chapters() {
		part += 1
		name := inLang(lang, chapter.title, chapter.titlePt)
		long := part == apart
		mut wide := 1
		if chapter.length > 5 { wide = 2 }
		if long { wide = 11 }
		rows := (chapter.length + wide - 1) / wide

		mut Str[dyn] tiles = []
		first := index + 1
		for j := 0; j < chapter.length; j++ {
			if all bounds index {
				slide := all[index]
				tiles = tiles + [ui.html(chartTileView(index, slide, lang))]
			}
			index += 1
		}
		if long {
			append(families, "<div class=\"fam-gap f{part}\" aria-hidden=\"true\"><span>{first}–{index}</span></div>")
		}
		mut kind := "fam"
		if long { kind = "fam fam-long" }
		append(families, "<section class=\"" + kind + " f{part}\" style=\"--rows:{rows};--wide:{wide}\">"
			+ ui.html(ui.text([ui.heading(level)], name))
			+ "<div class=\"fam-tiles\">" + join(tiles, "") + "</div></section>")
		append(key, "<li class=\"f{part}\">" + escapeHtml(name) + "</li>")
	}
	return "<div class=\"chart\"><div class=\"chart-sky\" style=\"--fams:{part}\">" + join(families, "") + "</div>"
		+ "<ul class=\"chart-key\">" + join(key, "") + "</ul></div>"
}

// Which chapter the chart sets apart under its skyline, counted from one: the
// longest, when it is too long to stand in the skyline — more than eight rows
// of two — and none, as nought, when none is. Never more than one, because
// ./theme has one place under the skyline to put it, and a second chapter
// sent there is drawn over by the first rather than beside it.
func apartChapter(): Int {
	mut longest := 0
	mut size := 0
	mut part := 0
	for each chapter in slides.chapters() {
		part += 1
		if chapter.length > size {
			longest = part
			size = chapter.length
		}
	}
	if size > 16 { return longest }
	return 0
}

func chartTileView(idx: Int, slide: slides.Slide, lang: Str): ui.View {
	return ui.column([], [
		ui.link([], href("/{idx + 1}", lang), slideTitle(slide, lang)),
		ui.text([], "{idx + 1}"),
		symbolView(chart.symbol(slide.title)),
	])
}

func languageSwitcherView(lang: Str, path: Str): ui.View {
	mut enTone := ui.Tone.Normal()
	mut ptTone := ui.Tone.Normal()
	if lang == "pt" {
		ptTone = ui.Tone.Muted()
	} else {
		enTone = ui.Tone.Muted()
	}
	return ui.row([], [
		ui.link([ui.background(enTone)], href(path, "en"), "EN"),
		ui.link([ui.background(ptTone)], href(path, "pt"), "PT"),
	])
}

// The picture, above the code that draws it, on the slides that have one —
// and nothing at all on the rest.
//
// It answers with a vector rather than a View because there is no view that
// means "no view here": `ui.none` would still be a child, and a column with
// an empty child in it still spends a gap on it. An empty vector spends
// nothing, and the caller adds whatever came back.
//
// The picture is of a scene, and a scene is the one thing hive.ui cannot put
// in a document — but a *photograph* of one is an image, and an image is a
// widget the set has always had. ./shots says why it is a picture rather
// than the thing itself.
func shotView(slide: slides.Slide, lang: Str): ui.View[dyn] {
	if slide.shot == "" {
		return []
	}
	return [ui.column([], [
		ui.image([], slide.shot, shotAlt(lang)),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], shotCaption(lang)),
	])]
}

// The way to the compiler, under the explanation, on the slides that ask for
// one, and nothing on the rest.
func downloadViews(slide: slides.Slide, lang: Str): ui.View[dyn] {
	if slide.download {
		return [ui.row([], [downloadLinkView(lang), repoLinkView(lang)])]
	}
	return []
}

// The foot of a slide: the slide before and the slide after, either side of
// a stretch of the same line the track at the top is drawn with, this slide's
// station on it in amber. Neither end is a dead end: before the first slide
// is the front page and after the last is the contents.
func pagerView(idx: Int, all: slides.Slide[], lang: Str): ui.View {
	before := idx - 1
	after := idx + 1
	mut back := ui.link([], href("/", lang), tourTitle(lang))
	if all bounds before {
		back = ui.link([], href("/{idx}", lang), "{idx}. {slideTitle(all[before], lang)}")
	}
	mut on := ui.link([], href("/contents", lang), contentsLabel(lang))
	if all bounds after {
		on = ui.link([], href("/{idx + 2}", lang), "{idx + 2}. {slideTitle(all[after], lang)}")
	}
	return ui.row([], [back, ui.spacer(), on])
}

// The rules a slide teaches, each drawn as track by ./rail over the line of
// EBNF it was drawn from and a link to where the spec says it.
//
// They are folded away under the title, closed, behind one line that names
// them: the slide opens on its explanation and its programs, which are what
// a reader came for, and the grammar is one click away for whoever wants it.
// A slide teaching four rules used to open on four diagrams before a word of
// prose, and the Operators slide on nine. The fold is HTML's own `<details>`,
// which opens and closes without a script, and it and the figures inside it
// are written by hand because `hive.ui` has a widget for neither; what is
// inside each figure is views.
func rulesHtml(rules: grammar.Rule[], lang: Str): Str {
	if len(rules) == 0 {
		return ""
	}
	mut Str[dyn] figures = []
	mut Str[dyn] names = []
	for each r in rules {
		append(figures, "<figure class=\"rr\">" + ui.html(ruleView(r, lang)) + "</figure>")
		append(names, r.name)
	}
	return "<details class=\"tour-grammar\"><summary>" + escapeHtml(grammarLabel(lang))
		+ " <span>" + escapeHtml(join(names, ", ")) + "</span></summary>"
		+ "<div class=\"tour-rules\">" + join(figures, "") + "</div></details>"
}

func ruleView(r: grammar.Rule, lang: Str): ui.View {
	return ui.column([], [
		ui.row([], [
			ui.text([], r.name),
			ui.spacer(),
			ui.link([], grammar.specUrl() + grammar.anchor(r.section), specLabel(lang, r.section)),
		]),
		ui.row([], [rail.view(r.rows)]),
		ui.text([], r.ebnf),
	] + revisedViews(r, lang))
}

// Under a rule drawn from the compiler rather than copied from the
// specification, a line saying so — see ./grammar for which, and why.
func revisedViews(r: grammar.Rule, lang: Str): ui.View[dyn] {
	if r.revised {
		return [ui.text([ui.tone(ui.Tone.Muted())], revisedNote(lang, r.section))]
	}
	return []
}

// Every example a slide carries, one small labelled block per example. A
// slide with one example — most of them — shows no caption at all; a
// slide split into several shows what each one is about, so a big feature
// still arrives as several small, focused programs rather than one long
// one.
//
// On a slide, `runs` is true, and a program ./play says a browser can run
// gets the controls to run it under it. The front page passes false: it makes
// its case in programs a reader looks at, and ships no script to run them.
func examplesHtml(examples: slides.Example[], lang: Str, runs: Bool): Str {
	mut Str[dyn] blocks = []
	mut n := 0
	for each ex in examples {
		n += 1
		append(blocks, exampleHtml(ex, lang, n, runs))
	}
	return join(blocks, "")
}

func exampleHtml(ex: slides.Example, lang: Str, n: Int, runs: Bool): Str {
	mut caption := ex.caption
	if lang == "pt" {
		caption = ex.captionPt
	}
	mut captionHtml := ""
	if caption != "" {
		captionHtml = "<div class=\"tour-caption\">" + escapeHtml(caption) + "</div>"
	}
	code := exampleCode(ex, lang)
	if runs && play.runnable(code) {
		return "<div class=\"tour-example tour-play\">" + captionHtml + codeBlockHtml(code)
			+ runHtml(lang, n) + "</div>"
	}
	return "<div class=\"tour-example\">" + captionHtml + codeBlockHtml(code) + "</div>"
}

func exampleCode(ex: slides.Example, lang: Str): Str {
	if lang == "pt" {
		return ex.codePt
	}
	return ex.code
}

// Under a program a reader can run: the button, the button that puts the
// original back, a line saying what is happening, and the place what it
// prints goes. All of it is written hidden, so a page read without the script
// is exactly the page it always was, and only the script uncovers it.
//
// Every word the script will ever show is written here too, as data on the
// controls, so that the script carries no language of its own and the tour's
// two languages stay in the one file that has the rest of its words. `n`
// tells the samples on one slide apart, for the one id each needs: the
// sentence a screen reader is given about the keys.
func runHtml(lang: Str, n: Int): Str {
	says := dataAttr("lang", lang)
		+ dataAttr("label", editorLabel(lang))
		+ dataAttr("run", runLabel(lang))
		+ dataAttr("stop", stopLabel(lang))
		+ dataAttr("compiling", compilingNote(lang))
		+ dataAttr("running", runningNote(lang))
		+ dataAttr("output", outputCaption(lang))
		+ dataAttr("problems", problemsCaption(lang))
		+ dataAttr("refused", refusedCaption(lang))
		+ dataAttr("unreachable", unreachableNote(lang))
		+ dataAttr("stopped", stoppedNote(lang))
		+ dataAttr("slow", slowNote(lang))
		+ dataAttr("long", longNote(lang))
		+ dataAttr("silent", silentNote(lang))
		+ dataAttr("status", statusNote(lang))
	return "<div class=\"tour-run\" hidden" + says + ">"
		+ "<button type=\"button\" class=\"tour-run-go\">" + escapeHtml(runLabel(lang)) + "</button>"
		+ "<button type=\"button\" class=\"tour-run-reset\" hidden>" + escapeHtml(resetLabel(lang)) + "</button>"
		+ "<span class=\"tour-run-state\" role=\"status\">" + escapeHtml(editHint(lang)) + "</span>"
		+ "<span class=\"tour-run-keys\" id=\"tour-keys-{n}\">" + escapeHtml(keysHint(lang)) + "</span>"
		+ "</div><div class=\"tour-output\" hidden><div class=\"tour-caption\"></div><pre></pre></div>"
}

func dataAttr(name: Str, value: Str): Str {
	return " data-" + name + "=\"" + escapeAttr(value) + "\""
}

// The script, on a slide with anything for it to run, and nothing on one
// without: a slide of terminal sessions and windows is a page with no script
// on it at all.
func playScriptTag(examples: slides.Example[], lang: Str): Str {
	for each ex in examples {
		if play.runnable(exampleCode(ex, lang)) {
			return "<script src=\"" + play.scriptPath() + "\" defer></script>"
		}
	}
	return ""
}

// A slide's explanation, which carries the little markup prose needs and no
// more: a blank line between paragraphs, a list wherever lines open with
// "- ", and inside either, `code` and **bold**. Written out by hand for the
// reason the samples are: `hive.ui` has a text widget, and a paragraph with a
// name set in monospace in the middle of it is not one.
func proseHtml(text: Str): Str {
	mut Str[dyn] out = []
	for each para in split(text, "\n\n") {
		mut Str[dyn] words = []
		mut Str[dyn] items = []
		for each line in split(para, "\n") {
			if isItem(line) {
				if len(words) > 0 {
					append(out, "<p>" + inlineHtml(join(words, " ")) + "</p>")
					words = []
				}
				append(items, "<li>" + inlineHtml(itemText(line)) + "</li>")
			} else {
				if len(items) > 0 {
					append(out, "<ul>" + join(items, "") + "</ul>")
					items = []
				}
				append(words, line)
			}
		}
		if len(words) > 0 {
			append(out, "<p>" + inlineHtml(join(words, " ")) + "</p>")
		}
		if len(items) > 0 {
			append(out, "<ul>" + join(items, "") + "</ul>")
		}
	}
	return "<div class=\"tour-text\">" + join(out, "") + "</div>"
}

// The same text with its markup taken off, for the places that only take
// text: a page's description, read by a search engine or a link preview.
func plainText(text: Str): Str {
	unticked := join(split(text, "`"), "")
	unbolded := join(split(unticked, "**"), "")
	return join(split(unbolded, "\n- "), " ")
}

func isItem(line: Str): Bool {
	if indexOf(line, "- ") is Result.Ok(at) {
		return at == 0
	}
	return false
}

func itemText(line: Str): Str {
	cs := split(line, "")
	low := 2
	high := len(cs) - 1
	if cs bounds low && cs bounds high {
		return join(cs[low:high], "")
	}
	return ""
}

// `code`, **bold**, and everything else escaped. A code span opens with a
// run of backticks and closes at the next run exactly as long, so ``a `b` c``
// can hold a backtick; one space just inside each end is padding, dropped.
// A backtick with nothing to close it is a backtick.
func inlineHtml(s: Str): Str {
	cs := split(s, "")
	mut Str[dyn] out = []
	mut bold := false
	mut i := 0
	for ; i < len(cs); {
		if cs bounds i {
			c := cs[i]
			if c == "`" {
				run := tickRun(cs, i)
				close := closingRun(cs, i + run, run)
				if close >= 0 {
					append(out, "<code>" + escapeHtml(spanText(cs, i + run, close - 1)) + "</code>")
					i = close + run
					continue
				}
				for n := 0; n < run; n++ {
					append(out, "`")
				}
				i = i + run
				continue
			}
			if c == "*" && isStar(cs, i + 1) {
				if bold {
					append(out, "</strong>")
				} else {
					append(out, "<strong>")
				}
				bold = bold == false
				i = i + 2
				continue
			}
			append(out, escapeChar(c))
		}
		i = i + 1
	}
	if bold {
		append(out, "</strong>")
	}
	return join(out, "")
}

func isStar(cs: Str[], at: Int): Bool {
	if cs bounds at {
		return cs[at] == "*"
	}
	return false
}

// How many backticks in a row start at `from`.
func tickRun(cs: Str[], from: Int): Int {
	mut n := 0
	for at := from; at < len(cs); at++ {
		if cs bounds at {
			if cs[at] != "`" {
				return n
			}
		}
		n = n + 1
	}
	return n
}

// Where the next run of exactly `run` backticks starts, or -1.
func closingRun(cs: Str[], from: Int, run: Int): Int {
	mut at := from
	for ; at < len(cs); {
		n := tickRun(cs, at)
		if n == run {
			return at
		}
		if n > 0 {
			at = at + n
		} else {
			at = at + 1
		}
	}
	return -1
}

func spanText(cs: Str[], low: Int, high: Int): Str {
	mut Str[dyn] kept = []
	for at := low; at <= high; at++ {
		if cs bounds at {
			append(kept, cs[at])
		}
	}
	first := 0
	last := len(kept) - 1
	inner := 1
	innerLast := last - 1
	if kept bounds first && kept bounds last && kept bounds inner && kept bounds innerLast && inner <= innerLast {
		if kept[first] == " " && kept[last] == " " {
			return join(kept[inner:innerLast], "")
		}
	}
	return join(kept, "")
}

// Literal HTML, as the prose is: `hive.ui` has no monospaced,
// boxed text of its own, so a code example is written out by hand. The code
// itself never changes between languages — only its `//` comments do, in
// `codePt`.
//
// What it carries is two class names and no `style`. It used to be the other
// way round, with the whole appearance of a code block written inline right
// here, and that was the wrong place for it twice over: a stylesheet spelled
// out inside a Str is a stylesheet nobody can find when they come looking for
// why the samples look like that, and it is one no rule can override without
// `!important`. Both classes are answered for in ./theme.
//
// The sample goes through ./highlight rather than through `escapeHtml`, and
// the escaping goes with it: a painter that wrapped text in spans and left
// somebody else to escape it would have to be trusted to hand back the two
// jobs in the right order, and there is no order that works — escape first
// and the spans are escaped too, escape after and the markup is. So the one
// pass that decides where a span goes is the one that escapes what is inside
// it, and this line has nothing left to do but name the element.
func codeBlockHtml(code: Str): Str {
	return "<pre class=\"tour-code\"><code>" + highlight.html(code) + "</code></pre>"
}

func escapeChar(c: Str): Str {
	if c == "&" { return "&amp;" }
	else if c == "<" { return "&lt;" }
	else if c == ">" { return "&gt;" }
	return c
}

func escapeHtml(s: Str): Str {
	return join(map(split(s, ""), escapeChar), "")
}

// The same three, plus the quote that would otherwise end the attribute
// this text is sitting inside. Every `content=` and every `href=` this
// program writes by hand goes through here.
func escapeAttrChar(c: Str): Str {
	if c == "\"" { return "&quot;" }
	return escapeChar(c)
}

func escapeAttr(s: Str): Str {
	return join(map(split(s, ""), escapeAttrChar), "")
}

// ---------------------------------------------------------------------------
// The small, reusable pieces of interface text — everything that is not
// part of one particular slide.

func tourTitle(lang: Str): Str {
	if lang == "pt" { return "O Tour do Hive" }
	return "The Hive Tour"
}

func pageTitleSuffix(lang: Str): Str {
	if lang == "pt" { return " — O Tour do Hive" }
	return " — The Hive Tour"
}

// What the mark is, for whoever is not being shown it. The name is right
// beside it in either language, so what is left to say is the picture.
func logoAlt(lang: Str): Str {
	if lang == "pt" { return "O logo do Hive: uma abelha sobre um favo de mel" }
	return "The Hive logo: a bee on a honeycomb"
}

func homePageTitle(lang: Str): Str {
	if lang == "pt" { return "Hive — um tour pela linguagem" }
	return "Hive — a tour of the language"
}

// The landing page's own sentence, written rather than taken from the
// prose above it. It is the one description here worth a second pass: it is
// what a search result for the language itself shows, and what a link to
// the tour unfurls into everywhere it is pasted.
func homeDescription(lang: Str): Str {
	if lang == "pt" {
		return "Um tour interativo pelo Hive: uma linguagem compilada sem exceções em tempo de execução, que roda no desktop, no servidor, no navegador e no Android, e é pequena o bastante para se aprender em um dia."
	}
	return "An interactive tour of Hive: a compiled language with no runtime exceptions that runs on desktop, server, browser and Android, small enough to learn in a day."
}

func notFoundPageTitle(lang: Str): Str {
	if lang == "pt" { return "Página não encontrada — O Tour do Hive" }
	return "Not found — The Hive Tour"
}

func slideProgress(idx: Int, total: Int, lang: Str): Str {
	if lang == "pt" { return "Slide {idx + 1} de {total}" }
	return "Slide {idx + 1} of {total}"
}

// What the contents page is called, in the running head, on the page itself,
// and in the tab. One word doing three jobs, so it is the same word in all
// three places rather than a heading, a link label and a title that drift.
func contentsLabel(lang: Str): Str {
	if lang == "pt" { return "Sumário" }
	return "Contents"
}

func contentsDescription(lang: Str): Str {
	if lang == "pt" {
		return "Todos os recursos do tour da linguagem Hive, em ordem, cada um em uma página."
	}
	return "Every feature in the Hive language tour, in order, one to a page."
}

func startTourLabel(lang: Str): Str {
	if lang == "pt" { return "Começar o tour" }
	return "Start the tour"
}

func downloadLabel(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador" }
	return "Download the compiler"
}

// The playground's words: its controls, what it says beside them while a
// program compiles and runs, the captions over what comes back, and the
// sentences the server answers with when it does not build one. ./play holds
// the words for a program a browser cannot run, because it holds the list.

func editorLabel(lang: Str): Str {
	if lang == "pt" { return "O programa" }
	return "The program"
}

func runLabel(lang: Str): Str {
	if lang == "pt" { return "Rodar" }
	return "Run"
