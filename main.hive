func stoppedNote(lang: Str): Str {
	if lang == "pt" { return "Parado." }
	return "Stopped."
}

func slowNote(lang: Str): Str {
	if lang == "pt" { return "Parado depois de dez segundos." }
	return "Stopped after ten seconds."
}

func longNote(lang: Str): Str {
	if lang == "pt" { return "Parado: é mais do que esta página comporta." }
	return "Stopped: that is more than this page will hold."
}

func silentNote(lang: Str): Str {
	if lang == "pt" { return "Não imprimiu nada." }
	return "It printed nothing."
}

// Followed by the number and a full stop, by the script.
func statusNote(lang: Str): Str {
	if lang == "pt" { return "Terminou com o código" }
	return "It exited with status"
}

func notFromPageNote(lang: Str): Str {
	if lang == "pt" { return "Programas são rodados a partir das páginas do próprio tour." }
	return "Programs are run from the tour's own pages."
}

func tooLongNote(lang: Str): Str {
	if lang == "pt" { return "Esse programa é maior do que esta página compila: no máximo sessenta e quatro kilobytes." }
	return "That program is longer than this page will compile: sixty-four kilobytes at most."
}

func busyNote(lang: Str): Str {
	if lang == "pt" { return "O compilador está ocupado com o programa de outra pessoa. Tente de novo em instantes." }
	return "The compiler is busy with somebody else's program. Try again in a moment."
}

func timedOutNote(lang: Str): Str {
	if lang == "pt" { return "O compilador levou mais de trinta segundos e foi interrompido." }
	return "The compiler took longer than thirty seconds, and was stopped."
}

func brokenNote(lang: Str): Str {
