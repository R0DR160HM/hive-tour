	return "The compiler could not be started on this server."
}

func featuresCount(lang: Str, n: Int): Str {
	if lang == "pt" { return "{n} recursos, um por vez" }
	return "{n} features, one at a time"
}

// What the contents says about the tiles it shows in a deeper shade. It is
// said once, here, rather than left for a reader to work out from the picture.
func visitedHint(lang: Str): Str {
	if lang == "pt" { return "Os que você já leu aparecem em um tom mais forte." }
	return "The ones you have read are shown in a deeper shade."
}

// The switch to each scheme, as it reads in the running head, and the line
// that says what it does when the pointer rests on it. Only one of the two is
// ever shown — the one that is not the scheme on screen — and ./theme decides
// which.
func themeLabel(lang: Str, theme: Str): Str {
	if theme == "dark" {
		if lang == "pt" { return "Escuro" }
		return "Dark"
	}
	if lang == "pt" { return "Claro" }
	return "Light"
}

func themeHint(lang: Str, theme: Str): Str {
	if theme == "dark" {
		if lang == "pt" { return "Mudar para o tema escuro" }
		return "Switch to the dark theme"
	}
	if lang == "pt" { return "Mudar para o tema claro" }
	return "Switch to the light theme"
}

// What the line under a revised rule says: that it is drawn from the
// compiler, and that the specification's own version of it is behind.
func revisedNote(lang: Str, section: Str): Str {
	if lang == "pt" { return "Como o compilador lê; o §{section} da especificação está desatualizado aqui." }
	return "As the compiler reads it; §{section} of the specification is out of date here."
}

// What the fold the drawn rules sit behind is called, before their names.
func grammarLabel(lang: Str): Str {
	if lang == "pt" { return "Gramática:" }
	return "Grammar:"
}

// Under a drawn rule, where in the specification it comes from.
func specLabel(lang: Str, section: Str): Str {
	if lang == "pt" { return "Especificação §{section}" }
	return "Specification §{section}"
}

// Whichever of a pair of texts is in the language being read. ./home keeps
// its prose as fields side by side, the way ./slides does, and this is the
// one place that chooses between them.
func inLang(lang: Str, en: Str, pt: Str): Str {
	if lang == "pt" { return pt }
	return en
}

// What the picture is, for whoever is not being shown it, and what it says
// under itself to everybody else. Both are deliberately about *where* the
// picture came from rather than what is in it: a reader who cannot see it is
// better served by knowing this is a photograph of a real window running the
// code above than by a list of the coloured shapes in it, which the code
// beside it already spells out in full.
func shotAlt(lang: Str): Str {
	if lang == "pt" {
		return "Uma janela do hive.ui rodando o exemplo acima, fotografada"
	}
	return "A hive.ui window running the example above, photographed"
}

func shotCaption(lang: Str): Str {
	if lang == "pt" {
		return "Desenhado pelo hive.ui, em uma janela"
	}
	return "Drawn by hive.ui, in a window"
}

func notFoundText(lang: Str): Str {
	if lang == "pt" { return "Esse slide não existe." }
	return "That slide does not exist."
}
