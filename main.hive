func stopLabel(lang: Str): Str {
	if lang == "pt" { return "Parar" }
	return "Stop"
}

func resetLabel(lang: Str): Str {
	if lang == "pt" { return "Voltar ao original" }
	return "Put the original back"
}

func editHint(lang: Str): Str {
	if lang == "pt" { return "Dá para editar este programa e rodá-lo aqui." }
	return "You can edit this program and run it here."
}

func keysHint(lang: Str): Str {
	if lang == "pt" { return "Tab indenta, Esc sai do programa e Ctrl+Enter o roda." }
	return "Tab indents, Escape leaves the program, and Ctrl+Enter runs it."
}

func compilingNote(lang: Str): Str {
	if lang == "pt" { return "Compilando…" }
	return "Compiling…"
}

func runningNote(lang: Str): Str {
	if lang == "pt" { return "Rodando…" }
	return "Running…"
}

func outputCaption(lang: Str): Str {
