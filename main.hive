// The Hive Tour — an HTTP server that walks through the language one
// feature at a time, in the spirit of an interactive language tour. Every
// slide is one `Slide` value: a title, an explanation, and one or more
// code examples — each a complete, runnable program in its own right, kept
// small enough that one example makes one point. `handle` reads
// the slide number out of the URL, `hive.net.httpServe` does the rest.
//
// The interface is built with `hive.ui`: the sidebar, the heading, the
// explanation and the prev/next links are all `View`s, rendered by
// `ui.page`. The one thing the widget set has no answer for is a
// monospaced, boxed code sample, so that alone is written as literal HTML
// and spliced into the page in place of a marker view — everything else
// stays a view all the way down.
import hive.ui

type Example {
	caption: Str
	code:    Str
}

type Slide {
	title:       Str
	explanation: Str
	examples:    Example[dyn]
}

proc main(): void {
	echo "The Hive Tour: http://localhost:8080"
	hive.net.httpServe(8080, handle)
}

proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	if request.url == "/" {
		return homeResponse()
	}

	all := slides()
	if request.url is "/{n}" {
		parsed := hive.conv.sti(n)
		if parsed is Result.Ok(num) {
			idx := num - 1
			if all bounds idx {
				slide := all[idx]
				return renderSlide(slide, idx, all)
			}
		}
	}
	return notFoundResponse()
}

// ---------------------------------------------------------------------------
// Rendering

// The one View a page never keeps: a stand-in for the code examples, so
// they can be rendered once inside `ui.page` and then found again in the
// HTML that comes back. Its rendering has no attributes at all, so it
// always comes back exactly as `codeMarkerTag` says, whatever the renderer
// does.
func codeMarker(): Str {
	return "HIVE_TOUR_CODE_SAMPLE"
}

func codeMarkerView(): ui.View {
	return ui.text([], codeMarker())
}

func codeMarkerTag(): Str {
	return "<span class=\"h-text\">" + codeMarker() + "</span>"
}

func renderSlide(slide: Slide, idx: Int, all: Slide[]): hive.net.HttpResponse {
	total := len(all)
	top := ui.row([], [sidebarView(all, idx), headerColumn(slide, idx, total)])
	page := ui.page(slide.title + " — The Hive Tour", top)
	spliced := examplesHtml(slide.examples) + ui.html(bottomView(slide, idx, total))
	body := join(split(page, codeMarkerTag()), spliced)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// The landing page: what Hive is, in the same layout every slide uses, so
// the sidebar is already there to jump into wherever looks interesting —
// or `/1` picks it up from the beginning.
func homeResponse(): hive.net.HttpResponse {
	all := slides()
	content := ui.column([ui.gap(20), ui.pad(40), ui.grow(1), ui.width(680)], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"A tour of the language"),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Hive"),
		ui.text([], "Hive is a memory-managed, table-based language. Tables are a built-in idea rather than a library, values behave like values, and a good deal of what other languages leave to runtime — every vector index, every branch of a match, the columns a SQL query comes back with — is settled at compile time instead."),
		ui.text([], "This very page is the proof: it is served by an HTTP server written in Hive, and its interface below the code samples is built entirely out of hive.ui views. There is no framework underneath either of them — both are the standard library, and neither is a dependency this program had to ask for."),
		highlightsView(),
		ui.row([ui.gap(16), ui.align(ui.Align.Center())], [
			ui.link([ui.background(ui.Tone.Good())], "/1", "Start the tour →"),
			ui.link([], releaseUrl(), "Download the compiler"),
			ui.text([ui.tone(ui.Tone.Muted())], "{len(all)} features, one at a time"),
		]),
	])
	top := ui.row([], [sidebarView(all, -1), content])
	body := ui.page("Hive — a tour of the language", top)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// The one URL this program ever links outside itself: GitHub's own
// `/releases/latest` redirect, so the link never has to know a version
// number and never goes stale as new releases ship.
func releaseUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang/releases/latest"
}

func downloadLinkView(): ui.View {
	return ui.link([ui.background(ui.Tone.Good())], releaseUrl(), "Download the compiler →")
}

func highlightRow(text: Str): ui.View {
	return ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
		ui.icon([ui.tone(ui.Tone.Good())], ui.Icon.Check()),
		ui.text([], text),
	])
}

func highlightsView(): ui.View {
	return ui.column([ui.gap(8)], [
		highlightRow("One executable — nothing else to install, no runtime to configure"),
		highlightRow("Every vector index and slice proved in range at compile time"),
		highlightRow("Tables are a built-in type, not a library import"),
		highlightRow("HTTP, WebSockets, SQL, crypto, a UI and distributed actors — all in the standard library"),
		highlightRow("Values behave like values: two names never observe each other's writes, unless both say mut"),
	])
}

func notFoundResponse(): hive.net.HttpResponse {
	all := slides()
	content := ui.column([ui.pad(60), ui.align(ui.Align.Center()), ui.gap(12), ui.grow(1)], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "404"),
		ui.text([ui.tone(ui.Tone.Muted())], "That slide does not exist."),
		ui.link([ui.background(ui.Tone.Good())], "/1", "Start the tour"),
	])
	top := ui.row([], [sidebarView(all, -1), content])
	body := ui.page("Not found — The Hive Tour", top)
	return hive.net.HttpResponse(404, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// The list of every slide, down the left, under a link back to the home
// screen. The current one is picked out with a muted background —
// `ui.background`, not a class of our own, since the tone it takes is one
// `hive.ui`'s own stylesheet already knows. `idx` of `-1` — the home page
// and the 404 page both pass it — highlights none of them.
func sidebarView(all: Slide[], idx: Int): ui.View {
	mut ui.View[dyn] items = []
	for i := 0; i < len(all); i++ {
		item := all[i]
		mut highlight := ui.Tone.Normal()
		if i == idx {
			highlight = ui.Tone.Muted()
		}
		link := ui.link([ui.background(highlight)], "/{i + 1}", "{i + 1}. {item.title}")
		append(items, link)
	}
	home := ui.link([ui.size(ui.TextSize.Subtitle())], "/", "The Hive Tour")
	return ui.column(
		[ui.width(260), ui.pad(24), ui.gap(2), ui.scroll(ui.Axis.Vertical())],
		[home] + items,
	)
}

// The slide's own column: where it sits in the tour, its title, and then
// the marker the code examples land on once the page has been rendered.
func headerColumn(slide: Slide, idx: Int, total: Int): ui.View {
	titleGroup := ui.column([ui.gap(6)], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"Slide {idx + 1} of {total}"),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], slide.title),
	])
	return ui.column([ui.gap(24), ui.pad(40), ui.grow(1)], [titleGroup, codeMarkerView()])
}

// What follows the code examples: the explanation, one paragraph per view
// so each wraps on its own, a download link on the tour's last slide, and
// the prev/next pager. Rendered separately with `ui.html` and spliced in
// right after the examples, so it still ends up inside the same column the
// header opened.
func bottomView(slide: Slide, idx: Int, total: Int): ui.View {
	mut ui.View[dyn] blocks = []
	for each para in split(slide.explanation, "\n\n") {
		append(blocks, ui.text([], para))
	}
	if idx + 1 == total {
		append(blocks, downloadLinkView())
	}

	mut prevNode := ui.text([ui.tone(ui.Tone.Muted())], "← Prev")
	if idx > 0 {
		prevNode = ui.link([], "/{idx}", "← Prev")
	}
	mut nextNode := ui.text([ui.tone(ui.Tone.Muted())], "Next →")
	if idx + 1 < total {
		nextNode = ui.link([], "/{idx + 2}", "Next →")
	}
	pager := ui.row([ui.justify(ui.Justify.Between())], [prevNode, nextNode])
	append(blocks, pager)
	return ui.column([ui.gap(16)], blocks)
}

// Every example a slide carries, one small labelled block per example. A
// slide with one example — most of them — shows no caption at all; a
// slide split into several shows what each one is about, so a big feature
// still arrives as several small, focused programs rather than one long
// one.
func examplesHtml(examples: Example[]): Str {
	mut Str[dyn] blocks = []
	for each ex in examples {
		append(blocks, exampleHtml(ex))
	}
	return join(blocks, "")
}

func exampleHtml(ex: Example): Str {
	mut caption := ""
	if ex.caption != "" {
		caption = "<div style=\"font-size:12px;color:var(--muted);margin:0 0 6px;"
			+ "text-transform:uppercase;letter-spacing:.04em\">" + escapeHtml(ex.caption) + "</div>"
	}
	return "<div style=\"margin-bottom:20px\">" + caption + codeBlockHtml(ex.code) + "</div>"
}

// The one piece of literal HTML on the page: `hive.ui` has no monospaced,
// boxed text of its own, so a code example is written out by hand. It
// still leans on the theme `ui.page` already put in the document —
// `var(--surface)` and `var(--line)` — so it stays in step with light and
// dark mode without a stylesheet of its own.
func codeBlockHtml(code: Str): Str {
	return "<pre style=\"background:var(--surface);border:1px solid var(--line);"
		+ "border-radius:8px;padding:16px 18px;overflow-x:auto;font-size:13.5px;"
		+ "line-height:1.5;margin:0\"><code style=\"font-family:'SFMono-Regular',"
		+ "Consolas,Menlo,monospace\">" + escapeHtml(code) + "</code></pre>"
}

func escapeChar(c: Str): Str {
	if c == "&" { return "&amp;" }
	else if c == "<" { return "&lt;" }
	else if c == ">" { return "&gt;" }
	return c
}

func escapeHtml(s: Str): Str {
	return join(map(split(s, ""), escapeChar), "")
}

// ---------------------------------------------------------------------------
// The content of the tour, one feature at a time. Every code example below
// is a complete program: copy it into a `.hive` file and `hive run` it.

func slides(): Slide[37] {
	return [
		Slide(
			"Hello, World",
			"Every Hive program starts at proc main(): void, in the file handed to `hive run` or `hive build`. echo prints a value and appends a newline, converting whatever it is given to text the way it would be shown.",
			[Example("", `proc main(): void {
	echo "it works"
}`)],
		),
		Slide(
			"Comments",
			"A comment runs from // to the end of the line, and nothing more. There is no block comment form in Hive itself — inside a query body, which is SQL rather than Hive, SQL's own -- and /* */ are recognised instead.",
			[Example("", `proc main(): void {
	// A comment. The whole line, and nothing of the next.
	x := 1 // ...or the tail of one.
	echo x
}`)],
		),
		Slide(
			"Names have shapes",
			"A name's spelling says what it is, and each shape is enforced where the name is declared. camelCase names variables, parameters, fields and every proc/func/query. PascalCase names types, their variants, and atoms. UPPER_CASE is how a constant is written: a variable nothing reassigns. Keywords are lower case, and only lower case — a keyword spelled in another casing, like Proc or IF, is a compile error naming both readings rather than a usable identifier.",
			[Example("", `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: a variable
	MAX_RETRIES := 5          // UPPER_CASE: a constant
	shape := Shape.Circle(4)  // PascalCase: a type and its variant

	echo "{name}, retry up to {MAX_RETRIES} times, shape={shape}"
}`)],
		),
		Slide(
			"Variables and constants",
			":= infers a type from the value, including a static vector length. A type written out front with = states it instead, which is the only way to say [dyn], or to give a value nothing else says the shape of somewhere to land. A binding is immutable unless it says mut, and a mut variable may never be spelled UPPER_CASE — that shape is reserved for something nothing reassigns.",
			[Example("", `proc main(): void {
	x := 1                     // inferred, immutable
	mut count := 0              // inferred, reassignable
	mut Str[dyn] rows = []       // annotated: says "dynamic"
	MAX := 100                  // a constant, by its shape alone

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`)],
		),
		Slide(
			"Scalar types",
			"Str holds UTF-8 text. Int is a 64-bit signed integer whose overflow wraps silently. Float is a 64-bit float. Bool is true or false. Atom is an interned symbol, written #Name — a label, not a condition, so `if flag` is a compile error when flag is an Atom. void is a return type only; there is no void value, field or element. There is no implicit numeric widening anywhere: an Int never becomes a Float on its own.",
			[Example("", `proc main(): void {
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "{name} {count} {weight} {ready} {state}"
}`)],
		),
		Slide(
			"Strings",
			"A double-quoted string interpolates with \{expression} and escapes with \\n, \\t, \\\", \\\\, and \\\{ for a literal brace. A backtick string is raw: no escapes and no interpolation at all, so it is the natural way to hold a block of text — or, as on this very page, a block of Hive source — untouched. Its indentation is stripped at compile time down to the shortest common margin.",
			[
				Example("Interpolation and escapes", `proc main(): void {
	name := "bee"
	echo "hello, {name}!"       // interpolated
	echo "a literal brace: \{" // escaped
}`),
				Example("Raw strings", `proc main(): void {
	raw := `+"`"+`
		line one
		line two
	`+"`"+`
	echo raw
}`),
			],
		),
		Slide(
			"Vectors",
			"A vector is memory-contiguous and homogeneous. Str[3] is static: exactly three, always. Str[dyn] is dynamic: it promises nothing about its length and is the only kind append works on. Str[] is a parameter-only spelling that accepts either. A variable or field must say which of the two real kinds it holds — that promise is what the bounds checker rests on. + concatenates into a new vector; == compares structurally, element by element.",
			[Example("", `proc main(): void {
	v := ["a", "b", "c"]          // Str[3] — a static length, inferred
	mut Str[dyn] w = ["a", "b"]    // dynamic — the only kind append accepts
	append(w, "c")

	first := v[0]
	middle := v[0:1]                // slicing, both bounds inclusive
	echo "{first} {middle} {w}"
}`)],
		),
		Slide(
			"Builtins",
			"These are always in scope, with no import needed. len counts a vector's elements or a Str's characters; bytes counts a vector's backing storage or a Str's UTF-8 bytes. append and prepend grow a mutable dynamic vector at either end; drop removes a range and hands back exactly what it removed. join concatenates a vector of Str with a separator between each pair, and split is its inverse. indexOf finds the first equal element and, unlike a bare -1, an Ok index is always safe to use unguarded. row and column pull a Table's row or column by its first cell or its top cell. map, filter and filterMap each walk a vector with a func — map transforms every element, filter keeps the ones a predicate says yes to, filterMap does both in one pass — and sort puts a vector in order, in place when it stands alone as a statement over a mut vector.\n\nA declaration of your own — a func, proc, query or type sharing one of these names — wins over the builtin at every bare call, which stays reachable as hive.<name>.",
			[
				Example("Length and bytes", `proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	echo len(fruit)
	echo bytes("café")
}`),
				Example("Growing and shrinking", `proc main(): void {
	mut Str[dyn] basket = ["pear"]
	append(basket, "apple")
	prepend(basket, "kiwi")
	echo basket

	if basket bounds 0 {
		echo drop(basket, 0, 0)
	}
	echo basket
}`),
				Example("Joining, splitting and finding", `proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	line := join(fruit, ", ")
	echo split(line, ", ")

	if indexOf(fruit, "apple") is Result.Ok(i) {
		echo fruit[i]
	}
}`),
				Example("Walking a vector", `func isLong(fruit: Str): Bool {
	return len(fruit) > 4
}

func evenHalf(n: Int): Result<Int, Bool> {
	if n % 2 == 0 { return Result.Ok(n / 2) }
	return Result.Error(false)
}

proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	echo map(fruit, isLong)
	echo filter(fruit, isLong)
	echo filterMap([1, 2, 3, 4], evenHalf)
	echo sort(fruit)
}`),
				Example("Tables", `proc main(): void {
	table := [["name", "role"], ["ada", "engineer"], ["grace", "admiral"]]
	echo row(table, "ada")
	echo column(table, "role")
}`),
			],
		),
		Slide(
			"Bounds, proved at compile time",
			"A dedicated flow-sensitive pass proves every index and slice in range before the program ever runs. A literal index into a known length compiles outright; a computed index has to sit under a guard the pass can read, such as `if v bounds i \{ v[i] }` — sugar for `i >= 0 && i < len(v)`. Anything the pass cannot prove safe is a compile error, not a runtime panic — `echo v[len(v) - 1]` on its own is rejected outright, computed index and all. This very server leans on it: the slide number from the URL is checked with exactly this guard before it ever indexes the list of slides.",
			[Example("", `proc main(): void {
	v := ["a", "b", "c"]

	last := len(v) - 1
	if v bounds last {
		echo v[last]                 // fine — the guard covers it
	}
}`)],
		),
		Slide(
			"Tables and CSV",
			"Table is an alias for Str[dyn][dyn]: a vector of rows of cells. It is what `using` yields from a CSV, what a raw SQL query answers with, and what hive.map.toTable builds. A bare `using \"path\"` reads a comma-separated file; adding `as csv separating by \"<sep>\"` picks a different delimiter, such as a tab for a TSV — and every form answers with a Result, so the source says exactly which reader the build needs to link in.",
			[Example("", `proc main(): void {
	hive.file.write("./tour.csv", "name,role\nada,engineer\ngrace,admiral\n")

	csv := using "./tour.csv"
	if csv is Result.Ok(table) {
		if len(table) > 1 {
			echo table[1:]   // every row after the header
		}
	}
}`)],
		),
		Slide(
			"Result<T, E>",
			"Result is the language's one built-in generic union, and it is how every fallible operation reports itself: Result.Ok(value) or Result.Error(payload). Matching both variants with `is` is exhaustive, which lets a function written over a Result skip a dead else branch entirely.",
			[Example("", `func half(n: Int): Result<Int, Str> {
	if n % 2 == 0 { return Result.Ok(n / 2) }
	return Result.Error("not even")
}

proc main(): void {
	if half(4) is Result.Ok(v)      { echo v }
	else if half(4) is Result.Error(why) { echo why }
}`)],
		),
		Slide(
			"Declared types",
			"A type with no variants is a struct; with variants, a tagged union. A field declared outside any variant is added to every variant. A value is built by calling the type or the variant: User(1, \"ada\"), Shape.Circle(5). There is no subtyping and no interface — a variant is a way of building and matching a union, not a type of its own.",
			[
				Example("A struct", `type User {
	id:   Int
	name: Str
}

proc main(): void {
	u := User(1, "ada")
	echo u.name
}`),
				Example("A tagged union", `type Shape {
	Circle    { radius: Int }
	Rectangle { width: Int, height: Int }
	Point
}

proc main(): void {
	p := Shape.Circle(5)
	echo p
}`),
			],
		),
		Slide(
			"Pattern matching with is",
			"`is` checks a value against a pattern and yields a Bool, narrowing it and binding names usable right away — in the rest of the condition after &&, and in the branch body. There is no match statement; every match is an ordinary if/else if chain. Four kinds of pattern exist: a variant, a Result, a vector matched positionally with an optional ...rest, and a string template whose \{holes} bind the text between literal pieces.",
			[
				Example("Variant patterns", `type Shape {
	Circle    { radius: Int }
	Rectangle { width: Int, height: Int }
}

proc main(): void {
	shape := Shape.Circle(4)
	if shape is Shape.Circle(r)            { echo "circle, r={r}" }
	else if shape is Shape.Rectangle(w, _) { echo "rect, w={w}" }
}`),
				Example("Vector patterns", `proc main(): void {
	command := ["move", "north", "2"]
	if command is ["move", dir, ...steps] { echo "{dir}, {len(steps)} more" }
	else if command is ["stop"]           { echo "halt" }
}`),
				Example("String patterns", `proc main(): void {
	path := "/users/42/posts/7"
	if path is "/users/{id}/posts/{postId}" { echo "{id} / {postId}" }
}`),
			],
		),
		Slide(
			"func vs proc",
			"Both may perform I/O — echo, using, hive.net are all fine in either. The difference is what each may touch: a func cannot declare a mutex parameter (v: mut T) and cannot call a proc, so it can never write to storage its caller can see. A proc may do everything a func may, plus hold a mutex and call other procs. Programs start at proc main(): void. Nothing about the declaration says how a call runs — that is decided entirely at the call site.",
			[
				Example("func: cannot touch the caller's storage", `func greet(name: Str): Str {
	return "hey {name}!"
}

proc main(): void {
	echo greet("ada")
}`),
				Example("proc: may hold a mutex", `proc grow(vec: mut Str[dyn], tag: Str): void {
	append(vec, tag)
}

proc main(): void {
	mut Str[dyn] tags = ["bee"]
	grow(tags, "hive")
	echo tags
}`),
			],
		),
		Slide(
			"First-class functions",
			"A callable is a value: a bare name on its own (f := takes) or a partial application with _ holes (handler(_, db)), each hole becoming a parameter in order. A func value may be used where a proc is expected, never the reverse. Three things cannot become values: a generic callable, one with a mutex parameter, and one with a statically-sized parameter beyond a single immutable binding.",
			[
				Example("A bare reference, and map", `func double(n: Int): Int { return n * 2 }

proc main(): void {
	f := double
	echo "{f(21)} {map([1, 2, 3], double)}"
}`),
				Example("Partial application", `func add(a: Int, b: Int): Int { return a + b }

proc main(): void {
	addFive := add(5, _)   // _ becomes the parameter
	echo addFive(10)
}`),
			],
		),
		Slide(
			"Mutability and value semantics",
			"Variables are immutable unless marked mut. Vectors, tables, maps and the declared types built from them are value types: two names for one value never observe each other's writes — unless both are mut, which is how sharing is opted into. A mutex parameter (v: mut T) is the one place storage crosses a call boundary on purpose, and only a proc may declare one; whether a call shares the caller's storage or a copy depends on whether the caller waits for it there or fires it with async.",
			[Example("", `proc main(): void {
	mut Str[dyn] a = ["x", "y"]
	mut Str[dyn] b = a       // an alias: two names, one header
	append(b, "z")            // len(a) is now 3 too
	echo a

	b = ["replaced"]          // rebinding one rebinds both
	echo a
}`)],
		),
		Slide(
			"Concurrency",
			"Every call blocks its caller by default — there is no async func, no Future. What a call means is decided where it is written: f(x) waits; async f(x) fires and forgets; x := async f(x) starts it and waits only when x is read; await [f(a), f(b)] starts every call on its own thread and is one barrier resolving to a fully-typed vector. hive.task.sleep(ms) parks only the calling thread, which is why two sleeps started together finish in about the longer one rather than the sum. Any wait can be bounded with `with timeout <ms>`, turning the result into a Result rather than a crash.",
			[
				Example("Starting work and waiting for it", `proc slow(label: Str, ms: Int): Str {
	hive.task.sleep(ms)
	return label
}

proc main(): void {
	a := async slow("a", 30)      // starts now
	b := async slow("b", 30)      // starts now, alongside
	echo "{a} and {b}"             // waits for both, right here
}`),
				Example("Bounding a wait", `proc slow(label: Str, ms: Int): Str {
	hive.task.sleep(ms)
	return label
}

proc main(): void {
	if slow("c", 300) with timeout 50 is Result.Error(err) {
		echo "gave up after {err.waited}ms"
	}
}`),
