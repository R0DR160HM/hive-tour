// The Hive Tour — an HTTP server that walks through the language one
// feature at a time, in the spirit of an interactive language tour. Every
// slide is one `Slide` value: a title, an explanation, and one or more
// code examples — each a complete, runnable program in its own right, kept
// small enough that one example makes one point. Every piece of prose
// carries an English and a Portuguese version side by side; the code never
// does, because code is not prose. `handle` reads the slide number and the
// chosen language out of the URL, `hive.net.httpServe` does the rest.
//
// The interface is built with `hive.ui`: the sidebar, the heading, the
// explanation and the prev/next links are all `View`s, rendered by
// `ui.page`. The one thing the widget set has no answer for is a
// monospaced, boxed code sample, so that alone is written as literal HTML
// and spliced into the page in place of a marker view — everything else
// stays a view all the way down.
import hive.ui

type Example {
	caption:   Str
	captionPt: Str
	code:      Str
	codePt:    Str
}

type Slide {
	title:         Str
	titlePt:       Str
	explanation:   Str
	explanationPt: Str
	examples:      Example[dyn]
}

proc main(): void {
	echo "The Hive Tour: http://localhost:8080"
	hive.net.httpServe(8080, handle)
}

proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	path := requestPath(request.url)
	lang := requestLang(request.url)

	if path == "/" {
		return homeResponse(lang)
	}

	all := slides()
	if path is "/{n}" {
		parsed := hive.conv.sti(n)
		if parsed is Result.Ok(num) {
			idx := num - 1
			if all bounds idx {
				slide := all[idx]
				return renderSlide(slide, idx, all, lang)
			}
		}
	}
	return notFoundResponse(lang, path)
}

// The path and the query string travel together in `request.url` — a GET
// to "/3?lang=pt" arrives as exactly that one Str. Splitting on "?" is the
// whole of parsing either back out: `split` never yields zero pieces, so
// the path half is always there, and the query half is only there to ask
// about when a "?" showed up at all.
func requestPath(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 0 {
		return parts[0]
	}
	return url
}

// The only query parameter this server reads. Not a real query-string
// parser — it doesn't need to be one, since this program is the only thing
// that ever writes a `?lang=` into one of its own links.
func requestLang(url: Str): Str {
	parts := split(url, "?")
	if parts bounds 1 {
		if indexOf(parts[1], "lang=pt") is Result.Ok(_) {
			return "pt"
		}
	}
	return "en"
}

// ---------------------------------------------------------------------------
// Rendering

// The one View a page never keeps: a stand-in for the code examples, so
// they can be rendered once inside `ui.page` and then found again in the
// HTML that comes back. Its rendering has no attributes at all, so it
// always comes back exactly as `codeMarkerTag` says, whatever the renderer
// does.
func codeMarker(): Str {
	return "HIVE_TOUR_CODE_SAMPLE"
}

func codeMarkerView(): ui.View {
	return ui.text([], codeMarker())
}

func codeMarkerTag(): Str {
	return "<span class=\"h-text\">" + codeMarker() + "</span>"
}

func renderSlide(slide: Slide, idx: Int, all: Slide[], lang: Str): hive.net.HttpResponse {
	total := len(all)
	path := "/{idx + 1}"
	top := ui.row([], [sidebarView(all, idx, lang, path), headerColumn(slide, idx, total, lang)])
	page := ui.page(slideTitle(slide, lang) + pageTitleSuffix(lang), top)
	spliced := examplesHtml(slide.examples, lang) + ui.html(bottomView(slide, idx, total, lang, path))
	body := join(split(page, codeMarkerTag()), spliced)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"]], body)
}

func slideTitle(slide: Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.titlePt
	}
	return slide.title
}

func slideExplanation(slide: Slide, lang: Str): Str {
	if lang == "pt" {
		return slide.explanationPt
	}
	return slide.explanation
}

// The landing page: what Hive is, in the same layout every slide uses, so
// the sidebar is already there to jump into wherever looks interesting —
// or `/1` picks it up from the beginning.
func homeResponse(lang: Str): hive.net.HttpResponse {
	all := slides()
	content := ui.column([ui.gap(20), ui.pad(40), ui.grow(1), ui.width(680)], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], homeKicker(lang)),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Hive"),
		ui.text([], homeParagraphOne(lang)),
		ui.text([], homeParagraphTwo(lang)),
		highlightsView(lang),
		ui.row([ui.gap(16), ui.align(ui.Align.Center())], [
			ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourArrow(lang)),
			ui.link([], releaseUrl(), downloadLabel(lang)),
			ui.link([], repoUrl(), repoLinkLabel(lang)),
			ui.text([ui.tone(ui.Tone.Muted())], featuresCount(lang, len(all))),
		]),
	])
	top := ui.row([], [sidebarView(all, -1, lang, "/"), content])
	body := ui.page(homePageTitle(lang), top)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// The two URLs this program ever links outside itself: GitHub's own
// `/releases/latest` redirect, so the download link never has to know a
// version number and never goes stale as new releases ship, and the
// repository itself, for whoever wants the source rather than a binary.
func releaseUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang/releases/latest"
}

func repoUrl(): Str {
	return "https://github.com/R0DR160HM/hive-lang"
}

func downloadLinkView(lang: Str): ui.View {
	return ui.link([ui.background(ui.Tone.Good())], releaseUrl(), downloadLabelArrow(lang))
}

func repoLinkView(lang: Str): ui.View {
	return ui.link([], repoUrl(), repoLinkLabel(lang))
}

func repoLinkLabel(lang: Str): Str {
	if lang == "pt" { return "Ver o repositório" }
	return "View the repository"
}

func highlightRow(text: Str): ui.View {
	return ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
		ui.icon([ui.tone(ui.Tone.Good())], ui.Icon.Check()),
		ui.text([], text),
	])
}

func highlightsView(lang: Str): ui.View {
	if lang == "pt" {
		return ui.column([ui.gap(8)], [
			highlightRow("Um único executável — nada mais para instalar, nenhum runtime para configurar"),
			highlightRow("Todo índice e slice de vetor é comprovado dentro dos limites em tempo de compilação"),
			highlightRow("Tabelas são um tipo nativo da linguagem, não um import de biblioteca"),
			highlightRow("HTTP, WebSockets, SQL, criptografia, uma UI e atores distribuídos — tudo na biblioteca padrão"),
			highlightRow("Valores se comportam como valores: dois nomes nunca observam as escritas um do outro, a menos que ambos sejam mut"),
		])
	}
	return ui.column([ui.gap(8)], [
		highlightRow("One executable — nothing else to install, no runtime to configure"),
		highlightRow("Every vector index and slice proved in range at compile time"),
		highlightRow("Tables are a built-in type, not a library import"),
		highlightRow("HTTP, WebSockets, SQL, crypto, a UI and distributed actors — all in the standard library"),
		highlightRow("Values behave like values: two names never observe each other's writes, unless both say mut"),
	])
}

func notFoundResponse(lang: Str, path: Str): hive.net.HttpResponse {
	all := slides()
	content := ui.column([ui.pad(60), ui.align(ui.Align.Center()), ui.gap(12), ui.grow(1)], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "404"),
		ui.text([ui.tone(ui.Tone.Muted())], notFoundText(lang)),
		ui.link([ui.background(ui.Tone.Good())], href("/1", lang), startTourPlain(lang)),
	])
	top := ui.row([], [sidebarView(all, -1, lang, path), content])
	body := ui.page(notFoundPageTitle(lang), top)
	return hive.net.HttpResponse(404, [["Content-Type", "text/html; charset=utf-8"]], body)
}

// Every internal link goes through here: unchanged in English, and
// carrying `?lang=pt` in Portuguese, so the language a visitor picked
// survives every click rather than resetting on the next page.
func href(path: Str, lang: Str): Str {
	if lang == "pt" {
		return path + "?lang=pt"
	}
	return path
}

// The list of every slide, down the left, under a link back to the home
// screen and the EN/PT switch. The current slide is picked out with a
// muted background — `ui.background`, not a class of our own, since the
// tone it takes is one `hive.ui`'s own stylesheet already knows — and the
// switch picks out the current language the same way. `idx` of `-1` — the
// home page and the 404 page both pass it — highlights no slide at all.
func sidebarView(all: Slide[], idx: Int, lang: Str, path: Str): ui.View {
	mut ui.View[dyn] items = []
	for i := 0; i < len(all); i++ {
		item := all[i]
		mut highlight := ui.Tone.Normal()
		if i == idx {
			highlight = ui.Tone.Muted()
		}
		link := ui.link(
			[ui.background(highlight)],
			href("/{i + 1}", lang),
			"{i + 1}. {slideTitle(item, lang)}",
		)
		append(items, link)
	}
	home := ui.link([ui.size(ui.TextSize.Subtitle())], href("/", lang), tourTitle(lang))
	return ui.column(
		[ui.width(260), ui.pad(24), ui.gap(2), ui.scroll(ui.Axis.Vertical())],
		[home, languageSwitcherView(lang, path)] + items,
	)
}

func languageSwitcherView(lang: Str, path: Str): ui.View {
	mut enTone := ui.Tone.Normal()
	mut ptTone := ui.Tone.Normal()
	if lang == "pt" {
		ptTone = ui.Tone.Muted()
	} else {
		enTone = ui.Tone.Muted()
	}
	return ui.row([ui.gap(6)], [
		ui.link([ui.background(enTone)], href(path, "en"), "EN"),
		ui.link([ui.background(ptTone)], href(path, "pt"), "PT"),
	])
}

// The slide's own column: where it sits in the tour, its title, and then
// the marker the code examples land on once the page has been rendered.
func headerColumn(slide: Slide, idx: Int, total: Int, lang: Str): ui.View {
	titleGroup := ui.column([ui.gap(6)], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], slideProgress(idx, total, lang)),
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], slideTitle(slide, lang)),
	])
	return ui.column([ui.gap(24), ui.pad(40), ui.grow(1)], [titleGroup, codeMarkerView()])
}

// What follows the code examples: the explanation, one paragraph per view
// so each wraps on its own, a download link on the tour's last slide, and
// the prev/next pager. Rendered separately with `ui.html` and spliced in
// right after the examples, so it still ends up inside the same column the
// header opened.
func bottomView(slide: Slide, idx: Int, total: Int, lang: Str, path: Str): ui.View {
	mut ui.View[dyn] blocks = []
	for each para in split(slideExplanation(slide, lang), "\n\n") {
		append(blocks, ui.text([], para))
	}
	if idx + 1 == total {
		append(blocks, ui.row([ui.gap(12)], [downloadLinkView(lang), repoLinkView(lang)]))
	}

	mut prevNode := ui.text([ui.tone(ui.Tone.Muted())], prevLabel(lang))
	if idx > 0 {
		prevNode = ui.link([], href("/{idx}", lang), prevLabel(lang))
	}
	mut nextNode := ui.text([ui.tone(ui.Tone.Muted())], nextLabel(lang))
	if idx + 1 < total {
		nextNode = ui.link([], href("/{idx + 2}", lang), nextLabel(lang))
	}
	pager := ui.row([ui.justify(ui.Justify.Between())], [prevNode, nextNode])
	append(blocks, pager)
	return ui.column([ui.gap(16)], blocks)
}

// Every example a slide carries, one small labelled block per example. A
// slide with one example — most of them — shows no caption at all; a
// slide split into several shows what each one is about, so a big feature
// still arrives as several small, focused programs rather than one long
// one.
func examplesHtml(examples: Example[], lang: Str): Str {
	mut Str[dyn] blocks = []
	for each ex in examples {
		append(blocks, exampleHtml(ex, lang))
	}
	return join(blocks, "")
}

func exampleHtml(ex: Example, lang: Str): Str {
	mut caption := ex.caption
	if lang == "pt" {
		caption = ex.captionPt
	}
	mut captionHtml := ""
	if caption != "" {
		captionHtml = "<div style=\"font-size:12px;color:var(--muted);margin:0 0 6px;"
			+ "text-transform:uppercase;letter-spacing:.04em\">" + escapeHtml(caption) + "</div>"
	}
	mut code := ex.code
	if lang == "pt" {
		code = ex.codePt
	}
	return "<div style=\"margin-bottom:20px\">" + captionHtml + codeBlockHtml(code) + "</div>"
}

// The one piece of literal HTML on the page: `hive.ui` has no monospaced,
// boxed text of its own, so a code example is written out by hand. It
// still leans on the theme `ui.page` already put in the document —
// `var(--surface)` and `var(--line)` — so it stays in step with light and
// dark mode without a stylesheet of its own. The code itself never
// changes between languages — only its `//` comments do, in `codePt`.
func codeBlockHtml(code: Str): Str {
	return "<pre style=\"background:var(--surface);border:1px solid var(--line);"
		+ "border-radius:8px;padding:16px 18px;overflow-x:auto;font-size:13.5px;"
		+ "line-height:1.5;margin:0\"><code style=\"font-family:'SFMono-Regular',"
		+ "Consolas,Menlo,monospace\">" + escapeHtml(code) + "</code></pre>"
}

func escapeChar(c: Str): Str {
	if c == "&" { return "&amp;" }
	else if c == "<" { return "&lt;" }
	else if c == ">" { return "&gt;" }
	return c
}

func escapeHtml(s: Str): Str {
	return join(map(split(s, ""), escapeChar), "")
}

// ---------------------------------------------------------------------------
// The small, reusable pieces of interface text — everything that is not
// part of one particular slide.

func tourTitle(lang: Str): Str {
	if lang == "pt" { return "O Tour do Hive" }
	return "The Hive Tour"
}

func pageTitleSuffix(lang: Str): Str {
	if lang == "pt" { return " — O Tour do Hive" }
	return " — The Hive Tour"
}

func homePageTitle(lang: Str): Str {
	if lang == "pt" { return "Hive — um tour pela linguagem" }
	return "Hive — a tour of the language"
}

func notFoundPageTitle(lang: Str): Str {
	if lang == "pt" { return "Página não encontrada — O Tour do Hive" }
	return "Not found — The Hive Tour"
}

func slideProgress(idx: Int, total: Int, lang: Str): Str {
	if lang == "pt" { return "Slide {idx + 1} de {total}" }
	return "Slide {idx + 1} of {total}"
}

func prevLabel(lang: Str): Str {
	if lang == "pt" { return "← Anterior" }
	return "← Prev"
}

func nextLabel(lang: Str): Str {
	if lang == "pt" { return "Próximo →" }
	return "Next →"
}

func startTourArrow(lang: Str): Str {
	if lang == "pt" { return "Começar o tour →" }
	return "Start the tour →"
}

func startTourPlain(lang: Str): Str {
	if lang == "pt" { return "Começar o tour" }
	return "Start the tour"
}

func downloadLabel(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador" }
	return "Download the compiler"
}

func downloadLabelArrow(lang: Str): Str {
	if lang == "pt" { return "Baixar o compilador →" }
	return "Download the compiler →"
}

func featuresCount(lang: Str, n: Int): Str {
	if lang == "pt" { return "{n} recursos, um por vez" }
	return "{n} features, one at a time"
}

func homeKicker(lang: Str): Str {
	if lang == "pt" { return "Um tour pela linguagem" }
	return "A tour of the language"
}

func homeParagraphOne(lang: Str): Str {
	if lang == "pt" {
		return "Hive é uma linguagem baseada em tabelas com memória gerenciada. Tabelas são uma ideia nativa da linguagem em vez de uma biblioteca, valores se comportam como valores, e boa parte do que outras linguagens deixam para o tempo de execução — todo índice de vetor, todo ramo de um match, as colunas que uma consulta SQL devolve — é resolvido em tempo de compilação."
	}
	return "Hive is a memory-managed, table-based language. Tables are a built-in idea rather than a library, values behave like values, and a good deal of what other languages leave to runtime — every vector index, every branch of a match, the columns a SQL query comes back with — is settled at compile time instead."
}

func homeParagraphTwo(lang: Str): Str {
	if lang == "pt" {
		return "Esta própria página é a prova: ela é servida por um servidor HTTP escrito em Hive, e sua interface abaixo dos exemplos de código é construída inteiramente com views do hive.ui. Não há framework por trás de nenhum dos dois — ambos são a biblioteca padrão, e nenhum é uma dependência que este programa precisou pedir."
	}
	return "This very page is the proof: it is served by an HTTP server written in Hive, and its interface below the code samples is built entirely out of hive.ui views. There is no framework underneath either of them — both are the standard library, and neither is a dependency this program had to ask for."
}

func notFoundText(lang: Str): Str {
	if lang == "pt" { return "Esse slide não existe." }
	return "That slide does not exist."
}

// ---------------------------------------------------------------------------
// The content of the tour, one feature at a time. Every code example below
// is a complete program: copy it into a `.hive` file and `hive run` it.

func slides(): Slide[37] {
	return [
		Slide(
			title: "Hello, World",
			titlePt: "Olá, Mundo",
			explanation: "Every Hive program starts at proc main(): void, in the file handed to `hive run` or `hive build`. echo prints a value and appends a newline, converting whatever it is given to text the way it would be shown.",
			explanationPt: "Todo programa Hive começa em proc main(): void, no arquivo passado para `hive run` ou `hive build`. echo imprime um valor e adiciona uma nova linha, convertendo o que quer que receba em texto da mesma forma que seria exibido.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	echo "it works"
}`, codePt: `proc main(): void {
	echo "funciona"
}`)],
		),
		Slide(
			title: "Comments",
			titlePt: "Comentários",
			explanation: "A comment runs from // to the end of the line, and nothing more. There is no block comment form in Hive itself — inside a query body, which is SQL rather than Hive, SQL's own -- and /* */ are recognised instead.",
			explanationPt: "Um comentário vai de // até o fim da linha, e nada mais. Não existe forma de comentário em bloco no próprio Hive — dentro do corpo de uma query, que é SQL e não Hive, os -- e /* */ do próprio SQL são reconhecidos em seu lugar.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	// A comment. The whole line, and nothing of the next.
	x := 1 // ...or the tail of one.
	echo x
}`, codePt: `proc main(): void {
	// Um comentário. A linha toda, e nada da próxima.
	x := 1 // ...ou o resto de uma.
	echo x
}`)],
		),
		Slide(
			title: "Names have shapes",
			titlePt: "Nomes têm formas",
			explanation: "A name's spelling says what it is, and each shape is enforced where the name is declared. camelCase names variables, parameters, fields and every proc/func/query. PascalCase names types, their variants, and atoms. UPPER_CASE is how a constant is written: a variable nothing reassigns. Keywords are lower case, and only lower case — a keyword spelled in another casing, like Proc or IF, is a compile error naming both readings rather than a usable identifier.",
			explanationPt: "A grafia de um nome diz o que ele é, e cada forma é obrigatória no lugar onde o nome é declarado. camelCase nomeia variáveis, parâmetros, campos e todo proc/func/query. PascalCase nomeia tipos, suas variantes e átomos. UPPER_CASE é como se escreve uma constante: uma variável que nada reatribui. Palavras-chave são em minúsculas, e somente em minúsculas — uma palavra-chave grafada de outra forma, como Proc ou IF, é um erro de compilação que aponta as duas leituras em vez de um identificador utilizável.",
			examples: [Example(caption: "", captionPt: "", code: `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: a variable
	MAX_RETRIES := 5          // UPPER_CASE: a constant
	shape := Shape.Circle(4)  // PascalCase: a type and its variant

	echo "{name}, retry up to {MAX_RETRIES} times, shape={shape}"
}`, codePt: `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: uma variável
	MAX_RETRIES := 5          // UPPER_CASE: uma constante
	shape := Shape.Circle(4)  // PascalCase: um tipo e sua variante

	echo "{name}, tente até {MAX_RETRIES} vezes, forma={shape}"
}`)],
		),
		Slide(
			title: "Variables and constants",
			titlePt: "Variáveis e constantes",
			explanation: ":= infers a type from the value, including a static vector length. A type written out front with = states it instead, which is the only way to say [dyn], or to give a value nothing else says the shape of somewhere to land. A binding is immutable unless it says mut, and a mut variable may never be spelled UPPER_CASE — that shape is reserved for something nothing reassigns.",
			explanationPt: ":= infere um tipo a partir do valor, incluindo um tamanho estático de vetor. Um tipo escrito explicitamente na frente com = o declara em vez disso, que é a única forma de dizer [dyn], ou de dar a um valor que nada mais define a forma de um lugar para chegar. Uma ligação é imutável a menos que diga mut, e uma variável mut nunca pode ser grafada em UPPER_CASE — essa forma é reservada para algo que nada reatribui.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	x := 1                     // inferred, immutable
	mut count := 0              // inferred, reassignable
	mut Str[dyn] rows = []       // annotated: says "dynamic"
	MAX := 100                  // a constant, by its shape alone

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`, codePt: `proc main(): void {
	x := 1                     // inferido, imutável
	mut count := 0              // inferido, reatribuível
	mut Str[dyn] rows = []       // anotado: diz "dinâmico"
	MAX := 100                  // uma constante, só pela forma

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`)],
		),
		Slide(
			title: "Scalar types",
			titlePt: "Tipos escalares",
			explanation: "Str holds UTF-8 text. Int is a 64-bit signed integer whose overflow wraps silently. Float is a 64-bit float. Bool is true or false. Atom is an interned symbol, written #Name — a label, not a condition, so `if flag` is a compile error when flag is an Atom. void is a return type only; there is no void value, field or element. There is no implicit numeric widening anywhere: an Int never becomes a Float on its own.",
			explanationPt: "Str guarda texto UTF-8. Int é um inteiro de 64 bits com sinal cujo overflow dá a volta silenciosamente. Float é um float de 64 bits. Bool é true ou false. Atom é um símbolo internado, escrito #Nome — um rótulo, não uma condição, então `if flag` é um erro de compilação quando flag é um Atom. void é apenas um tipo de retorno; não existe valor, campo ou elemento void. Não há ampliação numérica implícita em lugar nenhum: um Int nunca se torna um Float por conta própria.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "{name} {count} {weight} {ready} {state}"
}`, codePt: `proc main(): void {
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "{name} {count} {weight} {ready} {state}"
}`)],
		),
		Slide(
			title: "Strings",
			titlePt: "Strings",
			explanation: "A double-quoted string interpolates with \{expression} and escapes with \\n, \\t, \\\", \\\\, and \\\{ for a literal brace. A backtick string is raw: no escapes and no interpolation at all, so it is the natural way to hold a block of text — or, as on this very page, a block of Hive source — untouched. Its indentation is stripped at compile time down to the shortest common margin.",
			explanationPt: "Uma string entre aspas duplas interpola com \{expressão} e usa escapes com \\n, \\t, \\\", \\\\, e \\\{ para uma chave literal. Uma string entre crases é bruta: sem escapes e sem interpolação alguma, o que a torna a forma natural de guardar um bloco de texto — ou, como nesta própria página, um bloco de código-fonte Hive — intacto. Sua indentação é removida em tempo de compilação até a menor margem em comum.",
			examples: [
				Example(caption: "Interpolation and escapes", captionPt: "Interpolação e escapes", code: `proc main(): void {
	name := "bee"
	echo "hello, {name}!"       // interpolated
	echo "a literal brace: \{" // escaped
}`, codePt: `proc main(): void {
	name := "bee"
	echo "olá, {name}!"          // interpolado
	echo "uma chave literal: \{" // escapado
}`),
				Example(caption: "Raw strings", captionPt: "Strings brutas", code: `proc main(): void {
	raw := `+"`"+`
		line one
		line two
	`+"`"+`
	echo raw
}`, codePt: `proc main(): void {
	raw := `+"`"+`
		linha um
		linha dois
	`+"`"+`
	echo raw
}`),
			],
		),
		Slide(
			title: "Vectors",
			titlePt: "Vetores",
			explanation: "A vector is memory-contiguous and homogeneous. Str[3] is static: exactly three, always. Str[dyn] is dynamic: it promises nothing about its length and is the only kind append works on. Str[] is a parameter-only spelling that accepts either. A variable or field must say which of the two real kinds it holds — that promise is what the bounds checker rests on. + concatenates into a new vector; == compares structurally, element by element.",
			explanationPt: "Um vetor é contíguo na memória e homogêneo. Str[3] é estático: exatamente três, sempre. Str[dyn] é dinâmico: não promete nada sobre seu tamanho e é o único tipo sobre o qual append funciona. Str[] é uma grafia só para parâmetros que aceita qualquer um dos dois. Uma variável ou campo precisa dizer qual dos dois tipos reais ela guarda — essa promessa é o que sustenta o verificador de limites. + concatena em um novo vetor; == compara estruturalmente, elemento por elemento.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	v := ["a", "b", "c"]          // Str[3] — a static length, inferred
	mut Str[dyn] w = ["a", "b"]    // dynamic — the only kind append accepts
	append(w, "c")

	first := v[0]
	middle := v[0:1]                // slicing, both bounds inclusive
	echo "{first} {middle} {w}"
}`, codePt: `proc main(): void {
	v := ["a", "b", "c"]          // Str[3] — um tamanho estático, inferido
	mut Str[dyn] w = ["a", "b"]    // dinâmico — o único tipo que append aceita
	append(w, "c")

	first := v[0]
	middle := v[0:1]                // slicing, ambos os limites inclusivos
	echo "{first} {middle} {w}"
}`)],
		),
		Slide(
			title: "Builtins",
			titlePt: "Funções nativas",
			explanation: "These are always in scope, with no import needed. len counts a vector's elements or a Str's characters; bytes counts a vector's backing storage or a Str's UTF-8 bytes. append and prepend grow a mutable dynamic vector at either end; drop removes a range and hands back exactly what it removed. join concatenates a vector of Str with a separator between each pair, and split is its inverse. indexOf finds the first equal element and, unlike a bare -1, an Ok index is always safe to use unguarded. row and column pull a Table's row or column by its first cell or its top cell. map, filter and filterMap each walk a vector with a func — map transforms every element, filter keeps the ones a predicate says yes to, filterMap does both in one pass — and sort puts a vector in order, in place when it stands alone as a statement over a mut vector.\n\nA declaration of your own — a func, proc, query or type sharing one of these names — wins over the builtin at every bare call, which stays reachable as hive.<name>.",
			explanationPt: "Estas estão sempre no escopo, sem precisar de import. len conta os elementos de um vetor ou os caracteres de uma Str; bytes conta o armazenamento de um vetor ou os bytes UTF-8 de uma Str. append e prepend fazem crescer um vetor dinâmico mutável em uma das pontas; drop remove um intervalo e devolve exatamente o que removeu. join concatena um vetor de Str com um separador entre cada par, e split é o seu inverso. indexOf encontra o primeiro elemento igual e, diferente de um -1 solto, um índice Ok é sempre seguro de usar sem guarda. row e column extraem a linha ou coluna de uma Table pela primeira célula ou pela célula do topo. map, filter e filterMap cada um percorre um vetor com um func — map transforma cada elemento, filter mantém os que um predicado diz que sim, filterMap faz as duas coisas em uma passada — e sort põe um vetor em ordem, no lugar quando aparece isolado como instrução sobre um vetor mut.\n\nUma declaração sua — um func, proc, query ou type com um desses nomes — vence a função nativa em toda chamada sem qualificação, que continua acessível como hive.<nome>.",
			examples: [
				Example(caption: "Length and bytes", captionPt: "Tamanho e bytes", code: `proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	echo len(fruit)
	echo bytes("café")
}`, codePt: `proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	echo len(fruit)
	echo bytes("café")
}`),
				Example(caption: "Growing and shrinking", captionPt: "Crescendo e encolhendo", code: `proc main(): void {
	mut Str[dyn] basket = ["pear"]
	append(basket, "apple")
	prepend(basket, "kiwi")
	echo basket

	if basket bounds 0 {
		echo drop(basket, 0, 0)
	}
	echo basket
}`, codePt: `proc main(): void {
	mut Str[dyn] basket = ["pear"]
	append(basket, "apple")
	prepend(basket, "kiwi")
	echo basket

	if basket bounds 0 {
		echo drop(basket, 0, 0)
	}
	echo basket
}`),
				Example(caption: "Joining, splitting and finding", captionPt: "Juntando, dividindo e encontrando", code: `proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	line := join(fruit, ", ")
	echo split(line, ", ")

	if indexOf(fruit, "apple") is Result.Ok(i) {
		echo fruit[i]
	}
}`, codePt: `proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	line := join(fruit, ", ")
	echo split(line, ", ")

	if indexOf(fruit, "apple") is Result.Ok(i) {
		echo fruit[i]
	}
}`),
				Example(caption: "Walking a vector", captionPt: "Percorrendo um vetor", code: `func isLong(fruit: Str): Bool {
	return len(fruit) > 4
}

func evenHalf(n: Int): Result<Int, Bool> {
	if n % 2 == 0 { return Result.Ok(n / 2) }
	return Result.Error(false)
}

proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	echo map(fruit, isLong)
	echo filter(fruit, isLong)
	echo filterMap([1, 2, 3, 4], evenHalf)
	echo sort(fruit)
}`, codePt: `func isLong(fruit: Str): Bool {
	return len(fruit) > 4
}

func evenHalf(n: Int): Result<Int, Bool> {
	if n % 2 == 0 { return Result.Ok(n / 2) }
	return Result.Error(false)
}

proc main(): void {
	fruit := ["pear", "apple", "kiwi"]
	echo map(fruit, isLong)
	echo filter(fruit, isLong)
	echo filterMap([1, 2, 3, 4], evenHalf)
	echo sort(fruit)
}`),
				Example(caption: "Tables", captionPt: "Tabelas", code: `proc main(): void {
	table := [["name", "role"], ["ada", "engineer"], ["grace", "admiral"]]
	echo row(table, "ada")
	echo column(table, "role")
}`, codePt: `proc main(): void {
	table := [["name", "role"], ["ada", "engineer"], ["grace", "admiral"]]
	echo row(table, "ada")
	echo column(table, "role")
}`),
			],
		),
		Slide(
			title: "Bounds, proved at compile time",
			titlePt: "Limites, comprovados em tempo de compilação",
			explanation: "A dedicated flow-sensitive pass proves every index and slice in range before the program ever runs. A literal index into a known length compiles outright; a computed index has to sit under a guard the pass can read, such as `if v bounds i \{ v[i] }` — sugar for `i >= 0 && i < len(v)`. Anything the pass cannot prove safe is a compile error, not a runtime panic — `echo v[len(v) - 1]` on its own is rejected outright, computed index and all. This very server leans on it: the slide number from the URL is checked with exactly this guard before it ever indexes the list of slides.",
			explanationPt: "Uma passagem dedicada e sensível ao fluxo comprova que todo índice e slice está dentro dos limites antes mesmo do programa rodar. Um índice literal dentro de um tamanho conhecido compila sem mais nada; um índice calculado precisa estar sob uma guarda que a passagem saiba ler, como `if v bounds i \{ v[i] }` — açúcar sintático para `i >= 0 && i < len(v)`. Tudo que a passagem não conseguir provar seguro é um erro de compilação, não um panic em tempo de execução — `echo v[len(v) - 1]` sozinho já é rejeitado de cara, índice calculado e tudo. Este mesmo servidor se apoia nisso: o número do slide vindo da URL é verificado com exatamente essa guarda antes de indexar a lista de slides.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	v := ["a", "b", "c"]

	last := len(v) - 1
	if v bounds last {
		echo v[last]                 // fine — the guard covers it
	}
}`, codePt: `proc main(): void {
	v := ["a", "b", "c"]

	last := len(v) - 1
	if v bounds last {
		echo v[last]                 // tudo bem — a guarda cobre isso
	}
}`)],
		),
		Slide(
			title: "Tables and CSV",
			titlePt: "Tabelas e CSV",
			explanation: "Table is an alias for Str[dyn][dyn]: a vector of rows of cells. It is what `using` yields from a CSV, what a raw SQL query answers with, and what hive.map.toTable builds. A bare `using \"path\"` reads a comma-separated file; adding `as csv separating by \"<sep>\"` picks a different delimiter, such as a tab for a TSV — and every form answers with a Result, so the source says exactly which reader the build needs to link in.",
			explanationPt: "Table é um alias para Str[dyn][dyn]: um vetor de linhas de células. É o que `using` produz a partir de um CSV, o que uma query SQL bruta devolve, e o que hive.map.toTable constrói. Um `using \"caminho\"` simples lê um arquivo separado por vírgulas; acrescentar `as csv separating by \"<sep>\"` escolhe outro delimitador, como uma tabulação para um TSV — e toda forma devolve um Result, então o código diz exatamente qual leitor o build precisa vincular.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	hive.file.write("./tour.csv", "name,role\nada,engineer\ngrace,admiral\n")

	csv := using "./tour.csv"
	if csv is Result.Ok(table) {
		if len(table) > 1 {
			echo table[1:]   // every row after the header
		}
	}
}`, codePt: `proc main(): void {
	hive.file.write("./tour.csv", "name,role\nada,engineer\ngrace,admiral\n")

	csv := using "./tour.csv"
	if csv is Result.Ok(table) {
		if len(table) > 1 {
			echo table[1:]   // toda linha depois do cabeçalho
		}
	}
}`)],
		),
		Slide(
			title: "Result<T, E>",
			titlePt: "Result<T, E>",
			explanation: "Result is the language's one built-in generic union, and it is how every fallible operation reports itself: Result.Ok(value) or Result.Error(payload). Matching both variants with `is` is exhaustive, which lets a function written over a Result skip a dead else branch entirely.",
			explanationPt: "Result é a única união genérica nativa da linguagem, e é como toda operação falível se reporta: Result.Ok(valor) ou Result.Error(carga). Combinar as duas variantes com `is` é exaustivo, o que permite que uma função escrita sobre um Result dispense por completo um else morto.",
			examples: [Example(caption: "", captionPt: "", code: `func half(n: Int): Result<Int, Str> {
	if n % 2 == 0 { return Result.Ok(n / 2) }
	return Result.Error("not even")
}

proc main(): void {
	if half(4) is Result.Ok(v)      { echo v }
	else if half(4) is Result.Error(why) { echo why }
}`, codePt: `func half(n: Int): Result<Int, Str> {
	if n % 2 == 0 { return Result.Ok(n / 2) }
	return Result.Error("não é par")
}

proc main(): void {
	if half(4) is Result.Ok(v)      { echo v }
	else if half(4) is Result.Error(why) { echo why }
}`)],
		),
		Slide(
			title: "Declared types",
			titlePt: "Tipos declarados",
			explanation: "A type with no variants is a struct; with variants, a tagged union. A field declared outside any variant is added to every variant. A value is built by calling the type or the variant: User(1, \"ada\"), Shape.Circle(5). There is no subtyping and no interface — a variant is a way of building and matching a union, not a type of its own.",
			explanationPt: "Um type sem variantes é um struct; com variantes, uma união com tag. Um campo declarado fora de qualquer variante é adicionado a todas as variantes. Um valor é construído chamando o type ou a variante: User(1, \"ada\"), Shape.Circle(5). Não existe subtipagem nem interface — uma variante é uma forma de construir e combinar uma união, não um tipo próprio.",
			examples: [
				Example(caption: "A struct", captionPt: "Um struct", code: `type User {
	id:   Int
	name: Str
}

proc main(): void {
	u := User(1, "ada")
	echo u.name
}`, codePt: `type User {
	id:   Int
	name: Str
}

proc main(): void {
	u := User(1, "ada")
	echo u.name
}`),
				Example(caption: "A tagged union", captionPt: "Uma união com tag", code: `type Shape {
	Circle    { radius: Int }
	Rectangle { width: Int, height: Int }
	Point
}

proc main(): void {
	p := Shape.Circle(5)
	echo p
}`, codePt: `type Shape {
	Circle    { radius: Int }
	Rectangle { width: Int, height: Int }
	Point
}

proc main(): void {
	p := Shape.Circle(5)
	echo p
}`),
			],
		),
		Slide(
			title: "Pattern matching with is",
			titlePt: "Casamento de padrões com is",
			explanation: "`is` checks a value against a pattern and yields a Bool, narrowing it and binding names usable right away — in the rest of the condition after &&, and in the branch body. There is no match statement; every match is an ordinary if/else if chain. Four kinds of pattern exist: a variant, a Result, a vector matched positionally with an optional ...rest, and a string template whose \{holes} bind the text between literal pieces.",
			explanationPt: "`is` verifica um valor contra um padrão e produz um Bool, estreitando-o e vinculando nomes que já podem ser usados — no resto da condição depois de &&, e no corpo do ramo. Não existe instrução match; toda combinação é uma cadeia comum de if/else if. Existem quatro tipos de padrão: uma variante, um Result, um vetor combinado posicionalmente com um ...rest opcional, e um template de string cujos \{buracos} vinculam o texto entre os trechos literais.",
			examples: [
				Example(caption: "Variant patterns", captionPt: "Padrões de variante", code: `type Shape {
	Circle    { radius: Int }
	Rectangle { width: Int, height: Int }
}

proc main(): void {
	shape := Shape.Circle(4)
	if shape is Shape.Circle(r)            { echo "circle, r={r}" }
	else if shape is Shape.Rectangle(w, _) { echo "rect, w={w}" }
}`, codePt: `type Shape {
	Circle    { radius: Int }
	Rectangle { width: Int, height: Int }
}

proc main(): void {
	shape := Shape.Circle(4)
	if shape is Shape.Circle(r)            { echo "círculo, r={r}" }
	else if shape is Shape.Rectangle(w, _) { echo "retângulo, w={w}" }
}`),
				Example(caption: "Vector patterns", captionPt: "Padrões de vetor", code: `proc main(): void {
	command := ["move", "north", "2"]
	if command is ["move", dir, ...steps] { echo "{dir}, {len(steps)} more" }
	else if command is ["stop"]           { echo "halt" }
}`, codePt: `proc main(): void {
	command := ["move", "north", "2"]
	if command is ["move", dir, ...steps] { echo "{dir}, {len(steps)} a mais" }
	else if command is ["stop"]           { echo "parar" }
}`),
				Example(caption: "String patterns", captionPt: "Padrões de string", code: `proc main(): void {
	path := "/users/42/posts/7"
	if path is "/users/{id}/posts/{postId}" { echo "{id} / {postId}" }
}`, codePt: `proc main(): void {
	path := "/users/42/posts/7"
	if path is "/users/{id}/posts/{postId}" { echo "{id} / {postId}" }
}`),
			],
		),
		Slide(
			title: "func vs proc",
			titlePt: "func vs proc",
			explanation: "Both may perform I/O — echo, using, hive.net are all fine in either. The difference is what each may touch: a func cannot declare a mutex parameter (v: mut T) and cannot call a proc, so it can never write to storage its caller can see. A proc may do everything a func may, plus hold a mutex and call other procs. Programs start at proc main(): void. Nothing about the declaration says how a call runs — that is decided entirely at the call site.",
			explanationPt: "Ambos podem fazer I/O — echo, using, hive.net funcionam nos dois. A diferença é o que cada um pode tocar: um func não pode declarar um parâmetro mutex (v: mut T) e não pode chamar um proc, então nunca pode escrever em um armazenamento que quem o chamou consiga ver. Um proc pode fazer tudo que um func faz, além de guardar um mutex e chamar outros procs. Programas começam em proc main(): void. Nada na declaração diz como uma chamada roda — isso é decidido totalmente no local da chamada.",
			examples: [
				Example(caption: "func: cannot touch the caller's storage", captionPt: "func: não pode tocar no armazenamento de quem chamou", code: `func greet(name: Str): Str {
	return "hey {name}!"
}

proc main(): void {
	echo greet("ada")
}`, codePt: `func greet(name: Str): Str {
	return "olá, {name}!"
}

proc main(): void {
	echo greet("ada")
}`),
				Example(caption: "proc: may hold a mutex", captionPt: "proc: pode guardar um mutex", code: `proc grow(vec: mut Str[dyn], tag: Str): void {
	append(vec, tag)
}

proc main(): void {
	mut Str[dyn] tags = ["bee"]
	grow(tags, "hive")
	echo tags
}`, codePt: `proc grow(vec: mut Str[dyn], tag: Str): void {
	append(vec, tag)
}

proc main(): void {
	mut Str[dyn] tags = ["bee"]
	grow(tags, "hive")
	echo tags
}`),
			],
		),
		Slide(
			title: "First-class functions",
			titlePt: "Funções de primeira classe",
			explanation: "A callable is a value: a bare name on its own (f := takes) or a partial application with _ holes (handler(_, db)), each hole becoming a parameter in order. A func value may be used where a proc is expected, never the reverse. Three things cannot become values: a generic callable, one with a mutex parameter, and one with a statically-sized parameter beyond a single immutable binding.",
			explanationPt: "Algo chamável é um valor: um nome solto por si só (f := toma) ou uma aplicação parcial com buracos _ (handler(_, db)), cada buraco se tornando um parâmetro em ordem. Um valor func pode ser usado onde um proc é esperado, nunca o contrário. Três coisas não podem se tornar valores: um chamável genérico, um com parâmetro mutex, e um com parâmetro de tamanho estático além de uma única ligação imutável.",
			examples: [
				Example(caption: "A bare reference, and map", captionPt: "Uma referência solta, e map", code: `func double(n: Int): Int { return n * 2 }

proc main(): void {
	f := double
	echo "{f(21)} {map([1, 2, 3], double)}"
}`, codePt: `func double(n: Int): Int { return n * 2 }

proc main(): void {
	f := double
	echo "{f(21)} {map([1, 2, 3], double)}"
}`),
				Example(caption: "Partial application", captionPt: "Aplicação parcial", code: `func add(a: Int, b: Int): Int { return a + b }

proc main(): void {
	addFive := add(5, _)   // _ becomes the parameter
	echo addFive(10)
}`, codePt: `func add(a: Int, b: Int): Int { return a + b }

proc main(): void {
	addFive := add(5, _)   // _ se torna o parâmetro
	echo addFive(10)
}`),
			],
		),
		Slide(
			title: "Mutability and value semantics",
			titlePt: "Mutabilidade e semântica de valor",
			explanation: "Variables are immutable unless marked mut. Vectors, tables, maps and the declared types built from them are value types: two names for one value never observe each other's writes — unless both are mut, which is how sharing is opted into. A mutex parameter (v: mut T) is the one place storage crosses a call boundary on purpose, and only a proc may declare one; whether a call shares the caller's storage or a copy depends on whether the caller waits for it there or fires it with async.",
			explanationPt: "Variáveis são imutáveis a menos que marcadas com mut. Vetores, tabelas, maps e os tipos declarados construídos a partir deles são tipos de valor: dois nomes para um mesmo valor nunca observam as escritas um do outro — a menos que ambos sejam mut, que é como o compartilhamento é escolhido. Um parâmetro mutex (v: mut T) é o único lugar em que o armazenamento cruza uma fronteira de chamada de propósito, e só um proc pode declarar um; se uma chamada compartilha o armazenamento de quem a chamou ou uma cópia depende de quem a chamou esperar por ela ali ou disparar com async.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	mut Str[dyn] a = ["x", "y"]
	mut Str[dyn] b = a       // an alias: two names, one header
	append(b, "z")            // len(a) is now 3 too
	echo a

	b = ["replaced"]          // rebinding one rebinds both
	echo a
}`, codePt: `proc main(): void {
	mut Str[dyn] a = ["x", "y"]
	mut Str[dyn] b = a       // um alias: dois nomes, um só cabeçalho
	append(b, "z")            // len(a) também é 3 agora
	echo a

	b = ["replaced"]          // reatribuir um reatribui os dois
	echo a
}`)],
		),
		Slide(
			title: "Concurrency",
			titlePt: "Concorrência",
			explanation: "Every call blocks its caller by default — there is no async func, no Future. What a call means is decided where it is written: f(x) waits; async f(x) fires and forgets; x := async f(x) starts it and waits only when x is read; await [f(a), f(b)] starts every call on its own thread and is one barrier resolving to a fully-typed vector. hive.task.sleep(ms) parks only the calling thread, which is why two sleeps started together finish in about the longer one rather than the sum. Any wait can be bounded with `with timeout <ms>`, turning the result into a Result rather than a crash.",
			explanationPt: "Toda chamada bloqueia quem a chamou por padrão — não existe async func, não existe Future. O que uma chamada significa é decidido onde ela é escrita: f(x) espera; async f(x) dispara e esquece; x := async f(x) a inicia e só espera quando x é lido; await [f(a), f(b)] inicia cada chamada em sua própria thread e é uma única barreira que se resolve em um vetor totalmente tipado. hive.task.sleep(ms) estaciona apenas a thread que chamou, e é por isso que dois sleeps iniciados juntos terminam em cerca do mais longo, e não na soma. Qualquer espera pode ser limitada com `with timeout <ms>`, transformando o resultado em um Result em vez de uma falha.",
			examples: [
				Example(caption: "Starting work and waiting for it", captionPt: "Iniciando um trabalho e esperando por ele", code: `proc slow(label: Str, ms: Int): Str {
	hive.task.sleep(ms)
	return label
}

proc main(): void {
	a := async slow("a", 30)      // starts now
	b := async slow("b", 30)      // starts now, alongside
	echo "{a} and {b}"             // waits for both, right here
}`, codePt: `proc slow(label: Str, ms: Int): Str {
	hive.task.sleep(ms)
	return label
}

proc main(): void {
	a := async slow("a", 30)      // inicia agora
	b := async slow("b", 30)      // inicia agora, em paralelo
	echo "{a} and {b}"             // espera pelos dois, aqui mesmo
}`),
				Example(caption: "Bounding a wait", captionPt: "Limitando uma espera", code: `proc slow(label: Str, ms: Int): Str {
	hive.task.sleep(ms)
	return label
}

proc main(): void {
	if slow("c", 300) with timeout 50 is Result.Error(err) {
		echo "gave up after {err.waited}ms"
	}
}`, codePt: `proc slow(label: Str, ms: Int): Str {
	hive.task.sleep(ms)
	return label
}

proc main(): void {
	if slow("c", 300) with timeout 50 is Result.Error(err) {
		echo "desistiu depois de {err.waited}ms"
	}
}`),
			],
		),
		Slide(
			title: "Generics",
			titlePt: "Genéricos",
			explanation: "A name in a signature that is neither a builtin nor a declared type is a type variable, and it makes the callable generic. A variable is pinned down by where it appears in the parameters — including inside a parameter's own function type. Nothing about it is dynamic at run time: every call site is resolved at compile time, and one concrete copy is emitted per distinct set of type arguments — first_Str, first_Int — with no boxing and no dispatch.",
			explanationPt: "Um nome em uma assinatura que não é nem uma função nativa nem um tipo declarado é uma variável de tipo, e ela torna o chamável genérico. Uma variável é fixada por onde ela aparece nos parâmetros — inclusive dentro do próprio tipo de função de um parâmetro. Nada nisso é dinâmico em tempo de execução: todo local de chamada é resolvido em tempo de compilação, e uma cópia concreta é emitida para cada conjunto distinto de argumentos de tipo — first_Str, first_Int — sem boxing e sem despacho.",
			examples: [Example(caption: "", captionPt: "", code: `func first(v: T[]): Result<T, Bool> {
	if len(v) > 0 {
		return Result.Ok(v[0])
	}
	return Result.Error(false)
}

proc main(): void {
	a := first([1, 2, 3])       // first_Int
	b := first(["x", "y"])      // first_Str, a separate copy
	echo "{a} {b}"
}`, codePt: `func first(v: T[]): Result<T, Bool> {
	if len(v) > 0 {
		return Result.Ok(v[0])
	}
	return Result.Error(false)
}

proc main(): void {
	a := first([1, 2, 3])       // first_Int
	b := first(["x", "y"])      // first_Str, uma cópia separada
	echo "{a} {b}"
}`)],
		),
		Slide(
			title: "Modules",
			titlePt: "Módulos",
			explanation: "import brings another file's declarations into scope, reached through a name — the file's own by default, or whatever `as` renames it to. The path itself says what kind of import it is: a bare path is a Hive file on disk, an https:// path is a file inside a git repository — pinned to a commit, a tag or a branch — and hive.* names a standard library module, reached the same way and adding nothing to the build unless it is actually used.",
			explanationPt: "import traz as declarações de outro arquivo para o escopo, alcançadas através de um nome — o próprio nome do arquivo por padrão, ou o que `as` renomear para. O próprio caminho diz que tipo de import é: um caminho simples é um arquivo Hive em disco, um caminho https:// é um arquivo dentro de um repositório git — fixado em um commit, uma tag ou um branch — e hive.* nomeia um módulo da biblioteca padrão, alcançado da mesma forma e não adicionando nada ao build a menos que seja de fato usado.",
			examples: [Example(caption: "", captionPt: "", code: `import hive.crypto as crypto

proc main(): void {
	echo crypto.sha256("hive")
}`, codePt: `import hive.crypto as crypto

proc main(): void {
	echo crypto.sha256("hive")
}`)],
		),
		Slide(
			title: "Maps",
			titlePt: "Mapas",
			explanation: "hive.map.Map<K, T> is the one collection that is not a vector. A key is compared and hashed whole, so it must be a Str, Int, Float, Bool, Atom, or a declared type whose every field is one of those. new() says only \"empty\", so it has to land somewhere already typed — a mut declaration, here. set and delete need that mut map; get answers by key with a Result, has asks the same question without the value, and keys/values walk it in the order keys were set, which is what makes echoing one reproducible from run to run. fromTable and toTable cross to and from a Table of two-cell rows, for a map whose keys and values are both Str.",
			explanationPt: "hive.map.Map<K, T> é a única coleção que não é um vetor. Uma chave é comparada e tem seu hash calculado por completo, então precisa ser uma Str, Int, Float, Bool, Atom, ou um tipo declarado cujos campos sejam todos um desses. new() diz apenas \"vazio\", então precisa chegar em algum lugar já tipado — uma declaração mut, aqui. set e delete precisam desse map mut; get responde por chave com um Result, has faz a mesma pergunta sem o valor, e keys/values percorrem na ordem em que as chaves foram definidas, o que torna dar echo em um reproduzível de execução para execução. fromTable e toTable cruzam de e para uma Table de linhas de duas células, para um map cujas chaves e valores são ambos Str.",
			examples: [
				Example(caption: "Setting, getting and walking", captionPt: "Definindo, obtendo e percorrendo", code: `proc main(): void {
	mut hive.map.Map<Str, Int> counts = hive.map.new()
	hive.map.set(counts, "bees", 12)
	hive.map.set(counts, "hives", 3)

	if hive.map.get(counts, "bees") is Result.Ok(n) {
		echo n
	}
	echo hive.map.has(counts, "wasps")
	hive.map.delete(counts, "hives")
	echo hive.map.keys(counts)
	echo hive.map.values(counts)
}`, codePt: `proc main(): void {
	mut hive.map.Map<Str, Int> counts = hive.map.new()
	hive.map.set(counts, "bees", 12)
	hive.map.set(counts, "hives", 3)

	if hive.map.get(counts, "bees") is Result.Ok(n) {
		echo n
	}
	echo hive.map.has(counts, "wasps")
	hive.map.delete(counts, "hives")
	echo hive.map.keys(counts)
	echo hive.map.values(counts)
}`),
				Example(caption: "Crossing to and from a Table", captionPt: "Cruzando de e para uma Table", code: `proc main(): void {
	mut hive.map.Map<Str, Str> labels = hive.map.new()
	hive.map.set(labels, "bees", "many")
	echo hive.map.toTable(labels)

	echo hive.map.get(hive.map.fromTable([["wasps", "few"]]), "wasps")
}`, codePt: `proc main(): void {
	mut hive.map.Map<Str, Str> labels = hive.map.new()
	hive.map.set(labels, "bees", "many")
	echo hive.map.toTable(labels)

	echo hive.map.get(hive.map.fromTable([["wasps", "few"]]), "wasps")
}`),
			],
		),
		Slide(
			title: "Conversions",
			titlePt: "Conversões",
			explanation: "hive.conv is pure, so it works in a func as well as a proc. ceil, floor and round turn a Float into an Int, rounding half away from zero; itf widens an Int to a Float, and its/fts render a number as a Str. sti and stf parse text back into a number and, since parsing can fail, answer with a Result whose ConversionError carries the offending input. There is no implicit numeric conversion anywhere else in the language, which is exactly why this module exists: an Int never quietly becomes a Float.",
			explanationPt: "hive.conv é puro, então funciona tanto em um func quanto em um proc. ceil, floor e round transformam um Float em um Int, arredondando o meio para longe do zero; itf amplia um Int para um Float, e its/fts renderizam um número como uma Str. sti e stf interpretam texto de volta em um número e, como interpretar pode falhar, respondem com um Result cujo ConversionError carrega a entrada culpada. Não existe conversão numérica implícita em nenhum outro lugar da linguagem, e é exatamente por isso que este módulo existe: um Int nunca se torna um Float silenciosamente.",
			examples: [
				Example(caption: "Parsing text", captionPt: "Interpretando texto", code: `proc main(): void {
	if hive.conv.sti("42") is Result.Ok(n) {
		echo n + 1
	}
}`, codePt: `proc main(): void {
	if hive.conv.sti("42") is Result.Ok(n) {
		echo n + 1
	}
}`),
				Example(caption: "Rounding and widening", captionPt: "Arredondando e ampliando", code: `proc main(): void {
	half := hive.conv.itf(5) / 2.0   // widen first — Int and Float never mix
	echo hive.conv.round(half)
	echo hive.conv.fts(half)
	echo hive.conv.its(hive.conv.ceil(half))
}`, codePt: `proc main(): void {
	half := hive.conv.itf(5) / 2.0   // amplia primeiro — Int e Float nunca se misturam
	echo hive.conv.round(half)
	echo hive.conv.fts(half)
	echo hive.conv.its(hive.conv.ceil(half))
}`),
			],
		),
		Slide(
			title: "Math",
			titlePt: "Matemática",
			explanation: "hive.math is pure, and every one of its thirteen functions takes and answers with a Float — there is no integer twin, because Hive never widens a number behind your back. pi is the one constant; sin, cos, tan and their inverses asin, acos and atan2 cover angles; sqrt, hypot and abs cover distances; min, max and clamp cover bounds, with clamp defined as exactly min(max(v, low), high), so a range given backwards answers with the high bound. None of it reports an error: a value outside a function's domain simply answers with whatever non-finite Float the arithmetic already produces.",
			explanationPt: "hive.math é puro, e cada uma de suas treze funções recebe e responde com um Float — não existe uma versão inteira, porque Hive nunca amplia um número pelas suas costas. pi é a única constante; sin, cos, tan e suas inversas asin, acos e atan2 cobrem ângulos; sqrt, hypot e abs cobrem distâncias; min, max e clamp cobrem limites, com clamp definido como exatamente min(max(v, low), high), então um intervalo passado de trás para frente responde com o limite superior. Nada disso reporta um erro: um valor fora do domínio de uma função simplesmente responde com o Float não finito que a aritmética já produz.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	radius := 3.0
	area := hive.math.pi() * radius ** 2.0
	echo area

	echo hive.math.sqrt(hive.math.hypot(3.0, 4.0))
	echo hive.math.max(hive.math.min(2.0, 5.0), 1.0)
	echo hive.math.clamp(120.0, 0.0, 100.0)
}`, codePt: `proc main(): void {
	radius := 3.0
	area := hive.math.pi() * radius ** 2.0
	echo area

	echo hive.math.sqrt(hive.math.hypot(3.0, 4.0))
	echo hive.math.max(hive.math.min(2.0, 5.0), 1.0)
	echo hive.math.clamp(120.0, 0.0, 100.0)
}`)],
		),
		Slide(
			title: "JSON",
			titlePt: "JSON",
			explanation: "hive.json treats a Hive type declaration as the JSON schema itself. parse(text) with T derives a decoder for T at compile time and returns a Result whose Error carries the exact path that failed to decode; parse(text) with Table instead flattens the whole document into [path, value] rows, which hive.json.get looks up by a dotted path. encode(value) derives the encoder from the static type, so it can never fail — there is no Result to check on the way out. table(text) reads a JSON array of flat objects as a headered Table.",
			explanationPt: "hive.json trata uma declaração de tipo Hive como o próprio schema JSON. parse(text) with T deriva um decodificador para T em tempo de compilação e devolve um Result cujo Error carrega o caminho exato que falhou ao decodificar; parse(text) with Table, em vez disso, achata o documento inteiro em linhas [caminho, valor], que hive.json.get consulta por um caminho separado por pontos. encode(value) deriva o codificador a partir do tipo estático, então nunca pode falhar — não há Result para checar na saída. table(text) lê um array JSON de objetos simples como uma Table com cabeçalho.",
			examples: [
				Example(caption: "Encoding, and decoding into a declared type", captionPt: "Codificando, e decodificando em um tipo declarado", code: `type Greeting { name: Str }

proc main(): void {
	body := hive.json.encode(Greeting("ada"))
	echo body

	parsed := hive.json.parse(body) with Greeting
	if parsed is Result.Ok(g) {
		echo "hello, {g.name}!"
	}
}`, codePt: `type Greeting { name: Str }

proc main(): void {
	body := hive.json.encode(Greeting("ada"))
	echo body

	parsed := hive.json.parse(body) with Greeting
	if parsed is Result.Ok(g) {
		echo "olá, {g.name}!"
	}
}`),
				Example(caption: "Decoding into a Table", captionPt: "Decodificando em uma Table", code: `type Greeting { name: Str }

proc main(): void {
	body := hive.json.encode(Greeting("ada"))

	asTable := hive.json.parse(body) with Table
	if asTable is Result.Ok(table) {
		if hive.json.get(table, "name") is Result.Ok(name) {
			echo name
		}
	}
}`, codePt: `type Greeting { name: Str }

proc main(): void {
	body := hive.json.encode(Greeting("ada"))

	asTable := hive.json.parse(body) with Table
	if asTable is Result.Ok(table) {
		if hive.json.get(table, "name") is Result.Ok(name) {
			echo name
		}
	}
}`),
			],
		),
		Slide(
			title: "Files",
			titlePt: "Arquivos",
			explanation: "hive.file is general filesystem access, for what using doesn't cover. Contents move as a Str that holds bytes rather than validated text, so a binary file survives a read/write round trip untouched. read and lines pull a file in, write and append push one out, and delete, copy and move do what they say; exists and size ask without reading, and list and makeDir cover a directory. Everything fallible answers with a Result<_, hive.file.FileError> whose reason is a short tag: NotFound, Permission, Exists or Io.",
			explanationPt: "hive.file é acesso geral ao sistema de arquivos, para o que using não cobre. Conteúdos se movem como uma Str que guarda bytes em vez de texto validado, então um arquivo binário sobrevive intacto a uma ida e volta de leitura/escrita. read e lines trazem um arquivo para dentro, write e append o empurram para fora, e delete, copy e move fazem o que dizem; exists e size perguntam sem ler, e list e makeDir cobrem um diretório. Tudo que é falível responde com um Result<_, hive.file.FileError> cujo reason é uma tag curta: NotFound, Permission, Exists ou Io.",
			examples: [
				Example(caption: "Writing and reading", captionPt: "Escrevendo e lendo", code: `proc main(): void {
	hive.file.makeDir("./out")
	hive.file.write("./out/report.txt", "done")
	hive.file.append("./out/report.txt", "\nand done again")

	if hive.file.read("./out/report.txt") is Result.Ok(text) {
		echo text
	}
}`, codePt: `proc main(): void {
	hive.file.makeDir("./out")
	hive.file.write("./out/report.txt", "concluído")
	hive.file.append("./out/report.txt", "\ne concluído outra vez")

	if hive.file.read("./out/report.txt") is Result.Ok(text) {
		echo text
	}
}`),
				Example(caption: "Asking about a file", captionPt: "Perguntando sobre um arquivo", code: `proc main(): void {
	hive.file.makeDir("./out")
	hive.file.write("./out/report.txt", "done")

	echo hive.file.exists("./out/report.txt")
	if hive.file.size("./out/report.txt") is Result.Ok(n) {
		echo n
	}
	if hive.file.list("./out") is Result.Ok(names) {
		echo names
	}
}`, codePt: `proc main(): void {
	hive.file.makeDir("./out")
	hive.file.write("./out/report.txt", "concluído")

	echo hive.file.exists("./out/report.txt")
	if hive.file.size("./out/report.txt") is Result.Ok(n) {
		echo n
	}
	if hive.file.list("./out") is Result.Ok(names) {
		echo names
	}
}`),
			],
		),
		Slide(
			title: "Spreadsheets",
			titlePt: "Planilhas",
			explanation: "using reads more than a CSV. as xlsx and as ods each read a whole workbook and answer with a Result<Table[dyn], hive.TableError> — one Table per sheet, in document order, so an empty sheet is an empty Table rather than a missing one. Both readers are dependency-free. An xlsx cell arrives as the file stores it, with one exception: a date is kept internally as a day count, so the cell's own number format is consulted to catch exactly those and render them as a real date. An ods stores real dates already, so nothing there needs undoing.",
			explanationPt: "using lê mais do que um CSV. as xlsx e as ods leem cada um uma planilha inteira e respondem com um Result<Table[dyn], hive.TableError> — uma Table por aba, na ordem do documento, então uma aba vazia é uma Table vazia em vez de uma ausente. Os dois leitores não têm dependências. Uma célula de xlsx chega como o arquivo a guarda, com uma exceção: uma data é guardada internamente como uma contagem de dias, então o formato de número da própria célula é consultado para pegar exatamente essas e renderizá-las como uma data de verdade. Um ods já guarda datas de verdade, então nada ali precisa ser desfeito.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	sheets := using "./ledger.xlsx" as xlsx
	if sheets is Result.Ok(tables) {
		if tables bounds 0 {
			echo len(tables[0])
		}
	} else if sheets is Result.Error(err) {
		echo "no workbook yet: {err.message}"
	}
}`, codePt: `proc main(): void {
	sheets := using "./ledger.xlsx" as xlsx
	if sheets is Result.Ok(tables) {
		if tables bounds 0 {
			echo len(tables[0])
		}
	} else if sheets is Result.Error(err) {
		echo "ainda sem planilha: {err.message}"
	}
}`)],
		),
		Slide(
			title: "Terminal and processes",
			titlePt: "Terminal e processos",
			explanation: "hive.term is line-oriented terminal I/O: print writes to stdout, status writes to stderr — what a program is doing, as against what it was asked for — isTerminal says whether standard error is a person or a pipe, and read/readSecret block for a line of input, the second with the terminal's echo turned off. args() reads the command line, and exit(code) ends the program on the spot. Running another program is two calls apart by who is talking to the terminal: exec hands back everything the command wrote and turns a nonzero exit into a Result.Error, while attach gives the command this program's own terminal and answers with its exit status. Neither ever touches a shell, so nothing in an argument can be read as one.",
			explanationPt: "hive.term é I/O de terminal orientado a linhas: print escreve no stdout, status escreve no stderr — o que um programa está fazendo, em contraste com o que foi pedido a ele — isTerminal diz se a saída de erro padrão é uma pessoa ou um pipe, e read/readSecret bloqueiam por uma linha de entrada, o segundo com o eco do terminal desligado. args() lê a linha de comando, e exit(code) termina o programa na hora. Rodar outro programa é duas chamadas separadas por quem está falando com o terminal: exec devolve tudo que o comando escreveu e transforma uma saída diferente de zero em um Result.Error, enquanto attach dá ao comando o próprio terminal deste programa e responde com seu status de saída. Nenhum dos dois toca em um shell, então nada em um argumento pode ser lido como um.",
			examples: [
				Example(caption: "Running another program", captionPt: "Rodando outro programa", code: `proc main(): void {
	result := hive.term.exec("hostname", [], "")
	if result is Result.Ok(output) {
		echo "this machine is called: {output}"
	} else if result is Result.Error(why) {
		echo "could not run hostname: {why.message}"
	}
}`, codePt: `proc main(): void {
	result := hive.term.exec("hostname", [], "")
	if result is Result.Ok(output) {
		echo "esta máquina se chama: {output}"
	} else if result is Result.Error(why) {
		echo "não foi possível rodar hostname: {why.message}"
	}
}`),
				Example(caption: "Asking about the terminal itself", captionPt: "Perguntando sobre o próprio terminal", code: `proc main(): void {
	echo hive.term.isTerminal()
	echo hive.term.args()
}`, codePt: `proc main(): void {
	echo hive.term.isTerminal()
	echo hive.term.args()
}`),
			],
		),
		Slide(
			title: "Time",
			titlePt: "Tempo",
			explanation: "Times in Hive are plain Ints — Unix seconds — so they need no type of their own to pass around, store or compare. now() reads the clock; timezone() and timezoneOffset() say where the program thinks it is; format renders a time in local time with a strftime-style template — %Y, %m, %d, %H, %M, %S and the rest. An escape it doesn't recognise passes straight through rather than failing.",
			explanationPt: "Horários em Hive são Ints simples — segundos Unix — então não precisam de um tipo próprio para circular, ser guardados ou comparados. now() lê o relógio; timezone() e timezoneOffset() dizem onde o programa pensa que está; format renderiza um horário em hora local com um template no estilo strftime — %Y, %m, %d, %H, %M, %S e o resto. Um escape que ele não reconhece passa direto em vez de falhar.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	stamp := hive.time.now()
	echo hive.time.format(stamp, "%Y-%m-%d %H:%M")
	echo hive.time.timezone()
	echo hive.time.timezoneOffset()
}`, codePt: `proc main(): void {
	stamp := hive.time.now()
	echo hive.time.format(stamp, "%Y-%m-%d %H:%M")
	echo hive.time.timezone()
	echo hive.time.timezoneOffset()
}`)],
		),
		Slide(
			title: "Environment variables",
			titlePt: "Variáveis de ambiente",
			explanation: "hive.env.get resolves a name in one order: the .env file beside the program, then the .env in the parent folder, then the OS environment — and answers with a Result, since a variable that was never set is an ordinary outcome rather than a crash. The .env file is read once, on the first get: blank lines and # comments are ignored, an export prefix is allowed and stripped, and a quoted value has its quotes removed.",
			explanationPt: "hive.env.get resolve um nome em uma ordem: o arquivo .env ao lado do programa, depois o .env na pasta pai, depois o ambiente do sistema operacional — e responde com um Result, já que uma variável que nunca foi definida é um resultado comum, não uma falha. O arquivo .env é lido uma vez, no primeiro get: linhas vazias e comentários com # são ignorados, um prefixo export é permitido e removido, e um valor entre aspas tem as aspas removidas.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	result := hive.env.get("DATABASE_URL")
	if result is Result.Ok(url) {
		echo "DATABASE_URL is {url}"
	} else if result is Result.Error(why) {
		echo "DATABASE_URL is not set: {why.message}"
	}
}`, codePt: `proc main(): void {
	result := hive.env.get("DATABASE_URL")
	if result is Result.Ok(url) {
		echo "DATABASE_URL é {url}"
	} else if result is Result.Error(why) {
		echo "DATABASE_URL não está definida: {why.message}"
	}
}`)],
		),
		Slide(
			title: "Networking: HTTP",
			titlePt: "Rede: HTTP",
			explanation: "hive.net's HTTP corner needs no external dependency in either direction. httpServe(port, handler) starts a server that blocks forever, calling a proc(HttpRequest): HttpResponse once per request on a thread of its own — exactly the shape of the handler serving this very page. httpRequest performs a client request and answers with a Result, since getting no response at all — a bad URL, a refused connection, a timeout — is a Result.Error rather than an empty HttpResponse. resolve and localAddress round out the module: the first looks up every address behind a name, the second is the address another machine would reach this one on.",
			explanationPt: "O canto HTTP de hive.net não precisa de dependência externa em nenhuma das direções. httpServe(port, handler) inicia um servidor que bloqueia para sempre, chamando um proc(HttpRequest): HttpResponse uma vez por requisição, cada uma em sua própria thread — exatamente a forma do handler que está servindo esta própria página. httpRequest realiza uma requisição de cliente e responde com um Result, já que não obter resposta alguma — uma URL inválida, uma conexão recusada, um timeout — é um Result.Error em vez de um HttpResponse vazio. resolve e localAddress completam o módulo: o primeiro busca todos os endereços atrás de um nome, o segundo é o endereço pelo qual outra máquina alcançaria esta.",
			examples: [Example(caption: "", captionPt: "", code: `proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	headers := [["Content-Type", "text/plain"]]
	return hive.net.HttpResponse(200, headers, "hello, {request.url}!\n")
}

proc main(): void {
	hive.net.httpServe(8080, handle)
}`, codePt: `proc handle(request: hive.net.HttpRequest): hive.net.HttpResponse {
	headers := [["Content-Type", "text/plain"]]
	return hive.net.HttpResponse(200, headers, "olá, {request.url}!\n")
}

proc main(): void {
	hive.net.httpServe(8080, handle)
}`)],
		),
		Slide(
			title: "Networking: WebSockets",
			titlePt: "Rede: WebSockets",
			explanation: "hive.net's WebSocket support is RFC 6455 end to end: the handshake, frame headers, masking, ping/pong and fragmentation are the runtime's business, and a program only ever sees whole messages as a Str. wsServe(port, handler) serves connections the same shape httpServe serves requests, calling a proc(WsConnection): void once per connection; wsConnect dials one as a client, and wsRequest reads back the HttpRequest that opened it. wsClose ends a connection from this side; a peer that hangs up on its own answers as \"Closed\" — the ordinary end of a conversation, not a failure to report.",
			explanationPt: "O suporte a WebSocket de hive.net é RFC 6455 do início ao fim: o handshake, os cabeçalhos de frame, a mascaração, o ping/pong e a fragmentação são responsabilidade do runtime, e um programa só vê mensagens inteiras como uma Str. wsServe(port, handler) serve conexões da mesma forma que httpServe serve requisições, chamando um proc(WsConnection): void uma vez por conexão; wsConnect disca uma como cliente, e wsRequest lê de volta o HttpRequest que a abriu. wsClose termina uma conexão deste lado; um par que desliga por conta própria responde como \"Closed\" — o fim comum de uma conversa, não uma falha a ser reportada.",
			examples: [Example(caption: "", captionPt: "", code: `proc handle(conn: hive.net.WsConnection): void {
	if hive.net.wsReceive(conn) is Result.Ok(msg) {
		hive.net.wsSend(conn, "echo: {msg}")
	}
}

proc main(): void {
	hive.net.wsServe(8081, handle)
}`, codePt: `proc handle(conn: hive.net.WsConnection): void {
	if hive.net.wsReceive(conn) is Result.Ok(msg) {
		hive.net.wsSend(conn, "eco: {msg}")
	}
}

proc main(): void {
	hive.net.wsServe(8081, handle)
}`)],
		),
		Slide(
			title: "Networking: raw TCP",
			titlePt: "Rede: TCP bruto",
			explanation: "Raw TCP is a stream, not a queue of messages, so hive.net's socket calls move bytes rather than whole messages. socketConnect dials out and socketServe(port, handler) listens, calling a proc(SocketConnection): void once per connection; socketReceive(conn, bytes) does a short read — fewer bytes than asked for is normal, not an error — while socketReceiveLine reads up to the next newline and drops it. socketPeer names who is on the other end, and socketClose ends the stream. A SocketError's reason is Connect, Closed, Send or Receive.",
			explanationPt: "TCP bruto é um fluxo, não uma fila de mensagens, então as chamadas de socket de hive.net movem bytes em vez de mensagens inteiras. socketConnect disca para fora e socketServe(port, handler) escuta, chamando um proc(SocketConnection): void uma vez por conexão; socketReceive(conn, bytes) faz uma leitura curta — receber menos bytes do que foi pedido é normal, não um erro — enquanto socketReceiveLine lê até a próxima nova linha e a descarta. socketPeer nomeia quem está do outro lado, e socketClose termina o fluxo. O reason de um SocketError é Connect, Closed, Send ou Receive.",
			examples: [Example(caption: "", captionPt: "", code: `proc handle(conn: hive.net.SocketConnection): void {
	if hive.net.socketReceiveLine(conn) is Result.Ok(line) {
		hive.net.socketSend(conn, "you said: {line}\n")
	}
	hive.net.socketClose(conn)
}

proc main(): void {
	hive.net.socketServe(9000, handle)
}`, codePt: `proc handle(conn: hive.net.SocketConnection): void {
	if hive.net.socketReceiveLine(conn) is Result.Ok(line) {
		hive.net.socketSend(conn, "você disse: {line}\n")
	}
	hive.net.socketClose(conn)
}

proc main(): void {
	hive.net.socketServe(9000, handle)
}`)],
		),
		Slide(
			title: "Cryptography",
			titlePt: "Criptografia",
			explanation: "hive.crypto is pure, so it works in a func as well as a proc. sha256 and sha512 hash, and hmacSha256 authenticates with a key. encrypt and decrypt seal a string under a password with AES-256-GCM, using a fresh salt and nonce every call so the same text never encrypts alike twice; base64Encode and base64Decode move between text and base64, and randomHex draws bytes at random. jwtSign, jwtVerify and jwtDecode cover HS256 JSON Web Tokens end to end — jwtVerify checks the signature and expiry and accepts only HS256, closing off the classic algorithm-confusion attack outright, while jwtDecode reads the claims without verifying anything, and jwtHeader reads just alg/typ/kid.",
			explanationPt: "hive.crypto é puro, então funciona tanto em um func quanto em um proc. sha256 e sha512 calculam hash, e hmacSha256 autentica com uma chave. encrypt e decrypt selam uma string sob uma senha com AES-256-GCM, usando um salt e um nonce novos em cada chamada, então o mesmo texto nunca é criptografado da mesma forma duas vezes; base64Encode e base64Decode movem entre texto e base64, e randomHex sorteia bytes aleatórios. jwtSign, jwtVerify e jwtDecode cobrem JSON Web Tokens HS256 do início ao fim — jwtVerify verifica a assinatura e a expiração e aceita apenas HS256, eliminando de cara o clássico ataque de confusão de algoritmo, enquanto jwtDecode lê as claims sem verificar nada, e jwtHeader lê apenas alg/typ/kid.",
			examples: [
				Example(caption: "Hashing", captionPt: "Calculando hash", code: `proc main(): void {
	echo hive.crypto.sha256("hive")
	echo hive.crypto.sha512("hive")
	echo hive.crypto.hmacSha256("hive", "secret")
}`, codePt: `proc main(): void {
	echo hive.crypto.sha256("hive")
	echo hive.crypto.sha512("hive")
	echo hive.crypto.hmacSha256("hive", "secret")
}`),
				Example(caption: "Encryption", captionPt: "Cifrando e decifrando", code: `proc main(): void {
	sealed := hive.crypto.encrypt("a secret", "password")
	if hive.crypto.decrypt(sealed, "password") is Result.Ok(plain) {
		echo plain
	}
}`, codePt: `proc main(): void {
	sealed := hive.crypto.encrypt("um segredo", "password")
	if hive.crypto.decrypt(sealed, "password") is Result.Ok(plain) {
		echo plain
	}
}`),
				Example(caption: "Encoding and random bytes", captionPt: "Codificação e bytes aleatórios", code: `proc main(): void {
	encoded := hive.crypto.base64Encode("hive")
	if hive.crypto.base64Decode(encoded) is Result.Ok(decoded) {
		echo decoded
	}
	echo hive.crypto.randomHex(8)
}`, codePt: `proc main(): void {
	encoded := hive.crypto.base64Encode("hive")
	if hive.crypto.base64Decode(encoded) is Result.Ok(decoded) {
		echo decoded
	}
	echo hive.crypto.randomHex(8)
}`),
				Example(caption: "JWTs", captionPt: "JWTs", code: `type Claims { user: Str }

proc main(): void {
	token := hive.crypto.jwtSign(Claims("ada"), "secret")

	verified := hive.crypto.jwtVerify(token, "secret") with Claims
	if verified is Result.Ok(claims) {
		echo claims.user
	}
	echo hive.crypto.jwtHeader(token)
}`, codePt: `type Claims { user: Str }

proc main(): void {
	token := hive.crypto.jwtSign(Claims("ada"), "secret")

	verified := hive.crypto.jwtVerify(token, "secret") with Claims
	if verified is Result.Ok(claims) {
		echo claims.user
	}
	echo hive.crypto.jwtHeader(token)
}`),
			],
		),
		Slide(
			title: "SQL",
			titlePt: "SQL",
			explanation: "A query declaration is a func whose body is inline SQL and whose return type describes its rows. Columns are matched to fields by name, not position, so reordering a SELECT can never silently remap them, and values are always bound as parameters — never spliced into the text — so nothing a caller supplies can change what the statement means. connect opens a single connection and pool a whole pool of them, both answering with a Result<SqlConnection, SqlError>; close lets one go. SQL assembled at run time, rather than declared as a query, goes through run raw instead — untyped by construction, and easy to grep for.",
			explanationPt: "Uma declaração query é um func cujo corpo é SQL inline e cujo tipo de retorno descreve suas linhas. Colunas são associadas a campos pelo nome, não pela posição, então reordenar um SELECT nunca pode remapeá-las silenciosamente, e valores são sempre vinculados como parâmetros — nunca inseridos diretamente no texto — então nada que quem chama fornecer pode mudar o que a instrução significa. connect abre uma única conexão e pool abre um pool inteiro delas, ambos respondendo com um Result<SqlConnection, SqlError>; close libera uma. SQL montado em tempo de execução, em vez de declarado como uma query, passa por run raw em vez disso — sem tipo por construção, e fácil de encontrar com grep.",
			examples: [Example(caption: "", captionPt: "", code: `type User { id: Int, name: Str }

query findUser(name: Str): User[dyn] {
	SELECT id, name FROM users WHERE name = {name}
}

proc main(): void {
	pooled := hive.sql.pool(hive.sql.DatabaseDriver.SQLite(), "file::memory:?cache=shared", 1, 1)
	if pooled is Result.Ok(db) {
		using db run raw "CREATE TABLE users (id INTEGER, name TEXT)"
		using db run raw "INSERT INTO users (id, name) VALUES (1, 'ada')"

		found := using db run findUser("ada")
		if found is Result.Ok(users) {
			echo users
		}
		hive.sql.close(db)
	} else if pooled is Result.Error(err) {
		echo "could not open the database: {err.message}"
	}
}`, codePt: `type User { id: Int, name: Str }

query findUser(name: Str): User[dyn] {
	SELECT id, name FROM users WHERE name = {name}
}

proc main(): void {
	pooled := hive.sql.pool(hive.sql.DatabaseDriver.SQLite(), "file::memory:?cache=shared", 1, 1)
	if pooled is Result.Ok(db) {
		using db run raw "CREATE TABLE users (id INTEGER, name TEXT)"
		using db run raw "INSERT INTO users (id, name) VALUES (1, 'ada')"

		found := using db run findUser("ada")
		if found is Result.Ok(users) {
			echo users
		}
		hive.sql.close(db)
	} else if pooled is Result.Error(err) {
		echo "não foi possível abrir o banco de dados: {err.message}"
	}
}`)],
		),
		Slide(
			title: "The UI module",
			titlePt: "O módulo de UI",
			explanation: "hive.ui builds an interface as a value: a View is a tree of widgets, and every one of them takes the same two things, its attributes and then its own payload. row and column lay out children; text, image, icon and link show something; button, input, textarea, checkbox and select ask for something; table shows a Table, and spacer, spinner, none and overlay round out the set. Attributes are just as closed a set: gap, pad, width, height, grow, align, justify and scroll lay out; size, heading, tone and background style; disabled, busy, placeholder, hint and kind describe state; and on, onDismiss, onInput, onSubmit, onChoose, onToggle, onPick and onSort carry an event, for a window rather than this kind of page. Align, Justify, TextSize, Tone, Axis, InputKind and Icon are the enumerations behind them, reached like any other library type.\n\nhtml(view) renders a tree as an HTML fragment, and page(title, view) as a whole document with a stylesheet already built in, light and dark alike — which is exactly what an httpServe handler can answer a request with directly, and what every screen in this tour but its code samples is. The same tree, shown instead by window(title, view, update, state), becomes a live page: update is a fold over its events, the same shape a hive.syslink handler folds over a mailbox, so a window has an address and needs no mutex of its own.\n\nA scene is the one widget that only a window can draw. box, sphere, cylinder, ground, label and line are its shapes, positioned with at and turn and coloured with paint; eye, aim, lens and fog place and dress the camera; grab and crosshair capture the mouse, and onFrame, onKeyDown, onKeyUp, onLook and onGrab are the events a scene alone reports. A served page renders a scene's box empty — there is no socket for frames to travel down — so the two examples below are shown as code only: open either in a window to actually see it.",
			explanationPt: "hive.ui constrói uma interface como um valor: uma View é uma árvore de widgets, e cada um deles recebe as mesmas duas coisas, seus atributos e depois sua própria carga. row e column organizam filhos; text, image, icon e link mostram algo; button, input, textarea, checkbox e select pedem algo; table mostra uma Table, e spacer, spinner, none e overlay completam o conjunto. Os atributos são um conjunto igualmente fechado: gap, pad, width, height, grow, align, justify e scroll organizam; size, heading, tone e background estilizam; disabled, busy, placeholder, hint e kind descrevem estado; e on, onDismiss, onInput, onSubmit, onChoose, onToggle, onPick e onSort carregam um evento, para uma window e não para este tipo de página. Align, Justify, TextSize, Tone, Axis, InputKind e Icon são as enumerações por trás deles, acessadas como qualquer outro tipo da biblioteca.\n\nhtml(view) renderiza uma árvore como um fragmento HTML, e page(title, view) como um documento inteiro com uma stylesheet já embutida, claro e escuro igualmente — que é exatamente o que um handler de httpServe pode usar para responder a uma requisição diretamente, e o que toda tela deste tour, exceto suas amostras de código, é. A mesma árvore, mostrada em vez disso por window(title, view, update, state), se torna uma página viva: update é um fold sobre seus eventos, a mesma forma que um handler de hive.syslink faz fold sobre uma caixa de mensagens, então uma window tem um endereço e não precisa de mutex próprio.\n\nUma scene é o único widget que somente uma window consegue desenhar. box, sphere, cylinder, ground, label e line são suas formas, posicionadas com at e turn e coloridas com paint; eye, aim, lens e fog posicionam e ajustam a câmera; grab e crosshair capturam o mouse, e onFrame, onKeyDown, onKeyUp, onLook e onGrab são os eventos que somente uma scene reporta. Uma página servida renderiza a caixa de uma scene vazia — não há um socket para os frames viajarem — então os dois exemplos abaixo são mostrados apenas como código: abra qualquer um deles em uma window para realmente ver.",
			examples: [
				Example(caption: "A page, served directly", captionPt: "Uma página, servida diretamente", code: `proc main(): void {
	view := hive.ui.column([hive.ui.pad(24), hive.ui.gap(12)], [
		hive.ui.text([hive.ui.size(hive.ui.TextSize.Title()), hive.ui.heading(1)], "Hive Tour"),
		hive.ui.row([hive.ui.gap(8)], [
			hive.ui.input([hive.ui.placeholder("your name")], ""),
			hive.ui.button([hive.ui.tone(hive.ui.Tone.Good())], "Say hi"),
		]),
		hive.ui.link([hive.ui.background(hive.ui.Tone.Good())], "/1", "Start →"),
	])

	body := hive.ui.page("Hive", view)   // a whole document, served directly
	echo len(body)
}`, codePt: `proc main(): void {
	view := hive.ui.column([hive.ui.pad(24), hive.ui.gap(12)], [
		hive.ui.text([hive.ui.size(hive.ui.TextSize.Title()), hive.ui.heading(1)], "Tour do Hive"),
		hive.ui.row([hive.ui.gap(8)], [
			hive.ui.input([hive.ui.placeholder("seu nome")], ""),
			hive.ui.button([hive.ui.tone(hive.ui.Tone.Good())], "Dizer oi"),
		]),
		hive.ui.link([hive.ui.background(hive.ui.Tone.Good())], "/1", "Começar →"),
	])

	body := hive.ui.page("Hive", view)   // um documento inteiro, servido diretamente
	echo len(body)
}`),
				Example(caption: "A 3D scene, in a window", captionPt: "Uma cena 3D, em uma window", code: `type Msg { Tick }

func view(model: Int): hive.ui.View {
	shapes := [
		hive.ui.ground([hive.ui.paint(hive.ui.Tone.HEX("#2d5c34"))], 20.0, 20.0),
		hive.ui.box(
			[hive.ui.at(0.0, 0.5, -3.0), hive.ui.paint(hive.ui.Tone.HEX("#b5651d"))],
			1.0, 1.0, 1.0,
		),
		hive.ui.sphere([hive.ui.at(2.0, 1.0, -4.0), hive.ui.paint(hive.ui.Tone.HEX("#e0c341"))], 1.0),
	]
	return hive.ui.scene(
		[hive.ui.grow(1), hive.ui.eye(0.0, 1.6, 4.0), hive.ui.aim(0.0, 0.0), hive.ui.lens(70), hive.ui.fog(60)],
		shapes,
	)
}

proc update(model: Int, msg: Msg, envelope: hive.syslink.Envelope): Int {
	return model
}

proc main(): void {
	hive.ui.window("A 3D scene", view, update, 0)
}`, codePt: `type Msg { Tick }

func view(model: Int): hive.ui.View {
	shapes := [
		hive.ui.ground([hive.ui.paint(hive.ui.Tone.HEX("#2d5c34"))], 20.0, 20.0),
		hive.ui.box(
			[hive.ui.at(0.0, 0.5, -3.0), hive.ui.paint(hive.ui.Tone.HEX("#b5651d"))],
			1.0, 1.0, 1.0,
		),
		hive.ui.sphere([hive.ui.at(2.0, 1.0, -4.0), hive.ui.paint(hive.ui.Tone.HEX("#e0c341"))], 1.0),
	]
	return hive.ui.scene(
		[hive.ui.grow(1), hive.ui.eye(0.0, 1.6, 4.0), hive.ui.aim(0.0, 0.0), hive.ui.lens(70), hive.ui.fog(60)],
		shapes,
	)
}

proc update(model: Int, msg: Msg, envelope: hive.syslink.Envelope): Int {
	return model
}

proc main(): void {
	hive.ui.window("Uma cena 3D", view, update, 0)
}`),
				Example(caption: "Animating it, and reacting to a frame", captionPt: "Animando, e reagindo a um frame", code: `type Msg {
	Tick { ms: Int }
}

func view(angle: Float): hive.ui.View {
	return hive.ui.scene(
		[
			hive.ui.grow(1),
			hive.ui.eye(0.0, 1.5, 5.0),
			hive.ui.aim(0.0, 0.0),
			hive.ui.onFrame(Msg.Tick(_)),
		],
		[
			hive.ui.ground([hive.ui.paint(hive.ui.Tone.Muted())], 10.0, 10.0),
			hive.ui.box(
				[hive.ui.at(0.0, 1.0, 0.0), hive.ui.turn(0.0, angle, 0.0), hive.ui.paint(hive.ui.Tone.Good())],
				1.0, 1.0, 1.0,
			),
		],
	)
}

// A scene's onFrame reports how many milliseconds the last frame took, so
// the turn this box makes is in real seconds rather than in frames — the
// same box spins at the same speed at thirty frames a second or sixty.
proc spin(angle: Float, msg: Msg, envelope: hive.syslink.Envelope): Float {
	if msg is Msg.Tick(ms) {
		return angle + hive.conv.itf(ms) * 0.002
	}
	return angle
}

proc main(): void {
	hive.ui.window("A spinning box", view, spin, 0.0)
}`, codePt: `type Msg {
	Tick { ms: Int }
}

func view(angle: Float): hive.ui.View {
	return hive.ui.scene(
		[
			hive.ui.grow(1),
			hive.ui.eye(0.0, 1.5, 5.0),
			hive.ui.aim(0.0, 0.0),
			hive.ui.onFrame(Msg.Tick(_)),
		],
		[
			hive.ui.ground([hive.ui.paint(hive.ui.Tone.Muted())], 10.0, 10.0),
			hive.ui.box(
				[hive.ui.at(0.0, 1.0, 0.0), hive.ui.turn(0.0, angle, 0.0), hive.ui.paint(hive.ui.Tone.Good())],
				1.0, 1.0, 1.0,
			),
		],
	)
}

// O onFrame de uma scene reporta quantos milissegundos o último frame levou,
// então o giro que esta caixa faz é em segundos reais, não em frames — a
// mesma caixa gira na mesma velocidade a trinta quadros por segundo ou a sessenta.
proc spin(angle: Float, msg: Msg, envelope: hive.syslink.Envelope): Float {
	if msg is Msg.Tick(ms) {
		return angle + hive.conv.itf(ms) * 0.002
	}
	return angle
}

proc main(): void {
	hive.ui.window("Uma caixa girando", view, spin, 0.0)
}`),
			],
		),
		Slide(
			title: "Testing",
			titlePt: "Testes",
			explanation: "A test is a top-level declaration, named in prose because the name is documentation rather than something anything calls. `hive test entrypoint.hive` runs every test the entrypoint reaches, with no framework and no assertion vocabulary beyond the assert the language already has — and reports coverage, including which declarations were never exercised, on every run without a separate flag. This file has no main at all — a file holding only tests needs none — so it runs with `hive test`, not `hive run`.",
			explanationPt: "Um test é uma declaração de nível superior, nomeada em prosa porque o nome é documentação, não algo que alguma coisa chama. `hive test entrypoint.hive` roda todo test que o entrypoint alcança, sem framework e sem vocabulário de asserção além do assert que a linguagem já tem — e reporta cobertura, incluindo quais declarações nunca foram exercitadas, em toda execução sem uma flag separada. Este arquivo não tem main algum — um arquivo só com tests não precisa de um — então ele roda com `hive test`, não com `hive run`.",
			examples: [Example(caption: "", captionPt: "", code: `type Item {
	name:  Str
	price: Int
}

func total(items: Item[]): Int {
	mut sum := 0
	for each item in items {
		sum = sum + item.price
	}
	return sum
}

test "an empty cart costs nothing" {
	Item[0] empty = []
	assert total(empty) == 0
}

test "two items add up" {
	assert total([Item("wax", 5), Item("comb", 3)]) == 8
}`, codePt: `type Item {
	name:  Str
	price: Int
}

func total(items: Item[]): Int {
	mut sum := 0
	for each item in items {
		sum = sum + item.price
	}
	return sum
}

test "um carrinho vazio não custa nada" {
	Item[0] empty = []
	assert total(empty) == 0
}

test "dois itens se somam" {
	assert total([Item("wax", 5), Item("comb", 3)]) == 8
}`)],
		),
		Slide(
			title: "Distributed actors",
			titlePt: "Atores distribuídos",
			explanation: "hive.syslink gives a program addressable services, in this process or on another machine, reached by the identical statement either way. spawn starts one and register publishes it under an atom; at reaches a service on this node and on reaches one on another, both without any I/O. A service's handler is a fold over its mailbox — proc(State, Message, Envelope): State — so there is no mutex anywhere: the fold is the mutex, and answer inside it is how a deferred reply is sent. self reads a handler's own address, monitor asks to be told if another address stops, and stop ends one outright. A crash inside one service kills only that service and leaves the rest of the node running.\n\nlisten opens this node to others at an endpoint — an ip:port — and node/peers say who it is and who else it is currently connected to. Two nodes need nothing shared beyond a cluster key, written to ~/.hive/syslink.key on first run: copy that file to the second machine, or set HIVE_SYSLINK_KEY the same on both, and every connection between them is TLS 1.3 either way.",
			explanationPt: "hive.syslink dá a um programa serviços endereçáveis, neste processo ou em outra máquina, alcançados pela mesma instrução de qualquer forma. spawn inicia um e register o publica sob um átomo; at alcança um serviço neste nó e on alcança um em outro, ambos sem nenhum I/O. O handler de um serviço é um fold sobre sua caixa de mensagens — proc(State, Message, Envelope): State — então não há mutex em lugar nenhum: o fold é o mutex, e answer dentro dele é como uma resposta adiada é enviada. self lê o próprio endereço de um handler, monitor pede para ser avisado se outro endereço parar, e stop termina um de vez. Uma falha dentro de um serviço mata apenas aquele serviço e deixa o resto do nó rodando.\n\nlisten abre este nó para outros em um endpoint — um ip:port — e node/peers dizem quem ele é e com quem mais está conectado atualmente. Dois nós não precisam de nada compartilhado além de uma chave de cluster, escrita em ~/.hive/syslink.key na primeira execução: copie esse arquivo para a segunda máquina, ou defina HIVE_SYSLINK_KEY da mesma forma nas duas, e toda conexão entre elas é TLS 1.3 de qualquer forma.",
			examples: [
				Example(caption: "A service on this node", captionPt: "Um serviço neste nó", code: `type Note {
	Say   { text: Str }
	Count
	Total { count: Int }
}

proc tally(state: Int, msg: Note, envelope: hive.syslink.Envelope): Int {
	if msg is Note.Say(text) {
		echo text
		return state
	} else if msg is Note.Count {
		hive.syslink.answer(envelope, Note.Total(state))
		return state + 1
	}
	return state
}

proc main(): void {
	address := hive.syslink.spawn(tally, 0)
	hive.syslink.register(#Cache, address)

	async address(Note.Say("hi"))                    // fire and forget
	reply := address(Note.Count()) with timeout 250   // send and wait, bounded
	if reply is Result.Ok(msg) {
		echo msg
	}
}`, codePt: `type Note {
	Say   { text: Str }
	Count
	Total { count: Int }
}

proc tally(state: Int, msg: Note, envelope: hive.syslink.Envelope): Int {
	if msg is Note.Say(text) {
		echo text
		return state
	} else if msg is Note.Count {
		hive.syslink.answer(envelope, Note.Total(state))
		return state + 1
	}
	return state
}

proc main(): void {
	address := hive.syslink.spawn(tally, 0)
	hive.syslink.register(#Cache, address)

	async address(Note.Say("oi"))                     // dispara e esquece
	reply := address(Note.Count()) with timeout 250   // envia e espera, limitado
	if reply is Result.Ok(msg) {
		echo msg
	}
}`),
				Example(caption: "The same service, truly distributed", captionPt: "O mesmo serviço, verdadeiramente distribuído", code: `type Note {
	Say     { text: Str }
	HowMany
	Counted { seen: Int }
}

proc inbox(seen: Int, note: Note, from: hive.syslink.Envelope): Int {
	if note is Note.Say(text) {
		echo "heard: {text}"
		return seen + 1
	} else if note is Note.HowMany {
		hive.syslink.answer(from, Note.Counted(seen))
		return seen
	}
	return seen
}

// Run this exact program on two machines: a node is identified by where it
// is, so nothing about the two processes differs but the addresses typed
// in below — 192.168.1.10:9100 and 192.168.1.11:9100, one each way round.
proc main(): void {
	echo "This node's own ip:port?"
	me := hive.term.read()
	echo "The other node's ip:port?"
	peer := hive.term.read()

	if hive.syslink.listen(me) is Result.Error(err) {
		panic err
	}

	box := hive.syslink.spawn(inbox, 0)
	hive.syslink.register(#Inbox, box)

	mine := hive.syslink.at(#Inbox)
	theirs := hive.syslink.on(peer, #Inbox)

	async theirs(Note.Say("hello from {me}"))
	hive.task.sleep(500)
	echo "peers connected: {len(hive.syslink.peers())}"

	if theirs(Note.HowMany()) with timeout 4000 is Result.Ok(reply) {
		echo "the other node answered: {reply}"
	}
}`, codePt: `type Note {
	Say     { text: Str }
	HowMany
	Counted { seen: Int }
}

proc inbox(seen: Int, note: Note, from: hive.syslink.Envelope): Int {
	if note is Note.Say(text) {
		echo "ouvi: {text}"
		return seen + 1
	} else if note is Note.HowMany {
		hive.syslink.answer(from, Note.Counted(seen))
		return seen
	}
	return seen
}

// Rode este mesmo programa em duas máquinas: um nó é identificado por onde
// ele está, então nada nos dois processos difere além dos endereços digitados
// abaixo — 192.168.1.10:9100 e 192.168.1.11:9100, um de cada lado.
proc main(): void {
	echo "O ip:port deste nó?"
	me := hive.term.read()
	echo "O ip:port do outro nó?"
	peer := hive.term.read()

	if hive.syslink.listen(me) is Result.Error(err) {
		panic err
	}

	box := hive.syslink.spawn(inbox, 0)
	hive.syslink.register(#Inbox, box)

	mine := hive.syslink.at(#Inbox)
	theirs := hive.syslink.on(peer, #Inbox)

	async theirs(Note.Say("olá de {me}"))
	hive.task.sleep(500)
	echo "peers conectados: {len(hive.syslink.peers())}"

	if theirs(Note.HowMany()) with timeout 4000 is Result.Ok(reply) {
		echo "o outro nó respondeu: {reply}"
	}
}`),
