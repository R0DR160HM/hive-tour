	}
}`),
				Example(caption: "Encoding and random bytes", captionPt: "Codificação e bytes aleatórios", code: `proc main(): void {
	encoded := hive.crypto.base64Encode("hive")
	if hive.crypto.base64Decode(encoded) is Result.Ok(decoded) {
		echo decoded
	}
