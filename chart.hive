// The tour as a chart: every slide an element, in the colour of the chapter it
// belongs to, with its number and the one piece of Hive it is about.
//
// It is the picture a periodic table makes of chemistry — the whole subject at
// once, in families — made of a language small enough for the picture to be
// complete. The contents page is this chart, and so is the foot of the front
// page, where the claim that the language can be learned in a day is easier to
// believe for having all of it in view.
//
// The symbol on each tile is a real piece of the language wherever there is
// one — the keyword, the operator, the type or the module the slide teaches —
// so a reader who has finished the tour can read the chart as a summary of
// it. A slide is found by its English title, for the reason ./home and
// ./grammar find them that way, and chart.test.hive holds every slide in the
// tour to having a symbol here.

type Symbol {
	title:  Str
	symbol: Str
}

func symbol(title: Str): Str {
	for each entry in symbols() {
		if entry.title == title {
			return entry.symbol
		}
	}
	return ""
}

func symbols(): Symbol[dyn] {
	return [
		Symbol(title: "Hello, World", symbol: "main"),
		Symbol(title: "Running these examples", symbol: "run"),
		Symbol(title: "Every command", symbol: "hive"),
		Symbol(title: "Comments", symbol: "//"),
		Symbol(title: "Names have shapes", symbol: "Name"),
		Symbol(title: "Variables", symbol: ":="),
		Symbol(title: "Scalar types", symbol: "Int"),
