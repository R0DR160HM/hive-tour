// The three typefaces the tour is set in, carried inside the executable for
// the reason ./icon carries the mark: this program answers every request out
// of itself, and a page that fetched its type from somebody else's server
// would be a page with a dependency the front page says it does not have.
//
//   serif   Source Serif 4, roman, weights 400 to 700 and every optical size
//           from 8 to 60, so a caption and a heading are each drawn from the
//           cut that was made for their size. The headings and the prose.
//   italic  the same family's italic, at one optical size and two weights.
//           The names of grammar rules: in a railroad diagram, in the ALGOL
//           tradition, a rule is named in italic and a token is set in type.
//   mono    Source Code Pro, weights 400 to 700. The programs, the tokens in
//           a diagram, and every name in the prose set as code.
//
// All three are under the SIL Open Font License 1.1, which travels inside
// each file in its name table and beside this one in assets/fonts/. Each is
// cut down to the characters the two languages of this site use, which is
// what makes three faces cost less than one photograph. Source Code Pro's
// licence reserves the name "Source" for the unmodified font, and a subset is
// a modified one, so the cut carried here calls itself Hive Tour Mono.
//
// The italic's advance widths are written out in ./rail as well, because a
// diagram has to know how long a name is before the browser sets it: a box is
// drawn round the word, and a box drawn to the wrong width is a box the word
// sticks out of. Change the italic here and that table changes with it.
import ./icon

// Where each one is served, and the one place the paths are spelled: ./theme
// names them in its @font-face rules and main.hive routes them, and both ask
// here.
func serifPath(): Str {
	return "/font/serif.woff2"
}

func italicPath(): Str {
	return "/font/serif-italic.woff2"
}

func monoPath(): Str {
	return "/font/mono.woff2"
}

func woff2Type(): Str {
	return "font/woff2"
}

// The bytes, decoded the way ./icon decodes its own: base64 folded at 76
// columns, unfolded before the decoder sees a newline.
func serif(): Result<Str, hive.crypto.CryptoError> {
	return icon.decode(serifBase64())
}

func italic(): Result<Str, hive.crypto.CryptoError> {
	return icon.decode(italicBase64())
}

func mono(): Result<Str, hive.crypto.CryptoError> {
	return icon.decode(monoBase64())
}

