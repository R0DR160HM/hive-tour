				Example(caption: "JWTs", captionPt: "JWTs", code: `type Claims \{ user: Str }

proc main(): void \{
	token := encode(Claims("ada"), hive.crypto.jwtCodec("secret"))

	// Checks the signature and the times, then reads the claims.
	if Claims.decode(token, hive.crypto.jwtCodec("secret")) is Result.Ok(claims) \{
		echo claims.user
	}
	echo hive.crypto.jwtHeader(token)
}`, codePt: `type Claims \{ user: Str }

proc main(): void \{
	token := encode(Claims("ada"), hive.crypto.jwtCodec("secret"))

	// Confere a assinatura e os prazos, e então lê as claims.
	if Claims.decode(token, hive.crypto.jwtCodec("secret")) is Result.Ok(claims) \{
		echo claims.user
	}
	echo hive.crypto.jwtHeader(token)
}`),
