// The content of the tour, one feature at a time, and the two shapes it is
// held in. Nothing here knows anything about HTTP, about HTML, or about the
// interface that shows it: a slide is a title, an explanation and some
// examples, and what a reader eventually sees is main.hive's business rather
// than this file's.
//
// It lives apart from the server for the reason the drawing in ./logo does.
// The tour is fifty-three slides of prose in two languages, and a server is
// about two hundred lines; kept in one file, the second is a footnote to the
// first, and every edit to either means scrolling past all of the other. So
// the program is in main.hive and what the program is *about* is in here.
//
// Every code example below is a complete program: copy it into a `.hive`
// file and `hive run` it. That is the one rule this file is written to, and
// it is why there are several small examples on a slide rather than one long
// one — a program that has to be assembled out of fragments before it will
// run is a program the reader cannot check.
//
// `all` is the whole tour, in order, and its length is part of its type:
// `Slide[53]` rather than `Slide[dyn]`. A slide added here is a slide the
// sidebar lists, a slide the pager counts to, and a slide the sitemap names,
// because all three are built from this one vector — and the number in the
// type is what makes adding one a change the compiler checks rather than a
// number to remember to bump.

type Example {
	caption:   Str
	captionPt: Str
	code:      Str
	codePt:    Str
}

type Slide {
	title:         Str
	titlePt:       Str
	explanation:   Str
	explanationPt: Str
	examples:      Example[dyn]
	download:      Bool
	shot:          Str
}

func all(): Slide[53] {
	return [
		Slide(
			title: "Hello, World",
			titlePt: "Olá, Mundo",
			download: false,
			shot: "",
			explanation: "Every Hive program starts at proc main(): void, in the file handed to `hive run` or `hive build`. echo prints a value and appends a newline, converting whatever it is given to text the way it would be shown.",
			explanationPt: "Todo programa Hive começa em proc main(): void, no arquivo passado para `hive run` ou `hive build`. echo imprime um valor e adiciona uma nova linha, convertendo o que quer que receba em texto da mesma forma que seria exibido.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	echo "it works"
}`, codePt: `proc main(): void {
	echo "funciona"
}`)],
		),
		Slide(
			title: "Running these examples",
			titlePt: "Rodando estes exemplos",
			download: true,
			shot: "",
			explanation: "Every example from here on is a complete program: put it in a file ending in .hive, and one command runs it. The compiler is a single executable with nothing to install beside it — no runtime, no package manager, no project file — so the download link below is the whole of the setup.\n\nhive check reads a program and reports what is wrong with it without building anything, which is why it is the one worth reaching for first. hive run compiles and runs in a single step, hive build leaves a native executable behind, hive test runs a file's tests and reports coverage, and hive container writes a Dockerfile that builds and runs the program. Every pass reports as much as it can find rather than stopping at the first thing, so a program with six mistakes is a program whose author gets told about six.",
			explanationPt: "Todo exemplo daqui em diante é um programa completo: coloque-o em um arquivo terminado em .hive, e um comando o roda. O compilador é um único executável sem nada para instalar ao lado dele — sem runtime, sem gerenciador de pacotes, sem arquivo de projeto — então o link de download abaixo é toda a configuração que existe.\n\nhive check lê um programa e reporta o que há de errado nele sem construir nada, e é por isso que vale a pena recorrer a ele primeiro. hive run compila e roda em um único passo, hive build deixa um executável nativo pronto, hive test roda os testes de um arquivo e reporta a cobertura, e hive container escreve um Dockerfile que constrói e roda o programa. Toda passagem reporta tudo que consegue encontrar em vez de parar na primeira coisa, então um programa com seis erros é um programa cujo autor é avisado sobre os seis.",
			examples: [Example(caption: "", captionPt: "", code: `$ printf 'proc main(): void {\n\techo "it works"\n}\n' > hello.hive

$ hive check hello.hive
No problems found in hello.hive (0s)

$ hive run hello.hive
it works

$ hive build hello.hive
Compiled hello.hive -> hello (0s)`, codePt: `$ printf 'proc main(): void {\n\techo "funciona"\n}\n' > hello.hive

$ hive check hello.hive
No problems found in hello.hive (0s)

$ hive run hello.hive
funciona

$ hive build hello.hive
Compiled hello.hive -> hello (0s)`)],
		),
		Slide(
			title: "Comments",
			titlePt: "Comentários",
			download: false,
			shot: "",
			explanation: "A comment runs from // to the end of the line, and nothing more. There is no block comment form in Hive itself — inside a query body, which is SQL rather than Hive, SQL's own -- and /* */ are recognised instead.",
			explanationPt: "Um comentário vai de // até o fim da linha, e nada mais. Não existe forma de comentário em bloco no próprio Hive — dentro do corpo de uma query, que é SQL e não Hive, os -- e /* */ do próprio SQL são reconhecidos em seu lugar.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	// A comment. The whole line, and nothing of the next.
	x := 1 // ...or the tail of one.
	echo x
}`, codePt: `proc main(): void {
	// Um comentário. A linha toda, e nada da próxima.
	x := 1 // ...ou o resto de uma.
	echo x
}`)],
		),
		Slide(
			title: "Names have shapes",
			titlePt: "Nomes têm formas",
			download: false,
			shot: "",
			explanation: "A name's spelling says what it is, and each shape is enforced where the name is declared. camelCase names variables, parameters, fields and every proc/func/query. PascalCase names types, their variants, and atoms. UPPER_CASE is how a constant is written: a variable nothing reassigns. Keywords are lower case, and only lower case — a keyword spelled in another casing, like Proc or IF, is a compile error naming both readings rather than a usable identifier.",
			explanationPt: "A grafia de um nome diz o que ele é, e cada forma é obrigatória no lugar onde o nome é declarado. camelCase nomeia variáveis, parâmetros, campos e todo proc/func/query. PascalCase nomeia tipos, suas variantes e átomos. UPPER_CASE é como se escreve uma constante: uma variável que nada reatribui. Palavras-chave são em minúsculas, e somente em minúsculas — uma palavra-chave grafada de outra forma, como Proc ou IF, é um erro de compilação que aponta as duas leituras em vez de um identificador utilizável.",
			examples: [Example(caption: "", captionPt: "", code: `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: a variable
	MAX_RETRIES := 5          // UPPER_CASE: a constant
	shape := Shape.Circle(4)  // PascalCase: a type and its variant

	echo "{name}, retry up to {MAX_RETRIES} times, shape={shape}"
}`, codePt: `type Shape {
	Circle { radius: Int }
}

proc main(): void {
	name := "bee"             // camelCase: uma variável
	MAX_RETRIES := 5          // UPPER_CASE: uma constante
	shape := Shape.Circle(4)  // PascalCase: um tipo e sua variante

	echo "{name}, tente até {MAX_RETRIES} vezes, forma={shape}"
}`)],
		),
		Slide(
			title: "Variables and constants",
			titlePt: "Variáveis e constantes",
			download: false,
			shot: "",
			explanation: ":= infers a type from the value, including a static vector length. A type written out front with = states it instead, which is the only way to say [dyn], or to give a value nothing else says the shape of somewhere to land. A binding is immutable unless it says mut, and a mut variable may never be spelled UPPER_CASE — that shape is reserved for something nothing reassigns.",
			explanationPt: ":= infere um tipo a partir do valor, incluindo um tamanho estático de vetor. Um tipo escrito explicitamente na frente com = o declara em vez disso, que é a única forma de dizer [dyn], ou de dar a um valor que nada mais define a forma de um lugar para chegar. Uma ligação é imutável a menos que diga mut, e uma variável mut nunca pode ser grafada em UPPER_CASE — essa forma é reservada para algo que nada reatribui.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	x := 1                     // inferred, immutable
	mut count := 0              // inferred, reassignable
	mut Str[dyn] rows = []       // annotated: says "dynamic"
	MAX := 100                  // a constant, by its shape alone

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`, codePt: `proc main(): void {
	x := 1                     // inferido, imutável
	mut count := 0              // inferido, reatribuível
	mut Str[dyn] rows = []       // anotado: diz "dinâmico"
	MAX := 100                  // uma constante, só pela forma

	count = count + 1
	append(rows, "first")
	echo "{x} {count} {rows} {MAX}"
}`)],
		),
		Slide(
			title: "Scalar types",
			titlePt: "Tipos escalares",
			download: false,
			shot: "",
			explanation: "Str holds UTF-8 text. Int is a 64-bit signed integer whose overflow wraps silently. Float is a 64-bit float. Bool is true or false. Atom is an interned symbol, written #Name — a label, not a condition, so `if flag` is a compile error when flag is an Atom. void is a return type only; there is no void value, field or element. There is no implicit numeric widening anywhere: an Int never becomes a Float on its own.",
			explanationPt: "Str guarda texto UTF-8. Int é um inteiro de 64 bits com sinal cujo overflow dá a volta silenciosamente. Float é um float de 64 bits. Bool é true ou false. Atom é um símbolo internado, escrito #Nome — um rótulo, não uma condição, então `if flag` é um erro de compilação quando flag é um Atom. void é apenas um tipo de retorno; não existe valor, campo ou elemento void. Não há ampliação numérica implícita em lugar nenhum: um Int nunca se torna um Float por conta própria.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "{name} {count} {weight} {ready} {state}"
}`, codePt: `proc main(): void {
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "{name} {count} {weight} {ready} {state}"
}`)],
		),
		Slide(
			title: "Strings",
			titlePt: "Strings",
			download: false,
			shot: "",
			explanation: "A double-quoted string interpolates with \{expression} and escapes with \\n, \\t, \\\", \\\\, and \\\{ for a literal brace. A backtick string is raw: no escapes and no interpolation at all, so it is the natural way to hold a block of text — or, as on this very page, a block of Hive source — untouched. Its indentation is stripped at compile time down to the shortest common margin.\n\nA Str is a sequence of characters, and everything addresses it as one. len counts characters where bytes counts the UTF-8 they take, so for \"café\" they are 4 and 5. It is indexed and sliced by character too — s[0] is the first character, as a one-character Str, and s[1:3] is characters one through three with both bounds inclusive — and every one of those is proved in range at compile time, exactly as a vector's is. A Str carries no declared length, so an index into one is always guarded or comes from indexOf, whose Ok payload is a position the string really has.\n\nWhat a Str is not is storage. s[0] = \"x\" is a compile error: a string is a value, the same as an Int, and characters are not all the same width, so writing one would move every character after it. You build the new string instead.",
			explanationPt: "Uma string entre aspas duplas interpola com \{expressão} e usa escapes com \\n, \\t, \\\", \\\\, e \\\{ para uma chave literal. Uma string entre crases é bruta: sem escapes e sem interpolação alguma, o que a torna a forma natural de guardar um bloco de texto — ou, como nesta própria página, um bloco de código-fonte Hive — intacto. Sua indentação é removida em tempo de compilação até a menor margem em comum.\n\nUma Str é uma sequência de caracteres, e tudo a endereça como tal. len conta caracteres onde bytes conta o UTF-8 que eles ocupam, então para \"café\" são 4 e 5. Ela também é indexada e fatiada por caractere — s[0] é o primeiro caractere, como uma Str de um caractere, e s[1:3] são os caracteres de um a três com os dois limites inclusivos — e cada um deles é comprovado dentro dos limites em tempo de compilação, exatamente como o de um vetor. Uma Str não carrega tamanho declarado, então um índice nela sempre está sob guarda ou vem de indexOf, cujo payload Ok é uma posição que a string realmente tem.\n\nO que uma Str não é é armazenamento. s[0] = \"x\" é um erro de compilação: uma string é um valor, igual a um Int, e caracteres não têm todos a mesma largura, então escrever um moveria todos os caracteres depois dele. Você constrói a string nova no lugar disso.",
			examples: [
				Example(caption: "Interpolation and escapes", captionPt: "Interpolação e escapes", code: `proc main(): void {
	name := "bee"
	echo "hello, {name}!"       // interpolated
	echo "a literal brace: \{" // escaped
}`, codePt: `proc main(): void {
	name := "bee"
	echo "olá, {name}!"          // interpolado
	echo "uma chave literal: \{" // escapado
}`),
				// The backtick string this sample is *about* cannot be written
				// inside the backtick string that carries it, so its whole body
				// is spliced in as an escaped one instead — newlines, tabs and
				// both backticks. Written as two raw pieces with a backtick
				// between them, the outer string's own dedent would eat the
				// indentation the sample is there to show.
				Example(caption: "Raw strings", captionPt: "Strings brutas", code: `proc main(): void {
	raw := ` + "`\n\t\tline one\n\t\tline two\n\t`\n" + `	echo raw
}`, codePt: `proc main(): void {
	raw := ` + "`\n\t\tlinha um\n\t\tlinha dois\n\t`\n" + `	echo raw
}`),
				Example(caption: "Counted, indexed and sliced by character", captionPt: "Contada, indexada e fatiada por caractere", code: `proc main(): void {
	s := "café au lait"

	echo len(s)                  // 12 characters
	echo bytes(s)                // 13 bytes — é takes two

	if s bounds 3 {
		echo s[3]                // "é", the fourth character
		echo s[0:3]              // "café" — both bounds inclusive
	}

	// A position from indexOf is one the string really has, so the
	// slice taken at it needs no guard of its own.
	if indexOf(s, "au") is Result.Ok(at) {
		echo s[at:]              // "au lait"
	}
}`, codePt: `proc main(): void {
	s := "café au lait"

	echo len(s)                  // 12 caracteres
	echo bytes(s)                // 13 bytes — é ocupa dois

	if s bounds 3 {
		echo s[3]                // "é", o quarto caractere
		echo s[0:3]              // "café" — os dois limites inclusivos
	}

	// Uma posição vinda de indexOf é uma que a string realmente tem,
	// então a fatia tirada nela não precisa de guarda própria.
	if indexOf(s, "au") is Result.Ok(at) {
		echo s[at:]              // "au lait"
	}
}`),
			],
		),
		Slide(
			title: "Operators",
			titlePt: "Operadores",
			download: false,
			shot: "",
			explanation: "+ adds two numbers, concatenates two Str, and joins two vectors into a new one whose length is the two lengths added. - * / % ** are the rest of the arithmetic, and unary - is the only prefix operator in the language. == and != compare any two values of one type structurally — element by element down a vector, field by field through a declared type, and ignoring the order a map's keys were set in — while comparing two values of different types is a compile error rather than a silent false. < > <= >= order Int, Float and Str. && and || short-circuit, and both take a Bool and nothing else: there is no truthiness in Hive, so an Int, a Str, an Atom or a vector is not a condition.\n\nThere is no unary !. The only prefix operator is -, and ! exists solely as the first character of !=. That is a deliberate consequence of `is` being an expression: most conditions worth negating are matches, and `is` has no negated form either — the else is where the other case goes. A mutable number steps with the compound assignments += -= *= /= and with ++ and --, each one shorthand for the matching x = x <op> ….\n\nNone of these ever converts a number behind your back: an Int does not become a Float, so hive.math.max(0, health) is a compile error rather than a surprise, and hive.conv.itf is how you widen one on purpose.",
			explanationPt: "+ soma dois números, concatena dois Str, e junta dois vetores em um novo cujo tamanho é a soma dos dois tamanhos. - * / % ** são o resto da aritmética, e o - unário é o único operador prefixo da linguagem. == e != comparam quaisquer dois valores de um mesmo tipo estruturalmente — elemento por elemento ao longo de um vetor, campo por campo através de um tipo declarado, e ignorando a ordem em que as chaves de um mapa foram definidas — enquanto comparar dois valores de tipos diferentes é um erro de compilação, não um false silencioso. < > <= >= ordenam Int, Float e Str. && e || fazem curto-circuito, e ambos recebem um Bool e nada mais: não existe truthiness em Hive, então um Int, uma Str, um Atom ou um vetor não é uma condição.\n\nNão existe ! unário. O único operador prefixo é -, e ! existe apenas como o primeiro caractere de !=. Isso é uma consequência deliberada de `is` ser uma expressão: a maioria das condições que valem a pena negar são casamentos, e `is` também não tem forma negada — o else é onde o outro caso vai. Um número mutável avança com as atribuições compostas += -= *= /= e com ++ e --, cada uma sendo um atalho para o x = x <op> … correspondente.\n\nNenhum deles converte um número pelas suas costas: um Int não vira um Float, então hive.math.max(0, health) é um erro de compilação em vez de uma surpresa, e hive.conv.itf é como se amplia um de propósito.",
			examples: [
				Example(caption: "Arithmetic and comparison", captionPt: "Aritmética e comparação", code: `proc main(): void {
	echo 7 + 3 * 2        // 13 — * binds tighter than +
	echo 7 / 2            // 3 — Int division truncates
	echo 7 % 2            // 1 — the remainder
	echo 2 ** 10          // 1024
	echo -7               // the only prefix operator there is

	echo 3 < 4            // ordering: Int, Float and Str
	echo "bee" == "bee"   // structural equality
	echo [1, 2] != [2, 1]
}`, codePt: `proc main(): void {
	echo 7 + 3 * 2        // 13 — * liga mais forte que +
	echo 7 / 2            // 3 — divisão de Int trunca
	echo 7 % 2            // 1 — o resto
	echo 2 ** 10          // 1024
	echo -7               // o único operador prefixo que existe

	echo 3 < 4            // ordenação: Int, Float e Str
	echo "bee" == "bee"   // igualdade estrutural
	echo [1, 2] != [2, 1]
}`),
				Example(caption: "Text and vectors join with the same +", captionPt: "Texto e vetores se juntam com o mesmo +", code: `proc main(): void {
	echo "hive" + " " + "tour"   // Str: concatenation
	echo [1, 2] + [3]             // vectors: a new one, the lengths added
}`, codePt: `proc main(): void {
	echo "hive" + " " + "tour"   // Str: concatenação
	echo [1, 2] + [3]             // vetores: um novo, os tamanhos somados
}`),
				Example(caption: "Logic, and the missing !", captionPt: "Lógica, e o ! que falta", code: `proc main(): void {
	ready := true
	warm := false

	echo ready && warm
	echo ready || warm

	// There is no unary `+"`"+`!`+"`"+`: a negated condition is written by comparing,
	// or by matching the case you did not want.
	if warm == false { echo "not warm" }
	if indexOf([1, 2], 3) is Result.Error(_) { echo "not there" }
}`, codePt: `proc main(): void {
	ready := true
	warm := false

	echo ready && warm
	echo ready || warm

	// Não existe `+"`"+`!`+"` "+`unário: uma condição negada se escreve comparando,
	// ou casando o caso que você não queria.
	if warm == false { echo "não está quente" }
	if indexOf([1, 2], 3) is Result.Error(_) { echo "não está lá" }
}`),
				Example(caption: "Stepping a number", captionPt: "Avançando um número", code: `proc main(): void {
	mut n := 10
	n += 5
	n -= 3
	n *= 2
	n /= 4
	n++
	n--
	echo n     // 6
}`, codePt: `proc main(): void {
	mut n := 10
	n += 5
	n -= 3
	n *= 2
	n /= 4
	n++
	n--
	echo n     // 6
}`),
			],
		),
		Slide(
			title: "Arithmetic at the edges",
			titlePt: "Aritmética nas bordas",
			download: false,
			shot: "",
			explanation: "Most of arithmetic is unsurprising. These are the cases worth stating exactly, and what they have in common is that each one is a value rather than a crash. Division and remainder by zero both answer with 0. Int overflow wraps, two's-complement and silently — which is what makes 2 ** 100 come back as 0, since ** on Int is repeated multiplication and wraps the same way. A negative Int exponent has no integral answer, so it yields 0 rather than a fraction, while n ** 0 is 1. A remainder takes the sign of its dividend, so -7 % 3 is -1. Float arithmetic does reach non-finite values, so 10.0 ** 400.0 is +Inf; for the mathematical answer to a power, work in Float, where ** is real exponentiation.\n\nOne case in the whole language is unspecified: converting a Float that is +Inf, -Inf, NaN or simply too large into an Int, through hive.conv.ceil, floor or round. Go leaves that conversion implementation-dependent and Hive does not paper over it, so the answer may differ between Go versions and architectures. Non-finite values reach a program through Float overflow and through hive.conv.stf(\"Inf\"), so check the range you expect before converting if it matters.",
			explanationPt: "A maior parte da aritmética não surpreende. Estes são os casos que valem ser ditos com exatidão, e o que eles têm em comum é que cada um é um valor, e não uma falha. Divisão e resto por zero respondem ambos com 0. Overflow de Int dá a volta, em complemento de dois e silenciosamente — que é o que faz 2 ** 100 voltar como 0, já que ** sobre Int é multiplicação repetida e dá a volta da mesma forma. Um expoente Int negativo não tem resposta inteira, então produz 0 em vez de uma fração, enquanto n ** 0 é 1. Um resto toma o sinal do seu dividendo, então -7 % 3 é -1. A aritmética de Float alcança valores não finitos, então 10.0 ** 400.0 é +Inf; para a resposta matemática de uma potência, trabalhe em Float, onde ** é exponenciação de verdade.\n\nUm caso na linguagem inteira é não especificado: converter um Float que seja +Inf, -Inf, NaN ou simplesmente grande demais em um Int, através de hive.conv.ceil, floor ou round. O Go deixa essa conversão dependente da implementação e o Hive não disfarça isso, então a resposta pode diferir entre versões do Go e arquiteturas. Valores não finitos chegam a um programa por overflow de Float e por hive.conv.stf(\"Inf\"), então confira a faixa que você espera antes de converter, se isso importa.",
			examples: [Example(caption: "", captionPt: "", code: `proc main(): void {
	echo 1 / 0          // 0 — division by zero is a value, not a crash
	echo 5 % 0          // 0
	echo -7 % 3         // -1 — the remainder takes the sign of the dividend
	echo 2 ** 100       // 0 — Int overflow wraps, two's-complement, silently
	echo 2 ** -1        // 0 — a negative Int exponent has no integral answer
	echo 2 ** 0         // 1
	echo 10.0 ** 400.0  // +Inf — Float arithmetic does reach non-finite values
}`, codePt: `proc main(): void {
	echo 1 / 0          // 0 — divisão por zero é um valor, não uma falha
	echo 5 % 0          // 0
	echo -7 % 3         // -1 — o resto toma o sinal do dividendo
	echo 2 ** 100       // 0 — overflow de Int dá a volta, silenciosamente
	echo 2 ** -1        // 0 — um expoente Int negativo não tem resposta inteira
	echo 2 ** 0         // 1
	echo 10.0 ** 400.0  // +Inf — Float alcança valores não finitos
}`)],
		),
		Slide(
			title: "Control flow",
			titlePt: "Controle de fluxo",
			download: false,
			shot: "",
			explanation: "if, else if and else take a Bool, and only a Bool — an Atom is not a condition, and neither is an Int, a Str or a vector. Names bound by an `is` in the condition are in scope in that branch's body, and in the rest of the same condition after &&.\n\nThere are two loops. The counting one is for i := 0; i < 10; i++, whose counter is scoped to the loop and implicitly mutable, so it needs no mut — and any of its three clauses may be left out, which is how a while loop is written. The iterating one is for each name in values: it walks a vector binding each element to an immutable name, and because it never indexes it needs no bounds proof at all. for each name: T in values overrides the inferred element type. break leaves the innermost enclosing loop and continue skips to its next iteration; either one outside a loop is a compile error.\n\nEvery non-void callable has to return on every path, and a callable that does not is rejected by name rather than quietly handed a zero value. A path terminates by ending in return, in assert or panic, in an if/else whose every branch terminates, or in an else-less if/else if chain that covers its subject's whole type.",
			explanationPt: "if, else if e else recebem um Bool, e somente um Bool — um Atom não é uma condição, e um Int, uma Str ou um vetor também não. Nomes vinculados por um `is` na condição estão no escopo do corpo daquele ramo, e no resto da mesma condição depois de &&.\n\nExistem dois laços. O de contagem é for i := 0; i < 10; i++, cujo contador tem escopo do laço e é implicitamente mutável, então não precisa de mut — e qualquer uma de suas três cláusulas pode ser omitida, que é como se escreve um laço while. O de iteração é for each name in values: ele percorre um vetor vinculando cada elemento a um nome imutável, e como nunca indexa, não precisa de prova de limites alguma. for each name: T in values sobrepõe o tipo de elemento inferido. break sai do laço mais interno e continue pula para a próxima iteração dele; qualquer um dos dois fora de um laço é um erro de compilação.\n\nTodo callable não-void precisa retornar em todo caminho, e um que não retorna é recusado pelo nome em vez de receber silenciosamente um valor zero. Um caminho termina acabando em return, em assert ou panic, em um if/else cujos ramos todos terminam, ou em uma cadeia if/else if sem else que cobre o tipo inteiro do seu sujeito.",
			examples: [
				Example(caption: "if, else if, else", captionPt: "if, else if, else", code: `proc main(): void {
	frames := 7

	if frames > 10 {
		echo "a strong colony"
	} else if frames > 3 {
		echo "coming along"
	} else {
		echo "needs feeding"
	}
}`, codePt: `proc main(): void {
	frames := 7

	if frames > 10 {
		echo "uma colônia forte"
	} else if frames > 3 {
		echo "vai indo"
	} else {
		echo "precisa de alimento"
	}
}`),
				Example(caption: "The counting loop", captionPt: "O laço de contagem", code: `proc main(): void {
	for i := 0; i < 3; i++ {
		echo "frame {i}"
	}

	// Any clause may be left out. With only a condition, it is a while loop.
	mut left := 3
	for ; left > 0; {
		left -= 1
	}
	echo left
}`, codePt: `proc main(): void {
	for i := 0; i < 3; i++ {
		echo "quadro {i}"
	}

	// Qualquer cláusula pode ser omitida. Só com condição, é um laço while.
	mut left := 3
	for ; left > 0; {
		left -= 1
	}
	echo left
}`),
				Example(caption: "for each: walking a vector", captionPt: "for each: percorrendo um vetor", code: `proc main(): void {
	hives := ["north", "south", "orchard"]

	for each name in hives {
		echo name
	}

	for each name: Str in hives {   // the annotation overrides inference
		echo len(name)
	}
}`, codePt: `proc main(): void {
	hives := ["north", "south", "orchard"]

	for each name in hives {
		echo name
	}

	for each name: Str in hives {   // a anotação sobrepõe a inferência
		echo len(name)
	}
}`),
				Example(caption: "break and continue", captionPt: "break e continue", code: `proc main(): void {
	for each name in ["north", "", "south", "orchard"] {
		if name == "" {
			continue          // skip to the next one
		}
		if name == "south" {
			break             // leave the loop entirely
		}
		echo name
	}
}`, codePt: `proc main(): void {
	for each name in ["north", "", "south", "orchard"] {
		if name == "" {
			continue          // pula para o próximo
		}
		if name == "south" {
			break             // sai do laço por completo
		}
		echo name
	}
}`),
				Example(caption: "Every path must return", captionPt: "Todo caminho precisa retornar", code: `func grade(frames: Int): Str {
	if frames > 10 {
		return "strong"
	} else if frames > 3 {
		return "growing"
	}
	return "weak"    // without this tail, the func does not compile
}

proc main(): void {
	echo grade(7)
}`, codePt: `func grade(frames: Int): Str {
	if frames > 10 {
		return "forte"
	} else if frames > 3 {
		return "crescendo"
	}
	return "fraca"   // sem esta última linha, o func não compila
}

proc main(): void {
	echo grade(7)
}`),
			],
