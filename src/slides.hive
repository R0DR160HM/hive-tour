// The content of the tour, one feature at a time, and the two shapes it is
// held in. Nothing here knows anything about HTTP, about HTML, or about the
// interface that shows it: a slide is a title, an explanation and some
// examples, and what a reader eventually sees is ./site's business rather
// than this file's.
//
// It lives apart from the server for the reason the drawing in ./logo does.
// The tour is 86 slides of prose in two languages, and a server is about
// two hundred lines; kept in one file, the second is a footnote to the first.
//
// Every code example below is a complete program: copy it into a `.hive` file
// and `hive run` it. That is the one rule this file is written to, and it is
// why there are several small examples on a slide rather than one long one.
// Nothing is used on a slide before the slide that teaches it.
//
// An explanation is paragraphs separated by a blank line. Inside one, a name
// written in backticks is set as code, and a paragraph whose every line opens
// with "- " is a list; ./site draws both.
//
// `all` is the whole tour, in order, and its length is part of its type. Each
// chapter answers with a vector of a known length and `all` adds them up, so a
// slide added anywhere is a change the compiler checks rather than a number to
// remember to bump — and the sidebar, the pager and the sitemap are all built
// from this one vector.

type Example {
	caption:   Str
	captionPt: Str
	code:      Str
	codePt:    Str
}

type Slide {
	title:         Str
	titlePt:       Str
	explanation:   Str
	explanationPt: Str
	examples:      Example[dyn]
	download:      Bool
	shot:          Str
}

func all(): Slide[86] {
	return start()
		+ flow()
		+ collections()
		+ types()
		+ modules()
		+ concurrency()
		+ library()
		+ interfaces()
		+ tools()
}

// The nine chapters `all` is built from, by name and by length, in the same
// order. The tour's track is drawn in these nine sections and the contents
// page is set out in them, so a reader always knows which part of the
// language a slide belongs to. Each length is asked of the chapter itself
// rather than written down, so it is never a number that can disagree with
// the slides.
type Chapter {
	title:   Str
	titlePt: Str
	length:  Int
}

func chapters(): Chapter[9] {
	return [
		Chapter(title: "Getting started", titlePt: "Primeiros passos", length: len(start())),
		Chapter(title: "Control flow and functions", titlePt: "Controle de fluxo e funções", length: len(flow())),
		Chapter(title: "Vectors, bounds and tables", titlePt: "Vetores, limites e tabelas", length: len(collections())),
		Chapter(title: "Types, patterns and values", titlePt: "Tipos, padrões e valores", length: len(types())),
		Chapter(title: "Modules, tests and laws", titlePt: "Módulos, testes e leis", length: len(modules())),
		Chapter(title: "Threads and services", titlePt: "Threads e serviços", length: len(concurrency())),
		Chapter(title: "The standard library", titlePt: "A biblioteca padrão", length: len(library())),
		Chapter(title: "Windows, canvases and scenes", titlePt: "Janelas, canvases e cenas", length: len(interfaces())),
		Chapter(title: "Tools", titlePt: "Ferramentas", length: len(tools())),
	]
}

// Getting started
func start(): Slide[12] {
	return [
		Slide(
			title: "Hello, World",
			titlePt: "Olá, Mundo",
			download: false,
			shot: "",
			explanation: "Every Hive program starts at `proc main(): void`, in the file handed to `hive run` or `hive build`. `main` takes nothing and answers with nothing, and any other signature is a compile error: the command line arrives through `hive.term.args()` and an exit status leaves through `hive.term.exit(code)`, both met later. A file with no `main` still compiles, as a library or a file of tests.\n\n`echo` prints one value and a newline; the slide on `echo` shows how each kind of value is printed. Inside a double-quoted string, `\{…}` puts a value in, so `echo \"\{a} and \{b}\"` prints both. The slide on strings has the rest.",
			explanationPt: "Todo programa Hive começa em `proc main(): void`, no arquivo passado para `hive run` ou `hive build`. `main` não recebe nada e não responde com nada, e qualquer outra assinatura é um erro de compilação: a linha de comando chega por `hive.term.args()` e um código de saída sai por `hive.term.exit(code)`, os dois vistos mais adiante. Um arquivo sem `main` compila do mesmo jeito, como biblioteca ou arquivo de testes.\n\n`echo` imprime um valor e uma quebra de linha; o slide sobre `echo` mostra como cada tipo de valor é impresso. Dentro de uma string entre aspas duplas, `\{…}` insere um valor, então `echo \"\{a} and \{b}\"` imprime os dois. O slide sobre strings tem o resto.",
			examples: [
				Example(caption: "", captionPt: "", code: `proc main(): void \{
	echo "it works"
}`, codePt: `proc main(): void \{
	echo "funciona"
}`),
			],
		),
		Slide(
			title: "Running these examples",
			titlePt: "Rodando estes exemplos",
			download: true,
			shot: "",
			explanation: "Every example from here on is a complete program: save it in a file ending in `.hive` and one command runs it. The compiler is a single executable, released for Linux, macOS and Windows on `amd64` and `arm64` as `hivec-<os>-<arch>`. Put it on your `PATH` as `hive`, the name its own messages use. Hive compiles to Go, so running or building a program also needs **Go 1.24 or newer** on the `PATH`; checking one needs nothing else.\n\n- `hive check hello.hive` reports what is wrong with a program without building it. Run it first, and after every edit.\n- `hive run hello.hive` compiles and runs in one step. The program starts in the entrypoint's folder, receives everything after the file name, and its exit status becomes the command's.\n- `hive build hello.hive` leaves a native executable beside the entrypoint.\n\nA build writes the Go it generates to `hello.hive-build/`, beside the entrypoint, and deletes that folder first every time, so it is safe to ignore in version control. An error starts with `file:line:`, goes to standard error, and the command exits non-zero. Each compiler pass reports every mistake it finds, but a pass that found one stops the passes after it: fix the type errors, and the bounds errors behind them appear.",
			explanationPt: "Todo exemplo daqui em diante é um programa completo: salve-o em um arquivo terminado em `.hive` e um comando o roda. O compilador é um único executável, publicado para Linux, macOS e Windows em `amd64` e `arm64` como `hivec-<os>-<arch>`. Coloque-o no seu `PATH` como `hive`, o nome que as próprias mensagens dele usam. O Hive compila para Go, então rodar ou construir um programa também exige o **Go 1.24 ou mais novo** no `PATH`; checar não exige mais nada.\n\n- `hive check hello.hive` aponta o que há de errado em um programa sem construí-lo. Use-o primeiro, e depois de cada edição.\n- `hive run hello.hive` compila e roda em um passo. O programa começa na pasta do ponto de entrada, recebe tudo o que vem depois do nome do arquivo, e o código de saída dele vira o do comando.\n- `hive build hello.hive` deixa um executável nativo ao lado do ponto de entrada.\n\nUma build escreve o Go que gera em `hello.hive-build/`, ao lado do ponto de entrada, e apaga essa pasta antes toda vez, então é seguro ignorá-la no controle de versão. Um erro começa com `arquivo:linha:`, vai para a saída de erro, e o comando termina com código diferente de zero. Cada passagem do compilador reporta todo erro que encontra, mas uma passagem que encontrou algum interrompe as seguintes: corrija os erros de tipo, e os erros de limites atrás deles aparecem.",
			examples: [
				Example(caption: "", captionPt: "", code: `$ printf 'proc main(): void \{\n\techo "it works"\n}\n' > hello.hive

$ hive check hello.hive
No problems found in hello.hive (0s)

$ hive run hello.hive
it works

$ hive build hello.hive
Compiled hello.hive -> hello (0s)`, codePt: `$ printf 'proc main(): void \{\n\techo "funciona"\n}\n' > hello.hive

$ hive check hello.hive
No problems found in hello.hive (0s)

$ hive run hello.hive
funciona

$ hive build hello.hive
Compiled hello.hive -> hello (0s)`),
			],
		),
		Slide(
			title: "Every command",
			titlePt: "Todos os comandos",
			download: false,
			shot: "",
			explanation: "Eight commands take an entrypoint, and each is taught later, where it belongs:\n\n- `hive check`, `hive run` and `hive build`, the three above. `build` also takes `--target <goos>/<goarch>` to build for another platform.\n- `hive test` runs every `test` block the program reaches, side by side, and reports coverage. `--threads N` says how many run at once.\n- `hive emit` prints the Go a program compiles to, and needs no Go toolchain.\n- `hive analyze` scores what each `proc` and `func` will cost to run, lists what the program declares and never reaches, and writes a page of findings beside the entrypoint.\n- `hive container` writes a Dockerfile that builds the program and runs it.\n- `hive install` builds the program and moves it where a shell finds commands, so it runs by name, under `--name` if one is given.\n- `hive export --target android/arm64` packages a windowed program as an installable Android app.\n\nThree take nothing: `hive version` prints which release this is, `hive agents` writes `.hivedocs/` (a page per feature, for a coding agent to read) into the current folder, and `hive lsp` is the language server an editor starts, set up on the next slide. `hive` alone lists them all.\n\nA command refuses anything it does not take rather than ignoring it: a flag it has no use for, a second file, a command that does not exist. The mistake is in what was typed, not in any source, so these messages start with `hive:`, and the command exits non-zero.",
			explanationPt: "Oito comandos recebem um ponto de entrada, e cada um é ensinado mais adiante, onde pertence:\n\n- `hive check`, `hive run` e `hive build`, os três de antes. `build` também aceita `--target <goos>/<goarch>` para construir para outra plataforma.\n- `hive test` roda todo bloco `test` que o programa alcança, lado a lado, e reporta a cobertura. `--threads N` diz quantos rodam de uma vez.\n- `hive emit` imprime o Go para o qual um programa compila, e não precisa do Go instalado.\n- `hive analyze` dá uma nota ao custo de rodar cada `proc` e `func`, lista o que o programa declara e nunca alcança, e escreve uma página de achados ao lado do ponto de entrada.\n- `hive container` escreve um Dockerfile que constrói o programa e o roda.\n- `hive install` constrói o programa e o move para onde um shell encontra comandos, para que rode pelo nome, com o de `--name` se houver um.\n- `hive export --target android/arm64` empacota um programa com janela como um app Android instalável.\n\nTrês não recebem nada: `hive version` imprime qual versão é esta, `hive agents` escreve `.hivedocs/` (uma página por recurso, para um agente de programação ler) na pasta atual, e `hive lsp` é o servidor de linguagem que um editor inicia, configurado no próximo slide. `hive` sozinho lista todos.\n\nUm comando recusa qualquer coisa que não aceita, em vez de ignorá-la: uma flag que ele não usa, um segundo arquivo, um comando que não existe. O erro está no que foi digitado, não em código-fonte algum, então essas mensagens começam com `hive:`, e o comando termina com código diferente de zero.",
			examples: [
				Example(caption: "", captionPt: "", code: "$ hive emit hello.hive > main.go\n\n$ hive check hello.hive --verbose\nhive: `hive check` takes an entrypoint and nothing else. `--verbose` was given to it.\n\n$ hive chekc hello.hive\nhive: `chekc` is not a command. `hive` alone lists the ones there are.\n\n$ hive build\nhive: `hive build` needs an entrypoint: `hive build <entrypoint.hive>`.", codePt: "$ hive emit hello.hive > main.go\n\n$ hive check hello.hive --verbose\nhive: `hive check` takes an entrypoint and nothing else. `--verbose` was given to it.\n\n$ hive chekc hello.hive\nhive: `chekc` is not a command. `hive` alone lists the ones there are.\n\n$ hive build\nhive: `hive build` needs an entrypoint: `hive build <entrypoint.hive>`."),
			],
		),
		Slide(
			title: "Hive in your editor",
			titlePt: "Hive no seu editor",
			download: false,
			shot: "",
			explanation: "`hive lsp` is a language server: an editor starts it and from then on knows what the compiler knows. A mistake is underlined a moment after it is typed, a name shows what it is and where it was declared, and after a `.` the editor offers a value's fields, a module's calls or a type's variants. It reads each file as the editor holds it, saved or not, so the only setup is telling the editor the command. It is in the compiler from v0.3.7 on.\n\n- **Neovim** 0.11 or newer needs the three lines of `init.lua` below and no plugin. `K` then says what the name under the cursor is, `CTRL-]` goes to where it was declared, `gO` lists what the file declares, and `CTRL-X CTRL-O` offers what could come next.\n- **VS Code** starts a language server only through an extension. Hive's is on the Marketplace as **Hive Language**: search for it in the Extensions view, or install it as the second example does. It also colours Hive files.\n- **Any other editor** that speaks the Language Server Protocol runs the same command, `hive lsp`, for files ending in `.hive`.\n\n`LSP.md`, in the compiler's repository, has every step and what to check when nothing happens. The tour needs none of this: every example runs with `hive run`.",
			explanationPt: "`hive lsp` é um servidor de linguagem: um editor o inicia e daí em diante sabe o que o compilador sabe. Um erro aparece sublinhado um instante depois de digitado, um nome mostra o que é e onde foi declarado, e depois de um `.` o editor oferece os campos de um valor, as chamadas de um módulo ou as variantes de um tipo. Ele lê cada arquivo como o editor o tem, salvo ou não, então a única configuração é dizer ao editor qual é o comando. Está no compilador a partir da v0.3.7.\n\n- O **Neovim** 0.11 ou mais novo precisa das três linhas de `init.lua` abaixo e de nenhum plugin. `K` então diz o que é o nome sob o cursor, `CTRL-]` vai para onde ele foi declarado, `gO` lista o que o arquivo declara, e `CTRL-X CTRL-O` oferece o que pode vir a seguir.\n- O **VS Code** só inicia um servidor de linguagem através de uma extensão. A do Hive está no Marketplace como **Hive Language**: procure por ela na aba de Extensões, ou instale-a como faz o segundo exemplo. Ela também colore arquivos Hive.\n- **Qualquer outro editor** que fale o Language Server Protocol roda o mesmo comando, `hive lsp`, para arquivos terminados em `.hive`.\n\nO `LSP.md`, no repositório do compilador, tem cada passo e o que verificar quando nada acontece. O tour não precisa de nada disso: todo exemplo roda com `hive run`.",
			examples: [
				Example(caption: "Neovim: init.lua", captionPt: "Neovim: init.lua", code: `vim.filetype.add(\{ extension = \{ hive = "hive" } })
vim.lsp.config("hive", \{ cmd = \{ "hive", "lsp" }, filetypes = \{ "hive" } })
vim.lsp.enable("hive")`, codePt: `vim.filetype.add(\{ extension = \{ hive = "hive" } })
vim.lsp.config("hive", \{ cmd = \{ "hive", "lsp" }, filetypes = \{ "hive" } })
vim.lsp.enable("hive")`),
				Example(caption: "VS Code: install the extension", captionPt: "VS Code: instale a extensão", code: `$ code --install-extension R0DR160HM.hive-lang`, codePt: `$ code --install-extension R0DR160HM.hive-lang`),
			],
		),
		Slide(
			title: "Comments",
			titlePt: "Comentários",
			download: false,
			shot: "",
			explanation: "A comment runs from `//` to the end of the line. Hive has no block comment; only inside a `query` body, which is SQL rather than Hive, are SQL's own `--` and `/* */` recognised.\n\nA source file is UTF-8, and its line endings may be `\\n` or `\\r\\n`. A byte-order mark at the start of a file is refused: save it as \"UTF-8\", not \"UTF-8 with BOM\".",
			explanationPt: "Um comentário vai de `//` até o fim da linha. O Hive não tem comentário em bloco; só dentro do corpo de uma `query`, que é SQL e não Hive, os `--` e `/* */` do próprio SQL são reconhecidos.\n\nUm arquivo-fonte é UTF-8, e suas quebras de linha podem ser `\\n` ou `\\r\\n`. Uma marca de ordem de bytes (BOM) no início de um arquivo é recusada: salve-o como \"UTF-8\", não como \"UTF-8 com BOM\".",
			examples: [
				Example(caption: "", captionPt: "", code: `proc main(): void \{
	// A comment. The whole line, and nothing of the next.
	x := 1 // ...or the tail of one.
	echo x
}`, codePt: `proc main(): void \{
	// Um comentário. A linha toda, e nada da próxima.
	x := 1 // ...ou o resto de uma.
	echo x
}`),
			],
		),
		Slide(
			title: "Names have shapes",
			titlePt: "Nomes têm formas",
			download: false,
			shot: "",
			explanation: "A name's spelling says what it is, and each shape is enforced where the name is declared:\n\n- `camelCase` names variables, parameters, fields, every `proc`, `func` and `query`, and the name an import is reached through.\n- `PascalCase` names types, their variants, and atoms.\n- `UPPER_CASE` may name a variable nothing reassigns, the usual spelling for a constant. It is allowed, never required, and a `mut` variable, a parameter, a field, a loop counter or a name a pattern binds may not use it.\n\nA leading `_` is set aside before the shape is checked, so `_scratch` and `_MAX` are fine, and `_` alone throws a value away. Names use only ASCII letters, digits and `_`; `café` is not a name.\n\nThe keywords are `import proc func query test law type if else return is with void true false echo assert panic dyn mut async await for in each bounds break continue switch`. `axiom` is reserved for a later version: it means nothing yet, and any use of it is an error. Only the lower-case spelling is reserved, so `Proc`, `IF` and `proC` are ordinary names: a variant may be called `Return` and a type `Test`, but a field may not be called `type`. A field whose JSON key is a keyword takes another name and gives the key in an annotation, shown on the slide on field annotations.",
			explanationPt: "A grafia de um nome diz o que ele é, e cada forma é exigida onde o nome é declarado:\n\n- `camelCase` nomeia variáveis, parâmetros, campos, todo `proc`, `func` e `query`, e o nome pelo qual um import é alcançado.\n- `PascalCase` nomeia tipos, suas variantes e átomos.\n- `UPPER_CASE` pode nomear uma variável que nada reatribui, a grafia de costume para uma constante. É permitido, nunca obrigatório, e uma variável `mut`, um parâmetro, um campo, um contador de laço ou um nome vinculado por um padrão não podem usá-lo.\n\nUm `_` no início é posto de lado antes de a forma ser checada, então `_scratch` e `_MAX` valem, e `_` sozinho descarta um valor. Nomes usam só letras ASCII, dígitos e `_`; `café` não é um nome.\n\nAs palavras-chave são `import proc func query test law type if else return is with void true false echo assert panic dyn mut async await for in each bounds break continue switch`. `axiom` fica reservada para uma versão futura: ainda não significa nada, e qualquer uso dela é um erro. Só a grafia em minúsculas é reservada, então `Proc`, `IF` e `proC` são nomes comuns: uma variante pode se chamar `Return` e um tipo `Test`, mas um campo não pode se chamar `type`. Um campo cuja chave JSON é uma palavra-chave recebe outro nome e indica a chave em uma anotação, mostrada no slide sobre anotações de campo.",
			examples: [
				Example(caption: "", captionPt: "", code: `type Shape \{                  // a declared type, met properly later on
	Circle \{ radius: Int }
}

proc main(): void \{
	name := "bee"             // camelCase: a variable
	MAX_RETRIES := 5          // UPPER_CASE: a variable nothing reassigns
	shape := Shape.Circle(4)  // PascalCase: a type and its variant
	_scratch := 0             // a leading _ is set aside

	echo "\{name}, retry up to \{MAX_RETRIES} times, radius \{_scratch + 4}"
	echo shape                // \{4}: a value shows as its fields
}`, codePt: `type Shape \{                  // a declared type, met properly later on
	Circle \{ radius: Int }
}

proc main(): void \{
	name := "bee"             // camelCase: uma variável
	MAX_RETRIES := 5          // UPPER_CASE: uma variável que nada reatribui
	shape := Shape.Circle(4)  // PascalCase: um tipo e sua variante
	_scratch := 0             // um _ no início é posto de lado

	echo "\{name}, tente até \{MAX_RETRIES} vezes, raio \{_scratch + 4}"
	echo shape                // \{4}: um valor aparece como seus campos
}`),
			],
		),
		Slide(
			title: "Variables",
			titlePt: "Variáveis",
			download: false,
			shot: "",
			explanation: "`x := value` declares a variable and infers its type from the value, including a vector's length. `Type x = value` writes the type out. That is how a value that says nothing about its own shape, such as an empty vector or a new map, gets one, and it is the only way to say `[dyn]`. A length inferred from the value is still a fixed length: only a vector declared `[dyn]` can grow, with `append`, below.\n\nA variable is **immutable** unless it is declared `mut`: it can be neither reassigned nor written through (`v[0] = …`, `u.name = …`), whatever its spelling. `UPPER_CASE` is only a convention for such a variable; `mut` is what decides.\n\nA name is declared **once per block**. Declaring it again in the same block is a compile error, so assign to it instead. A block inside may declare its own, which hides the outer one until the inner block ends. `_ := value` throws a value away, as often as you like.",
			explanationPt: "`x := valor` declara uma variável e infere o tipo dela a partir do valor, incluindo o tamanho de um vetor. `Tipo x = valor` escreve o tipo explicitamente. É assim que um valor que não diz nada sobre a própria forma, como um vetor vazio ou um mapa novo, ganha uma, e é a única forma de dizer `[dyn]`. Um tamanho inferido do valor continua sendo um tamanho fixo: só um vetor declarado `[dyn]` pode crescer, com o `append`, abaixo.\n\nUma variável é **imutável** a menos que seja declarada `mut`: não pode ser reatribuída nem escrita por dentro (`v[0] = …`, `u.name = …`), qualquer que seja a grafia. `UPPER_CASE` é só uma convenção para esse tipo de variável; quem decide é o `mut`.\n\nUm nome é declarado **uma vez por bloco**. Declará-lo de novo no mesmo bloco é um erro de compilação, então atribua a ele em vez disso. Um bloco interno pode declarar o seu próprio, que esconde o de fora até o bloco interno terminar. `_ := valor` descarta um valor, quantas vezes você quiser.",
			examples: [
				Example(caption: "Declaring", captionPt: "Declarando", code: `proc main(): void \{
	x := 1                        // inferred, immutable
	mut count := 0                // inferred, reassignable
	mut Str[dyn] rows = []        // written out: an empty vector says nothing itself
	MAX := 100                    // immutable, and spelled like a constant

	count = count + 1
	append(rows, "first")
	echo "\{x} \{count} \{rows} \{MAX}"
}`, codePt: `proc main(): void \{
	x := 1                        // inferido, imutável
	mut count := 0                // inferido, reatribuível
	mut Str[dyn] rows = []        // escrito: um vetor vazio não diz nada sozinho
	MAX := 100                    // imutável, e grafado como uma constante

	count = count + 1
	append(rows, "first")
	echo "\{x} \{count} \{rows} \{MAX}"
}`),
				Example(caption: "One name per block", captionPt: "Um nome por bloco", code: "proc main(): void \{\n\tmut total := 10\n\t// total := 20        // compile error: `total` is already declared in this block\n\ttotal = 20            // an assignment, which is what that line meant\n\n\t_ := total * 2        // thrown away, on purpose\n\t_ := total + 1        // and again: `_` is never declared\n\techo total\n}", codePt: "proc main(): void \{\n\tmut total := 10\n\t// total := 20        // erro de compilação: `total` já foi declarado neste bloco\n\ttotal = 20            // uma atribuição, que é o que aquela linha queria dizer\n\n\t_ := total * 2        // descartado, de propósito\n\t_ := total + 1        // e de novo: `_` nunca é declarado\n\techo total\n}"),
			],
		),
		Slide(
			title: "Scalar types",
			titlePt: "Tipos escalares",
			download: false,
			shot: "",
			explanation: "- `Str` holds UTF-8 text.\n- `Int` is a 64-bit signed integer. It wraps round: arithmetic that would pass its largest or smallest value comes back from the other.\n- `Float` is a 64-bit floating-point number.\n- `UInt8`, `Int12`, `Float32` and the other sized numbers are on the next slide.\n- `Bool` is `true` or `false`.\n- `Atom` is a symbol, written `#Name`.\n- `void` is a return type only; there is no `void` value, field or element.\n\nNumber literals are decimal only: no hex, no `_` between digits, no exponent. A `Float` has digits on both sides of its point (`0.5`, not `.5` or `1.`), and `-1` is the minus operator applied to `1`. No number is ever converted for you: an `Int` does not become a `Float` on its own, and `hive.conv.itf` widens one on purpose.\n\nAn atom is a label. `echo` prints its name, but inside a string, interpolated or added with `+`, it becomes the small number the compiler gave it, so compare atoms with `==`, not as text. `#Nil` is always 0; every other atom is numbered by where it is first mentioned, which is also the order `sort` puts atoms in. An atom cannot be computed, and it is not a condition: `if state` is a compile error when `state` is an `Atom`.",
			explanationPt: "- `Str` guarda texto UTF-8.\n- `Int` é um inteiro de 64 bits com sinal. Ele dá a volta: uma conta que passaria do seu maior ou menor valor volta pelo outro.\n- `Float` é um número de ponto flutuante de 64 bits.\n- `UInt8`, `Int12`, `Float32` e os outros números com tamanho estão no próximo slide.\n- `Bool` é `true` ou `false`.\n- `Atom` é um símbolo, escrito `#Nome`.\n- `void` é apenas um tipo de retorno; não existe valor, campo ou elemento `void`.\n\nLiterais numéricos são só decimais: sem hexadecimal, sem `_` entre dígitos, sem expoente. Um `Float` tem dígitos dos dois lados do ponto (`0.5`, não `.5` nem `1.`), e `-1` é o operador de menos aplicado a `1`. Nenhum número é convertido por conta própria: um `Int` não vira `Float` sozinho, e `hive.conv.itf` amplia um de propósito.\n\nUm átomo é um rótulo. `echo` imprime o nome dele, mas dentro de uma string, interpolado ou somado com `+`, ele vira o pequeno número que o compilador lhe deu, então compare átomos com `==`, não como texto. `#Nil` é sempre 0; todo outro átomo é numerado pelo lugar onde é mencionado pela primeira vez, que é também a ordem em que `sort` os coloca. Um átomo não pode ser calculado, e não é uma condição: `if state` é um erro de compilação quando `state` é um `Atom`.",
			examples: [
				Example(caption: "", captionPt: "", code: `proc main(): void \{
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "\{name} \{count} \{weight} \{ready}"
	echo state             // Ready — echo prints an atom's name
	echo "state: \{state}"  // state: 1 — inside a string it is its number
	echo state == #Ready   // true — which is why atoms are compared, not printed
}`, codePt: `proc main(): void \{
	Str   name   = "bee"
	Int   count  = 42
	Float weight = 3.14
	Bool  ready  = true
	Atom  state  = #Ready

	echo "\{name} \{count} \{weight} \{ready}"
	echo state             // Ready — echo imprime o nome de um átomo
	echo "state: \{state}"  // state: 1 — dentro de uma string ele é o seu número
	echo state == #Ready   // true — por isso átomos são comparados, não impressos
}`),
			],
		),
		Slide(
			title: "Sized numbers",
			titlePt: "Números com tamanho",
			download: false,
			shot: "",
			explanation: "When a program keeps many small numbers, each can take only the bits it needs:\n\n- `UInt1` … `UInt64` are unsigned integers of that many bits, so a `UInt4` holds 0 to 15. `Int1` … `Int63` are signed, so an `Int4` holds −8 to 7. `Int64` is another name for `Int`.\n- `Float32` is a 32-bit float, about seven digits. `Float64` is another name for `Float`.\n- A sized integer wraps at its own width, the way `Int` wraps at 64: a `UInt4` at 15 plus one is 0. `-` on an unsigned type is a compile error.\n- A literal takes the type it lands in, and has to fit it: `UInt4 x = 16` is a compile error.\n- No number changes type on its own: a `UInt8` becomes an `Int` only through `Int(x)`, a `Float32` a `Float` only through `Float(x)`, and `UInt4 + UInt8` is a compile error until one side is converted. Two integers of any sizes still compare by value.\n- `UInt4(x)` keeps the low bits and never fails, and `UInt4.checked(x)` answers `Error(x)` where `x` does not fit.\n- A sized index is its own bounds proof: a `UInt4` indexes any vector of 16 or more with no guard.\n- A vector of them is packed, each value taking only its own bits: a million `UInt4`s take half a megabyte.",
			explanationPt: "Quando um programa guarda muitos números pequenos, cada um pode ocupar só os bits de que precisa:\n\n- `UInt1` … `UInt64` são inteiros sem sinal com essa quantidade de bits, então um `UInt4` guarda de 0 a 15. `Int1` … `Int63` têm sinal, então um `Int4` guarda de −8 a 7. `Int64` é outro nome para `Int`.\n- `Float32` é um float de 32 bits, com uns sete dígitos. `Float64` é outro nome para `Float`.\n- Um inteiro com tamanho dá a volta na sua própria largura, como o `Int` dá a volta em 64: um `UInt4` em 15 mais um é 0. `-` num tipo sem sinal é um erro de compilação.\n- Um literal assume o tipo de onde ele cai, e precisa caber nele: `UInt4 x = 16` é um erro de compilação.\n- Nenhum número muda de tipo sozinho: um `UInt8` vira `Int` só por `Int(x)`, um `Float32` vira `Float` só por `Float(x)`, e `UInt4 + UInt8` é um erro de compilação até um dos lados ser convertido. Dois inteiros de quaisquer tamanhos ainda se comparam pelo valor.\n- `UInt4(x)` mantém os bits de baixo e nunca falha, e `UInt4.checked(x)` responde `Error(x)` quando `x` não cabe.\n- Um índice com tamanho é a sua própria prova de limites: um `UInt4` indexa qualquer vetor de 16 ou mais sem guarda.\n- Um vetor deles é compactado, cada valor ocupando só os próprios bits: um milhão de `UInt4` ocupa meio megabyte.",
			examples: [
				Example(caption: "", captionPt: "", code: `type Pixel \{
	r: UInt8
	g: UInt8
	b: UInt8
}

proc main(): void \{
	UInt4 level = 15
	echo level + 1            // 0 — a UInt4 wraps at 16
	Int wide = Int(level)     // widened, and said so
	echo wide + 1             // 16
	echo UInt8(300)           // 44 — the low 8 bits
	echo UInt8.checked(300)   // Error(300)
	echo Pixel(255, 128, 0)   // \{255, 128, 0}
	Float32 third = 0.1
	echo third                // 0.1

	Str[16] names = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p"]
	echo names[level]         // p — no guard: a UInt4 is at most 15

	UInt4[dyn] steps = [3, 1, 4, 1, 5, 9, 2, 6]
	echo bytes(steps)         // 8 — packed: all eight in one 64-bit word
}`, codePt: `type Pixel \{
	r: UInt8
	g: UInt8
	b: UInt8
}

proc main(): void \{
	UInt4 level = 15
	echo level + 1            // 0 — um UInt4 dá a volta em 16
	Int wide = Int(level)     // alargado, e dito
	echo wide + 1             // 16
	echo UInt8(300)           // 44 — os 8 bits de baixo
	echo UInt8.checked(300)   // Error(300)
	echo Pixel(255, 128, 0)   // \{255, 128, 0}
	Float32 third = 0.1
	echo third                // 0.1

	Str[16] names = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p"]
	echo names[level]         // p — sem guarda: um UInt4 é no máximo 15

	UInt4[dyn] steps = [3, 1, 4, 1, 5, 9, 2, 6]
	echo bytes(steps)         // 8 — compactado: os oito numa palavra de 64 bits
}`),
			],
		),
		Slide(
			title: "Operators",
			titlePt: "Operadores",
			download: false,
			shot: "",
			explanation: "Each operator is defined on particular types, and using it on anything else is a compile error:\n\n- `+` adds two numbers, joins two `Str`s, and joins two vectors into a new one whose length is the two added.\n- `-` `*` `/` `%` `**` are arithmetic, on `Int` or `Float`.\n- `==` and `!=` compare two values of one type structurally: element by element down a vector, field by field through a declared type. Two function values cannot be compared, and two different types are an error rather than a silent `false`.\n- `<` `>` `<=` `>=` order an `Int`, a `Float` or a `Str`, and nothing else.\n- `&&` and `||` take `Bool`s and short-circuit. There is no truthiness: an `Int`, a `Str`, an `Atom` or a vector is not a condition.\n- Unary `-` negates a number; unary `!` inverts a `Bool`.\n- `&` `|` `^` and unary `~` work on an integer's bits, and `<<` `>>` shift one; they are on the slide on bits and bytes.\n\nFrom loosest to tightest: `||`, `&&`, then `is` and `bounds`, then the comparisons, the bitwise operators, `+ -`, `* / %`, the pipe `|>`, unary `-`, `!` and `~`, and tightest `**`. So `!found && ready` is `(!found) && ready`, `-2 ** 2` is `-(2 ** 2)`, and `**` groups from the right: `2 ** 3 ** 2` is `2 ** 9`. Comparisons do not chain: `1 < x < 3` is a compile error. `!` may not be applied to an expression containing an `is`, since what a match binds could never be set; write the `else` instead.\n\nA `mut` variable steps with `+=` `-=` `*=` `/=`, each shorthand for `x = x <op> …`, and an `Int` with `++` and `--`. `+=` joins a `Str` too. Nothing converts a number behind your back: `hive.math.max(0, health)` with an `Int` `health` is a compile error.",
			explanationPt: "Cada operador é definido para certos tipos, e usá-lo em qualquer outra coisa é um erro de compilação:\n\n- `+` soma dois números, junta duas `Str`s, e junta dois vetores em um novo cujo tamanho é a soma dos dois.\n- `-` `*` `/` `%` `**` são aritmética, sobre `Int` ou `Float`.\n- `==` e `!=` comparam dois valores de um mesmo tipo estruturalmente: elemento por elemento ao longo de um vetor, campo por campo através de um tipo declarado. Dois valores de função não podem ser comparados, e dois tipos diferentes são um erro, não um `false` silencioso.\n- `<` `>` `<=` `>=` ordenam um `Int`, um `Float` ou uma `Str`, e nada mais.\n- `&&` e `||` recebem `Bool`s e fazem curto-circuito. Não existe truthiness: um `Int`, uma `Str`, um `Atom` ou um vetor não é uma condição.\n- O `-` unário nega um número; o `!` unário inverte um `Bool`.\n- `&` `|` `^` e o `~` unário trabalham nos bits de um inteiro, e `<<` `>>` deslocam um; eles estão no slide sobre bits e bytes.\n\nDo mais fraco ao mais forte: `||`, `&&`, depois `is` e `bounds`, depois as comparações, os operadores de bits, `+ -`, `* / %`, o pipe `|>`, o `-`, o `!` e o `~` unários, e o mais forte, `**`. Então `!found && ready` é `(!found) && ready`, `-2 ** 2` é `-(2 ** 2)`, e `**` agrupa pela direita: `2 ** 3 ** 2` é `2 ** 9`. Comparações não se encadeiam: `1 < x < 3` é um erro de compilação. `!` não pode ser aplicado a uma expressão que contenha um `is`, já que o que um casamento vincula nunca poderia ser preenchido; escreva o `else` em vez disso.\n\nUma variável `mut` avança com `+=` `-=` `*=` `/=`, cada um atalho para `x = x <op> …`, e um `Int` com `++` e `--`. `+=` também junta uma `Str`. Nada converte um número pelas suas costas: `hive.math.max(0, health)` com um `health` `Int` é um erro de compilação.",
			examples: [
				Example(caption: "Arithmetic and comparison", captionPt: "Aritmética e comparação", code: `proc main(): void \{
	echo 7 + 3 * 2        // 13 — * binds tighter than +
	echo 7 / 2            // 3 — Int division truncates
	echo 7 % 2            // 1 — the remainder
	echo 2 ** 3 ** 2      // 512 — ** groups from the right
	echo -2 ** 2          // -4 — ** binds tighter than unary minus

	echo 3 < 4            // ordering: Int, Float and Str
	echo "bee" == "bee"   // structural equality
	echo [1, 2] != [2, 1]
}`, codePt: `proc main(): void \{
	echo 7 + 3 * 2        // 13 — * liga mais forte que +
	echo 7 / 2            // 3 — divisão de Int trunca
	echo 7 % 2            // 1 — o resto
	echo 2 ** 3 ** 2      // 512 — ** agrupa pela direita
	echo -2 ** 2          // -4 — ** liga mais forte que o menos unário

	echo 3 < 4            // ordenação: Int, Float e Str
	echo "bee" == "bee"   // igualdade estrutural
	echo [1, 2] != [2, 1]
}`),
				Example(caption: "Text and vectors join with the same +", captionPt: "Texto e vetores se juntam com o mesmo +", code: `proc main(): void \{
	echo "hive" + " " + "tour"   // Str: joined
	echo [1, 2] + [3]             // vectors: a new one, the lengths added
}`, codePt: `proc main(): void \{
	echo "hive" + " " + "tour"   // Str: juntadas
	echo [1, 2] + [3]             // vetores: um novo, os tamanhos somados
}`),
				Example(caption: "Logic, and negation", captionPt: "Lógica, e negação", code: `proc main(): void \{
	ready := true
	warm := false

	echo ready && warm
	echo ready || warm
	echo !warm

	// Tighter than every comparison, so both of these need their parentheses.
	echo !(ready && warm)
	echo !(1 == 2)
}`, codePt: `proc main(): void \{
	ready := true
	warm := false

	echo ready && warm
	echo ready || warm
	echo !warm

	// Mais forte que qualquer comparação, então estes dois precisam dos parênteses.
	echo !(ready && warm)
	echo !(1 == 2)
}`),
				Example(caption: "Stepping a variable", captionPt: "Avançando uma variável", code: `proc main(): void \{
	mut n := 10
	n += 5
	n -= 3
	n *= 2
	n /= 4
	n++
	n--
	echo n          // 6

	mut greeting := "hello"
	greeting += ", bee"
	echo greeting
}`, codePt: `proc main(): void \{
	mut n := 10
	n += 5
	n -= 3
	n *= 2
	n /= 4
	n++
	n--
	echo n          // 6

	mut greeting := "olá"
	greeting += ", bee"
	echo greeting
}`),
			],
		),
		Slide(
			title: "Arithmetic at the edges",
			titlePt: "Aritmética nas bordas",
			download: false,
			shot: "",
			explanation: "None of these edge cases crashes; each one gives a value:\n\n- Dividing by zero, or taking a remainder by zero, gives `0`, for an `Int` and a `Float` alike.\n- An `Int` wraps round. A sum, difference, product or power that would pass the largest `Int`, `9223372036854775807`, comes back from the smallest, `-9223372036854775808`, and the other way round: a counter that passes the top turns negative. Negating the smallest `Int` gives itself, since it has no opposite.\n- `**` on `Int`s is repeated multiplication, so `2 ** 100` wraps too, all the way round to `0`. A negative exponent has no whole answer, so it gives `0`, and `n ** 0` is `1`. For the real answer to a power, work in `Float`, where `**` is true exponentiation.\n- A remainder takes the sign of the number divided, so `-7 % 3` is `-1`, and `%` works on `Float`s.\n- `Float` arithmetic does reach infinity: `10.0 ** 400.0` is `+Inf`.\n\nOne case in the whole language is left unspecified: converting a `Float` that is infinite, not a number, or too large for an `Int` into one with `hive.conv.ceil`, `floor` or `round`. Check the range first if it matters.",
			explanationPt: "Nenhum destes casos de borda causa uma falha; cada um dá um valor:\n\n- Dividir por zero, ou tirar o resto por zero, dá `0`, tanto para um `Int` quanto para um `Float`.\n- Um `Int` dá a volta. Uma soma, diferença, produto ou potência que passaria do maior `Int`, `9223372036854775807`, volta pelo menor, `-9223372036854775808`, e vice-versa: um contador que passa do topo fica negativo. Negar o menor `Int` dá ele mesmo, já que ele não tem oposto.\n- `**` sobre `Int`s é multiplicação repetida, então `2 ** 100` também dá a volta, até chegar a `0`. Um expoente negativo não tem resposta inteira, então dá `0`, e `n ** 0` é `1`. Para a resposta real de uma potência, trabalhe em `Float`, onde `**` é exponenciação de verdade.\n- Um resto toma o sinal do número dividido, então `-7 % 3` é `-1`, e `%` funciona com `Float`s.\n- A aritmética de `Float` chega ao infinito: `10.0 ** 400.0` é `+Inf`.\n\nUm caso na linguagem inteira fica sem especificação: transformar em `Int` um `Float` infinito, não numérico ou grande demais para um `Int`, com `hive.conv.ceil`, `floor` ou `round`. Confira a faixa antes, se isso importar.",
			examples: [
				Example(caption: "", captionPt: "", code: `proc main(): void \{
	echo 1 / 0          // 0 — division by zero is a value, not a crash
	echo 1.0 / 0.0      // 0
	echo 5 % 0          // 0
	echo -7 % 3         // -1 — the remainder takes the sign of what is divided
	echo 7.5 % 2.0      // 1.5

	top := 9223372036854775807
	echo top + 1        // -9223372036854775808 — an Int wraps round
	echo -top - 10      // 9223372036854775799 — at either edge
	echo 2 ** 100       // 0
	echo 2 ** -1        // 0 — a negative Int exponent has no whole answer
	echo 10.0 ** 400.0  // +Inf — Float arithmetic does reach infinity
}`, codePt: `proc main(): void \{
	echo 1 / 0          // 0 — divisão por zero é um valor, não uma falha
	echo 1.0 / 0.0      // 0
	echo 5 % 0          // 0
	echo -7 % 3         // -1 — o resto toma o sinal do que é dividido
	echo 7.5 % 2.0      // 1.5

	top := 9223372036854775807
	echo top + 1        // -9223372036854775808 — um Int dá a volta
	echo -top - 10      // 9223372036854775799 — em qualquer das bordas
	echo 2 ** 100       // 0
	echo 2 ** -1        // 0 — um expoente Int negativo não tem resposta inteira
	echo 10.0 ** 400.0  // +Inf — a aritmética de Float chega ao infinito
}`),
			],
		),
		Slide(
			title: "Strings",
			titlePt: "Strings",
			download: false,
			shot: "",
			explanation: "A double-quoted string interpolates `\{expression}` — anything that is an expression, not only a name — and may run over several lines. Its escapes are `\\n`, `\\t`, `\\r`, `\\\"`, `\\\\`, and `\\\{` for a literal brace; a backslash before any other character is just that character, so `\"\\q\"` is `q`.\n\nA backtick string is for a block of text. Its indentation is stripped at compile time down to the shortest margin its lines share — a tab and a space each count as one — and a blank first or last line is dropped, so it can be indented along with the code around it. It interpolates `\{expression}` too, and its one escape is `\\\{`: every other backslash is a backslash, which makes it the place for a regular expression or a Windows path. It cannot hold a backtick at all; join one in with `` \"`\" `` if you need it.\n\nA `Str` is a value, like an `Int`: nothing writes into one, and every operation hands back a new string. It is counted, indexed and sliced by character, which the slide after the bounds checker shows.",
			explanationPt: "Uma string entre aspas duplas interpola `\{expressão}` — qualquer coisa que seja uma expressão, não só um nome — e pode ocupar várias linhas. Seus escapes são `\\n`, `\\t`, `\\r`, `\\\"`, `\\\\`, e `\\\{` para uma chave literal; uma barra invertida antes de qualquer outro caractere é só esse caractere, então `\"\\q\"` é `q`.\n\nUma string entre crases serve para um bloco de texto. Sua indentação é removida em tempo de compilação até a menor margem que as linhas têm em comum — uma tabulação e um espaço contam como um cada — e uma primeira ou última linha em branco é descartada, então ela pode ser indentada junto com o código em volta. Ela também interpola `\{expressão}`, e seu único escape é `\\\{`: toda outra barra invertida é uma barra invertida, o que a torna o lugar para uma expressão regular ou um caminho do Windows. Ela não pode conter crase alguma; junte uma com `` \"`\" `` se precisar.\n\nUma `Str` é um valor, como um `Int`: nada escreve dentro dela, e toda operação devolve uma string nova. Ela é contada, indexada e fatiada por caractere, o que o slide depois do verificador de limites mostra.",
			examples: [
				Example(caption: "Interpolation and escapes", captionPt: "Interpolação e escapes", code: `proc main(): void \{
	name := "bee"
	echo "hello, \{name}!"            // interpolated
	echo "\{name + name}!"           // any expression
	echo "a literal brace: \\{"      // escaped
	echo "tab:\t| quote:\" | \q"    // \q is just q
	echo "two
lines"
}`, codePt: `proc main(): void \{
	name := "bee"
	echo "olá, \{name}!"              // interpolado
	echo "\{name + name}!"           // qualquer expressão
	echo "uma chave literal: \\{"    // escapado
	echo "tab:\t| aspas:\" | \q"    // \q é só q
	echo "duas
linhas"
}`),
				Example(caption: "Backtick strings", captionPt: "Strings entre crases", code: "proc main(): void \{\n\tname := \"bee\"\n\tblock := `\n\t\thello, \{name}\n\t\ta literal brace: \\\{\n\t\ta backslash stays: C:\\hive\\bin\n\t`\n\techo block\n}", codePt: "proc main(): void \{\n\tname := \"bee\"\n\tblock := `\n\t\tolá, \{name}\n\t\tuma chave literal: \\\{\n\t\ta barra invertida fica: C:\\hive\\bin\n\t`\n\techo block\n}"),
			],
		),
	]
}

// Control flow and functions
func flow(): Slide[5] {
	return [
		Slide(
			title: "if and else",
			titlePt: "if e else",
			download: false,
			shot: "",
			explanation: "`if`, `else if` and `else` take a `Bool` and nothing else: an `Atom` is not a condition, and neither is an `Int`, a `Str` or a vector. Braces are always written.\n\nEvery pair of braces is a block, and a block may declare names of its own. One that reuses a name from outside hides the outer one until the block ends, even with a different type; the outer variable is untouched and comes back after the closing brace.",
			explanationPt: "`if`, `else if` e `else` recebem um `Bool` e nada mais: um `Atom` não é uma condição, e um `Int`, uma `Str` ou um vetor também não. As chaves são sempre escritas.\n\nTodo par de chaves é um bloco, e um bloco pode declarar nomes próprios. Um que reusa um nome de fora esconde o de fora até o bloco terminar, mesmo com outro tipo; a variável de fora fica intocada e volta depois da chave de fechamento.",
			examples: [
				Example(caption: "if, else if, else", captionPt: "if, else if, else", code: `proc main(): void \{
	frames := 7

	if frames > 10 \{
		echo "a strong colony"
	} else if frames > 3 \{
		echo "coming along"
	} else \{
		echo "needs feeding"
	}
}`, codePt: `proc main(): void \{
	frames := 7

	if frames > 10 \{
		echo "uma colônia forte"
	} else if frames > 3 \{
		echo "vai indo"
	} else \{
		echo "precisa de alimento"
	}
}`),
				Example(caption: "A block's own names", captionPt: "Os nomes próprios de um bloco", code: `proc main(): void \{
	total := 10
	if total > 5 \{
		total := "ten"     // this block's own: hides the outer one
		echo total         // ten
	}
	echo total             // 10 — untouched
}`, codePt: `proc main(): void \{
	total := 10
	if total > 5 \{
		total := "dez"     // o próprio deste bloco: esconde o de fora
		echo total         // dez
	}
	echo total             // 10 — intocado
}`),
			],
		),
		Slide(
			title: "Loops",
			titlePt: "Laços",
			download: false,
			shot: "",
			explanation: "Hive has two loops.\n\nThe counting loop is `for i := 0; i < 10; i++`. Its counter belongs to the loop, so the next loop may give its counter the same name, and it is mutable without `mut`, though still held to the `camelCase` rule. Any of the three clauses may be left out, which is how a while loop is written: `for ; left > 0; \{ … }`.\n\nThe walking loop is `for each name in values`. It binds each element of a vector to an immutable `name`, in order, and since it never indexes it needs no bounds proof. `for each name: T in values` states the element type instead of inferring it, and a type the elements do not fit is a compile error. A `Str` and a map are not vectors, so neither can be walked this way: `split(text, \"\")` gives a string's characters, and a map's keys are shown on its slide.\n\n`break` leaves the innermost loop and `continue` skips to its next turn; either one outside a loop is a compile error.",
			explanationPt: "O Hive tem dois laços.\n\nO laço de contagem é `for i := 0; i < 10; i++`. Seu contador pertence ao laço, então o próximo laço pode dar o mesmo nome ao seu contador, e ele é mutável sem `mut`, embora ainda siga a regra do `camelCase`. Qualquer uma das três cláusulas pode ser omitida, que é como se escreve um laço while: `for ; left > 0; \{ … }`.\n\nO laço de percorrer é `for each name in values`. Ele vincula cada elemento de um vetor a um `name` imutável, em ordem, e como nunca indexa, não precisa de prova de limites. `for each name: T in values` declara o tipo do elemento em vez de inferi-lo, e um tipo que os elementos não satisfazem é um erro de compilação. Uma `Str` e um mapa não são vetores, então nenhum dos dois pode ser percorrido assim: `split(text, \"\")` dá os caracteres de uma string, e as chaves de um mapa aparecem no slide dele.\n\n`break` sai do laço mais interno e `continue` pula para a próxima volta dele; qualquer um dos dois fora de um laço é um erro de compilação.",
			examples: [
				Example(caption: "The counting loop", captionPt: "O laço de contagem", code: `proc main(): void \{
	for i := 0; i < 3; i++ \{
		echo "frame \{i}"
	}
	for i := 10; i > 7; i-- \{       // the counter is the loop's own
		echo "countdown \{i}"
	}

	// Any clause may be left out. With only a condition, it is a while loop.
	mut left := 3
	for ; left > 0; \{
		left -= 1
	}
	echo left
}`, codePt: `proc main(): void \{
	for i := 0; i < 3; i++ \{
		echo "quadro \{i}"
	}
	for i := 10; i > 7; i-- \{       // o contador é do próprio laço
		echo "contagem \{i}"
	}

	// Qualquer cláusula pode ser omitida. Só com condição, é um laço while.
	mut left := 3
	for ; left > 0; \{
		left -= 1
	}
	echo left
}`),
				Example(caption: "for each, break and continue", captionPt: "for each, break e continue", code: `proc main(): void \{
	for each name: Str in ["north", "", "south", "orchard"] \{
		if name == "" \{
			continue          // skip to the next one
		}
		if name == "south" \{
			break             // leave the loop entirely
		}
		echo name
	}
}`, codePt: `proc main(): void \{
	for each name: Str in ["north", "", "south", "orchard"] \{
		if name == "" \{
			continue          // pula para o próximo
		}
		if name == "south" \{
			break             // sai do laço por completo
		}
		echo name
	}
}`),
			],
		),
		Slide(
			title: "Functions",
			titlePt: "Funções",
			download: false,
			shot: "",
			explanation: "A callable is declared with `func` or `proc`, a name, its parameters as `name: Type`, and the type it answers with. The return type is always written, as `void` when it answers with nothing. Callables may be declared anywhere in a file, in any order, and may call themselves. A parameter is immutable inside the body, and a call waits for the callee to finish.\n\nThe two keywords differ only in what a callable may write that its caller can see; the slide on `func` and `proc` covers it. Until then, write `func`, and `proc` for `main`.\n\nA callable that answers with a value must end every path through its body. A path ends with `return`, with `panic`, with a call to `hive.term.exit` (which ends the whole program), or with an `if`/`else` whose every branch ends. An `assert` does not end one: an assertion that holds carries on past it, so a function ending on `assert` still has a path that returns nothing, and is refused.",
			explanationPt: "Um chamável é declarado com `func` ou `proc`, um nome, seus parâmetros como `nome: Tipo`, e o tipo com que ele responde. O tipo de retorno é sempre escrito, como `void` quando não responde com nada. Chamáveis podem ser declarados em qualquer lugar do arquivo, em qualquer ordem, e podem chamar a si mesmos. Um parâmetro é imutável dentro do corpo, e uma chamada espera o chamado terminar.\n\nAs duas palavras-chave diferem só no que um chamável pode escrever que o chamador consegue ver; o slide sobre `func` e `proc` trata disso. Até lá, escreva `func`, e `proc` para o `main`.\n\nUm chamável que responde com um valor precisa encerrar todo caminho pelo seu corpo. Um caminho termina com `return`, com `panic`, com uma chamada a `hive.term.exit` (que encerra o programa inteiro), ou com um `if`/`else` cujos ramos todos terminam. Um `assert` não termina um caminho: uma asserção que vale segue adiante, então uma função que acaba em `assert` ainda tem um caminho que não retorna nada, e é recusada.",
			examples: [
				Example(caption: "Declaring and calling", captionPt: "Declarando e chamando", code: `proc main(): void \{
	echo grade(7)
	echo factorial(5)
}

func grade(frames: Int): Str \{
	if frames > 10 \{
		return "strong"
	} else if frames > 3 \{
		return "growing"
	}
	return "weak"    // without this, a path would end with nothing to answer
}

func factorial(n: Int): Int \{
	if n <= 1 \{
		return 1
	}
	return n * factorial(n - 1)
}`, codePt: `proc main(): void \{
	echo grade(7)
	echo factorial(5)
}

func grade(frames: Int): Str \{
	if frames > 10 \{
		return "forte"
	} else if frames > 3 \{
		return "crescendo"
	}
	return "fraca"   // sem isto, um caminho terminaria sem nada para responder
}

func factorial(n: Int): Int \{
	if n <= 1 \{
		return 1
	}
	return n * factorial(n - 1)
}`),
				Example(caption: "What ends a path", captionPt: "O que encerra um caminho", code: `func sign(n: Int): Int \{
	if n > 0 \{
		return 1
	} else if n < 0 \{
		return -1
	}
	// assert n == 0     // would not do: a holding assert carries on
	return 0
}

func settings(path: Str): Str \{
	if path != "" \{
		return path
	}
	echo "no settings file given"
	hive.term.exit(2)    // ends the program, so it ends this path too
}

proc main(): void \{
	echo sign(-4)
	echo settings("hive.toml")
}`, codePt: `func sign(n: Int): Int \{
	if n > 0 \{
		return 1
	} else if n < 0 \{
		return -1
	}
	// assert n == 0     // não serviria: um assert que vale segue adiante
	return 0
}

func settings(path: Str): Str \{
	if path != "" \{
		return path
	}
	echo "nenhum arquivo de configuração informado"
	hive.term.exit(2)    // encerra o programa, então encerra este caminho também
}

proc main(): void \{
	echo sign(-4)
	echo settings("hive.toml")
}`),
			],
		),
		Slide(
			title: "Result<T, E>",
			titlePt: "Result<T, E>",
			download: false,
			shot: "",
			explanation: "`Result` is how every fallible operation reports itself: `Result.Ok(value)` when it worked, `Result.Error(payload)` when it did not. It is the language's one built-in generic union, written `Result<Int, Str>` for an `Int` or a `Str` explaining why not.\n\n`r is Result.Ok(v)` is a `Bool` that is `true` when `r` holds an `Ok`, and binds `v` to what it carries for the branch it guards, and for the rest of the same condition after `&&`. An `if`/`else if` chain testing one subject for both `Ok` and `Error` covers every case, so a function can end on it without a dead `else`. A branch that adds a condition of its own, `answer is Result.Ok(v) && v > 10`, covers nothing: it can be false with an `Ok` in hand. The slides on pattern matching show everything else `is` can do.",
			explanationPt: "`Result` é como toda operação falível se reporta: `Result.Ok(valor)` quando deu certo, `Result.Error(carga)` quando não deu. É a única união genérica nativa da linguagem, escrita `Result<Int, Str>` para um `Int` ou uma `Str` explicando por que não.\n\n`r is Result.Ok(v)` é um `Bool` que é `true` quando `r` guarda um `Ok`, e vincula `v` ao que ele carrega para o ramo que protege, e para o resto da mesma condição depois de `&&`. Uma cadeia `if`/`else if` que testa um mesmo sujeito para `Ok` e `Error` cobre todos os casos, então uma função pode terminar nela sem um `else` morto. Um ramo que acrescenta uma condição própria, `answer is Result.Ok(v) && v > 10`, não cobre nada: ele pode ser falso com um `Ok` na mão. Os slides sobre casamento de padrões mostram tudo o mais que `is` sabe fazer.",
			examples: [
				Example(caption: "", captionPt: "", code: `func half(n: Int): Result<Int, Str> \{
	if n % 2 == 0 \{
		return Result.Ok(n / 2)
	}
	return Result.Error("\{n} is not even")
}

func describe(n: Int): Str \{
	answer := half(n)
	if answer is Result.Ok(v) \{
		return "half: \{v}"
	} else if answer is Result.Error(why) \{
		return why
	}
}

proc main(): void \{
	echo describe(4)    // half: 2
	echo describe(5)    // 5 is not even

	if half(40) is Result.Ok(v) && v > 10 \{
		echo "a big half: \{v}"
	}
}`, codePt: `func half(n: Int): Result<Int, Str> \{
	if n % 2 == 0 \{
		return Result.Ok(n / 2)
	}
	return Result.Error("\{n} não é par")
}

func describe(n: Int): Str \{
	answer := half(n)
	if answer is Result.Ok(v) \{
		return "metade: \{v}"
	} else if answer is Result.Error(why) \{
		return why
	}
}

proc main(): void \{
	echo describe(4)    // metade: 2
	echo describe(5)    // 5 não é par

	if half(40) is Result.Ok(v) && v > 10 \{
		echo "uma metade grande: \{v}"
	}
}`),
			],
		),
		Slide(
			title: "assert and panic",
			titlePt: "assert e panic",
			download: false,
			shot: "",
			explanation: "`assert cond` says that `cond` must hold, and what a failure does depends on where it is written. In ordinary code a failed assertion has proved the program wrong, so the program stops, printing the condition as written and, for `==` or `!=`, what each side came out as. Inside a `test` it has proved the test wrong, so the failure is recorded and the rest of the suite still runs; the testing slide shows that report. Either way its operands are evaluated exactly once, whether it holds or not.\n\n`panic value` stops the program at once, printing `value` the way `echo` would (so an atom prints its name), and it takes any value, not only a `Bool`. It never returns, so a path ending in `panic` counts as ended, which closes off a tail the checker cannot see is unreachable. An `assert` does not end a path: one that holds carries on. A panic inside a test fails only that test, and one inside a service kills only that service.",
			explanationPt: "`assert cond` diz que `cond` precisa valer, e o que uma falha faz depende de onde ele está escrito. Em código comum, uma asserção que falha provou que o programa está errado, então o programa para, imprimindo a condição como foi escrita e, para `==` ou `!=`, no que cada lado deu. Dentro de um `test`, ela provou que o teste está errado, então a falha é registrada e o resto da suíte continua rodando; o slide de testes mostra esse relatório. De qualquer forma, seus operandos são avaliados exatamente uma vez, valendo ou não.\n\n`panic value` para o programa na hora, imprimindo `value` do jeito que o `echo` faria (então um átomo imprime seu nome), e aceita qualquer valor, não só um `Bool`. Ele nunca retorna, então um caminho que termina em `panic` conta como encerrado, o que fecha um final que o verificador não consegue ver que é inalcançável. Um `assert` não encerra um caminho: um que vale segue adiante. Um panic dentro de um teste reprova só aquele teste, e um dentro de um serviço mata só aquele serviço.",
			examples: [
				Example(caption: "In ordinary code, a failed assert stops the program", captionPt: "Em código comum, um assert que falha para o programa", code: `func total(prices: Int[]): Int \{
	mut sum := 0
	for each p in prices \{
		sum += p
	}
	return sum
}

proc main(): void \{
	assert total([3, 4]) == 7    // holds: nothing happens
	echo "the basket adds up"
	assert total([3, 4]) == 8    // does not: the program stops, here
	echo "never reached"
}`, codePt: `func total(prices: Int[]): Int \{
	mut sum := 0
	for each p in prices \{
		sum += p
	}
	return sum
}

proc main(): void \{
	assert total([3, 4]) == 7    // vale: nada acontece
	echo "o carrinho fecha a conta"
	assert total([3, 4]) == 8    // não vale: o programa para, aqui
	echo "nunca alcançado"
}`),
				Example(caption: "What it prints", captionPt: "O que ele imprime", code: `$ hive run basket.hive
the basket adds up
panic: hive: assertion failed: total([3, 4]) == 8
	  left:  7
	  right: 8

goroutine 1 [running]:
…`, codePt: `$ hive run basket.hive
o carrinho fecha a conta
panic: hive: assertion failed: total([3, 4]) == 8
	  left:  7
	  right: 8

goroutine 1 [running]:
…`),
				Example(caption: "panic closes off a tail the checker cannot see is unreachable", captionPt: "panic fecha um final que o verificador não vê que é inalcançável", code: `func sign(n: Int): Int \{
	if n > 0 \{
		return 1
	} else if n < 0 \{
		return -1
	} else if n == 0 \{
		return 0
	}
	// Every Int is one of the three, but nothing proves it to the compiler.
	panic "an Int that is not positive, negative or zero: \{n}"
}

proc main(): void \{
	echo sign(-8)
}`, codePt: `func sign(n: Int): Int \{
	if n > 0 \{
		return 1
	} else if n < 0 \{
		return -1
	} else if n == 0 \{
		return 0
	}
	// Todo Int é um dos três, mas nada prova isso ao compilador.
	panic "um Int que não é positivo, negativo nem zero: \{n}"
}

proc main(): void \{
	echo sign(-8)
}`),
			],
		),
	]
}

// Vectors, bounds and tables
func collections(): Slide[7] {
	return [
		Slide(
			title: "Vectors",
			titlePt: "Vetores",
			download: false,
			shot: "",
			explanation: "A vector holds elements of one type, side by side in memory, and its type says how long it is:\n\n- `Str[3]` is static: exactly three, always. `v := [\"a\", \"b\", \"c\"]` is one, since a length inferred from the value is still a fixed length.\n- `Str[dyn]` is dynamic: it promises nothing about its length, and it is the only kind `append`, `prepend` and `drop` change. It has to be written out, as `mut Str[dyn] v = …`.\n- `Str[]` is a parameter-only spelling that takes either kind. A parameter declared `Str[dyn]` takes only a vector declared `[dyn]`.\n\nA vector of vectors reads left to right: `Str[3][2]` is two vectors of three, so `grid[1][2]` is the last cell of the second row. `v[i]` reads an element and `v[lo:hi]` slices with **both bounds inclusive**, so `v[0:1]` is two elements; either bound may be left out. Every index and slice is proved in range when the program compiles, as the slide on bounds shows. `+` joins two vectors into a new one, and `==` compares them element by element.",
			explanationPt: "Um vetor guarda elementos de um só tipo, lado a lado na memória, e seu tipo diz o tamanho dele:\n\n- `Str[3]` é estático: exatamente três, sempre. `v := [\"a\", \"b\", \"c\"]` é um, já que um tamanho inferido do valor continua sendo um tamanho fixo.\n- `Str[dyn]` é dinâmico: não promete nada sobre o tamanho, e é o único tipo que `append`, `prepend` e `drop` alteram. Ele precisa ser escrito, como `mut Str[dyn] v = …`.\n- `Str[]` é uma grafia só para parâmetros, que aceita qualquer um dos dois. Um parâmetro declarado `Str[dyn]` só aceita um vetor declarado `[dyn]`.\n\nUm vetor de vetores se lê da esquerda para a direita: `Str[3][2]` são dois vetores de três, então `grid[1][2]` é a última célula da segunda linha. `v[i]` lê um elemento e `v[lo:hi]` fatia com **os dois limites inclusivos**, então `v[0:1]` são dois elementos; qualquer um dos limites pode ser omitido. Todo índice e toda fatia são provados dentro dos limites quando o programa compila, como mostra o slide sobre limites. `+` junta dois vetores em um novo, e `==` os compara elemento por elemento.",
			examples: [
				Example(caption: "", captionPt: "", code: `proc main(): void \{
	v := ["a", "b", "c"]            // Str[3] — a static length, inferred
	mut Str[dyn] w = ["a", "b"]     // dynamic — the only kind append accepts
	append(w, "c")

	echo v[0]                       // a
	echo v[0:1]                     // ["a", "b"] — both bounds inclusive
	echo v[1:]                      // ["b", "c"]
	echo v == ["a", "b", "c"]       // true — element by element

	Str[3][2] grid = [["a", "b", "c"], ["d", "e", "f"]]
	echo grid[1][2]                 // f — two rows of three
}`, codePt: `proc main(): void \{
	v := ["a", "b", "c"]            // Str[3] — um tamanho estático, inferido
	mut Str[dyn] w = ["a", "b"]     // dinâmico — o único tipo que append aceita
	append(w, "c")

	echo v[0]                       // a
	echo v[0:1]                     // ["a", "b"] — os dois limites inclusivos
	echo v[1:]                      // ["b", "c"]
	echo v == ["a", "b", "c"]       // true — elemento por elemento

	Str[3][2] grid = [["a", "b", "c"], ["d", "e", "f"]]
	echo grid[1][2]                 // f — duas linhas de três
}`),
			],
		),
		Slide(
			title: "Builtins",
			titlePt: "Funções nativas",
			download: false,
			shot: "",
			explanation: "These are always in scope, with no import:\n\n- `len` counts a vector's elements, a `Str`'s characters or a map's pairs; `bytes` counts a vector's storage or a `Str`'s UTF-8.\n- `append` and `prepend` grow a `mut` `[dyn]` vector at either end; `drop(v, low, high)` removes a range, both ends inclusive, and hands back what it removed.\n- `join(vector, sep)` puts a `Str` vector together with a separator; `split(str, sep)` is its inverse, and `split(s, \"\")` is every character.\n- `replaceFirst` and `replaceAll` rewrite one occurrence or every one, answering with a new string.\n- `indexOf` finds the first equal element, or in a `Str` the first occurrence, counted in characters, as a `Result` whose `Ok` position is always safe to index with.\n- `map`, `filter`, `filterMap` and `sort` walk a vector, on the slide on walking and sorting; `row`, `column` and `toTable` are for tables, `spawn`, `at` and `kill` for services, and `hide`, `bypass` and `reveal` for secrets, each on its own slide.\n\nA builtin can only be called. Several are overloaded, so a bare `len` or a partial `join(_, \",\")` is not a value; wrap it in a `func` of your own. Its arguments may be named like any call's, with the names above (`join(sep: \", \", vector: fruit)`), and an overloaded position answers to each of its names, so `len(str: s)` and `len(vector: v)` are both `len`.\n\nA `func`, `proc`, `query` or `type` of your own with one of these names wins at every bare call, and the builtin stays reachable as `hive.<name>`.",
			explanationPt: "Estas estão sempre no escopo, sem import:\n\n- `len` conta os elementos de um vetor, os caracteres de uma `Str` ou os pares de um mapa; `bytes` conta o armazenamento de um vetor ou o UTF-8 de uma `Str`.\n- `append` e `prepend` fazem crescer um vetor `mut` `[dyn]` em uma das pontas; `drop(v, low, high)` remove um intervalo, as duas pontas inclusivas, e devolve o que removeu.\n- `join(vector, sep)` junta um vetor de `Str` com um separador; `split(str, sep)` é o inverso, e `split(s, \"\")` são todos os caracteres.\n- `replaceFirst` e `replaceAll` reescrevem uma ocorrência ou todas, respondendo com uma string nova.\n- `indexOf` encontra o primeiro elemento igual, ou em uma `Str` a primeira ocorrência, contada em caracteres, como um `Result` cuja posição `Ok` é sempre segura para indexar.\n- `map`, `filter`, `filterMap` e `sort` percorrem um vetor, no slide sobre percorrer e ordenar; `row`, `column` e `toTable` são para tabelas, `spawn`, `at` e `kill` para serviços, e `hide`, `bypass` e `reveal` para segredos, cada um no seu slide.\n\nUma função nativa só pode ser chamada. Várias são sobrecarregadas, então um `len` solto ou um `join(_, \",\")` parcial não é um valor; embrulhe-a em um `func` seu. Os argumentos dela podem ser nomeados como os de qualquer chamada, com os nomes acima (`join(sep: \", \", vector: fruit)`), e uma posição sobrecarregada atende a cada um dos seus nomes, então `len(str: s)` e `len(vector: v)` são ambos `len`.\n\nUm `func`, `proc`, `query` ou `type` seu com um desses nomes vence em toda chamada sem qualificação, e a função nativa continua acessível como `hive.<nome>`.",
			examples: [
				Example(caption: "Measuring, growing and shrinking", captionPt: "Medindo, crescendo e encolhendo", code: `proc main(): void \{
	echo len(["pear", "apple", "kiwi"])   // 3
	echo bytes("café")                     // 5

	mut Str[dyn] basket = ["pear"]
	append(basket, "apple")
	prepend(value: "kiwi", vector: basket) // named, in any order
	echo basket

	// drop's two bounds are proved like an index, which is the next slide:
	// here the guard is that basket has a first element.
	if basket bounds 0 \{
		echo drop(basket, 0, 0)            // ["kiwi"]
	}
	echo basket                            // ["pear", "apple"]
}`, codePt: `proc main(): void \{
	echo len(["pear", "apple", "kiwi"])   // 3
	echo bytes("café")                     // 5

	mut Str[dyn] basket = ["pear"]
	append(basket, "apple")
	prepend(value: "kiwi", vector: basket) // nomeados, em qualquer ordem
	echo basket

	// os dois limites de drop são provados como um índice, que é o próximo slide:
	// aqui a guarda é que basket tem um primeiro elemento.
	if basket bounds 0 \{
		echo drop(basket, 0, 0)            // ["kiwi"]
	}
	echo basket                            // ["pear", "apple"]
}`),
				Example(caption: "Joining, splitting, finding and rewriting", captionPt: "Juntando, dividindo, encontrando e reescrevendo", code: `proc main(): void \{
	fruit := ["pear", "apple", "kiwi"]
	line := join(fruit, ", ")
	echo split(line, ", ")

	if indexOf(fruit, "apple") is Result.Ok(i) \{
		echo fruit[i]          // an Ok position needs no guard
	}

	path := "a/b/c"
	echo replaceFirst(path, "/", " > ")   // a > b/c
	echo replaceAll(path, "/", " > ")     // a > b > c
	echo path                             // a/b/c — a Str is a value
}`, codePt: `proc main(): void \{
	fruit := ["pear", "apple", "kiwi"]
	line := join(fruit, ", ")
	echo split(line, ", ")

	if indexOf(fruit, "apple") is Result.Ok(i) \{
		echo fruit[i]          // uma posição Ok não precisa de guarda
	}

	caminho := "a/b/c"
	echo replaceFirst(caminho, "/", " > ")   // a > b/c
	echo replaceAll(caminho, "/", " > ")     // a > b > c
	echo caminho                             // a/b/c — uma Str é um valor
}`),
				Example(caption: "A declaration of your own wins", captionPt: "Uma declaração sua vence", code: `// Ours. Its own parameters, its own arity, and it is what every bare
// call to len in this file means from here on.
func len(label: Str, extra: Int): Str \{
	return "\{label}\{extra}"
}

proc main(): void \{
	Str[dyn] v = ["a", "b"]

	echo len("x", 2)          // ours: x2
	echo hive.len(v)          // the builtin, by its long name: 2
	echo hive.join(v, "-")    // the long name works whether you shadowed or not
}`, codePt: `// A nossa. Seus próprios parâmetros, sua própria aridade, e é o que toda
// chamada solta a len neste arquivo significa daqui em diante.
func len(label: Str, extra: Int): Str \{
	return "\{label}\{extra}"
}

proc main(): void \{
	Str[dyn] v = ["a", "b"]

	echo len("x", 2)          // a nossa: x2
	echo hive.len(v)          // a nativa, pelo nome longo: 2
	echo hive.join(v, "-")    // o nome longo funciona tendo sombreado ou não
}`),
			],
		),
		Slide(
			title: "Bounds, proved at compile time",
			titlePt: "Limites, provados em tempo de compilação",
			download: false,
			shot: "",
			explanation: "Every index and slice is proved in range before the program runs, so none can fail when it does; one the compiler cannot prove is a compile error. What proves one:\n\n- A literal index into a vector whose length is known: `v[2]` on a `Str[3]`.\n- A guard, `if v bounds i \{ … }`, which is `i >= 0 && i < len(v)`. It covers the branch under it and the rest of its own `&&` condition, so `if v bounds i && v[i] > 0` is proved; it proves nothing past an `||`.\n- A counting loop whose counter starts at zero or above and counts up by one while below `len(v)`. An `Int` wraps past its largest value, so a counter stepping by more could turn negative, and proves nothing.\n- A position `indexOf` answered with, but only for the vector it searched.\n\nWhat proves nothing: an index worked out on the spot, like `v[len(v) - 1]`, which has to be bound to a name and guarded; an early `return`, since a guard proves only the branch it opens; and a cell of a row picked by a moving index, `t[r][c]`, where the row has to be bound first (`row := t[r]`) and the cell guarded against it. A slice's two bounds are proved one at a time.\n\nA proof lasts until something could change what it was about: assigning to the vector or the index, declaring either again or binding its name in a pattern, `drop` (the one builtin that shortens a vector), or handing the vector to a `mut` parameter. Inside a loop, what the body does counts against every turn.",
			explanationPt: "Todo índice e toda fatia são provados dentro dos limites antes de o programa rodar, então nenhum pode falhar quando ele roda; um que o compilador não consegue provar é um erro de compilação. O que prova um:\n\n- Um índice literal em um vetor de tamanho conhecido: `v[2]` em um `Str[3]`.\n- Uma guarda, `if v bounds i \{ … }`, que é `i >= 0 && i < len(v)`. Ela cobre o ramo abaixo dela e o resto da sua própria condição com `&&`, então `if v bounds i && v[i] > 0` fica provado; ela não prova nada depois de um `||`.\n- Um laço de contagem cujo contador começa em zero ou acima e sobe de um em um enquanto for menor que `len(v)`. Um `Int` dá a volta depois do seu maior valor, então um contador que sobe mais que isso poderia ficar negativo, e não prova nada.\n- Uma posição que `indexOf` respondeu, mas só para o vetor que ele procurou.\n\nO que não prova nada: um índice calculado na hora, como `v[len(v) - 1]`, que precisa ser vinculado a um nome e guardado; um `return` antecipado, já que uma guarda prova só o ramo que abre; e uma célula de uma linha escolhida por um índice que muda, `t[r][c]`, em que a linha precisa ser vinculada antes (`row := t[r]`) e a célula guardada contra ela. Os dois limites de uma fatia são provados um de cada vez.\n\nUma prova dura até algo poder mudar aquilo de que ela trata: atribuir ao vetor ou ao índice, declarar qualquer um de novo ou vincular o nome dele em um padrão, `drop` (o único builtin que encurta um vetor), ou passar o vetor a um parâmetro `mut`. Dentro de um laço, o que o corpo faz conta para toda volta.",
			examples: [
				Example(caption: "What proves an index", captionPt: "O que prova um índice", code: `proc main(): void \{
	v := ["a", "b", "c"]
	echo v[2]                          // a literal into a known length

	last := len(v) - 1
	if v bounds last \{
		echo v[last]                   // the guard covers it
	}
	if v bounds last && v[last] == "c" \{
		echo "and the rest of its own condition"
	}

	for i := 0; i < len(v); i++ \{
		echo v[i]                      // the loop's own condition is the guard
	}

	if indexOf(v, "b") is Result.Ok(at) \{
		echo v[at]                     // a position indexOf answered with
	}
}`, codePt: `proc main(): void \{
	v := ["a", "b", "c"]
	echo v[2]                          // um literal em um tamanho conhecido

	last := len(v) - 1
	if v bounds last \{
		echo v[last]                   // a guarda cobre
	}
	if v bounds last && v[last] == "c" \{
		echo "e o resto da própria condição"
	}

	for i := 0; i < len(v); i++ \{
		echo v[i]                      // a condição do laço é a guarda
	}

	if indexOf(v, "b") is Result.Ok(at) \{
		echo v[at]                     // uma posição que indexOf respondeu
	}
}`),
				Example(caption: "Binding the row a moving index picks", captionPt: "Vinculando a linha que um índice variável escolhe", code: "func cell(t: Str[dyn][dyn], r: Int, c: Int): Str \{\n\t// `if t bounds r \{ if t[r] bounds c \{ echo t[r][c] } }` is refused:\n\t// t[r] is a different row each time r moves, so it is bound first.\n\tif t bounds r \{\n\t\trow := t[r]\n\t\tif row bounds c \{\n\t\t\treturn row[c]\n\t\t}\n\t}\n\treturn \"\"\n}\n\nproc main(): void \{\n\tStr[dyn][dyn] t = [[\"a\", \"b\"], [\"c\", \"d\"]]\n\techo cell(t, 1, 0)\n}", codePt: "func cell(t: Str[dyn][dyn], r: Int, c: Int): Str \{\n\t// `if t bounds r \{ if t[r] bounds c \{ echo t[r][c] } }` é recusado:\n\t// t[r] é uma linha diferente a cada vez que r muda, então ela é vinculada antes.\n\tif t bounds r \{\n\t\trow := t[r]\n\t\tif row bounds c \{\n\t\t\treturn row[c]\n\t\t}\n\t}\n\treturn \"\"\n}\n\nproc main(): void \{\n\tStr[dyn][dyn] t = [[\"a\", \"b\"], [\"c\", \"d\"]]\n\techo cell(t, 1, 0)\n}"),
			],
		),
		Slide(
			title: "The characters of a Str",
			titlePt: "Os caracteres de uma Str",
			download: false,
			shot: "",
			explanation: "A `Str` is counted, indexed and sliced by character. `len` counts characters where `bytes` counts the UTF-8 they take, so for `\"café\"` they are 4 and 5. `s[0]` is the first character, as a one-character `Str`, and `s[1:3]` is characters one to three, both bounds inclusive.\n\nThose are proved in range exactly as a vector's are, with one difference: a string never has a length the compiler knows, because there is no `Str[3]` for text. So even `s[1]` on a literal sitting right there needs a guard, or a position `indexOf` answered with.\n\nNothing writes into a `Str`: `s[0] = \"x\"` is a compile error, because characters are not all the same width and writing one would move every character after it. Build the new string instead. `for each` does not walk a `Str` either; `split(s, \"\")` gives its characters as a vector.",
			explanationPt: "Uma `Str` é contada, indexada e fatiada por caractere. `len` conta caracteres enquanto `bytes` conta o UTF-8 que eles ocupam, então para `\"café\"` são 4 e 5. `s[0]` é o primeiro caractere, como uma `Str` de um caractere, e `s[1:3]` são os caracteres de um a três, os dois limites inclusivos.\n\nEles são provados dentro dos limites exatamente como os de um vetor, com uma diferença: uma string nunca tem um tamanho que o compilador conheça, porque não existe `Str[3]` para texto. Então até `s[1]` em um literal bem ali precisa de uma guarda, ou de uma posição que `indexOf` respondeu.\n\nNada escreve dentro de uma `Str`: `s[0] = \"x\"` é um erro de compilação, porque caracteres não têm todos a mesma largura e escrever um moveria todos os caracteres depois dele. Construa a string nova em vez disso. `for each` também não percorre uma `Str`; `split(s, \"\")` dá os caracteres dela como um vetor.",
			examples: [
				Example(caption: "", captionPt: "", code: `proc main(): void \{
	s := "café au lait"

	echo len(s)                  // 12 characters
	echo bytes(s)                // 13 bytes — é takes two

	if s bounds 3 \{
		echo s[3]                // é, the fourth character
		echo s[0:3]              // café — both bounds inclusive
	}

	// A position from indexOf is one the string really has, so the
	// slice taken at it needs no guard of its own.
	if indexOf(s, "au") is Result.Ok(at) \{
		echo s[at:]              // au lait
	}

	for each c in split("bee", "") \{
		echo c
	}
}`, codePt: `proc main(): void \{
	s := "café au lait"

	echo len(s)                  // 12 caracteres
	echo bytes(s)                // 13 bytes — é ocupa dois

	if s bounds 3 \{
		echo s[3]                // é, o quarto caractere
		echo s[0:3]              // café — os dois limites inclusivos
	}

	// Uma posição vinda de indexOf é uma que a string realmente tem,
	// então a fatia tirada nela não precisa de guarda própria.
	if indexOf(s, "au") is Result.Ok(at) \{
		echo s[at:]              // au lait
	}

	for each c in split("bee", "") \{
		echo c
	}
}`),
			],
		),
		Slide(
			title: "Walking and sorting",
			titlePt: "Percorrendo e ordenando",
			download: false,
			shot: "",
			explanation: "Four builtins walk a vector with a function, calling it once per element, in order, on the calling thread. `map`, `filter` and `filterMap` take a `func` or a `proc`, but never one that takes its element `mut`; `sort` takes a `func`:\n\n- `map(values, transform)` answers with every element transformed, at the vector's length. A transform that answers with nothing is refused: a walk that only acts is a `for each`.\n- `filter(values, keep)` answers with the elements `keep` says `true` to.\n- `filterMap(values, transform)` does both: `transform` answers with a `Result`, and the `Ok` payloads are kept.\n- `sort(values)` answers with the elements in their own order, below, and `sort(values, first)` in the order a `func(a, b): Bool` gives, `true` when `a` comes first. Equal elements keep the order they had.\n\nWithout a comparator, `sort` uses the elements' own order:\n\n- numbers by value, and `false` before `true`;\n- a `Str` by its bytes, so `\"B\"` comes before `\"a\"`;\n- an atom by where it was first mentioned;\n- a vector element by element, and a declared type field by field, in declaration order;\n- a union by the order its variants were declared in, and a `Result` with its `Error`s before its `Ok`s.\n\nA map, an address and a function value have no order, nor does a type holding one, so sorting them takes a comparator. Written as a statement on a `mut` vector, `sort` sorts it in place.",
			explanationPt: "Quatro funções nativas percorrem um vetor com uma função, chamada uma vez por elemento, em ordem, na thread que chamou. `map`, `filter` e `filterMap` aceitam um `func` ou um `proc`, mas nunca um que receba seu elemento como `mut`; `sort` recebe um `func`:\n\n- `map(values, transform)` responde com todo elemento transformado, no mesmo tamanho do vetor. Uma transformação que não responde nada é recusada: um percurso que só age é um `for each`.\n- `filter(values, keep)` responde com os elementos para os quais `keep` diz `true`.\n- `filterMap(values, transform)` faz as duas coisas: `transform` responde com um `Result`, e as cargas `Ok` são mantidas.\n- `sort(values)` responde com os elementos na ordem própria deles, descrita abaixo, e `sort(values, first)` na ordem que um `func(a, b): Bool` dá, `true` quando `a` vem primeiro. Elementos iguais mantêm a ordem que tinham.\n\nSem comparador, `sort` usa a ordem própria dos elementos:\n\n- números pelo valor, e `false` antes de `true`;\n- uma `Str` pelos bytes, então `\"B\"` vem antes de `\"a\"`;\n- um átomo por onde foi mencionado primeiro;\n- um vetor elemento por elemento, e um tipo declarado campo por campo, na ordem da declaração;\n- uma união pela ordem em que as variantes foram declaradas, e um `Result` com os `Error`s antes dos `Ok`s.\n\nUm mapa, um endereço e um valor de função não têm ordem, nem um tipo que guarde um deles, então ordená-los pede um comparador. Escrito como instrução sobre um vetor `mut`, `sort` o ordena no lugar.",
			examples: [
				Example(caption: "map, filter and filterMap", captionPt: "map, filter e filterMap", code: `func isLong(fruit: Str): Bool \{
	return len(fruit) > 4
}

func shout(fruit: Str): Str \{
	return fruit + "!"
}

func evenHalf(n: Int): Result<Int, Bool> \{
	if n % 2 == 0 \{
		return Result.Ok(n / 2)
	}
	return Result.Error(false)
}

proc main(): void \{
	fruit := ["pear", "apple", "kiwi"]
	echo map(fruit, shout)                   // ["pear!", "apple!", "kiwi!"]
	echo filter(fruit, isLong)               // ["apple"]
	echo filterMap([1, 2, 3, 4], evenHalf)   // [1, 2]
}`, codePt: `func isLong(fruit: Str): Bool \{
	return len(fruit) > 4
}

func shout(fruit: Str): Str \{
	return fruit + "!"
}

func evenHalf(n: Int): Result<Int, Bool> \{
	if n % 2 == 0 \{
		return Result.Ok(n / 2)
	}
	return Result.Error(false)
}

proc main(): void \{
	fruit := ["pear", "apple", "kiwi"]
	echo map(fruit, shout)                   // ["pear!", "apple!", "kiwi!"]
	echo filter(fruit, isLong)               // ["apple"]
	echo filterMap([1, 2, 3, 4], evenHalf)   // [1, 2]
}`),
				Example(caption: "Sorting", captionPt: "Ordenando", code: `func longerFirst(a: Str, b: Str): Bool \{
	return len(a) > len(b)
}

proc main(): void \{
	echo sort(["pear", "Apple", "kiwi"])        // ["Apple", "kiwi", "pear"] — by bytes
	echo sort([true, false])                    // [false, true]
	echo sort([[2, 1], [1, 9], [1, 2]])         // [[1, 2], [1, 9], [2, 1]]
	echo sort(["fig", "banana", "kiwi"], longerFirst)

	mut ranks := [3, 1, 2]
	sort(ranks)                                 // a statement: sorts ranks in place
	echo ranks
}`, codePt: `func longerFirst(a: Str, b: Str): Bool \{
	return len(a) > len(b)
}

proc main(): void \{
	echo sort(["pear", "Apple", "kiwi"])        // ["Apple", "kiwi", "pear"] — pelos bytes
	echo sort([true, false])                    // [false, true]
	echo sort([[2, 1], [1, 9], [1, 2]])         // [[1, 2], [1, 9], [2, 1]]
	echo sort(["fig", "banana", "kiwi"], longerFirst)

	mut ranks := [3, 1, 2]
	sort(ranks)                                 // uma instrução: ordena ranks no lugar
	echo ranks
}`),
			],
		),
		Slide(
			title: "Pipes",
			titlePt: "Pipes",
			download: false,
			shot: "",
			explanation: "`x |> f(a)` is sugar for `f(x, a)`: the value on the left becomes the call's first argument, so a chain reads in the order it runs rather than inside out. `|>` is left-associative, and a stage with no other arguments needs no parentheses: `x |> f` is `f(x)`, as `x |> f()` is.\n\nIt binds tighter than `+ - * / %` and every comparison, and looser than the prefix operators and `**`, so a pipeline can sit on either side of one: `v |> len > 2` compares the length, and `2 ** 3 |> f` is `f(8)`. It takes the value written beside it, so `1 + 2 |> f` is `1 + f(2)`; put a computed value in parentheses.\n\nA `proc`, a builtin, a library call and a constructor all pipe. A pipe compiles to exactly the call you could have written by hand: there is no pipeline object, and nothing is deferred.",
			explanationPt: "`x |> f(a)` é açúcar sintático para `f(x, a)`: o valor da esquerda vira o primeiro argumento da chamada, então uma sequência se lê na ordem em que roda, e não de dentro para fora. O `|>` é associativo à esquerda, e um estágio sem outros argumentos dispensa os parênteses: `x |> f` é `f(x)`, assim como `x |> f()`.\n\nEle se liga mais forte que `+ - * / %` e que toda comparação, e mais fraco que os operadores prefixados e que `**`, então um pipeline pode ficar dos dois lados de um deles: `v |> len > 2` compara o comprimento, e `2 ** 3 |> f` é `f(8)`. Ele pega o valor escrito ao lado dele, então `1 + 2 |> f` é `1 + f(2)`; um valor calculado vai entre parênteses.\n\nUm `proc`, uma função nativa, uma chamada da biblioteca e um construtor entram num pipe do mesmo jeito. Um pipe compila exatamente para a chamada que você poderia ter escrito à mão: não existe objeto de pipeline, e nada fica adiado.",
			examples: [
				Example(caption: "A chain reads in the order it runs", captionPt: "Uma sequência se lê na ordem em que roda", code: `func isEven(n: Int): Bool \{ return n % 2 == 0 }
func label(n: Int): Str \{ return "#\{n}" }

proc main(): void \{
	Int[dyn] nums = [1, 2, 3, 4, 5, 6]

	echo nums |> filter(isEven) |> map(label) |> join(", ")

	// The same call, and what the line above compiles to.
	echo join(map(filter(nums, isEven), label), ", ")
}`, codePt: `func isEven(n: Int): Bool \{ return n % 2 == 0 }
func label(n: Int): Str \{ return "#\{n}" }

proc main(): void \{
	Int[dyn] nums = [1, 2, 3, 4, 5, 6]

	echo nums |> filter(isEven) |> map(label) |> join(", ")

	// A mesma chamada, e no que a linha acima compila.
	echo join(map(filter(nums, isEven), label), ", ")
}`),
				Example(caption: "What it binds to", captionPt: "A quem ele se liga", code: `func double(n: Int): Int \{ return n * 2 }

proc main(): void \{
	Str[dyn] words = ["a", "b", "c"]

	// Tighter than a comparison, so this is len(words) > 2.
	echo words |> len > 2

	// And it takes the value beside it: 1 + double(2), not double(3).
	echo 1 + 2 |> double
	echo (1 + 2) |> double
	echo 2 ** 3 |> double    // 16 — ** binds tighter than a pipe
}`, codePt: `func double(n: Int): Int \{ return n * 2 }

proc main(): void \{
	Str[dyn] words = ["a", "b", "c"]

	// Mais forte que uma comparação, então isto é len(words) > 2.
	echo words |> len > 2

	// E ele pega o valor ao lado: 1 + double(2), e não double(3).
	echo 1 + 2 |> double
	echo (1 + 2) |> double
	echo 2 ** 3 |> double    // 16 — ** liga mais forte que um pipe
}`),
			],
		),
		Slide(
			title: "Tables and CSV",
			titlePt: "Tabelas e CSV",
			download: false,
			shot: "",
			explanation: "`Table` is the name for `Str[dyn][dyn]`: a vector of rows of cells. Three builtins work on one:\n\n- `row(table, key)` is the first row whose first cell is `key`, and `column(table, key)` the column whose top cell is `key`; each is `[]` when there is none.\n- `toTable(cells, wide)` cuts a flat vector into rows of `wide`, the last row holding what was left.\n\n`hive.file.csv(path, separator)` reads a separated file into a table. The separator is one character and is always written, since Hive has no optional parameters. While reading:\n\n- a quoted field may hold the separator, a newline or a doubled `\"\"`;\n- blank lines are skipped;\n- a byte-order mark at the start, which spreadsheets often write, is dropped;\n- every row keeps its own length, so a ragged file gives ragged rows, and a cell still needs its guard.\n\nA failure is a `hive.file.TableError`, carrying the `path` and a `message`. Spreadsheets, databases and maps answer with tables too, each on its own slide.",
			explanationPt: "`Table` é o nome de `Str[dyn][dyn]`: um vetor de linhas de células. Três funções nativas trabalham com uma:\n\n- `row(table, key)` é a primeira linha cuja primeira célula é `key`, e `column(table, key)` a coluna cuja célula do topo é `key`; cada uma é `[]` quando não há nenhuma.\n- `toTable(cells, wide)` corta um vetor plano em linhas de `wide`, a última ficando com o que sobrou.\n\n`hive.file.csv(path, separator)` lê um arquivo separado para uma tabela. O separador é um caractere só e é sempre escrito, já que o Hive não tem parâmetros opcionais. Na leitura:\n\n- um campo entre aspas pode conter o separador, uma quebra de linha ou um `\"\"` dobrado;\n- linhas em branco são puladas;\n- uma marca de ordem de bytes no início, que planilhas costumam escrever, é descartada;\n- toda linha mantém o próprio tamanho, então um arquivo irregular dá linhas irregulares, e uma célula ainda precisa da sua guarda.\n\nUma falha é um `hive.file.TableError`, com o `path` e uma `message`. Planilhas, bancos de dados e mapas também respondem com tabelas, cada um no seu slide.",
			examples: [
				Example(caption: "Rows, columns and cuts", captionPt: "Linhas, colunas e cortes", code: `proc main(): void \{
	Table crew = [["name", "role"], ["ada", "engineer"], ["grace", "admiral"]]
	echo row(crew, "ada")                          // ["ada", "engineer"]
	echo column(crew, "role")                      // ["role", "engineer", "admiral"]
	echo toTable(["a", "b", "c", "d", "e"], 2)     // [["a", "b"], ["c", "d"], ["e"]]
}`, codePt: `proc main(): void \{
	Table crew = [["name", "role"], ["ada", "engineer"], ["grace", "admiral"]]
	echo row(crew, "ada")                          // ["ada", "engineer"]
	echo column(crew, "role")                      // ["role", "engineer", "admiral"]
	echo toTable(["a", "b", "c", "d", "e"], 2)     // [["a", "b"], ["c", "d"], ["e"]]
}`),
				Example(caption: "Reading a CSV", captionPt: "Lendo um CSV", code: `proc main(): void \{
	hive.file.write("./crew.csv", "name,role\nada,\"engineer, first\"\ngrace\n")

	read := hive.file.csv("./crew.csv", ",")
	if read is Result.Ok(table) \{
		for each line in table \{
			echo "\{len(line)} cells: \{line}"     // the last row has one
		}
	} else if read is Result.Error(why) \{
		echo "\{why.path}: \{why.message}"
	}
}`, codePt: `proc main(): void \{
	hive.file.write("./crew.csv", "name,role\nada,\"engineer, first\"\ngrace\n")

	read := hive.file.csv("./crew.csv", ",")
	if read is Result.Ok(table) \{
		for each line in table \{
			echo "\{len(line)} células: \{line}"   // a última linha tem uma
		}
	} else if read is Result.Error(why) \{
		echo "\{why.path}: \{why.message}"
	}
}`),
			],
		),
	]
}

// Types, patterns and values
func types(): Slide[15] {
	return [
		Slide(
			title: "Declared types",
			titlePt: "Tipos declarados",
			download: false,
			shot: "",
			explanation: "A `type` with no variants is a struct; with variants, it is a tagged union. A value is built by calling the type or the variant — `User(1, \"ada\")`, `Shape.Circle(5)` — with its fields in order, or by name in any order. A variant that carries nothing is still called, `Shape.Point()`, because `Shape.Point` alone names the variant, not a value of it. There is no subtyping and no interface: a variant is a way to build and match a union, not a type of its own.\n\nA field declared outside every variant is added to all of them, after each variant's own fields, and it is the only kind of field read straight off a union value: `event.at`. Every other field belongs to its variant and is reached by matching with `is`, a few slides on — even one that every variant declares under the same name. A union value is built whole, so none of its fields is assigned on its own.\n\nA type may hold itself through a variant, as a tree does, or through a vector. A struct that holds itself directly, or through a `Result`, could never be finished, and is refused.",
			explanationPt: "Um `type` sem variantes é um struct; com variantes, é uma união com tag. Um valor é construído chamando o tipo ou a variante — `User(1, \"ada\")`, `Shape.Circle(5)` — com os campos em ordem, ou por nome em qualquer ordem. Uma variante que não carrega nada também é chamada, `Shape.Point()`, porque `Shape.Point` sozinho nomeia a variante, e não um valor dela. Não existe subtipagem nem interface: uma variante é uma forma de construir e casar uma união, não um tipo próprio.\n\nUm campo declarado fora de todas as variantes é adicionado a todas elas, depois dos campos próprios de cada uma, e é o único tipo de campo lido direto de um valor de união: `event.at`. Todo outro campo pertence à sua variante e é alcançado casando com `is`, alguns slides adiante — mesmo um que toda variante declare com o mesmo nome. Um valor de união é construído inteiro, então nenhum campo dele é atribuído sozinho.\n\nUm tipo pode conter a si mesmo através de uma variante, como uma árvore, ou de um vetor. Um struct que contém a si mesmo diretamente, ou através de um `Result`, nunca poderia ser terminado, e é recusado.",
			examples: [
				Example(caption: "A struct", captionPt: "Um struct", code: `type User \{
	id:   Int
	name: Str
}

proc main(): void \{
	u := User(1, "ada")
	echo u.name
	echo User(name: "grace", id: 2).id   // by name, in any order
}`, codePt: `type User \{
	id:   Int
	name: Str
}

proc main(): void \{
	u := User(1, "ada")
	echo u.name
	echo User(name: "grace", id: 2).id   // por nome, em qualquer ordem
}`),
				Example(caption: "A tagged union, and its shared fields", captionPt: "Uma união com tag, e seus campos compartilhados", code: "type Event \{\n\tat: Int                  // outside every variant: every one has it\n\tOpened \{ by: Str }\n\tClosed\n}\n\nproc main(): void \{\n\te := Event.Opened(\"ada\", 5)   // the variant's own field first, then `at`\n\techo e.at                      // 5 — a shared field is read straight off\n\t// echo e.by                   // compile error: `by` belongs to Opened\n\n\tfor each ev in [e, Event.Closed(9)] \{\n\t\techo ev.at\n\t}\n}", codePt: "type Event \{\n\tat: Int                  // fora de todas as variantes: toda uma o tem\n\tOpened \{ by: Str }\n\tClosed\n}\n\nproc main(): void \{\n\te := Event.Opened(\"ada\", 5)   // o campo próprio da variante primeiro, depois `at`\n\techo e.at                      // 5 — um campo compartilhado é lido direto\n\t// echo e.by                   // erro de compilação: `by` pertence a Opened\n\n\tfor each ev in [e, Event.Closed(9)] \{\n\t\techo ev.at\n\t}\n}"),
				Example(caption: "A type that holds itself", captionPt: "Um tipo que contém a si mesmo", code: `type Expr \{
	Num \{ value: Int }
	Add \{ left: Expr, right: Expr }
}

type Folder \{
	name: Str
	children: Folder[dyn]    // through a vector
}

proc main(): void \{
	sum := Expr.Add(Expr.Num(1), Expr.Num(2))
	echo sum
	echo Folder("root", [Folder("docs", [])]).name
}`, codePt: `type Expr \{
	Num \{ value: Int }
	Add \{ left: Expr, right: Expr }
}

type Folder \{
	name: Str
	children: Folder[dyn]    // através de um vetor
}

proc main(): void \{
	sum := Expr.Add(Expr.Num(1), Expr.Num(2))
	echo sum
	echo Folder("root", [Folder("docs", [])]).name
}`),
			],
		),
		Slide(
			title: "How echo shows a value",
			titlePt: "Como o echo mostra um valor",
			download: false,
			shot: "",
			explanation: "`echo` writes one line to standard output, and `panic` and interpolation show a value the same way:\n\n- A `Str` on its own **is** the line, unquoted. Inside a vector, a record or a `Result` it is quoted, which is what tells `[\"1\", \"2\"]` from `[1, 2]` and from `[\"1 2\"]`.\n- An `Int` and a `Bool` as written. A `Float` at its shortest: `3.0` shows as `3`, `0.1 + 0.2` as `0.30000000000000004`, and a large one with an exponent, `1.23456789123e+08`.\n- An atom by its name — except inside a string, where it is its number.\n- A vector as its elements in brackets, and a `Result` as `Ok(…)` or `Error(…)`.\n- A declared value as its fields in braces, and nothing else: `User(1, \"ada\")` shows as `\{1, \"ada\"}`, `Shape.Circle(3)` as `\{3}`, and a variant carrying nothing as `\{}`. The type and the variant are not shown, so a program that needs a readable name writes one.\n\nThe one value none of them shows is a `Secret`, on the next slide.",
			explanationPt: "`echo` escreve uma linha na saída padrão, e `panic` e a interpolação mostram um valor do mesmo jeito:\n\n- Uma `Str` sozinha **é** a linha, sem aspas. Dentro de um vetor, de um registro ou de um `Result`, ela aparece entre aspas, que é o que distingue `[\"1\", \"2\"]` de `[1, 2]` e de `[\"1 2\"]`.\n- Um `Int` e um `Bool` como escritos. Um `Float` no seu menor formato: `3.0` aparece como `3`, `0.1 + 0.2` como `0.30000000000000004`, e um grande com expoente, `1.23456789123e+08`.\n- Um átomo pelo seu nome — exceto dentro de uma string, onde ele é o seu número.\n- Um vetor como seus elementos entre colchetes, e um `Result` como `Ok(…)` ou `Error(…)`.\n- Um valor declarado como seus campos entre chaves, e nada mais: `User(1, \"ada\")` aparece como `\{1, \"ada\"}`, `Shape.Circle(3)` como `\{3}`, e uma variante que não carrega nada como `\{}`. O tipo e a variante não aparecem, então um programa que precisa de um nome legível escreve um.\n\nO único valor que nenhum deles mostra é um `Secret`, no próximo slide.",
			examples: [
				Example(caption: "", captionPt: "", code: `type User \{
	id:   Int
	name: Str
}

type Shape \{
	Circle \{ radius: Int }
	Point
}

func half(n: Int): Result<Int, Str> \{
	if n % 2 == 0 \{
		return Result.Ok(n / 2)
	}
	return Result.Error("odd")
}

proc main(): void \{
	echo "plain"                   // plain
	echo ["plain", "1"]            // ["plain", "1"]
	echo 3.0                       // 3
	echo 0.1 + 0.2                 // 0.30000000000000004
	echo #Ready                    // Ready
	echo half(4)                   // Ok(2)
	echo half(3)                   // Error("odd")
	echo User(1, "ada")            // \{1, "ada"}
	echo [Shape.Circle(3), Shape.Point()]   // [\{3}, \{}]
}`, codePt: `type User \{
	id:   Int
	name: Str
}

type Shape \{
	Circle \{ radius: Int }
	Point
}

func half(n: Int): Result<Int, Str> \{
	if n % 2 == 0 \{
		return Result.Ok(n / 2)
	}
	return Result.Error("ímpar")
}

proc main(): void \{
	echo "simples"                 // simples
	echo ["simples", "1"]          // ["simples", "1"]
	echo 3.0                       // 3
	echo 0.1 + 0.2                 // 0.30000000000000004
	echo #Ready                    // Ready
	echo half(4)                   // Ok(2)
	echo half(3)                   // Error("ímpar")
	echo User(1, "ada")            // \{1, "ada"}
	echo [Shape.Circle(3), Shape.Point()]   // [\{3}, \{}]
}`),
			],
		),
		Slide(
			title: "Secrets",
			titlePt: "Segredos",
			download: false,
			shot: "",
			explanation: "A `Secret<T>` holds a value that must not leak — a password, a key, a token, or a record of them — and the compiler enforces it:\n\n- `echo`, `panic`, interpolation and writing JSON all refuse a `Secret`, and anything that holds one: a field, an element, a `Result`. `reveal(secret)` is the only way back to the `T`.\n- `T` is plain data: text, numbers, vectors, maps, results and declared types made of them. A `Secret` of a function, an address, a library handle or another `Secret` is a compile error, and so is a bare `Secret` that does not say what it holds. The library's secrets are text, so they are `Secret<Str>`.\n- The value is kept as bytes in memory the operating system is told never to swap to disk, and is cleared once nothing holds it.\n- `==` compares two in constant time, so the time it takes says nothing about where they differ. A map is kept in key order, so two holding the same pairs are equal. A `Secret` has no order.\n\nLocked memory is finite, so `hide(value)` answers a `Result<Secret<T>, SecretError>`: `SecretError.LimitExceeded` when the limit is used up, and `SecretError.Unsupported` where the platform cannot lock memory at all, each with a `message`. `bypass(value)` makes a `Secret<T>` that cannot fail, in ordinary memory that may be swapped out — for a value that was never really secret on the way in, like a literal, which the executable holds anyway. Two library calls have the same kind of twin: `hive.term.readSecretBypass()` and `hive.crypto.decryptBypass(ciphertext, password)` are `readSecret` and `decrypt` into ordinary memory, so neither stops at the limit.\n\nA program that declares its own `Secret` still reaches the builtin as `hive.Secret<T>`, and its error as `hive.SecretError`.",
			explanationPt: "Um `Secret<T>` guarda um valor que não pode vazar — uma senha, uma chave, um token, ou um registro deles — e o compilador garante isso:\n\n- `echo`, `panic`, a interpolação e a escrita de JSON recusam um `Secret`, e qualquer coisa que guarde um: um campo, um elemento, um `Result`. `reveal(secret)` é o único caminho de volta para o `T`.\n- `T` é um dado simples: texto, números, vetores, mapas, resultados e tipos declarados feitos deles. Um `Secret` de uma função, de um endereço, de um recurso da biblioteca ou de outro `Secret` é um erro de compilação, e também um `Secret` sozinho, que não diz o que guarda. Os segredos da biblioteca são texto, então são `Secret<Str>`.\n- O valor fica em bytes numa memória que o sistema operacional é instruído a nunca levar para o swap, e é zerado assim que nada mais o segura.\n- `==` compara dois em tempo constante, então o tempo que leva não diz nada sobre onde eles diferem. Um mapa é guardado em ordem de chave, então dois com os mesmos pares são iguais. Um `Secret` não tem ordem.\n\nMemória travada é finita, então `hide(value)` responde com um `Result<Secret<T>, SecretError>`: `SecretError.LimitExceeded` quando o limite se esgota, e `SecretError.Unsupported` onde a plataforma não consegue travar memória nenhuma, cada um com uma `message`. `bypass(value)` faz um `Secret<T>` que não falha, em memória comum que pode ir para o swap — para um valor que nunca foi segredo de verdade na chegada, como um literal, que o executável já guarda de qualquer jeito. Duas chamadas da biblioteca têm um gêmeo do mesmo tipo: `hive.term.readSecretBypass()` e `hive.crypto.decryptBypass(ciphertext, password)` são o `readSecret` e o `decrypt` em memória comum, então nenhuma das duas para no limite.\n\nUm programa que declara o seu próprio `Secret` ainda alcança o nativo como `hive.Secret<T>`, e o erro dele como `hive.SecretError`.",
			examples: [
				Example(caption: "Kept, compared, never shown", captionPt: "Guardado, comparado, nunca mostrado", code: `type Login \{
	user:     Str
	password: Secret<Str>
}

proc main(): void \{
	typed := hide("hunter2")
	if typed is Result.Error(why) \{
		echo why
	} else if typed is Result.Ok(password) \{
		echo reveal(password)                // hunter2
		echo password == bypass("hunter2")   // true
		echo Login("ada", password).user     // ada
		// echo password                      — a compile error
		// echo Login("ada", password)        — and so is this
	}
}`, codePt: `type Login \{
	user:     Str
	password: Secret<Str>
}

proc main(): void \{
	typed := hide("hunter2")
	if typed is Result.Error(why) \{
		echo why
	} else if typed is Result.Ok(password) \{
		echo reveal(password)                // hunter2
		echo password == bypass("hunter2")   // true
		echo Login("ada", password).user     // ada
		// echo password                      — um erro de compilação
		// echo Login("ada", password)        — e este também
	}
}`),
				Example(caption: "Any plain value", captionPt: "Qualquer valor simples", code: `type Card \{
	number: Str
	pin:    Int
}

proc main(): void \{
	card := bypass(Card("4111 1111 1111 1111", 1234))
	echo reveal(card).pin                 // 1234
	codes := bypass([93, 17, 42])
	echo len(reveal(codes))               // 3
	echo codes == bypass([93, 17, 42])    // true
	// Secret<Str> s = codes              — a compile error: it holds Int[3]
}`, codePt: `type Card \{
	number: Str
	pin:    Int
}

proc main(): void \{
	card := bypass(Card("4111 1111 1111 1111", 1234))
	echo reveal(card).pin                 // 1234
	codes := bypass([93, 17, 42])
	echo len(reveal(codes))               // 3
	echo codes == bypass([93, 17, 42])    // true
	// Secret<Str> s = codes              — um erro de compilação: guarda Int[3]
}`),
			],
		),
		Slide(
			title: "A length is a promise",
			titlePt: "Um tamanho é uma promessa",
			download: false,
			shot: "",
			explanation: "A declared static length is kept everywhere a value reaches it. Every value that lands in a `Str[3]` — an initialiser, a later assignment, an argument, a field of a constructed value, a returned value — has to be exactly three long, and a length the compiler cannot see is refused, which is why `split` can never fill one. Because the promise holds at every one of those places, a `Str[3]` can be indexed unguarded even after it is reassigned, and so can a `Str[3]` parameter inside the callee. A `Str[3]` field is the same, construction included: assigning a whole new record still leaves it exactly three.\n\nAn inferred length is a length too — `mut v := [\"a\", \"b\", \"c\"]` can only be rebound to another three, and never grows — but the bounds pass keeps less about it. Writing through the name keeps the proof. Rebinding the name loses it, even to the same length and even in a branch that may not run, since a proof that holds only sometimes is not a proof. Declare the type when you want the promise, and `[dyn]` when you want a vector that grows and whose indexes you will guard.\n\nA guard proves less again: `if 2 < len(box.items)` is about the value the field held at that moment, so replacing the field, or the record around it, loses the proof, even inside the branch the guard opened.\n\nA known length survives every operation that cannot change it: `+` adds the two lengths, and `map` and `sort` keep their input's. `filter` and `filterMap` claim no length. All that is known about theirs is a maximum, and a maximum never puts an index in range, since a filter may keep nothing.",
			explanationPt: "Um tamanho estático declarado é mantido em todo lugar onde um valor chega a ele. Todo valor que cai num `Str[3]` — um inicializador, uma atribuição posterior, um argumento, um campo de um valor construído, um valor retornado — precisa ter exatamente três, e um tamanho que o compilador não consegue ver é recusado, e é por isso que `split` nunca consegue preencher um. Como a promessa vale em todos esses lugares, um `Str[3]` pode ser indexado sem guarda mesmo depois de reatribuído, e um parâmetro `Str[3]` também pode, dentro de quem foi chamado. Um campo `Str[3]` é a mesma coisa, inclusive na construção: atribuir um registro inteiramente novo ainda o deixa com exatamente três.\n\nUm tamanho inferido também é um tamanho — `mut v := [\"a\", \"b\", \"c\"]` só pode ser reatribuído a outro de três, e nunca cresce — mas o verificador de limites guarda menos sobre ele. Escrever através do nome mantém a prova. Reatribuir o nome a perde, mesmo para o mesmo tamanho e mesmo num ramo que pode nem rodar, já que uma prova que só vale às vezes não é uma prova. Declare o tipo quando quiser a promessa, e `[dyn]` quando quiser um vetor que cresce e cujos índices você vai guardar.\n\nUma guarda prova menos ainda: `if 2 < len(box.items)` trata do valor que o campo guardava naquele instante, então substituir o campo, ou o registro em volta dele, perde a prova, mesmo dentro do ramo que a guarda abriu.\n\nUm tamanho conhecido sobrevive a toda operação que não pode mudá-lo: `+` soma os dois tamanhos, e `map` e `sort` mantêm o da entrada. `filter` e `filterMap` não afirmam tamanho nenhum. Tudo o que se sabe do resultado deles é um máximo, e um máximo nunca coloca um índice na faixa, já que um filtro pode não guardar nada.",
			examples: [
				Example(caption: "A declared length is kept", captionPt: "Um tamanho declarado é mantido", code: "proc main(): void \{\n\tmut Str[3] v = [\"a\", \"b\", \"c\"]\n\tv = [\"x\", \"y\", \"z\"]   // still exactly three: the promise is kept\n\techo v[2]              // no guard needed, here or ever\n\n\t// v = [\"x\"]           // compile error: `v` is declared Str[3]\n}", codePt: "proc main(): void \{\n\tmut Str[3] v = [\"a\", \"b\", \"c\"]\n\tv = [\"x\", \"y\", \"z\"]   // ainda exatamente três: a promessa é mantida\n\techo v[2]              // sem guarda, aqui ou em qualquer lugar\n\n\t// v = [\"x\"]           // erro de compilação: `v` é declarado Str[3]\n}"),
				Example(caption: "An inferred one keeps its length, and less of its proof", captionPt: "Um inferido mantém o tamanho, e menos da prova", code: "proc main(): void \{\n\tmut v := [\"a\", \"b\", \"c\"]   // a Str[3]: rebound only to three, never grown\n\tv[0] = \"x\"                  // a write through the name keeps the length\n\techo v[2]\n\n\t// v = [\"x\"]               // compile error: `v` is a Str[3]\n\t// v = [\"x\", \"y\", \"z\"]      // fine, but a rebinding costs the proof,\n\t// echo v[2]                // so this would need a guard\n}", codePt: "proc main(): void \{\n\tmut v := [\"a\", \"b\", \"c\"]   // um Str[3]: reatribuído só a três, nunca cresce\n\tv[0] = \"x\"                  // escrever através do nome mantém o tamanho\n\techo v[2]\n\n\t// v = [\"x\"]               // erro de compilação: `v` é um Str[3]\n\t// v = [\"x\", \"y\", \"z\"]      // vale, mas uma reatribuição custa a prova,\n\t// echo v[2]                // então isto precisaria de uma guarda\n}"),
				Example(caption: "What a known length survives", captionPt: "O que um tamanho conhecido sobrevive", code: `func twice(n: Int): Int \{ return n * 2 }

proc main(): void \{
	Int[2] a = [2, 1]
	Int[8] b = [1, 2, 3, 4, 5, 6, 7, 8]

	both := a + b            // ten elements: the lengths add
	echo both[9]              // no guard needed

	doubled := map(a, twice)  // still two
	ordered := sort(a)        // still two
	echo "\{doubled[1]} \{ordered[1]}"

	// filter and filterMap claim nothing, so their results always need one.
}`, codePt: `func twice(n: Int): Int \{ return n * 2 }

proc main(): void \{
	Int[2] a = [2, 1]
	Int[8] b = [1, 2, 3, 4, 5, 6, 7, 8]

	both := a + b            // dez elementos: os tamanhos somam
	echo both[9]              // sem precisar de guarda

	doubled := map(a, twice)  // ainda dois
	ordered := sort(a)        // ainda dois
	echo "\{doubled[1]} \{ordered[1]}"

	// filter e filterMap não afirmam nada, então seus resultados sempre precisam.
}`),
				Example(caption: "A field's length is a promise too", captionPt: "O tamanho de um campo também é uma promessa", code: `type Reading \{
	sectors: Float[3]     // three, in every Reading there will ever be
	notes:   Str[dyn]     // any number, in each one separately
}

func slower(was: Reading): Reading \{
	return Reading([was.sectors[0] + 0.1, was.sectors[1], was.sectors[2]], was.notes)
}

proc main(): void \{
	mut Reading lap = Reading([31.4, 28.9, 33.2], ["clean"])
	echo lap.sectors[2]        // no guard: the declaration promised three

	lap = slower(lap)          // a whole new record...
	echo lap.sectors[2]        // ...and still three, so still no guard

	// The other way round for a [dyn] field, where only a guard can say:
	if lap.notes bounds 0 \{
		echo lap.notes[0]
	}
}`, codePt: `type Reading \{
	sectors: Float[3]     // três, em toda Reading que existir
	notes:   Str[dyn]     // quantos forem, em cada uma separadamente
}

func slower(was: Reading): Reading \{
	return Reading([was.sectors[0] + 0.1, was.sectors[1], was.sectors[2]], was.notes)
}

proc main(): void \{
	mut Reading lap = Reading([31.4, 28.9, 33.2], ["limpa"])
	echo lap.sectors[2]        // sem guarda: a declaração prometeu três

	lap = slower(lap)          // um registro inteiramente novo...
	echo lap.sectors[2]        // ...e ainda três, então ainda sem guarda

	// O contrário para um campo [dyn], onde só uma guarda pode dizer:
	if lap.notes bounds 0 \{
		echo lap.notes[0]
	}
}`),
			],
		),
		Slide(
			title: "Matching with is",
			titlePt: "Casando com is",
			download: false,
			shot: "",
			explanation: "`value is Pattern` is a `Bool`: `true` when the value has that shape, and it binds names for what the value carries. A match goes in an `if`, an `if`/`else if` chain, or an arm of a `switch`, on a later slide.\n\n- A variant pattern names the variant and binds its fields **by position**, the variant's own fields first and the shared ones after: `shape is Shape.Rectangle(w, h)`. It binds every field or none — `Shape.Rectangle` alone matches any rectangle — and `_` takes a field without binding it.\n- `Result.Ok(v)` and `Result.Error(e)` are variant patterns too.\n- A name in a pattern is always a **new** name: it never compares with a variable already in scope. To test for a particular value, write the value in its place — `Result.Ok(1)` — or bind it and compare after `&&`.\n\nA name a match binds is immutable. It is in scope in the branch the match guards and in the rest of the condition after `&&` — `if r is Result.Ok(n) && n > 10` — but not in an `else`, and not past an `||`, where nothing says which side matched.",
			explanationPt: "`valor is Padrão` é um `Bool`: `true` quando o valor tem aquela forma, e ele vincula nomes para o que o valor carrega. Um casamento fica num `if`, numa cadeia `if`/`else if`, ou num braço de um `switch`, num slide mais adiante.\n\n- Um padrão de variante nomeia a variante e vincula seus campos **por posição**, os próprios da variante primeiro e os compartilhados depois: `shape is Shape.Rectangle(w, h)`. Ele vincula todos os campos ou nenhum — `Shape.Rectangle` sozinho casa com qualquer retângulo — e `_` pega um campo sem vinculá-lo.\n- `Result.Ok(v)` e `Result.Error(e)` também são padrões de variante.\n- Um nome em um padrão é sempre um nome **novo**: ele nunca é comparado com uma variável que já está no escopo. Para testar um valor específico, escreva o próprio valor no lugar dele — `Result.Ok(1)` — ou vincule-o e compare depois de `&&`.\n\nUm nome vinculado por um casamento é imutável. Ele está no escopo do ramo que o casamento protege e no resto da condição depois de `&&` — `if r is Result.Ok(n) && n > 10` — mas não em um `else`, e não depois de um `||`, onde nada diz qual lado casou.",
			examples: [
				Example(caption: "Variants, and what they bind", captionPt: "Variantes, e o que vinculam", code: `type Shape \{
	Circle    \{ radius: Int }
	Rectangle \{ width: Int, height: Int }
	Point
}

func describe(shape: Shape): Str \{
	if shape is Shape.Circle(r) && r > 10 \{
		return "a big circle"
	} else if shape is Shape.Circle(r) \{
		return "a circle of \{r}"
	} else if shape is Shape.Rectangle(w, _) \{
		return "a rectangle \{w} wide"
	}
	return "a point"
}

proc main(): void \{
	echo describe(Shape.Circle(40))
	echo describe(Shape.Circle(4))
	echo describe(Shape.Rectangle(3, 9))
	echo describe(Shape.Point())
}`, codePt: `type Shape \{
	Circle    \{ radius: Int }
	Rectangle \{ width: Int, height: Int }
	Point
}

func describe(shape: Shape): Str \{
	if shape is Shape.Circle(r) && r > 10 \{
		return "um círculo grande"
	} else if shape is Shape.Circle(r) \{
		return "um círculo de \{r}"
	} else if shape is Shape.Rectangle(w, _) \{
		return "um retângulo de \{w} de largura"
	}
	return "um ponto"
}

proc main(): void \{
	echo describe(Shape.Circle(40))
	echo describe(Shape.Circle(4))
	echo describe(Shape.Rectangle(3, 9))
	echo describe(Shape.Point())
}`),
				Example(caption: "A name in a pattern is always new", captionPt: "Um nome em um padrão é sempre novo", code: "proc main(): void \{\n\twanted := 3\n\tfound := indexOf([5, 3, 1], 3)\n\n\t// This `wanted` is a new name bound to whatever position came back:\n\t// it hides the outer one and compares with nothing.\n\tif found is Result.Ok(wanted) \{\n\t\techo \"at \{wanted}\"\n\t}\n\t// To test for a particular value, write it in its place...\n\tif found is Result.Ok(1) \{\n\t\techo \"second, as expected\"\n\t}\n\t// ...or bind it and compare.\n\tif found is Result.Ok(at) && at > 0 \{\n\t\techo \"not first\"\n\t}\n\techo wanted            // 3 — the outer one, untouched\n}", codePt: "proc main(): void \{\n\twanted := 3\n\tfound := indexOf([5, 3, 1], 3)\n\n\t// Este `wanted` é um nome novo vinculado à posição que voltou:\n\t// ele esconde o de fora e não compara com nada.\n\tif found is Result.Ok(wanted) \{\n\t\techo \"na posição \{wanted}\"\n\t}\n\t// Para testar um valor específico, escreva-o no lugar dele...\n\tif found is Result.Ok(1) \{\n\t\techo \"a segunda, como esperado\"\n\t}\n\t// ...ou vincule-o e compare.\n\tif found is Result.Ok(at) && at > 0 \{\n\t\techo \"não é a primeira\"\n\t}\n\techo wanted            // 3 — o de fora, intocado\n}"),
			],
		),
		Slide(
			title: "Matching vectors and strings",
			titlePt: "Casando vetores e strings",
			download: false,
			shot: "",
			explanation: "A vector pattern matches element by element. An element is a literal — an `Int`, `Float`, `Str`, `Atom` or `Bool` — a name that binds it, or a pattern of its own, and a last `...rest` binds whatever follows as a vector. Without one, the lengths have to be equal.\n\nA string pattern is a template whose `\{holes}` bind the text between its literal pieces. The template has to cover the **whole** string, and each hole takes the shortest text that lets the rest match: `\"a/b/c\" is \"\{x}/\{y}\"` gives `x` `a` and `y` `b/c`. A hole at the end therefore takes everything left, so `\"/users/42/extra\" is \"/users/\{id}\"` binds `id` to `42/extra`. That is a routing trap, and a hole that says what it takes avoids it: `\{id is (\\d+)}` binds only what the regular expression matches.\n\nNothing between those parentheses is escaped by the string — `\{year is (\\d\{4})}` is four digits, not an interpolation of 4 — and the regular expression is read at compile time, so a malformed one is a compile error naming what is wrong. These are refused too:\n\n- two open holes side by side with no text between them, since a pattern has to have one reading (a hole that says what it takes ends itself, so it may be followed by another);\n- a hole that is anything but a plain name, since a pattern binds and does not compute;\n- a regex hole in a string being built rather than matched.\n\n**Patterns nest.** Wherever a pattern binds a name — a variant's field, a vector's element — it may hold a pattern instead, and the whole is still one match: `r is Result.Ok(Route.Page([\"home\", ...rest]))`. It is exactly the `&&` chain it abbreviates, outer value first, and compiles to the same program. A variant's field may also hold a literal it has to equal. A pattern binds each name only once, and a variant pattern has to be of the type it is matched against; anything else is a compile error.",
			explanationPt: "Um padrão de vetor casa elemento por elemento. Um elemento é um literal — um `Int`, `Float`, `Str`, `Atom` ou `Bool` — um nome que o vincula, ou um padrão próprio, e um `...rest` no final vincula o que vier depois como um vetor. Sem ele, os tamanhos precisam ser iguais.\n\nUm padrão de string é um modelo cujos `\{buracos}` vinculam o texto entre os seus trechos literais. O modelo precisa cobrir a string **inteira**, e cada buraco pega o menor texto que deixa o resto casar: `\"a/b/c\" is \"\{x}/\{y}\"` dá `x` `a` e `y` `b/c`. Por isso um buraco no final pega tudo o que sobrou, e `\"/users/42/extra\" is \"/users/\{id}\"` vincula `id` a `42/extra`. Essa é uma armadilha de rotas, e um buraco que diz o que aceita a evita: `\{id is (\\d+)}` vincula só o que a expressão regular casa.\n\nNada entre esses parênteses é escapado pela string — `\{year is (\\d\{4})}` são quatro dígitos, e não uma interpolação de 4 — e a expressão regular é lida em tempo de compilação, então uma malformada é um erro de compilação dizendo o que há de errado. Também são recusados:\n\n- dois buracos abertos lado a lado sem texto entre eles, já que um padrão precisa ter uma leitura só (um buraco que diz o que aceita termina a si mesmo, então pode vir seguido de outro);\n- um buraco que não seja um nome simples, já que um padrão vincula e não calcula;\n- um buraco de regex numa string sendo construída, e não casada.\n\n**Padrões se aninham.** Onde quer que um padrão vincule um nome — o campo de uma variante, o elemento de um vetor — ele pode conter um padrão no lugar, e o todo continua sendo um casamento só: `r is Result.Ok(Route.Page([\"home\", ...rest]))`. Ele é exatamente a cadeia de `&&` que abrevia, o valor de fora primeiro, e compila para o mesmo programa. O campo de uma variante também pode conter um literal ao qual precisa ser igual. Um padrão vincula cada nome uma vez só, e um padrão de variante precisa ser do tipo com que é casado; o contrário é um erro de compilação.",
			examples: [
				Example(caption: "Vector patterns", captionPt: "Padrões de vetor", code: `proc main(): void \{
	command := ["move", "north", "2"]
	if command is ["move", dir, ...steps] \{
		echo "\{dir}, \{len(steps)} more"
	} else if command is ["stop"] \{
		echo "halt"
	}
}`, codePt: `proc main(): void \{
	command := ["move", "north", "2"]
	if command is ["move", dir, ...steps] \{
		echo "\{dir}, \{len(steps)} a mais"
	} else if command is ["stop"] \{
		echo "parar"
	}
}`),
				Example(caption: "String templates, and where a hole stops", captionPt: "Modelos de string, e onde um buraco para", code: `proc main(): void \{
	if "/users/42/posts/7" is "/users/\{id}/posts/\{postId}" \{
		echo "\{id} / \{postId}"            // 42 / 7
	}
	if "a/b/c" is "\{x}/\{y}" \{
		echo "\{x} | \{y}"                  // a | b/c — the shortest first hole
	}
	if "/users/42/extra" is "/users/\{id}" \{
		echo id                           // 42/extra — a last hole takes the rest
	}
	if "/users/42/extra" is "/users/\{id is (\d+)}" \{
		echo "never: digits only, and the template covers the whole string"
	}
}`, codePt: `proc main(): void \{
	if "/users/42/posts/7" is "/users/\{id}/posts/\{postId}" \{
		echo "\{id} / \{postId}"            // 42 / 7
	}
	if "a/b/c" is "\{x}/\{y}" \{
		echo "\{x} | \{y}"                  // a | b/c — o menor primeiro buraco
	}
	if "/users/42/extra" is "/users/\{id}" \{
		echo id                           // 42/extra — um último buraco pega o resto
	}
	if "/users/42/extra" is "/users/\{id is (\d+)}" \{
		echo "nunca: só dígitos, e o modelo cobre a string inteira"
	}
}`),
				Example(caption: "A hole that says what it takes", captionPt: "Um buraco que diz o que aceita", code: `func route(path: Str): Str \{
	// Only digits reach id, so /users/nobody falls through
	// to the next branch instead of matching this one.
	if path is "/users/\{id is (\d+)}" \{
		return "user #\{id}"
	}
	// The two kinds of hole mix freely — they are one construct.
	if path is "/api/v\{version is (\d+)}/\{rest}" \{
		return "v\{version}, then \{rest}"
	}
	// Braces inside the parentheses are the regex's own: this is
	// four digits, not an interpolation.
	if path is "/logs/\{year is (\d\{4})}" \{
		return "logs for \{year}"
	}
	return "no match"
}

proc main(): void \{
	echo route("/users/42")        // user #42
	echo route("/users/nobody")    // no match
	echo route("/api/v2/things")   // v2, then things
	echo route("/logs/2026")       // logs for 2026
}`, codePt: `func rota(caminho: Str): Str \{
	// Só dígitos chegam em id, então /usuarios/ninguem cai para
	// o próximo ramo em vez de casar com este.
	if caminho is "/usuarios/\{id is (\d+)}" \{
		return "usuário #\{id}"
	}
	// Os dois tipos de buraco se misturam à vontade — são uma
	// construção só.
	if caminho is "/api/v\{versao is (\d+)}/\{resto}" \{
		return "v\{versao}, depois \{resto}"
	}
	// Chaves dentro dos parênteses são da própria regex: isto são
	// quatro dígitos, não uma interpolação.
	if caminho is "/logs/\{ano is (\d\{4})}" \{
		return "logs de \{ano}"
	}
	return "sem correspondência"
}

proc main(): void \{
	echo rota("/usuarios/42")        // usuário #42
	echo rota("/usuarios/ninguem")   // sem correspondência
	echo rota("/api/v2/coisas")      // v2, depois coisas
	echo rota("/logs/2026")          // logs de 2026
}`),
				Example(caption: "What a string pattern refuses", captionPt: "O que um padrão de string recusa", code: `proc main(): void \{
	path := "/users/42"

	// Each of these is refused before the program is built:
	// if path is "/users/\{id}\{name}" \{ }        // two open holes side by side
	// if path is "/users/\{len(path)}" \{ }       // a hole binds, it does not compute
	// if path is "\{a is (a\{2,1})}" \{ }          // \{2,1} counts down
	// if path is "\{a is ((?=b)c)}" \{ }          // no lookaround
	// if path is "\{a is ((b)\1)}" \{ }           // and no backreference

	// Fine: the first hole says where it ends.
	if path is "/users/\{id is (\d+)}\{rest}" \{
		echo "\{id}[\{rest}]"
	}
}`, codePt: `proc main(): void \{
	path := "/users/42"

	// Cada um destes é recusado antes de o programa ser construído:
	// if path is "/users/\{id}\{name}" \{ }        // dois buracos abertos lado a lado
	// if path is "/users/\{len(path)}" \{ }       // um buraco vincula, não calcula
	// if path is "\{a is (a\{2,1})}" \{ }          // \{2,1} conta para trás
	// if path is "\{a is ((?=b)c)}" \{ }          // sem lookaround
	// if path is "\{a is ((b)\1)}" \{ }           // e sem retrorreferência

	// Vale: o primeiro buraco diz onde termina.
	if path is "/users/\{id is (\d+)}\{rest}" \{
		echo "\{id}[\{rest}]"
	}
}`),
				Example(caption: "Patterns inside patterns", captionPt: "Padrões dentro de padrões", code: `type Route \{
	Page \{ segments: Str[dyn] }
	Missing
}

func resolve(path: Str): Result<Route, Str> \{
	if path == "" \{
		return Result.Error("empty")
	}
	return Result.Ok(Route.Page(split(path, ",")))
}

proc main(): void \{
	path := "foo/abc/bar,x,y"

	// A Result holding a Page, holding a vector whose first element
	// is a string with a hole in it: one pattern.
	if resolve(path) is Result.Ok(Route.Page(["foo/\{padding}/bar", ...rest])) \{
		echo "\{padding}, then \{len(rest)} more"      // abc, then 2 more
	}

	// The very same match, written out as the chain it abbreviates.
	if resolve(path) is Result.Ok(route) && route is Route.Page(parts) && parts is [head, ...rest] && head is "foo/\{padding}/bar" \{
		echo "\{padding}, then \{len(rest)} more"
	}

	// A literal stands where a name would: the field has to equal it.
	if resolve("") is Result.Error("empty") \{
		echo "nothing to resolve"
	}
}`, codePt: `type Route \{
	Page \{ segments: Str[dyn] }
	Missing
}

func resolve(path: Str): Result<Route, Str> \{
	if path == "" \{
		return Result.Error("vazio")
	}
	return Result.Ok(Route.Page(split(path, ",")))
}

proc main(): void \{
	path := "foo/abc/bar,x,y"

	// Um Result com uma Page, com um vetor cujo primeiro elemento
	// é uma string com um buraco: um padrão só.
	if resolve(path) is Result.Ok(Route.Page(["foo/\{padding}/bar", ...rest])) \{
		echo "\{padding}, depois mais \{len(rest)}"    // abc, depois mais 2
	}

	// O mesmo casamento, escrito como a cadeia que ele abrevia.
	if resolve(path) is Result.Ok(route) && route is Route.Page(parts) && parts is [head, ...rest] && head is "foo/\{padding}/bar" \{
		echo "\{padding}, depois mais \{len(rest)}"
	}

	// Um literal fica onde ficaria um nome: o campo precisa ser igual a ele.
	if resolve("") is Result.Error("vazio") \{
		echo "nada para resolver"
	}
}`),
			],
		),
		Slide(
			title: "Bits and bytes",
			titlePt: "Bits e bytes",
			download: false,
			shot: "",
			explanation: "`&`, `|` and `^` are and, or and exclusive or on two integers of one type; `~` flips every bit; `<<` and `>>` shift the left side by a count that is unsigned or a literal, so it is never negative. Every result stays within its type's width, and `&=` `|=` `^=` `<<=` `>>=` update a `mut` integer. These operators bind tighter than a comparison — `x & 1 == 0` asks about `x & 1` — and have no order among themselves: `x >> 4 & 0xF` is a compile error until parentheses say which goes first. A `Bool` keeps `&&`, `||` and `!`.\n\n`0xFF` and `0b1010` are hexadecimal and binary literals, and `_` may sit between digits: `0xFFFF_0000`.\n\n`<<<...>>>` builds bytes and takes them apart, most significant bit first, each field as wide as its type:\n\n- `<<<version, length, payload>>>` is a `UInt8[dyn]`: a `UInt4` writes four bits, a `UInt16` two bytes, a `Str` or a `UInt8[]` its bytes, and a literal one byte unless it says otherwise, `0x0D0A: UInt16`.\n- `packet is <<<version: UInt4, ihl: UInt4, length: UInt16, ...rest>>>` reads them back. A field is a name and its type, a literal to match, `_` to skip, or a run of bytes whose length an earlier field read, `body: UInt8[size]`.\n- `little` after a field orders its bytes least significant first.\n- The subject is a `UInt8[]`, a `Str` or an integer. The compiler checks that every field lands where it should: whole bytes, and a run starting on a byte.\n\n`hive.conv.bytesOf(text)` and `hive.conv.fromBytes(bytes)` convert between a `Str` and its bytes.",
			explanationPt: "`&`, `|` e `^` são e, ou e ou exclusivo sobre dois inteiros de um mesmo tipo; `~` inverte cada bit; `<<` e `>>` deslocam o lado esquerdo por uma contagem sem sinal ou literal, então nunca negativa. Todo resultado fica dentro da largura do seu tipo, e `&=` `|=` `^=` `<<=` `>>=` atualizam um inteiro `mut`. Esses operadores se ligam mais forte que uma comparação — `x & 1 == 0` pergunta sobre `x & 1` — e não têm ordem entre si: `x >> 4 & 0xF` é um erro de compilação até que parênteses digam o que vem primeiro. Um `Bool` continua com `&&`, `||` e `!`.\n\n`0xFF` e `0b1010` são literais hexadecimal e binário, e `_` pode ficar entre dígitos: `0xFFFF_0000`.\n\n`<<<...>>>` monta bytes e os desmonta, do bit mais significativo em diante, cada campo tão largo quanto o seu tipo:\n\n- `<<<version, length, payload>>>` é um `UInt8[dyn]`: um `UInt4` escreve quatro bits, um `UInt16` dois bytes, uma `Str` ou um `UInt8[]` os seus bytes, e um literal um byte, a menos que diga outra coisa, `0x0D0A: UInt16`.\n- `packet is <<<version: UInt4, ihl: UInt4, length: UInt16, ...rest>>>` os lê de volta. Um campo é um nome e o seu tipo, um literal a casar, `_` para pular, ou uma sequência de bytes cujo tamanho um campo anterior leu, `body: UInt8[size]`.\n- `little` depois de um campo ordena os seus bytes do menos significativo em diante.\n- O alvo é um `UInt8[]`, uma `Str` ou um inteiro. O compilador confere que cada campo cai onde deve: bytes inteiros, e uma sequência começando no início de um byte.\n\n`hive.conv.bytesOf(text)` e `hive.conv.fromBytes(bytes)` convertem entre uma `Str` e os seus bytes.",
			examples: [
				Example(caption: "", captionPt: "", code: `func fnv1a(text: Str): UInt32 \{
	mut UInt32 hash = 0x811C_9DC5
	for each b in hive.conv.bytesOf(text) \{
		hash = (hash ^ UInt32(b)) * 0x0100_0193
	}
	return hash
}

proc main(): void \{
	UInt8 flags = 0b1100_1010
	echo flags & 0x0F         // 10
	echo flags >> 4           // 12
	echo ~flags               // 53
	echo fnv1a("hello")       // 1335831723

	UInt8[dyn] header = <<<UInt4(4), UInt4(5), 0, 0x0054: UInt16>>>
	echo header               // [69, 0, 0, 84]
	if header is <<<version: UInt4, ihl: UInt4, _: UInt8, length: UInt16>>> \{
		echo "IPv\{version}, \{length} bytes"
	}
}`, codePt: `func fnv1a(text: Str): UInt32 \{
	mut UInt32 hash = 0x811C_9DC5
	for each b in hive.conv.bytesOf(text) \{
		hash = (hash ^ UInt32(b)) * 0x0100_0193
	}
	return hash
}

proc main(): void \{
	UInt8 flags = 0b1100_1010
	echo flags & 0x0F         // 10
	echo flags >> 4           // 12
	echo ~flags               // 53
	echo fnv1a("hello")       // 1335831723

	UInt8[dyn] header = <<<UInt4(4), UInt4(5), 0, 0x0054: UInt16>>>
	echo header               // [69, 0, 0, 84]
	if header is <<<version: UInt4, ihl: UInt4, _: UInt8, length: UInt16>>> \{
		echo "IPv\{version}, \{length} bytes"
	}
}`),
			],
		),
		Slide(
			title: "Chains that cover a type",
			titlePt: "Cadeias que cobrem um tipo",
			download: false,
			shot: "",
			explanation: "An `if`/`else if` chain with no `else` ends a path when its branches take **every value** of their subject and every branch ends. That is what lets a total function over a union be written without a dead `else`, and dropping a case is then a compile error naming a value nothing takes — `` `r` when it is `Result.Ok(Route.Missing)` ``.\n\nWhat counts toward covering:\n\n- a union is covered by its variants and a `Result` by `Ok` and `Error`, **as deep as the patterns go**: `Result.Ok(Route.Page(_))`, `Result.Ok(Route.Missing)` and `Result.Error(_)` cover a `Result<Route, Str>`;\n- a vector is covered by its lengths — `[]` and `[first, ...rest]` take every one — and a `Bool` by `true` and `false`;\n- numbers, atoms and strings have no finite cover, except a template that is one open hole, `\"\{text}\"`, which takes every string;\n- a branch with more to its condition than its pattern, like `shape is Shape.Circle(r) && r > 0`, counts for nothing, since it may not match every circle;\n- the subject is a variable, or a path of fields from one like `order.status`; a call is not, since it may answer differently each time.\n\nA chain that cannot be proved to cover its subject needs a last `return`, or a `panic` for a case that cannot happen.",
			explanationPt: "Uma cadeia `if`/`else if` sem `else` encerra um caminho quando seus ramos aceitam **todo valor** do sujeito e todo ramo termina. É isso que permite escrever uma função total sobre uma união sem um `else` morto, e esquecer um caso é então um erro de compilação que nomeia um valor que nada aceita — `` `r` when it is `Result.Ok(Route.Missing)` ``.\n\nO que conta para cobrir:\n\n- uma união é coberta pelas suas variantes e um `Result` por `Ok` e `Error`, **até onde os padrões descem**: `Result.Ok(Route.Page(_))`, `Result.Ok(Route.Missing)` e `Result.Error(_)` cobrem um `Result<Route, Str>`;\n- um vetor é coberto pelos seus tamanhos — `[]` e `[first, ...rest]` aceitam todos — e um `Bool` por `true` e `false`;\n- números, átomos e strings não têm cobertura finita, exceto um modelo que é um único buraco aberto, `\"\{text}\"`, que aceita toda string;\n- um ramo com mais coisa na condição do que o padrão, como `shape is Shape.Circle(r) && r > 0`, não conta para nada, já que pode não casar com todo círculo;\n- o sujeito é uma variável, ou um caminho de campos a partir de uma, como `order.status`; uma chamada não é, já que pode responder diferente a cada vez.\n\nUma cadeia que não pode ser provada como cobrindo o sujeito precisa de um último `return`, ou de um `panic` para um caso que não pode acontecer.",
			examples: [
				Example(caption: "Covering a type", captionPt: "Cobrindo um tipo", code: "type Shape \{\n\tCircle    \{ radius: Int }\n\tRectangle \{ width: Int, height: Int }\n\tPoint\n}\n\nfunc area(shape: Shape): Int \{\n\tif shape is Shape.Circle(r) \{\n\t\treturn 3 * r * r\n\t} else if shape is Shape.Rectangle(w, h) \{\n\t\treturn w * h\n\t} else if shape is Shape.Point \{\n\t\treturn 0\n\t}\n\t// No `else`, and none needed: the three variants are the whole of Shape.\n}\n\nfunc size(found: Result<Int, Str>): Int \{\n\tif found is Result.Ok(n) \{\n\t\treturn n\n\t} else if found is Result.Error(_) \{\n\t\treturn -1\n\t}\n}\n\nproc main(): void \{\n\techo area(Shape.Rectangle(3, 4))\n\techo size(Result.Error(\"missing\"))\n}", codePt: "type Shape \{\n\tCircle    \{ radius: Int }\n\tRectangle \{ width: Int, height: Int }\n\tPoint\n}\n\nfunc area(shape: Shape): Int \{\n\tif shape is Shape.Circle(r) \{\n\t\treturn 3 * r * r\n\t} else if shape is Shape.Rectangle(w, h) \{\n\t\treturn w * h\n\t} else if shape is Shape.Point \{\n\t\treturn 0\n\t}\n\t// Sem `else`, e nenhum é preciso: as três variantes são o Shape inteiro.\n}\n\nfunc size(found: Result<Int, Str>): Int \{\n\tif found is Result.Ok(n) \{\n\t\treturn n\n\t} else if found is Result.Error(_) \{\n\t\treturn -1\n\t}\n}\n\nproc main(): void \{\n\techo area(Shape.Rectangle(3, 4))\n\techo size(Result.Error(\"missing\"))\n}"),
				Example(caption: "Covering as deep as the patterns go", captionPt: "Cobrindo até onde os padrões descem", code: `type Route \{
	Page \{ segments: Str[dyn] }
	Missing
}

// Every value a Result<Route, Str> can be is taken below, so the
// chain ends the function and nothing has to follow it.
func kind(r: Result<Route, Str>): Str \{
	if r is Result.Ok(Route.Page([])) \{
		return "an empty page"
	} else if r is Result.Ok(Route.Page([_, ...more])) \{
		return "a page of \{len(more) + 1}"
	} else if r is Result.Ok(Route.Missing) \{
		return "a missing page"
	} else if r is Result.Error(_) \{
		return "no page at all"
	}
}

proc main(): void \{
	echo kind(Result.Ok(Route.Page(["a", "b"])))   // a page of 2
	echo kind(Result.Ok(Route.Missing()))          // a missing page
	echo kind(Result.Error("offline"))             // no page at all
}`, codePt: `type Route \{
	Page \{ segments: Str[dyn] }
	Missing
}

// Todo valor que um Result<Route, Str> pode ter é aceito abaixo, então
// a cadeia encerra a função e nada precisa vir depois dela.
func kind(r: Result<Route, Str>): Str \{
	if r is Result.Ok(Route.Page([])) \{
		return "uma página vazia"
	} else if r is Result.Ok(Route.Page([_, ...more])) \{
		return "uma página de \{len(more) + 1}"
	} else if r is Result.Ok(Route.Missing) \{
		return "uma página ausente"
	} else if r is Result.Error(_) \{
		return "nenhuma página"
	}
}

proc main(): void \{
	echo kind(Result.Ok(Route.Page(["a", "b"])))   // uma página de 2
	echo kind(Result.Ok(Route.Missing()))          // uma página ausente
	echo kind(Result.Error("offline"))             // nenhuma página
}`),
