// Windows, canvases and scenes
func interfaces(): Slide[6] {
	return [
		Slide(
			title: "Views",
			titlePt: "Views",
			download: false,
			shot: "",
			explanation: "`hive.ui` builds an interface as a value: a `View` is a tree of widgets. Each widget takes its attributes first and then what it shows, except `spacer()` and `none()`, which take nothing, and `spinner(attrs)`, which takes only attributes.\n\n- Layout: `row(attrs, views)`, `column(attrs, views)`, and `overlay(attrs, child)`, which is a centred, dimmed dialog, or, with an `align` or `justify`, a panel pinned to an edge that lets clicks through.\n- Display: `text(attrs, content)`, `image(attrs, src, alt)`, `icon(attrs, Icon)`, `link(attrs, href, label)`, `table(attrs, rows)` for a `Table`, and `canvas` for drawing, on its own slide.\n- Input: `button(attrs, label)`, `input(attrs, value)`, `textarea(attrs, value)`, `checkbox(attrs, label, checked)`, `select(attrs, options, chosen)`.\n\nAttributes are a closed set too, and one that does not apply to a widget is ignored:\n\n- layout: `gap`, `pad`, `width` (capped at the space available), `height`, `grow`, `align`, `justify`, `scroll`;\n- style: `size`, `heading`, `tone`, `background`;\n- state: `disabled`, `busy` (which also disables), `placeholder`, `hint`, `kind`.\n\nThe enumerations behind them are closed sets, reached like any library type:\n\n- `Align` is `Start`, `Center`, `End` or `Stretch`, and `Justify` is `Start`, `Center`, `End` or `Between`;\n- `TextSize` is `Title`, `Subtitle`, `Body` or `Caption`, and `Axis` is `Horizontal`, `Vertical` or `Both`;\n- `InputKind` is `Text`, `Number`, `Date`, `Password`, `Search` or `Range`, a slider from 0 to 100;\n- `Tone` is `Normal`, `Muted`, `Good`, `Warn` or `Danger`, or an exact colour through `HEX` and `RGBA`. A malformed `HEX` is `Normal`, and an `RGBA` channel is clamped;\n- `Icon` is one of eighteen, so a name that is not one of them is a compile error.\n\n`html(view)` renders a tree as an HTML fragment, and `page(title, view)` as a whole document with its stylesheet built in, for light and dark. An `httpServe` handler can answer with it directly, and every screen of this tour except the code samples is one. On a touch screen, controls grow to a thumb's width and a field's text to 16 pixels. Because a view is a value, an interface can be tested without a browser: a test renders one with `html` and reads the markup. That is the cheapest place to check that a disabled button is disabled, and that somebody else's text cannot smuggle a script into the page.",
			explanationPt: "`hive.ui` constrói uma interface como um valor: uma `View` é uma árvore de widgets. Cada widget recebe primeiro os atributos e depois o que mostra, exceto `spacer()` e `none()`, que não recebem nada, e `spinner(attrs)`, que recebe só atributos.\n\n- Layout: `row(attrs, views)`, `column(attrs, views)`, e `overlay(attrs, child)`, que é um diálogo centralizado e escurecido ou, com um `align` ou `justify`, um painel preso a uma borda que deixa os cliques passarem.\n- Exibição: `text(attrs, content)`, `image(attrs, src, alt)`, `icon(attrs, Icon)`, `link(attrs, href, label)`, `table(attrs, rows)` para uma `Table`, e `canvas` para desenhar, no seu próprio slide.\n- Entrada: `button(attrs, label)`, `input(attrs, value)`, `textarea(attrs, value)`, `checkbox(attrs, label, checked)`, `select(attrs, options, chosen)`.\n\nOs atributos também são um conjunto fechado, e um que não se aplica a um widget é ignorado:\n\n- layout: `gap`, `pad`, `width` (limitado ao espaço disponível), `height`, `grow`, `align`, `justify`, `scroll`;\n- estilo: `size`, `heading`, `tone`, `background`;\n- estado: `disabled`, `busy` (que também desabilita), `placeholder`, `hint`, `kind`.\n\nAs enumerações por trás deles são conjuntos fechados, alcançados como qualquer tipo da biblioteca:\n\n- `Align` é `Start`, `Center`, `End` ou `Stretch`, e `Justify` é `Start`, `Center`, `End` ou `Between`;\n- `TextSize` é `Title`, `Subtitle`, `Body` ou `Caption`, e `Axis` é `Horizontal`, `Vertical` ou `Both`;\n- `InputKind` é `Text`, `Number`, `Date`, `Password`, `Search` ou `Range`, um controle deslizante de 0 a 100;\n- `Tone` é `Normal`, `Muted`, `Good`, `Warn` ou `Danger`, ou uma cor exata por `HEX` e `RGBA`. Um `HEX` malformado vira `Normal`, e um canal `RGBA` é limitado à faixa;\n- `Icon` é um de dezoito, então um nome que não seja um deles é erro de compilação.\n\n`html(view)` renderiza uma árvore como um fragmento HTML, e `page(title, view)` como um documento inteiro com a folha de estilo embutida, para tema claro e escuro. Um handler de `httpServe` pode responder com ele diretamente, e toda tela deste tour, menos os exemplos de código, é feita assim. Numa tela de toque, os controles crescem até a largura de um polegar e o texto de um campo até 16 pixels. Como uma view é um valor, uma interface pode ser testada sem navegador: um teste renderiza uma com `html` e lê a marcação. É o lugar mais barato para conferir que um botão desabilitado está desabilitado, e que o texto de outra pessoa não consegue contrabandear um script para a página.",
			examples: [
				Example(caption: "A page, served directly", captionPt: "Uma página, servida diretamente", code: `proc main(): void \{
	view := hive.ui.column([hive.ui.pad(24), hive.ui.gap(12)], [
		hive.ui.text([hive.ui.size(hive.ui.TextSize.Title()), hive.ui.heading(1)], "Hive Tour"),
		hive.ui.row([hive.ui.gap(8)], [
			hive.ui.input([hive.ui.placeholder("your name")], ""),
			hive.ui.button([hive.ui.tone(hive.ui.Tone.Good())], "Say hi"),
		]),
		hive.ui.link([hive.ui.background(hive.ui.Tone.Good())], "/1", "Start →"),
	])

	body := hive.ui.page("Hive", view)   // a whole document, served directly
	echo len(body)
}`, codePt: `proc main(): void \{
	view := hive.ui.column([hive.ui.pad(24), hive.ui.gap(12)], [
		hive.ui.text([hive.ui.size(hive.ui.TextSize.Title()), hive.ui.heading(1)], "Tour do Hive"),
		hive.ui.row([hive.ui.gap(8)], [
			hive.ui.input([hive.ui.placeholder("seu nome")], ""),
			hive.ui.button([hive.ui.tone(hive.ui.Tone.Good())], "Dizer oi"),
		]),
		hive.ui.link([hive.ui.background(hive.ui.Tone.Good())], "/1", "Começar →"),
	])

	body := hive.ui.page("Hive", view)   // um documento inteiro, servido diretamente
	echo len(body)
}`),
				Example(caption: "An interface you can test", captionPt: "Uma interface que dá para testar", code: `type Model \{
	posts: Str[dyn]
	draft: Str
}

func view(model: Model): ui.View \{
	mut ui.View[dyn] kids = [
		ui.input([ui.placeholder("say something")], model.draft),
		ui.button([ui.disabled(model.draft == "")], "Post"),
	]
	for each post in model.posts \{
		append(kids, ui.text([], post))
	}
	return ui.column([ui.pad(24), ui.gap(8)], kids)
}

test "the post button is disabled until something is typed" \{
	empty := ui.html(view(Model([], "")))
	assert indexOf(empty, "disabled") is Result.Ok(_)

	typed := ui.html(view(Model([], "hi")))
	assert indexOf(typed, "disabled") is Result.Error(_)
}

test "a post body cannot smuggle markup into the page" \{
	page := ui.html(view(Model(["<script>steal()</script>"], "")))
	assert indexOf(page, "<script>") is Result.Error(_)
}`, codePt: `type Model \{
	posts: Str[dyn]
	draft: Str
}

func view(model: Model): ui.View \{
	mut ui.View[dyn] kids = [
		ui.input([ui.placeholder("diga algo")], model.draft),
		ui.button([ui.disabled(model.draft == "")], "Publicar"),
	]
	for each post in model.posts \{
		append(kids, ui.text([], post))
	}
	return ui.column([ui.pad(24), ui.gap(8)], kids)
}

test "o botão fica desabilitado até algo ser digitado" \{
	empty := ui.html(view(Model([], "")))
	assert indexOf(empty, "disabled") is Result.Ok(_)

	typed := ui.html(view(Model([], "oi")))
	assert indexOf(typed, "disabled") is Result.Error(_)
}

test "o corpo de um post não contrabandeia markup para a página" \{
	page := ui.html(view(Model(["<script>steal()</script>"], "")))
	assert indexOf(page, "<script>") is Result.Error(_)
}`),
			],
		),
		Slide(
			title: "A window is a service",
			titlePt: "Uma janela é um serviço",
			download: false,
			shot: "",
			explanation: "Shown in a window, the same tree becomes a live interface. `hive.ui.window(title, view, update)` is a service's handler, and `spawn` opens it with the state it starts from:\n\n- `view` is a `func(Model): View`, called again after every turn. It is a `func`, so drawing can never change anything.\n- `update` is a `proc(mut Model, Msg): Msg` that changes the model in place for each event. If it takes a third parameter, `window: Address<Msg>`, it is handed the window's own address every turn. Its answer goes back to a request from another node, and is dropped for the window's own events.\n- An event carries a message. `on(msg)` is for a click and `onDismiss(msg)` for a click on an overlay's backdrop. Events that report something take a function that builds the message, like `Msg.Changed(_)`: `onInput`, `onSubmit` and `onChoose` report a `Str`, `onToggle` a `Bool`, `onSort` a column's index, and `onPick` a table row's, not counting the header. A `link` in a window sends its message instead of following its `href`, and a served page keeps a link only if it is a path or an `http`, `https` or `mailto` link.\n\nOpening a window does not wait for it, so a program can open several. On Windows and Linux the program draws the window itself, every widget included, with no browser involved. It gets a browser window instead if the program ships its own typeface or opens it with `hive.ui.webview`, which takes the same three arguments as `window`. On other systems it is always a browser window: an application-mode window on a profile of its own, with none of anybody's session or extensions in it, or a tab on a machine with no Chromium-family browser. Closing a window kills its service, closing the last one ends the program, and a `main` that returns while a window is open waits for them.\n\nWork that must not block the screen needs no command type: `update` is a `proc`, so it can start the work with `async`, and given the window's address, that work can send its result back as an ordinary message.\n\nThe program's icon is `assets/icon.png` beside the entrypoint, a PNG of at most 256×256, and its typeface is `assets/font.woff2`; without one, a window uses the system's own. Nothing in the source names either: the whole `assets/` folder is built into the executable, and on Windows the executable carries the icon too, so a file manager and a pinned shortcut show it. `HIVE_WINDOW=print` prints the window's address, `hive-window <url>`, instead of opening a browser, for whatever else is going to show the page, and it makes a window the program would draw itself a page too, so there is one to show.",
			explanationPt: "Mostrada numa janela, a mesma árvore vira uma interface viva. `hive.ui.window(title, view, update)` é o handler de um serviço, e `spawn` a abre com o estado de onde ela começa:\n\n- `view` é um `func(Model): View`, chamado de novo depois de toda volta. Por ser um `func`, desenhar nunca pode mudar nada.\n- `update` é um `proc(mut Model, Msg): Msg` que altera o modelo no lugar a cada evento. Se receber um terceiro parâmetro, `window: Address<Msg>`, ele ganha o endereço da própria janela a cada volta. A resposta dele volta para um pedido de outro nó, e é descartada nos eventos da própria janela.\n- Um evento carrega uma mensagem. `on(msg)` serve para um clique e `onDismiss(msg)` para um clique no fundo de um overlay. Eventos que informam algo recebem uma função que monta a mensagem, como `Msg.Changed(_)`: `onInput`, `onSubmit` e `onChoose` informam uma `Str`, `onToggle` um `Bool`, `onSort` o índice de uma coluna, e `onPick` o de uma linha da tabela, sem contar o cabeçalho. Um `link` numa janela envia a sua mensagem em vez de seguir o `href`, e uma página servida só mantém um link se ele for um caminho ou um link `http`, `https` ou `mailto`.\n\nAbrir uma janela não espera por ela, então um programa pode abrir várias. No Windows e no Linux o próprio programa desenha a janela, com todos os widgets, sem navegador nenhum. Ela vira uma janela de navegador se o programa trouxer uma fonte própria ou se for aberta com `hive.ui.webview`, que recebe os mesmos três argumentos que `window`. Nos outros sistemas é sempre uma janela de navegador: uma janela em modo aplicativo, num perfil próprio, sem nada da sessão ou das extensões de ninguém, ou uma aba numa máquina sem navegador da família Chromium. Fechar uma janela mata o serviço dela, fechar a última encerra o programa, e um `main` que retorna com uma janela aberta espera por elas.\n\nUm trabalho que não pode travar a tela não precisa de tipo de comando: `update` é um `proc`, então pode iniciar o trabalho com `async`, e, tendo o endereço da janela, esse trabalho pode mandar o resultado de volta como uma mensagem comum.\n\nO ícone do programa é `assets/icon.png` ao lado do ponto de entrada, um PNG de no máximo 256×256, e a fonte dele é `assets/font.woff2`; sem ela, uma janela usa a do sistema. Nada no código nomeia nenhum dos dois: a pasta `assets/` inteira entra no executável, e no Windows o executável também carrega o ícone, então um gerenciador de arquivos e um atalho fixado o mostram. `HIVE_WINDOW=print` imprime o endereço da janela, `hive-window <url>`, em vez de abrir um navegador, para o que mais for mostrar a página, e faz de uma janela que o programa desenharia ele mesmo uma página também, para que haja uma a mostrar.",
			examples: [
				Example(caption: "A window, with no command type", captionPt: "Uma janela, sem tipo de comando", code: `type Model \{
	rows:    Str[dyn]
	loading: Bool
}

type Msg \{
	Refresh
	Loaded \{ rows: Str[dyn] }
}

func view(model: Model): ui.View \{
	mut ui.View[dyn] kids = [ui.button([ui.on(Msg.Refresh())], "Refresh")]
	if model.loading \{
		append(kids, ui.spinner([]))
	}
	for each row in model.rows \{
		append(kids, ui.text([], row))
	}
	return ui.column([ui.pad(24), ui.gap(8)], kids)
}

proc update(model: mut Model, msg: Msg, window: Address<Msg>): Msg \{
	if msg is Msg.Refresh \{
		async reload(window)         // off it goes; nothing to hold
		model.loading = true         // ...and the spinner starts now
	} else if msg is Msg.Loaded(rows) \{
		model = Model(rows, false)   // it comes back as a message
	}
	return msg
}

proc reload(window: Address<Msg>): void \{
	hive.task.sleep(400)
	async window(Msg.Loaded(["north", "south"]))
}

proc main(): void \{
	spawn(ui.window("Colonies", view, update), Model([], false))
}`, codePt: `type Model \{
	rows:    Str[dyn]
	loading: Bool
}

type Msg \{
	Refresh
	Loaded \{ rows: Str[dyn] }
}

func view(model: Model): ui.View \{
	mut ui.View[dyn] kids = [ui.button([ui.on(Msg.Refresh())], "Atualizar")]
	if model.loading \{
		append(kids, ui.spinner([]))
	}
	for each row in model.rows \{
		append(kids, ui.text([], row))
	}
	return ui.column([ui.pad(24), ui.gap(8)], kids)
}

proc update(model: mut Model, msg: Msg, window: Address<Msg>): Msg \{
	if msg is Msg.Refresh \{
		async reload(window)         // lá vai; nada a segurar
		model.loading = true         // ...e o spinner começa agora
	} else if msg is Msg.Loaded(rows) \{
		model = Model(rows, false)   // volta como uma mensagem
	}
	return msg
}

proc reload(window: Address<Msg>): void \{
	hive.task.sleep(400)
	async window(Msg.Loaded(["north", "south"]))
}

proc main(): void \{
	spawn(ui.window("Colônias", view, update), Model([], false))
}`),
			],
		),
		Slide(
			title: "Drawing on a canvas",
			titlePt: "Desenhando em um canvas",
			download: false,
			shot: "",
			explanation: "`canvas(attrs, marks)` is a widget like any other and a `Mark` is a value like any other, so what a canvas holds is what is on it right now. There is no drawing context, no frame to schedule and nothing to clear: a chart is rebuilt from the state like the rest of the page, and a served page draws it the same way a window does.\n\nThere are five marks, each because it cannot be made from the others:\n\n- `dot(attrs, x, y, radius)`, a filled circle;\n- `bar(attrs, x, y, width, height)`, a rectangle;\n- `path(attrs, points)`, a line through a run of points written `x, y, x, y`, and `patch(attrs, points)`, the same points filled;\n- `words(attrs, x, y, height, text)`, text placed on the plane.\n\nA ring is a path around a circle, an arrow is a path, and a grid is a vector of paths. A `dot` is always filled.\n\nEverything is in the program's own units. `region(x, y, width, height)` sets which part of the plane the box shows, so on a circuit mapped in metres, a car nine metres long is drawn nine metres long. `paint(Tone)` is a mark's colour and `thick(Float)` a path's width, also in the region's units, so zooming in makes the roads thicker, as zooming in should. The box may be any shape, and the drawing keeps its own proportions, centred. Every mark, a bar included, is placed by its middle, and words are centred on their position, with their height in the region's units. `y` grows downward, as on a page, so a chart's floor is its largest `y`.",
			explanationPt: "`canvas(attrs, marks)` é um widget como qualquer outro e um `Mark` é um valor como qualquer outro, então o que um canvas guarda é o que está nele agora. Não há contexto de desenho, nem quadro para agendar, nem nada para limpar: um gráfico é reconstruído a partir do estado como o resto da página, e uma página servida o desenha do mesmo jeito que uma janela.\n\nExistem cinco marcas, cada uma porque não dá para fazê-la com as outras:\n\n- `dot(attrs, x, y, radius)`, um círculo preenchido;\n- `bar(attrs, x, y, width, height)`, um retângulo;\n- `path(attrs, points)`, uma linha por uma sequência de pontos escrita `x, y, x, y`, e `patch(attrs, points)`, os mesmos pontos preenchidos;\n- `words(attrs, x, y, height, text)`, texto posicionado no plano.\n\nUm anel é um path em volta de um círculo, uma seta é um path, e uma grade é um vetor de paths. Um `dot` é sempre preenchido.\n\nTudo fica nas unidades do próprio programa. `region(x, y, width, height)` define qual parte do plano a caixa mostra, então, num circuito mapeado em metros, um carro de nove metros é desenhado com nove metros. `paint(Tone)` é a cor de uma marca e `thick(Float)` a largura de um path, também nas unidades da região, então dar zoom engrossa as estradas, como deve ser. A caixa pode ter qualquer formato, e o desenho mantém as próprias proporções, centralizado. Toda marca, inclusive uma barra, é posicionada pelo meio, e as palavras ficam centralizadas na sua posição, com a altura nas unidades da região. O `y` cresce para baixo, como numa página, então o chão de um gráfico é o seu maior `y`.",
			examples: [
				Example(caption: "A chart, in the program's own units", captionPt: "Um gráfico, nas unidades do próprio programa", code: `// Twelve across and a hundred down, so a month of 68 kilos is drawn 68
// long and nothing has to be turned into pixels first.
func chart(harvest: Int[]): ui.View \{
	mut ui.Mark[dyn] marks = []
	for i := 0; i < len(harvest); i++ \{
		tall := hive.conv.itf(harvest[i])    // the loop's own condition proves i
		// A bar is placed from its middle, which is why the floor is
		// 100 and the middle of one standing on it is half a bar up.
		append(marks, ui.bar([ui.paint(ui.Tone.Good())],
			hive.conv.itf(i) + 0.5, 100.0 - tall / 2.0, 0.7, tall))
	}
	append(marks, ui.words([ui.paint(ui.Tone.Muted())], 6.0, 8.0, 7.0, "kg per month"))
	return ui.canvas([
		ui.width(480),
		ui.height(200),
		ui.region(0.0, 0.0, 12.0, 100.0),
	], marks)
}

proc main(): void \{
	// The same tree a window would swap in is what a page writes out.
	echo len(ui.page("Harvest", chart([31, 44, 58, 72, 68, 51])))
}`, codePt: `// Doze de largura e cem de altura, então um mês de 68 quilos é desenhado
// com 68 de comprimento e nada precisa virar pixel primeiro.
func chart(harvest: Int[]): ui.View \{
	mut ui.Mark[dyn] marks = []
	for i := 0; i < len(harvest); i++ \{
		tall := hive.conv.itf(harvest[i])    // a condição do laço prova i
		// Um bar é posicionado pelo seu meio, e é por isso que o chão
		// é 100 e o meio de um em pé sobre ele fica meia barra acima.
		append(marks, ui.bar([ui.paint(ui.Tone.Good())],
			hive.conv.itf(i) + 0.5, 100.0 - tall / 2.0, 0.7, tall))
	}
	append(marks, ui.words([ui.paint(ui.Tone.Muted())], 6.0, 8.0, 7.0, "kg por mês"))
	return ui.canvas([
		ui.width(480),
		ui.height(200),
		ui.region(0.0, 0.0, 12.0, 100.0),
	], marks)
}

proc main(): void \{
	// A mesma árvore que uma window trocaria é a que uma página escreve.
	echo len(ui.page("Colheita", chart([31, 44, 58, 72, 68, 51])))
}`),
				Example(caption: "A line, a dot and a word", captionPt: "Uma linha, um ponto e uma palavra", code: `proc main(): void \{
	// A line through five places — x, y, x, y — and a dot on the last of them.
	trace := ui.path([ui.thick(0.15), ui.paint(ui.Tone.Good())],
		[0.0, 2.0, 1.0, 5.0, 2.0, 4.0, 3.0, 8.0, 4.0, 7.0])
	tip := ui.dot([ui.paint(ui.Tone.Good())], 4.0, 7.0, 0.2)

	// Words are centred on the place, and their height is in region units
	// too — so this one is a twelfth as tall as the plane it sits on.
	label := ui.words([ui.paint(ui.Tone.Muted())], 4.0, 8.4, 0.8, "now")

	view := ui.canvas([
		ui.width(360),
		ui.height(200),
		ui.region(-0.5, 0.0, 5.5, 10.0),
	], [trace, tip, label])

	echo ui.html(view)
}`, codePt: `proc main(): void \{
	// Uma linha através de cinco lugares — x, y, x, y — e um ponto sobre o último.
	trace := ui.path([ui.thick(0.15), ui.paint(ui.Tone.Good())],
		[0.0, 2.0, 1.0, 5.0, 2.0, 4.0, 3.0, 8.0, 4.0, 7.0])
	tip := ui.dot([ui.paint(ui.Tone.Good())], 4.0, 7.0, 0.2)

	// words fica centralizado no lugar, e sua altura também está nas
	// unidades da região — então esta tem um doze avos do plano em que está.
	label := ui.words([ui.paint(ui.Tone.Muted())], 4.0, 8.4, 0.8, "agora")

	view := ui.canvas([
		ui.width(360),
		ui.height(200),
		ui.region(-0.5, 0.0, 5.5, 10.0),
	], [trace, tip, label])

	echo ui.html(view)
}`),
			],
		),
		Slide(
			title: "Three dimensions",
			titlePt: "Três dimensões",
			download: false,
			shot: "/shot/three-dimensions.png",
			explanation: "`hive.ui.scene(attrs, shapes)` is the one widget only a window can draw: a camera, a sky and a vector of shapes, rebuilt from the state by an ordinary `func` every frame. Nothing is a handle (no mesh to keep, no material to allocate), so a program says what is there now, never what changed. Its shapes are `hive.ui` calls like every other widget. It is the one part of the library that carries a download: Hive's own scene engine, built on Filament, fetched on the first build that draws a scene, checked against a pinned SHA-256, cached, and built into the executable. In a window the program draws itself, on Windows and Linux amd64, the engine runs as a process beside the program; in a window that is a page, it runs as WebAssembly. A scene looks the same either way.\n\nShapes take their dimensions in metres as their payload, the arguments after `attrs`, because a sphere without a radius is not a sphere with a default one:\n\n- `box(attrs, width, height, depth)`, `sphere(attrs, radius)`, `cylinder(attrs, radius, height)`, and `cone(attrs, top, bottom, height)`: a top of `0` makes a point, and a top equal to the bottom makes a cylinder.\n- `roof(attrs, wide, tall, long)`, a ridge along its length with a gable at each end; `ground(attrs, width, depth)`, already lying flat.\n- `label(attrs, words)`, always facing the viewer; `sprite(attrs, image, wide, tall)`, a picture from the program's `assets/` that also faces the viewer. A sprite stands on its foot rather than its middle, is drawn unfiltered, and is untinted unless painted.\n- `line(attrs, fromX, fromY, fromZ, toX, toY, toZ)`, which has no position of its own.\n\n`at(x, y, z)` is where a shape's middle is. `turn(x, y, z)` is its rotation in radians, applied as a heading: yaw (`y`) first, then pitch (`x`) about the shape's own side-to-side axis, then roll (`z`) about its own length. So a shape turned to face somewhere and then pitched tips nose-up in the direction it faces. `paint(Tone)` is its colour, and a colour with alpha (`Tone.RGBA`, or a four- or eight-digit `Tone.HEX`) is see-through.\n\n`surface(Surface)` is what a shape is made of, drawn over its colour. From the ground up: `Turf`, `Gravel`, `Tarmac`, `Kerb`; `Concrete`, `Brick`, `Panes`, `Planks`, `Staves`; `Bark`, `Leaves`, `Crowd`; `Mesh`; and `Speckle`, `Metal`, `Carbon`, `Rubber`, `Glass`, `Gloss`.\n\n- A finish repeats about every two metres, on a box face by face.\n- Every finish has relief except `Gloss`, `Glass` and `Mesh`. `Mesh` has real holes and shows from both sides, and `Panes` paints its own glass.\n- A shape that names no surface gets one from its kind: a ground is `Turf`, a cylinder or a cone `Staves`, a sphere `Speckle`, anything else `Planks`.\n- A photograph at `assets/textures/<surface>.jpg` replaces a finish's drawing, with a `-normal.jpg` beside it for relief. It is laid over the colour, so it should average mid-grey; if it is missing, the drawing is used.",
			explanationPt: "`hive.ui.scene(attrs, shapes)` é o único widget que só uma janela consegue desenhar: uma câmera, um céu e um vetor de formas, reconstruídos a partir do estado por um `func` comum a cada quadro. Nada é um handle (nenhuma malha para guardar, nenhum material para alocar), então um programa diz o que existe agora, nunca o que mudou. Suas formas são chamadas `hive.ui` como qualquer outro widget. É a única parte da biblioteca que traz um download: o motor de cenas do próprio Hive, construído sobre o Filament, buscado na primeira build que desenha uma cena, conferido contra um SHA-256 fixado, guardado em cache e embutido no executável. Numa janela que o próprio programa desenha, no Windows e no Linux amd64, o motor roda como um processo ao lado do programa; numa janela que é uma página, ele roda como WebAssembly. Uma cena fica igual nos dois casos.\n\nAs formas recebem as dimensões em metros como carga, os argumentos depois de `attrs`, porque uma esfera sem raio não é uma esfera com um raio padrão:\n\n- `box(attrs, width, height, depth)`, `sphere(attrs, radius)`, `cylinder(attrs, radius, height)`, e `cone(attrs, top, bottom, height)`: um topo `0` faz uma ponta, e um topo igual à base faz um cilindro.\n- `roof(attrs, wide, tall, long)`, uma cumeeira ao longo do comprimento com uma empena em cada ponta; `ground(attrs, width, depth)`, já deitado.\n- `label(attrs, words)`, sempre de frente para quem olha; `sprite(attrs, image, wide, tall)`, uma imagem dos `assets/` do programa que também fica de frente para quem olha. Um sprite fica de pé sobre a base em vez de pelo meio, é desenhado sem filtro e fica sem tingir, a menos que seja pintado.\n- `line(attrs, fromX, fromY, fromZ, toX, toY, toZ)`, que não tem posição própria.\n\n`at(x, y, z)` é onde fica o meio de uma forma. `turn(x, y, z)` é a rotação dela em radianos, aplicada como um rumo: guinada (`y`) primeiro, depois inclinação (`x`) em torno do eixo lateral da própria forma, depois rolagem (`z`) em torno do próprio comprimento. Assim, uma forma virada para algum lugar e depois inclinada levanta o nariz na direção em que olha. `paint(Tone)` é a cor dela, e uma cor com alfa (`Tone.RGBA`, ou um `Tone.HEX` de quatro ou oito dígitos) é translúcida.\n\n`surface(Surface)` é do que uma forma é feita, desenhado sobre a cor dela. Do chão para cima: `Turf`, `Gravel`, `Tarmac`, `Kerb`; `Concrete`, `Brick`, `Panes`, `Planks`, `Staves`; `Bark`, `Leaves`, `Crowd`; `Mesh`; e `Speckle`, `Metal`, `Carbon`, `Rubber`, `Glass`, `Gloss`.\n\n- Um acabamento se repete mais ou menos a cada dois metros, numa caixa face a face.\n- Todo acabamento tem relevo, exceto `Gloss`, `Glass` e `Mesh`. `Mesh` tem furos de verdade e aparece dos dois lados, e `Panes` pinta o próprio vidro.\n- Uma forma que não nomeia superfície ganha uma pelo seu tipo: um chão é `Turf`, um cilindro ou um cone `Staves`, uma esfera `Speckle`, qualquer outra coisa `Planks`.\n- Uma fotografia em `assets/textures/<surface>.jpg` substitui o desenho de um acabamento, com um `-normal.jpg` ao lado para o relevo. Ela é aplicada sobre a cor, então deve ter média cinza; se faltar, o desenho é usado.",
			examples: [
				Example(caption: "A 3D scene, in a window", captionPt: "Uma cena 3D, numa janela", code: `type Msg \{ Tick }

func view(model: Int): hive.ui.View \{
	shapes := [
		hive.ui.ground([hive.ui.paint(hive.ui.Tone.HEX("#2d5c34"))], 20.0, 20.0),
		hive.ui.box(
			[
				hive.ui.at(0.0, 0.5, -3.0),
				hive.ui.paint(hive.ui.Tone.HEX("#b5651d")),
				hive.ui.surface(hive.ui.Surface.Planks()),
			],
			1.0, 1.0, 1.0,
		),
		hive.ui.sphere([hive.ui.at(2.0, 1.0, -4.0), hive.ui.paint(hive.ui.Tone.HEX("#e0c341"))], 1.0),
		// A cone takes both radii: nought at the top is the pointed one.
		hive.ui.cone(
			[
				hive.ui.at(-2.0, 0.4, -3.0),
				hive.ui.paint(hive.ui.Tone.HEX("#ff5a1f")),
				hive.ui.surface(hive.ui.Surface.Gloss()),
			],
			0.0, 0.4, 0.8,
		),
		// And a colour with an alpha is drawn see-through.
		hive.ui.box(
			[hive.ui.at(0.0, 1.2, -1.5), hive.ui.paint(hive.ui.Tone.RGBA(120, 200, 255, 96))],
			3.0, 2.0, 0.2,
		),
	]
	return hive.ui.scene(
		[hive.ui.grow(1), hive.ui.eye(0.0, 1.6, 4.0), hive.ui.aim(0.0, 0.0), hive.ui.lens(70), hive.ui.fog(60)],
		shapes,
	)
}

proc update(model: mut Int, msg: Msg): Msg \{
	return msg
}

proc main(): void \{
	spawn(hive.ui.window("A 3D scene", view, update), 0)
