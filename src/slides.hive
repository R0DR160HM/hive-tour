				1.0, 1.0, 1.0,
			),
		],
	)
}

// O onFrame de uma scene reporta quantos milissegundos o último frame levou,
// então o giro que esta caixa faz é em segundos reais, não em frames — a
// mesma caixa gira na mesma velocidade a trinta quadros por segundo ou a sessenta.
proc spin(angle: mut Float, msg: Msg): Msg \{
	if msg is Msg.Tick(ms) \{
		angle += hive.conv.itf(ms) * 0.002
	}
	return msg
}

proc main(): void \{
	spawn(hive.ui.window("Uma caixa girando", view, spin), 0.0)
}`),
				Example(caption: "Driving it with a gamepad", captionPt: "Dirigindo com um gamepad", code: `type Msg \{
	Tick \{ ms: Int }
	Padded \{ pad: Int, control: Str, at: Float }
}

type Kart \{
	x:        Float
	z:        Float
	steer:    Float
	throttle: Float
}

func view(kart: Kart): hive.ui.View \{
	return hive.ui.scene(
		[
			hive.ui.grow(1),
			hive.ui.eye(kart.x, 4.0, kart.z + 9.0),
			hive.ui.aim(0.0, -0.25),
			hive.ui.lens(70),
			hive.ui.onFrame(Msg.Tick(_)),
			hive.ui.onPad(Msg.Padded(_, _, _)),
		],
		[
			hive.ui.ground(
				[hive.ui.paint(hive.ui.Tone.HEX("#61686f")), hive.ui.surface(hive.ui.Surface.Tarmac())],
				120.0, 120.0,
			),
			hive.ui.box(
				[
					hive.ui.at(kart.x, 0.4, kart.z),
					hive.ui.paint(hive.ui.Tone.HEX("#00d2be")),
					hive.ui.surface(hive.ui.Surface.Gloss()),
				],
				1.6, 0.6, 3.4,
			),
		],
	)
}

// A stick and a trigger arrive through the same hole and are told apart by
// name, because a button is a control that is only ever 0 or 1. Nothing is
// held on to here that the pad did not say: onPad reports what *changed*,
// so the model remembers the last position of each control it cares about.
proc drive(kart: mut Kart, msg: Msg): Msg \{
	if msg is Msg.Padded(pad, control, at) \{
		if control == "leftX" \{ kart.steer = at }
		if control == "rt" \{ kart.throttle = at }
	} else if msg is Msg.Tick(ms) \{
		step := hive.conv.itf(ms) / 1000.0
		kart.x = kart.x + kart.steer * kart.throttle * 16.0 * step
		kart.z = kart.z - kart.throttle * 16.0 * step
	}
	return msg
}

proc main(): void \{
	spawn(hive.ui.window("A pad", view, drive), Kart(0.0, 0.0, 0.0, 0.0))
}`, codePt: `type Msg \{
	Tick \{ ms: Int }
	Padded \{ pad: Int, control: Str, at: Float }
}

type Kart \{
	x:        Float
	z:        Float
	steer:    Float
	throttle: Float
}

func view(kart: Kart): hive.ui.View \{
	return hive.ui.scene(
		[
			hive.ui.grow(1),
			hive.ui.eye(kart.x, 4.0, kart.z + 9.0),
			hive.ui.aim(0.0, -0.25),
			hive.ui.lens(70),
			hive.ui.onFrame(Msg.Tick(_)),
			hive.ui.onPad(Msg.Padded(_, _, _)),
		],
		[
			hive.ui.ground(
				[hive.ui.paint(hive.ui.Tone.HEX("#61686f")), hive.ui.surface(hive.ui.Surface.Tarmac())],
				120.0, 120.0,
			),
			hive.ui.box(
				[
					hive.ui.at(kart.x, 0.4, kart.z),
					hive.ui.paint(hive.ui.Tone.HEX("#00d2be")),
					hive.ui.surface(hive.ui.Surface.Gloss()),
				],
				1.6, 0.6, 3.4,
			),
		],
	)
}

// Um analógico e um gatilho chegam pelo mesmo buraco e são distinguidos pelo
// nome, porque um botão é um comando que só é 0 ou 1. Nada é guardado aqui
// que o controle não tenha dito: onPad reporta o que *mudou*, então o modelo
// lembra a última posição de cada comando que lhe interessa.
proc drive(kart: mut Kart, msg: Msg): Msg \{
	if msg is Msg.Padded(pad, control, at) \{
		if control == "leftX" \{ kart.steer = at }
		if control == "rt" \{ kart.throttle = at }
	} else if msg is Msg.Tick(ms) \{
		step := hive.conv.itf(ms) / 1000.0
		kart.x = kart.x + kart.steer * kart.throttle * 16.0 * step
		kart.z = kart.z - kart.throttle * 16.0 * step
	}
	return msg
}

proc main(): void \{
	spawn(hive.ui.window("Um controle", view, drive), Kart(0.0, 0.0, 0.0, 0.0))
}`),
			],
		),
		Slide(
			title: "A sound is a shape",
			titlePt: "Um som é uma forma",
			download: false,
			shot: "",
			explanation: "`sound(attrs, name)` is a scene's tenth shape, the one heard from where it stands rather than drawn there. It takes `at` like every other shape, plus four attributes of its own: `voice(Voice)` is which noise it makes, `pitch(Float)` how high and `volume(Float)` how loud, each a multiple of that voice at rest rather than hertz or decibels, and `track(Str)` is a recording under the program's own `assets/`.\n\nA sound is a shape because a noise in a world has a place in it. It is placed by the same `at`, written into the same frame, and heard from the scene's own `eye` and `aim`, so what is heard on the left is what is drawn on the left, and it fades as the listener walks away.\n\nThe payload is a name, and the name is the sound's identity from one frame to the next. A box is matched to whatever was in its slot last frame, but an oscillator rebuilt that way would click sixty times a second. So a name that was in the last frame carries on, a name that has just arrived starts, and a name that has gone fades out. What happens then depends on the voice:\n\n- `Engine`, `Tyres`, `Brakes`, `Wind`, `Crowd` and `Music` are **sustained**: they last as long as the scene keeps naming them.\n- `Impact`, `Chime` and `Talk` are **struck**: they fire once, when the name arrives. Naming `\"hit-3\"` for as long as a car knows it was hit is one impact; dropping the name and bringing it back is a second.\n- `Music` and `Talk` have nowhere to stand, so neither is panned.\n\nEvery voice is made of oscillators and filtered noise unless `track` names a file. A sustained voice loops its recording, with `pitch` as the playback speed; a struck one plays it once, and is not heard if the recording is still decoding when the sound arrives. A missing or undecodable file falls back to the made voice. A browser plays no sound before the first click or key press, and the runtime tries again on each one.",
			explanationPt: "`sound(attrs, name)` é a décima forma de uma cena, a que é ouvida de onde está em vez de desenhada ali. Ela recebe `at` como qualquer outra forma, mais quatro atributos próprios: `voice(Voice)` é que ruído ela faz, `pitch(Float)` o quão agudo e `volume(Float)` o quão alto, cada um como múltiplo daquela voz em repouso, e não em hertz ou decibéis, e `track(Str)` é uma gravação nos `assets/` do próprio programa.\n\nUm som é uma forma porque um ruído num mundo tem um lugar nele. Ele é posicionado pelo mesmo `at`, escrito no mesmo quadro e ouvido a partir do `eye` e do `aim` da própria cena, então o que se ouve à esquerda é o que está desenhado à esquerda, e ele diminui conforme quem ouve se afasta.\n\nA carga é um nome, e o nome é a identidade do som de um quadro para o outro. Uma caixa é casada com o que estava no seu lugar no quadro anterior, mas um oscilador reconstruído assim estalaria sessenta vezes por segundo. Então um nome que estava no último quadro continua, um nome que acabou de chegar começa, e um nome que sumiu vai se apagando. O que acontece depois depende da voz:\n\n- `Engine`, `Tyres`, `Brakes`, `Wind`, `Crowd` e `Music` são **sustentadas**: duram enquanto a cena continuar nomeando-as.\n- `Impact`, `Chime` e `Talk` são **percutidas**: disparam uma vez, quando o nome chega. Nomear `\"hit-3\"` enquanto um carro souber que foi atingido é um impacto; deixar o nome sumir e trazê-lo de volta é um segundo.\n- `Music` e `Talk` não têm onde ficar, então nenhuma das duas é posicionada entre os lados.\n\nToda voz é feita de osciladores e ruído filtrado, a menos que `track` nomeie um arquivo. Uma voz sustentada repete a gravação em laço, com `pitch` como velocidade de reprodução; uma percutida a toca uma vez, e não é ouvida se a gravação ainda estiver sendo decodificada quando o som chegar. Um arquivo ausente ou que não se consegue decodificar volta para a voz feita. Um navegador não toca som antes do primeiro clique ou tecla, e o runtime tenta de novo a cada um.",
			examples: [
				Example(caption: "Sustained and struck, side by side", captionPt: "Sustentada e percutida, lado a lado", code: `type Msg \{ Tick }

type Car \{
	seat:  Int
	x:     Float
	z:     Float
	speed: Float
	knock: Bool
}

// A func like every other shape-maker, and worth noticing that a sound is
// exactly as much of a value as a box is: sixty of these are built a second
// and thrown away, while the voice on the other end of the name goes on
// running the whole time.
func noises(cars: Car[]): ui.Shape[dyn] \{
	mut ui.Shape[dyn] out = []
	for each car in cars \{
		// Sustained: it lasts as long as the scene goes on naming it, and
		// bends with the speed rather than being restarted at a new one.
		append(out, ui.sound([
			ui.at(car.x, 0.6, car.z),
			ui.voice(ui.Voice.Engine()),
			ui.pitch(0.7 + car.speed / 90.0),
			ui.volume(0.6),
		], "engine-\{car.seat}"))

		// Struck: it fires when the name arrives and is deaf to everything
		// after it. Letting the name go and bringing it back is a second one.
		if car.knock \{
			append(out, ui.sound([
				ui.at(car.x, 0.6, car.z),
				ui.voice(ui.Voice.Impact()),
				ui.pitch(1.0),
				ui.volume(0.8),
			], "hit-\{car.seat}"))
		}
	}
	return out
}

func view(cars: Car[dyn]): ui.View \{
	solids := [ui.ground([ui.paint(ui.Tone.HEX("#3a3f45"))], 400.0, 400.0)]
	return ui.scene([
		ui.grow(1),
		ui.eye(0.0, 1.4, 6.0),
		ui.aim(0.0, 0.0),
		ui.background(ui.Tone.HEX("#8ec5ff")),
	], solids + noises(cars))
}

proc update(cars: mut Car[dyn], msg: Msg): Msg \{
	return msg
}

proc main(): void \{
	Car[dyn] grid = [Car(1, -2.0, 0.0, 40.0, false), Car(2, 2.0, -6.0, 62.0, true)]
	spawn(ui.window("Sound", view, update), grid)
}`, codePt: `type Msg \{ Tick }

type Car \{
	seat:  Int
	x:     Float
	z:     Float
	speed: Float
	knock: Bool
}

// Um func como todo outro construtor de formas deste arquivo, e vale notar
// que um som é exatamente tão valor quanto uma box: sessenta destes são
// construídos por segundo e jogados fora, enquanto a voz do outro lado do
// nome segue rodando o tempo todo.
func noises(cars: Car[]): ui.Shape[dyn] \{
	mut ui.Shape[dyn] out = []
	for each car in cars \{
		// Sustentada: dura enquanto a scene continuar a nomeando, e dobra
		// com a velocidade em vez de ser reiniciada em uma nova.
		append(out, ui.sound([
			ui.at(car.x, 0.6, car.z),
			ui.voice(ui.Voice.Engine()),
			ui.pitch(0.7 + car.speed / 90.0),
			ui.volume(0.6),
		], "engine-\{car.seat}"))

		// Percutida: dispara quando o nome chega e fica surda a tudo depois
		// disso. Soltar o nome e trazê-lo de volta é um segundo impacto.
		if car.knock \{
			append(out, ui.sound([
				ui.at(car.x, 0.6, car.z),
				ui.voice(ui.Voice.Impact()),
				ui.pitch(1.0),
				ui.volume(0.8),
			], "hit-\{car.seat}"))
		}
	}
	return out
}

func view(cars: Car[dyn]): ui.View \{
	solids := [ui.ground([ui.paint(ui.Tone.HEX("#3a3f45"))], 400.0, 400.0)]
	return ui.scene([
		ui.grow(1),
		ui.eye(0.0, 1.4, 6.0),
		ui.aim(0.0, 0.0),
		ui.background(ui.Tone.HEX("#8ec5ff")),
	], solids + noises(cars))
}

proc update(cars: mut Car[dyn], msg: Msg): Msg \{
	return msg
}

proc main(): void \{
	Car[dyn] grid = [Car(1, -2.0, 0.0, 40.0, false), Car(2, 2.0, -6.0, 62.0, true)]
	spawn(ui.window("Som", view, update), grid)
}`),
