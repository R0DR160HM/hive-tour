		org_id = \{session.user.org.id}
	}
}

query names(session: Session): Str[dyn] \{
	SELECT name FROM people
	WHERE \{
		if session.user is User.Regular \{ org_id = \{session.user.org.id} }
	}
	ORDER BY name
}

proc main(): void \{
	bees := Organization(1, "Bees")
	ada := Session(User.Regular(1, "Ada", bees))
	root := Session(User.Admin(2, "Root", bees))
	opened := hive.sql.pool(hive.sql.DatabaseDriver.SQLite(), ":memory:", 1, 1)
	if opened is Result.Ok(db) \{
		hive.sql.unsafe(db, "CREATE TABLE people (name TEXT, org_id INTEGER)")
		hive.sql.unsafe(db, "INSERT INTO people VALUES ('Ada', 1), ('Grace', 1), ('Tim', 2)")
		echo hive.sql.run(db, names(ada))
		echo hive.sql.run(db, names(root))
		hive.sql.close(db)
	}
}`),
				Example(caption: "chats.hive, wrong on purpose", captionPt: "chats.hive, errado de propósito", code: `type Contact \{
	id: Int
}

type Chat \{
